# Dockerfile to build FlagScale Debian packages
# No vendor SDK needed - pure Python package

# Debian trixie ships python3-setuptools >= 75, which meets the
# pyproject.toml `setuptools>=77.0` build requirement once trixie reaches
# the matching point release. Earlier distros (Ubuntu 24.04 noble has
# 68.x) fall short, so we cannot use them as the default base.
ARG BASE_IMAGE=debian
ARG BASE_IMAGE_VERSION=trixie-slim

FROM ${BASE_IMAGE}:${BASE_IMAGE_VERSION}

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    debhelper \
    devscripts \
    dpkg-dev \
    fakeroot \
    dh-python \
    pybuild-plugin-pyproject \
    python3-all \
    python3-setuptools \
    python3-wheel \
    python3-pip \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

COPY . /workspace/FlagScale
WORKDIR /workspace/FlagScale

# Copy packaging debian dir to source root
RUN cp -r packaging/debian debian

# Build the package
RUN dpkg-buildpackage -us -uc -b 2>&1 || \
    { echo "=== Build failed, showing logs ==="; \
      find /workspace -name "*.log" -exec echo "=== {} ===" \; -exec cat {} \; 2>/dev/null || true; \
      exit 1; }

# Collect built .deb files
RUN mkdir -p /output && \
    find /workspace -maxdepth 1 -name "*.deb" -exec cp {} /output/ \; && \
    ls -lh /output/
