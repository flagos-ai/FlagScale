diff --git a/.gitlab-ci.yml b/.gitlab-ci.yml
index ee74684c6..cf4f13e6a 100644
--- a/.gitlab-ci.yml
+++ b/.gitlab-ci.yml
@@ -2,7 +2,7 @@
   UNIT_TEST: "yes"
   UNIT_TEST_REPEAT: 1
   UNIT_TEST_TIMEOUT: 30
-  INTEGRATION_TEST: "no"
+  INTEGRATION_TEST: "yes"
   INTEGRATION_TEST_SCOPE: mr
