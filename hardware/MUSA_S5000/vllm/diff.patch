+#include <vector>
+#include <numeric>
+#include "musa.h"
+#include "musa_runtime.h"
+#include "../../linear/common.muh"
+#include "../../quantization/fp8/common.muh"
+
+#ifndef MU_CHECK
+#define MU_CHECK(expression)                                                   \
+    {                                                                          \
+        MUresult status = (expression);                                        \
+        if (status != MUSA_SUCCESS)                                            \
+        {                                                                      \
+            const char *err_str;                                               \
+            muGetErrorString(status, &err_str);                                \
+            std::cerr << "musa driver failed  " << __FILE__<<":"<< __LINE__    \
+            << " : " << err_str << std::endl;                                  \
+            std::exit(EXIT_FAILURE);                                           \
+        }                                                                      \
+    }
+#endif
+
+#ifndef MUSART_CHECK
+#define MUSART_CHECK(expr)                                                            \
+    do                                                                                \
+    {                                                                                 \
+        musaError_t _err = (expr);                                                    \
+        if (_err != musaSuccess)                                                      \
+        {                                                                             \
+            fprintf(stderr, "musa runtime failed " #expr ": err=%d(%s) line=%s:%d\n", \
+                    (int)_err, musaGetErrorString(_err),__FILE__,  __LINE__);         \
+            abort();                                                                  \
+        }                                                                             \
+    } while (0)
+#endif
+
+struct TensorDesc {
+  TensorDesc(const std::vector<uint64_t> &dims, void* ptr, MUtensorDescriptorDataType tensor_dtype, int dtype_size, bool h2d = true) {
+    d_size = dtype_size;
+    tensorRank = dims.size();
+    uint32_t last_stride = 1;
+    for (size_t i = 0; i < tensorRank; ++i) {
+        globalDim[i] = dims[i];
+        if (dims[i] == 0) {
+            is_empty = true;
+        }
+        last_stride = last_stride * dims[i];
+        if (i != tensorRank - 1) {
+            globalStrides[i] = last_stride * dtype_size;
+        }
+    }
+    tensorDataType = tensor_dtype;
+    interleave = MU_TENSOR_DESCRIPTOR_INTERLEAVE_NONE;
+    MU_CHECK(muTensorDescriptorEncode(&tensorDesc, tensorDataType, tensorRank, ptr, globalDim, globalStrides, interleave, oobConstantFill));
+    if (h2d) {
+        MUSART_CHECK(musaMalloc(&desc_addr, 64));
+        MUSART_CHECK(musaMemcpy(desc_addr, (void *)&tensorDesc, 64, musaMemcpyHostToDevice));
+    }
+  }
+
+  MUtensorDescriptor tensorDesc;
+  MUtensorDescriptorDataType tensorDataType;
+  uint32_t tensorRank;
+  uint64_t globalDim[5];
+  uint64_t globalStrides[4]; // 8 * 4 = 32 , 0x20
+  MUtensorDescriptorInterleave interleave;
+  uint64_t oobConstantFill{0};
+  void *desc_addr;
+  int d_size;
+  bool is_empty{false};
+};
+
+// FastDivmod functions
+/**
+ * log2 computation, what's the
+ * difference between the below codes and
+ * log2_up/down codes?
+ */
+template <typename value_t>
+__device__ __host__ __forceinline__ value_t clz(value_t x) {
+  for (int i = 31; i >= 0; --i) {
+    if ((1 << i) & x)
+      return 31 - i;
+  }
+  return 32;
+}
+
+template <typename value_t>
+__device__ __host__ __forceinline__ value_t find_log2(value_t x) {
+  int a = int(31 - clz(x));
+  a += (x & (x - 1)) != 0;  // Round up, add 1 if not a power of 2.
+  return a;
+}
+
+/**
+ * Find divisor, using find_log2
+ */
+__device__ __host__ __forceinline__ void find_divisor(uint32_t& mul,
+                                                      uint32_t& shr,
+                                                      uint32_t denom) {
+  if ((denom & (denom - 1)) == 0) {
+    mul = 1;
+    shr = find_log2(denom);
+  } else {
+    uint32_t p = 31 + find_log2(denom);
+    unsigned m =
+        unsigned(((1ull << p) + unsigned(denom) - 1) / unsigned(denom));
+
+    mul = m;
+    shr = p;
+  }
+}
+
+/**
+ * Find quotient and remainder using device-side intrinsics
+ */
+__device__ __host__ __forceinline__ void fast_divmod(uint32_t& quo,
+                                                     uint32_t& rem,
+                                                     uint32_t src, uint32_t div,
+                                                     uint32_t mul,
+                                                     uint32_t shr) {
+  quo = (uint32_t)(((uint64_t)src * mul) >> shr);
+
+  // The remainder.
+  rem = src - (quo * div);
+}
+
+struct FastDivmodForAsm {
+  uint32_t divisor;
+  uint32_t multiplier;
+  uint32_t shift_right;
+
+  FastDivmodForAsm() : divisor(0), multiplier(0), shift_right(0) {}
+  explicit FastDivmodForAsm(uint32_t divisor_) : divisor(divisor_) {
+    find_divisor_for_asm(multiplier, shift_right, divisor);
+  }
+
+  void find_divisor_for_asm(uint32_t& mul, uint32_t& shr, uint32_t denom) {
+    if (denom == 1) {
+      mul = 0;
+      shr = 0;
+    } else {
+      uint32_t p = 31 + find_log2(denom);
+      unsigned m =
+          unsigned(((1ull << p) + unsigned(denom) - 1) / unsigned(denom));
+
+      mul = m;
+      shr = p - 32;
+    }
+  }
+};
