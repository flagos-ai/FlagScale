+template <class ElementDst, bool IsPerGroupScale, class TensorScale, class Tensor0, class Tensor1>
+MUTE_DEVICE
+void
+dequant_w4(TensorScale scale_tensor, Tensor0& w4_tensor, Tensor1& f16_tensor) {
+  using ElementB = mute::conditional_t<IsPerGroupScale, uint8_t, int8_t>;
+  using ElementLH = mute::conditional_t<IsPerGroupScale, float, int8_t>;
+  MUTE_STATIC_ASSERT_V(size(w4_tensor) == size(f16_tensor));
+  // using v2f16_t = _Float16 __attribute__((vector_size(4)));
+  // using v2f16_t = mutlass::Array<mutlass::bfloat16_t, 2>;
+  constexpr bool is_half = is_same_v<ElementDst, mutlass::half_t>;
+  using v2f16_t = mute::conditional_t<is_half,
+                                      _Float16 __attribute__((vector_size(4))),
+                                      mutlass::Array<mutlass::bfloat16_t, 2>>;
+  using v2f32_t = float __attribute__((vector_size(8)));
+
+  Tensor s8_view = recast<ElementB>(w4_tensor);
+  Tensor v2f16_view = recast<v2f16_t>(f16_tensor);
+  // if (thread(0)) {
+  //   print("f16_tensor = ");print(f16_tensor);print("\n");
+  //   print("v2f16_view = ");print(v2f16_view);print("\n");
+  //   print("scale_tensor = ");print(scale_tensor);print("\n");
+  // }
+  asm("CTRL.NOP");
+  MUTE_UNROLL
+  for (int mi = 0; mi < size<1>(s8_view); ++mi) {
+    MUTE_UNROLL
+    for (int ni = 0; ni < size<2>(s8_view); ++ni) {
+      // alignment data
+      MUTE_UNROLL
+      for (int vi = 0; vi < size<0>(s8_view); ++vi) {
+        ElementLH lo;
+        ElementLH hi;
+        if constexpr (IsPerGroupScale) {
+          lo = (float)((s8_view(vi, mi, ni)) & 0xF) - 8.f;
+          hi = (float)((s8_view(vi, mi, ni) >> 4)) - 8.f;
+        } else {
+          lo = (s8_view(vi, mi, ni) << 4) & 0xF0;
+          hi = s8_view(vi, mi, ni) & 0xF0;
+        }
+        if constexpr (is_half) {
+          if constexpr (IsPerGroupScale) {
+            v2f32_t value{float(lo) * scale_tensor(vi, mi, ni), float(hi) * scale_tensor(vi, mi, ni)};
+            v2f16_view(vi, mi, ni) = __builtin_convertvector(value, v2f16_t);
+          } else {
+            v2f32_t value{float(lo), float(hi)};
+            v2f16_view(vi, mi, ni) = __builtin_convertvector(value, v2f16_t);
+          }
+        } else {
+          if constexpr (IsPerGroupScale) {
+            v2f32_t value{float(lo) * scale_tensor(vi, mi, ni), float(hi)* scale_tensor(vi, mi, ni)};
+            float2 f32x2 = make_float2(value[0], value[1]);
+            __mt_bfloat162 res = __float22bfloat162_rn(f32x2);
+
+            v2f16_t f16x2;
+            f16x2[0] = mutlass::bfloat16_t(res.x);
+            f16x2[1] = mutlass::bfloat16_t(res.y);
+
+            v2f16_view(vi, mi, ni) = f16x2;
+          } else {
+            v2f32_t value{float(lo), float(hi)};
+            float2 f32x2 = make_float2(value[0], value[1]);
+            __mt_bfloat162 res = __float22bfloat162_rn(f32x2);
+
+            v2f16_t f16x2;
+            f16x2[0] = mutlass::bfloat16_t(res.x);
+            f16x2[1] = mutlass::bfloat16_t(res.y);
+
+            v2f16_view(vi, mi, ni) = f16x2;
+          }
+        }
+      }
+    }
+  }
+  // if (thread(0)) {
+  //   print("f16_tensor = ");print(f16_tensor(0));print("\n");
+  // }
+  asm("CTRL.NOP");
+}
