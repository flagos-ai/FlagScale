+  int HEAD_DIM_VO_,
+  int CTA_Q_,
+  int CTA_KV_,
+  int PAGE_SIZE_,
+  class Element_,
+  bool SplitKV_ = true,
+  bool IsQInReg_ = true
+>
+struct DecodeMLAKernelTraits {
+  using Element = Element_;
+  using ElementQ = Element;
+  using ElementKV = Element;
+  using ElementAccumulator = float;
+  using ElementO = conditional_t<SplitKV_, float, Element>;
+
+  static constexpr int CTA_Q         = CTA_Q_;
+  static constexpr int CTA_KV        = CTA_KV_;
+  static constexpr int HEAD_DIM_QK   = HEAD_DIM_QK_;
+  static constexpr int HEAD_DIM_VO   = HEAD_DIM_VO_;
+  static constexpr int IsQInReg      = IsQInReg_;
+  static constexpr int SplitKV       = SplitKV_;
+  static constexpr int PAGE_SIZE     = PAGE_SIZE_;
+  static constexpr int SplitQKSmem   = !IsQInReg;
+
+  static_assert(SplitKV, "Only support SplitKV.");
+
+  static constexpr int FragmentSize = 2;
+
+  using TileShape_QKD = Shape<Int<CTA_Q>, Int<CTA_KV>, Int<HEAD_DIM_QK>>;
+  using TileShape_PDV = Shape<Int<CTA_Q>, Int<HEAD_DIM_VO>, Int<CTA_KV>>;
+
+  // assume (1,1,1) for decode mla
+  using AtomLayoutMNK = Layout<Shape<Int<CTA_Q/32>, _1, _1>>;
+
+  // Internal Mma Stride type
+  using MmaStrideMNMajor = Stride<_1, int>;
+  using MmaStrideKMajor  = Stride<int, _1>;
+
+  using PermutedTileN = decltype(get_mp22_permute_tile_for_operand_B<Int<CTA_KV>, Int<32>>());
+  using PermuteLayoutMNK = Tile<Underscore, PermutedTileN, Underscore>;
+
+  using TiledMmaQK = decltype(mute::make_tiled_mma(
+    mutlass::gemm::collective::detail::mp22_mma_operation_select<
+                                        ElementQ, MmaStrideKMajor,
+                                        ElementKV,MmaStrideKMajor>(),
+    AtomLayoutMNK{},
