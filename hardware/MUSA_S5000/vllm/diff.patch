+    }
+
+template <int HeadDimQK, int HeadDimVO, typename T, bool ReturnL = false>
+void flash_attn_fwd_kernel_launcher(
+    const T *Q, const T *K, const T *V,
+    T *O, T *P, float *L,
+    int q, int kv, int d_qk, int d_vo,
+    int h, int h_kv, int b, bool causal, mute::Shape<int, int, int> qkv_elem,
+    int q_seq_stride, int q_head_stride, int q_batch_stride,
+    int k_seq_stride, int k_head_stride, int k_batch_stride,
+    int v_seq_stride, int v_head_stride, int v_batch_stride,
+    int o_seq_stride, int o_head_stride, int o_batch_stride,
+    int l_seq_stride, int l_head_stride, int l_batch_stride)
+{
+    TORCH_CHECK(d_qk == HeadDimQK && d_vo == HeadDimVO,
+                "Head dimensions must match kernel specialization");
+
+    constexpr int TileM = 64;
+    constexpr int TileN = 64;
+    const musaStream_t stream = at::musa::getCurrentMUSAStream();
+    using KernelTraits = AttentionForwardKernelTraits<HeadDimQK, HeadDimVO, TileM, TileN,
+                                                      false, // EnableVarlen
+                                                      true,
+                                                      true, // robustQ
+                                                      true, // robustK
+                                                      true, // robustV
+                                                      T,
+                                                      ReturnL>;
+
+    int h_r = h / h_kv;
+    auto problem_shape = mute::make_shape(q, kv, d_qk, d_vo, mute::make_shape(h_r, h_kv), b);
+
+    using AttentionParams = AttentionParams<KernelTraits>;
+    using Arguments = typename AttentionParams::Arguments;
+    Arguments arguments = {Q, K, V, O, P, L};
+
+    auto params = AttentionParams::to_underlying_arguments(problem_shape, arguments, qkv_elem,
+                                                           q_seq_stride, q_head_stride, q_batch_stride,
+                                                           k_seq_stride, k_head_stride, k_batch_stride,
+                                                           v_seq_stride, v_head_stride, v_batch_stride,
+                                                           o_seq_stride, o_head_stride, o_batch_stride,
+                                                           l_head_stride, l_batch_stride);
+
+    dim3 block_dims(KernelTraits::NumThreads);
+    dim3 grid_dims(mute::ceil_div(mute::size<0>(problem_shape), KernelTraits::CTA_Q),
+                   mute::size<4>(problem_shape),
+                   mute::size<5>(problem_shape));
+
+    if (causal)
+    {
+        flash_atten_forward<KernelTraits, true, true><<<grid_dims, block_dims, 0, stream>>>(params);
+    }
+    else
+    {
+        flash_atten_forward<KernelTraits, true, false><<<grid_dims, block_dims, 0, stream>>>(params);
+    }
+}
+
+template <int HeadDimQK, int HeadDimVO, typename T, bool ReturnL = false>
+void varlen_flash_attn_fwd_kernel_launcher(
+    const T *Q, const T *K, const T *V,
+    T *O, T *P, float *L,
+    int q, int kv, int d_qk, int d_vo,
+    int h, int h_kv, int b, bool causal, mute::Shape<int, int, int> qkv_elem,
+    int q_seq_stride, int q_head_stride, int q_batch_stride,
+    int k_seq_stride, int k_head_stride, int k_batch_stride,
+    int v_seq_stride, int v_head_stride, int v_batch_stride,
+    int o_seq_stride, int o_head_stride, int o_batch_stride,
+    int l_seq_stride, int l_head_stride, int l_batch_stride,
+    int *cu_q_seqlen, int *cu_kv_seqlen, int max_seqlen_q, int max_seqlen_kv)
+{
+    TORCH_CHECK(d_qk == HeadDimQK && d_vo == HeadDimVO,
+                "Head dimensions must match kernel specialization");
+
+    constexpr int TileM = 64;
+    constexpr int TileN = 64;
+    const musaStream_t stream = at::musa::getCurrentMUSAStream();
+    VariableLength varlen_q{max_seqlen_q, cu_q_seqlen};
+    VariableLength varlen_kv{max_seqlen_kv, cu_kv_seqlen};
+
+    int h_r = h / h_kv;
+    auto problem_shape = mute::make_shape(varlen_q, varlen_kv, d_qk, d_vo, mute::make_shape(h_r, h_kv), b);
+
+    using KernelTraits = AttentionForwardKernelTraits<HeadDimQK, HeadDimVO, TileM, TileN,
+                                                      true, // EnableVarlen
+                                                      true, // IsQInReg
+                                                      true, // robustQ
+                                                      true, // robustK
+                                                      true, // robustV
+                                                      T,
+                                                      ReturnL>;
+    using AttentionParams = AttentionParams<KernelTraits>;
+    using Arguments = typename AttentionParams::Arguments;
+    Arguments arguments = {Q, K, V, O, P, L};
+
+    auto params = AttentionParams::to_underlying_arguments(problem_shape, arguments, qkv_elem,
+                                                           q_seq_stride, q_head_stride, q_batch_stride,
+                                                           k_seq_stride, k_head_stride, k_batch_stride,
+                                                           v_seq_stride, v_head_stride, v_batch_stride,
+                                                           o_seq_stride, o_head_stride, o_batch_stride,
+                                                           l_head_stride, l_batch_stride);
+
+    dim3 block_dims(KernelTraits::NumThreads);
+    dim3 grid_dims(mute::ceil_div(mute::size<0>(problem_shape), KernelTraits::CTA_Q),
+                   mute::size<4>(problem_shape),
+                   mute::size<5>(problem_shape));
+
+    if (causal)
+    {
+        flash_atten_forward<KernelTraits, true, true><<<grid_dims, block_dims, 0, stream>>>(params);
+    }
+    else
+    {
+        flash_atten_forward<KernelTraits, true, false><<<grid_dims, block_dims, 0, stream>>>(params);
+    }
+}
+
+template <typename scalar_t, bool ReturnL>
+void dispatch_head_dims_fixed(
+    int d_qk, int d_vo,
+    const scalar_t *q_ptr, const scalar_t *k_ptr, const scalar_t *v_ptr,
+    scalar_t *o_ptr, scalar_t *P, float *l_ptr,
+    int seqlen_q, int seqlen_kv, int num_head_q, int num_head_kv, int batch, bool causal,
+    mute::Shape<int, int, int> qkv_elem,
+    int q_seq_stride, int q_head_stride, int q_batch_stride,
+    int k_seq_stride, int k_head_stride, int k_batch_stride,
+    int v_seq_stride, int v_head_stride, int v_batch_stride,
+    int o_seq_stride, int o_head_stride, int o_batch_stride,
+    int l_seq_stride, int l_head_stride, int l_batch_stride)
+{
+    if (d_qk == 192 && d_vo == 128) {
+        flash_attn_fwd_kernel_launcher<192, 128, scalar_t, ReturnL>(
+            q_ptr, k_ptr, v_ptr, o_ptr, P, l_ptr,
+            seqlen_q, seqlen_kv, d_qk, d_vo,
+            num_head_q, num_head_kv, batch, causal, qkv_elem,
