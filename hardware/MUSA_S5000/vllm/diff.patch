+// Utility functions to convert stride_factor to the strides used by the Affine2 layout.
+//
+// stride_factor is the logical distance between two coorinates.
+//
+// All Coodinates used here are matrix coordinates.  stride[0] and extent[0] are for the
+// rows.  stride[1] and extent[1] are for the columns.
+template <typename Affine2Layout>
+  struct Affine2Layout_Factory {
+  MUTLASS_HOST_DEVICE
+  static Affine2Layout layout_factory(mutlass::Coord<2> const &extent, typename Affine2Layout::Stride stride_factor) {
+    return Affine2Layout::packed(extent);
+  }
+};
+
+template <>
+struct Affine2Layout_Factory<mutlass::layout::AffineRank2ColumnMajor> {
+MUTLASS_HOST_DEVICE
+static mutlass::layout::AffineRank2ColumnMajor layout_factory(
+  mutlass::Coord<2> const &extent,
+  typename mutlass::layout::AffineRank2ColumnMajor::Stride stride_factor) {
+    return mutlass::layout::AffineRank2ColumnMajor({ stride_factor[0], stride_factor[0] * stride_factor[1] * extent[0] });
+  }
+};
+
+template <>
+struct Affine2Layout_Factory<mutlass::layout::AffineRank2RowMajor> {
+MUTLASS_HOST_DEVICE
+static mutlass::layout::AffineRank2RowMajor layout_factory(
+  mutlass::Coord<2> const &extent,
+  typename mutlass::layout::AffineRank2RowMajor::Stride stride_factor) {
+    return mutlass::layout::AffineRank2RowMajor({ stride_factor[0] * stride_factor[1] * extent[1], stride_factor[1] });
+  }
+};
+
+// The base layout mutlass::layout::AffineRankN<2> is similar to AffineRank2ColumnMajor
+template <>
+struct Affine2Layout_Factory<mutlass::layout::AffineRankN<2>> {
+MUTLASS_HOST_DEVICE
+static mutlass::layout::AffineRankN<2> layout_factory(
+  mutlass::Coord<2> const &extent,
+  typename mutlass::layout::AffineRankN<2>::Stride stride_factor) {
+    return mutlass::layout::AffineRankN<2>({ stride_factor[0], stride_factor[0] * stride_factor[1] * extent[0] });
+  }
+};
