+// load vector into shared memory every blockDim.x elems
+// each warp load [BLOCK_K, BLOCK_M] of mat using DMA.LD.B128 into register
+// If BLOCK_K = 16 and BLOCK_M = 32, for example,
+// tid0-tid7  load 1st row,
+// tid8-tid15 load 2nd row, and so on...
+// col_continuous: matrix(k*m) is col-continuous
+template <typename T, AlignAttr ALIGN_ATTR, int BLOCK_K, int BLOCK_M, int iobit>
+__global__ void batch_gemv_swiglu_col_continuous_kernel(
+    T *d, const T *mat, const T *v, const int batch, const int m, const int k,
+    const int ldm, const int64_t batch_stride_m, const int inc_x,
+    const int64_t batch_stride_x, const int inc_d, const int64_t batch_stride_d,
+    float alpha, const int half_m) {
+  constexpr int bits_of_byte = 8;
+  constexpr int Vlen = iobit / (sizeof(T) * bits_of_byte);
+  using CDtype = typename InferComputeDtype<T>::ComputeDtype;
+  using vec = typename VecType<T, iobit>::Ttype;
+  using cvec = typename VecType<CDtype, 128>::Ttype;
+
+  int tid2 = threadIdx.x;
+  int bx = blockIdx.x; // block in vector
+  int by = blockIdx.y; // batch
+  if (bx * BLOCK_M >= half_m)
+    return;
+
+  // load mat using B128
+  int part_id = tid2 / (blockDim.x / 2);
+  int tid = tid2 % (blockDim.x / 2);
+  int slice_id = tid % (BLOCK_M / Vlen);
+  int lane_id = tid / (BLOCK_M / Vlen);
+  int m_id = bx * BLOCK_M + slice_id * Vlen;
+
+  CDtype res = CDtype(0);
+  extern __shared__ char shared_array[];
+  CDtype *smem = (CDtype *)shared_array;
+
+  CDtype cur_thread_sum[Vlen];
+#pragma unroll
+  for (int i = 0; i < Vlen; i++) {
+    cur_thread_sum[i] = (CDtype)0;
+  }
+
+  // #if defined(__MUSA_ARCH__) && __MUSA_ARCH__ >= 220
+  for (int row_id = lane_id; row_id < k; row_id += BLOCK_K) {
+    if (m_id < half_m) {
+      T m_reg[Vlen];
+      // base_mat_offset 去掉batch维度，删除by * batch_stride_m +
+      int64_t base_mat_offset = row_id * (int64_t)ldm +
+                                (int64_t)m_id + part_id * half_m;
+      if constexpr (ALIGN_ATTR == AlignAttr::ALIGN_VEC) {
+        *((vec *)m_reg) = *(vec *)(mat + base_mat_offset);
+      } else {
+        if (bx * BLOCK_M + BLOCK_M <= half_m) {
+          *((vec *)m_reg) = *(vec *)(mat + base_mat_offset);
+        } else {
+          m_reg[0] = *(mat + base_mat_offset);
+#pragma unroll
+          for (int p = 1; p < Vlen; p++) {
+            m_reg[p] = m_id + p < half_m ? *(mat + base_mat_offset + p) : T(0);
+          }
+        }
+      }
+
+      int64_t v_offset = row_id * (int64_t)inc_x + by * batch_stride_x;
+      T v_val = v[v_offset];
+#pragma unroll
+      for (int p = 0; p < Vlen; p++) {
+        cur_thread_sum[p] += (CDtype)v_val * (CDtype)m_reg[p];
+      }
+    }
+  }
+  // #endif
+
+  CDtype *smem_mat = &smem[0];
+  int sts_offset = lane_id * BLOCK_M * 2 + part_id * BLOCK_M + slice_id * Vlen;
+#pragma unroll
+  for (int p = 0; p < Vlen / 4; p++) {
+    *(cvec *)(&smem_mat[sts_offset + p * 4]) =
+        *(cvec *)(&cur_thread_sum[p * 4]);
+  }
+  __SYNCTHREADS_LM;
+  // return;
+
+#pragma unroll
+  for (int p = 0; p < Vlen / 4; p++) {
+#pragma unroll
+    for (int a = BLOCK_K / 2; a > 1; a >>= 1) {
+      if (lane_id < a) {
+        cvec w_reg = *(cvec *)(&smem_mat[sts_offset + p * 4]);
+        cvec r_reg = *(cvec *)(&smem_mat[sts_offset + p * 4 + a * BLOCK_M * 2]);
+        w_reg.x += r_reg.x;
+        w_reg.y += r_reg.y;
+        w_reg.z += r_reg.z;
+        w_reg.w += r_reg.w;
+        *(cvec *)(&smem_mat[sts_offset + p * 4]) = w_reg;
+      }
+      __SYNCTHREADS_LM;
+    }
+  }
+
+  m_id = bx * BLOCK_M + tid;
+  if (tid < BLOCK_M && m_id < half_m) {
+    CDtype v0 = alpha * (smem_mat[tid] + smem_mat[BLOCK_M * 2 + tid]);
+    CDtype v1 = alpha * (smem_mat[tid + BLOCK_M] +
+                         smem_mat[BLOCK_M * 2 + tid + BLOCK_M]);
+    res = v0 * sigmoid(v0) * v1;
+    int64_t out_offset = by * batch_stride_d + m_id * (int64_t)inc_d;
+    d[out_offset] = res;
+  }
+}
