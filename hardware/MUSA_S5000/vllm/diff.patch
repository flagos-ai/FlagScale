+#include "mute/layout.hpp"
+
+////////////////////////////////////////////////////////////////////////////////////////////////////
+
+namespace mutlass::detail {
+
+////////////////////////////////////////////////////////////////////////////////////////////////////
+
+template <class TiledMma, class = void>
+struct IsSparseTensorOp : mute::false_type { };
+
+// TiledMma for sparse must have ValTypeE
+template <class TiledMma>
+struct IsSparseTensorOp<TiledMma, mute::void_t<typename TiledMma::ValTypeE>>
+    : mute::true_type { };
+
+// The following metafunction is used to extract the OperatorClass from a mutlass 3.x kernel.
+template <class TiledMma>
+struct get_operator_class {
+  static constexpr bool is_sparse_op = IsSparseTensorOp<TiledMma>::value;
+  static constexpr bool is_tensor_op = mute::size<0>(typename TiledMma::AtomShape_MNK{}) >= 8;
+  using type = mute::conditional_t<
+                is_tensor_op,
+                mute::conditional_t<
+                  is_sparse_op,
+                  mutlass::arch::OpClassSparseTensorOp,
+                    mutlass::arch::OpClassTensorOp
+                  >,
+                mutlass::arch::OpClassSimt
+                >;
+};
+
+template <class T>
+using get_operator_class_t = typename get_operator_class<T>::type;
+
+////////////////////////////////////////////////////////////////////////////////////////////////////
+
+} // namespace mutlass::detail
