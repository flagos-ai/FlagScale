+template <typename Element, typename AccumType>
+class TestVarlenAttention {
+public:
+  //
+  // Type definitions
+  //
+  static constexpr float kLog2e = float(1.4426950408889634074); // log_2(e) = M_LOG2E
+  using ElementQ = Element;
+  using ElementK = Element;
+  using ElementS = Element;
+  using ElementP = AccumType;
+  using ElementAccumulator = AccumType;
+  using ElementV = Element;
+  using ElementO = Element;
+
+  using ElementCompute = AccumType;
+
+  using ElementNorm = AccumType;
+  using ElementSum = AccumType;
+  using ElementSoftmaxCompute = AccumType;
+
+  template <
+    bool WithCausal,
+    bool WithSoftmax,
+    bool IsVarlen,
+    class ProblemShapeIn,
+    class TensorQ,
+    class TensorK,
+    class TensorV,
+    class TensorO>
+  void compute(ProblemShapeIn problem_shape,
+              TensorQ mQ,
+              TensorK mK,
+              TensorV mV,
+              TensorO mO) {
+
+    auto seqlen_q = get<0>(problem_shape);
+    auto seqlen_kv = get<1>(problem_shape);
+    int DimQK = get<2>(problem_shape);
+    int DimVO = get<3>(problem_shape);
+
+    int H = size<4>(problem_shape);
+    int H_R = get<4,0>(problem_shape);
+    int H_KV = get<4,1>(problem_shape);
+    int B = size<5>(problem_shape);
+
+    static constexpr float kLog2e = float(1.4426950408889634074); // log_2(e) = M_LOG2E
+
+    float alpha = 1.0f / sqrt(float(DimQK));
+
+    for (int b = 0; b < B; ++b) {
+      for (int h = 0; h < H; ++h) {
+
+        int actual_seqlen_q = 0;
+        if constexpr (IsVarlen) {
+          actual_seqlen_q = seqlen_q.cumulative_length[b + 1] - seqlen_q.cumulative_length[b];
+        } else {
+          actual_seqlen_q = seqlen_q;
+        }
+
+        int actual_seqlen_kv = 0;
+        if constexpr (IsVarlen) {
+          actual_seqlen_kv = seqlen_kv.cumulative_length[b + 1] - seqlen_kv.cumulative_length[b];
+        } else {
+          actual_seqlen_kv = seqlen_kv;
+        }
+
+        int q_idx_offset = seqlen_q.cumulative_length[b];
+        int kv_idx_offset = seqlen_kv.cumulative_length[b];
+
+        std::vector<ElementAccumulator> host_P(actual_seqlen_q * actual_seqlen_kv * H);
+
+        Tensor mP = make_tensor(host_P.data(),
+                make_shape(actual_seqlen_q, actual_seqlen_kv, get<4>(problem_shape)),
+                make_stride(actual_seqlen_kv, _1{}, make_stride(H_KV*actual_seqlen_q*actual_seqlen_kv, actual_seqlen_q * actual_seqlen_kv)));
+
+        for (int q = 0; q < actual_seqlen_q; ++q) {
+          // P = QK
+          for (int k = 0; k < actual_seqlen_kv; ++k) {
+            ElementAccumulator acc = ElementAccumulator(0);
+            for (int d = 0; d < DimQK; ++d) {
+              acc += ElementAccumulator(mQ(q_idx_offset + q, d, h)) * ElementAccumulator(mK(kv_idx_offset + k, d, h));
+            }
+
+            if constexpr (WithCausal) {
+              if (k >= (q + 1)) {
+                acc = -std::numeric_limits<ElementAccumulator>::infinity();
+              }
+            }
+            mP(q, k, h) = acc;
+          }
+
+          if constexpr (WithSoftmax) {
+            for (int k = 0; k < actual_seqlen_kv; ++k) {
+              mP(q, k, h) *= kLog2e * alpha;
+            }
+            ElementAccumulator max_val = mP(q, 0, h);
+            for (int k = 1; k < actual_seqlen_kv; ++k) {
+              max_val = std::max(max_val, mP(q, k, h));
+            }
+
+            ElementAccumulator sum_val = 0;
+            for (int k = 0; k < actual_seqlen_kv; ++k) {
+              sum_val += std::exp2f(mP(q, k, h) - max_val);
+            }
+
+            ElementAccumulator inv_sum = 1.0f / sum_val;
+            for (int k = 0; k < actual_seqlen_kv; ++k) {
+              mP(q, k, h) = std::exp2f(mP(q, k, h) - max_val) * inv_sum;
+            }
+          }
+
+          // O = PV
+          for (int d = 0; d < DimVO; ++d) {
+            ElementAccumulator acc = 0;
+            for (int v = 0; v < actual_seqlen_kv; ++v) {
+              acc += ElementAccumulator(mP(q, v, h)) * ElementAccumulator(mV(kv_idx_offset + v, d, h));
+            }
+            mO(q_idx_offset + q, d, h) = ElementO(acc);
+          }
+        }
+      }
+    }
+  }
+};
