+
+ #pragma once
+
+ #include <mute/tensor.hpp>
+ #include <mute/atom/mma_atom.hpp>
+ #include <mute/atom/copy_atom.hpp>
+
+ #include <mutlass/mutlass.h>
+ #include <mutlass/gemm/gemm.h>
+ #include <mutlass/gemm/collective/collective_builder.hpp>
+ #include "mutlass/epilogue/thread/linear_combination.h"
+ #include <mute/atom/copy_atom.hpp>
+
+ using namespace mute;
+
+ template<
+ class ElementA,
+ class ElementB,
+ class SmemLayoutA,
+ class SmemLayoutB
+ >
+ struct SharedStorage {
+   mute::array_aligned<ElementA, mute::cosize_v<SmemLayoutA>, 128> smem_a;
+   mute::array_aligned<ElementB, mute::cosize_v<SmemLayoutB>, 128> smem_b;
+ };
+
+ template <
+   class TileShapeMNK_,
+   class ElementA_,
+   class ElementB_,
+   class ElementD_,
+   class ElementIdx_,
+   class ElementScale_,
+   class ElementTopk_,
+   int AlignmentA,
+   int AlignmentB,
+   int GroupSizeM_,
+   bool WithScale_,
+   bool WithQuant_,
+   bool MulRoutedWeight_,
+   bool GroupScale_,
+   int QuantSizeK_
+ >
+ struct GroupGemmKernelTraits {
+
+   using ElementA = mute::conditional_t<mute::is_same_v<ElementA_, float>, tfloat32_t, ElementA_>;
+   using ElementB = mute::conditional_t<mute::is_same_v<ElementB_, float>, tfloat32_t, ElementB_>;
+   using ElementD = ElementD_;
+   using ElementScale = ElementScale_;
+   using ElementIdx = ElementIdx_;
+   using ElementAccum = float;
+   using ElementTopk = ElementTopk_;
+
+   using StrideA = mutlass::detail::TagToStrideA_t<mutlass::layout::RowMajor>;
+   using StrideB = mutlass::detail::TagToStrideB_t<mutlass::layout::ColumnMajor>;
+   using StrideD = mutlass::detail::TagToStrideC_t<mutlass::layout::RowMajor>;
+
+   using TileShapeMNK = TileShapeMNK_;
+   static constexpr int TileSizeM = size<0>(TileShapeMNK{});
+   static constexpr int TileSizeN = size<1>(TileShapeMNK{});
+   static constexpr int TileSizeK = size<2>(TileShapeMNK{});
+   static constexpr int GroupSizeM = GroupSizeM_;
+   static constexpr bool WithScale = WithScale_;
+   static constexpr bool WithQuant = WithQuant_;
+   static constexpr bool MulRoutedWeight = MulRoutedWeight_;
+   static constexpr bool GroupScale = GroupScale_;
+   static const int QuantSizeK = QuantSizeK_;
+
+   using MmaOp = decltype(mutlass::gemm::collective::detail::mp22_mma_operation_select<ElementA, StrideA, ElementA, StrideB>());
+
+   using TiledMma = decltype(mutlass::gemm::collective::detail::mp22_make_tensorop_tiled_mma<TileShapeMNK, MmaOp>());
+   static constexpr int NumThreads = size(TiledMma{});
+
+   static constexpr int ThreadCount = size(TiledMma{});
+   // A
+   using SmemLayoutAtomA = decltype(mutlass::gemm::collective::detail::make_mp22_smem_atom_layout<ElementA, StrideA>());
+   using SmemCopyAtomA = Copy_Atom<DefaultCopy, ElementA>;
+   using SmemLayoutA = decltype(tile_to_shape(
+       SmemLayoutAtomA{},
+       make_shape(shape<0>(TileShapeMNK{}), shape<2>(TileShapeMNK{}))));
+
+   // B
+   using SmemLayoutAtomB = decltype(mutlass::gemm::collective::detail::make_mp22_smem_atom_layout<ElementA, StrideB>());
+   using SmemCopyAtomB = Copy_Atom<DefaultCopy, ElementA>;
+   using SmemLayoutB = decltype(tile_to_shape(
+     SmemLayoutAtomB{},
+     make_shape(shape<1>(TileShapeMNK{}), shape<2>(TileShapeMNK{}))));
+
+   using SharedStorage = SharedStorage<ElementA, ElementA, SmemLayoutA, SmemLayoutB>;
+
+   static constexpr int threads_major_a = TileSizeK   / AlignmentA;
+   static constexpr int threads_minor_a = ThreadCount / threads_major_a;
+   using GmemTiledCopyAOperation = UniversalCopy<uint_bit_t<AlignmentA * sizeof_bits_v<ElementA>>>;
+   using GmemTiledCopyA = decltype(make_tiled_copy(
+     Copy_Atom<GmemTiledCopyAOperation, ElementA>{},
+     Layout<Shape <Int<threads_minor_a>, Int<threads_major_a>>,
+            Stride<Int<threads_major_a>,                _1>>{},
+     Layout<Shape<_1, Int<AlignmentA>>>{}));
+
+   static constexpr int threads_major_b = TileSizeK   / AlignmentB;
+   static constexpr int threads_minor_b = ThreadCount / threads_major_b;
+   using GmemTiledCopyBOperation = UniversalCopy<uint_bit_t<AlignmentB * sizeof_bits_v<ElementB>>>;
+   using GmemTiledCopyB = decltype(make_tiled_copy(
+     Copy_Atom<GmemTiledCopyBOperation, ElementB>{},
+     Layout<Shape <Int<threads_minor_b>, Int<threads_major_b>>,
+            Stride<Int<threads_major_b>,                _1>>{},
+     Layout<Shape<_1, Int<AlignmentB>>>{}));
+
+   using GmemTiledCopyScaleBOperation = UniversalCopy<uint_bit_t<AlignmentB * sizeof_bits_v<ElementScale>>>;
+   using GmemTiledCopyScaleB = decltype(make_tiled_copy(
+     Copy_Atom<GmemTiledCopyScaleBOperation, ElementScale>{},
+     Layout<Shape <Int<threads_minor_b>, Int<threads_major_b>>,
+            Stride<Int<threads_major_b>,                _1>>{},
+     Layout<Shape<_1, Int<AlignmentB>>>{}));
+
+   // using ScalePermTile = Layout<Shape<_32, _2, _4>, Stride<_1, _128, _32>>;
+   using GmemTiledCopyAoffsetOperation = UniversalCopy<uint_bit_t<sizeof_bits_v<ElementIdx>>>;
+   using GmemTiledCopyAoffset = decltype(make_tiled_copy(
+     Copy_Atom<GmemTiledCopyAoffsetOperation, ElementIdx>{},
+     Layout<Shape <Int<threads_minor_a>, Int<threads_major_a>>,
+            Stride<Int<threads_major_a>,                _1>>{},
+     Layout<Shape<_1, _1>>{}));
+   static constexpr int  TileKOffsetA = threads_major_a;
+
+  //  using GmemTiledCopyBoffsetOperation = UniversalCopy<uint_bit_t<AlignmentB * sizeof_bits_v<ElementB>>>;
+  //  using GmemTiledCopyB = decltype(make_tiled_copy(
+  //    Copy_Atom<GmemTiledCopyBoffsetOperation, ElementB>{},
+  //    Layout<Shape <Int<threads_minor_b>, Int<threads_major_b>>,
+  //           Stride<Int<threads_major_b>,                _1>>{},
+  //    Layout<Shape<_1, Int<AlignmentB>>>{}));
+
+ };
