+from typing import Optional, Tuple, Union
+
+import torch
+import torch.nn.functional as F
+from vllm.model_executor.layers.layernorm import RMSNorm
+from vllm_musa import _musa_custom_ops as ops
+
+
+def __init__(
+        self,
+        hidden_size: int,
+        eps: float = 1e-6,
+        var_hidden_size: Optional[int] = None,
+        has_weight: bool = True,
+        dtype: Optional[torch.dtype] = None,
+        fuse_cast: Optional[bool] = False,
+    ) -> None:
+        super(RMSNorm, self).__init__()
+
+        self.hidden_size = hidden_size
+        self.variance_epsilon = eps
+        self.variance_size_override = (None if var_hidden_size == hidden_size
+                                       else var_hidden_size)
+        self.has_weight = has_weight
+        if dtype is not None:
+            self.weight = torch.ones(hidden_size, dtype=dtype)
+        else:
+            self.weight = torch.ones(hidden_size)
+        if self.has_weight:
+            self.weight = torch.nn.Parameter(self.weight)
+        self.fuse_cast = fuse_cast
+
+
+def rmsnorm_cast(
+  x: torch.Tensor, weight:torch.Tensor,  variance_epsilon: float
+) -> tuple[torch.Tensor, torch.Tensor]:
+
+    out, out_scale = ops.rmsnorm_cast(x, weight, variance_epsilon, quant_size=128)  # TODO: Hardcode quant_size to 128
+    return (out, out_scale)
+
+
+def rmsnorm_add_cast(
+    x: torch.Tensor, residual: torch.Tensor, weight: torch.Tensor,
+    variance_epsilon: float
+)-> tuple[torch.Tensor, torch.Tensor]:
+
+    out_fp8, out_scale = ops.rmsnorm_add_cast(x, residual, weight, variance_epsilon, quant_size=128) # TODO: Hardcode quant_size to 128
+    return (out_fp8, out_scale), x     # x = x + residual, out is bf16 precison output
+
+
+def forward_oot(
+        self,
+        x: torch.Tensor,
+        residual: Optional[torch.Tensor] = None,
+    ) -> Union[torch.Tensor, Tuple[torch.Tensor, torch.Tensor]]:
+        if not self.fuse_cast:
+            if residual is not None:
+                ops.musa_fused_add_rms_norm(
+                    x,
+                    residual,
+                    self.weight, # added by qn: self.weight.data
+                    self.variance_epsilon,
+                )
+                return x, residual
+            x = F.rms_norm(x, (self.hidden_size, ), self.weight, self.variance_epsilon)
+            # out = torch.empty_like(x)
+            # ops.rms_norm(
+            #     out,
+            #     x,
+            #     self.weight,  # added by qn: self.weight.data
+            #     self.variance_epsilon,
+            # )
+            return x
+        else:
+             if residual is not None:
+                  return rmsnorm_add_cast(x, residual, self.weight, self.variance_epsilon)
+                    # ops.fused_add_rms_norm(
+                    #     x,
+                    #     residual,
+                    #     self.weight, # added by qn: self.weight.data
+                    #     self.variance_epsilon,
+                    # )
+                    # return x, residual
+             else:
+                  return rmsnorm_cast(x, self.weight, self.variance_epsilon)
+
+RMSNorm.__init__ = __init__
+RMSNorm.forward = forward_oot
diff --git a/vllm_musa/vllm_musa/ops/moe_align_block_size.py b/vllm_musa/vllm_musa/ops/moe_align_block_size.py
