+
+using namespace mute;
+
+
+/////////////////////////////////////////////////////////////////////////////////////////////////
+/// GEMM kernel configurations
+/////////////////////////////////////////////////////////////////////////////////////////////////
+
+using ElementScale       = float;                // Element type for scaling factor
+using ElementIdx         = int32_t;
+constexpr int AlignmentA  = 8;    // Alignment of A matrix in units of elements (up to 16 bytes)
+constexpr int AlignmentB  = 8;    // Alignment of B matrix in units of elements (up to 16 bytes)
+constexpr int AlignmentC  = 1;    // Alignment of C matrix in units of elements (up to 16 bytes)
+constexpr int AlignmentD  = 1;    // Alignment of C matrix in units of elements (up to 16 bytes)
+constexpr int Stages   = 2;
+
+using TileShape           = Shape<_32, _32, _64>;   // Threadblock-level tile size
+constexpr int GroupSizeM   = 1;
+
+constexpr bool check_error = false;
+
+template <typename AType, typename BType, typename CType, typename ScoreType, bool WITH_W4A16_QUANT>
+void fused_moe_mutlass_kernel_launcher(
+    AType *A, BType *B, CType *C, float *B_scale,
+    int32_t *num_tokens_post_padded, int32_t *sorted_token_ids, int32_t *expert_ids,
+    ScoreType *topk_weights, int32_t *topk_ids,
+    const int32_t M, const int32_t N, const int32_t K, const int32_t E, const int EM, const int topk_ids_elements,
+    const int stride_am, const int stride_ak, const int stride_be, const int stride_bk, const int stride_bn,
+    const int stride_cm, const int stride_cn, const int stride_asm, const int stride_ask,
+    const int stride_bse, const int stride_bsk, const int stride_bsn,
+    const int m_offset, const int expert_offset, const int topk, bool mul_routed_weight, int group_size) {
+
+    if (K % size<2>(TileShape{}) != 0 || N % size<1>(TileShape{}) != 0) {
+        std::cerr << "K must be divisible by AlignmentA and AlignmentB and N must divisible by TileShapeN" << std::endl;
+        std::abort();
+    }
+
+    using MoeParams = MoeParams<AType, BType, CType, ElementScale, ElementIdx, ScoreType>;
+
+    typename MoeParams::LayoutA g_layout_a = make_layout(make_shape(int64_t(M), int64_t(K)),
+                            make_stride(int64_t(stride_am), _1{}));
+    typename MoeParams::LayoutB g_layout_b = make_layout(make_shape(int64_t(N), int64_t(K), int64_t(E)),
+                            make_stride(int64_t(K), _1{}, int64_t(N*K)));
+    typename MoeParams::LayoutD g_layout_d = make_layout(make_shape(int64_t(M*topk), int64_t(N)),
+                            make_stride(int64_t(stride_cm), _1{}));
+    typename MoeParams::LayoutScale g_layout_scale;
+    if (group_size != -1) {
+        g_layout_scale = make_layout(make_shape(int64_t(N), int64_t(K / group_size), int64_t(E)),
+                                     make_stride(int64_t(K / group_size), _1{}, int64_t(K / group_size * N)));
+    } else {
+        g_layout_scale = make_layout(make_shape(int64_t(N), int64_t(1), int64_t(E)),
+                                    make_stride(int64_t(1), _1{}, int64_t(stride_bse)));
+    }
+    typename MoeParams::LayoutOffset g_layout_m_offset = make_layout(make_shape(int64_t(m_offset)),
+                                        make_stride(_1{}));
+    typename MoeParams::LayoutOffset g_layout_expert_offset = make_layout(make_shape(int64_t(expert_offset)),
+                                                        make_stride(_1{}));
+    if(check_error) {
+        print("EM = ");print(EM);print("\n");
+        print("topk_ids_elements = ");print(topk_ids_elements);print("\n");
+        print("g_layout_a = ");print(g_layout_a);print("\n");
+        print("g_layout_b = ");print(g_layout_b);print("\n");
+        print("g_layout_d = ");print(g_layout_d);print("\n");
+        print("g_layout_scale = ");print(g_layout_scale);print("\n");
+        print("g_layout_m_offset = ");print(g_layout_m_offset);print("\n");
+        print("g_layout_expert_offset = ");print(g_layout_expert_offset);print("\n");
+        print("WITH_W4A16_QUANT = ");print(WITH_W4A16_QUANT);print("\n");
+        print("mul_routed_weight = ");print(mul_routed_weight);print("\n");
+        print("GroupScale = ");print(group_size);print("\n");
+
+    }
+
+    auto params = MoeParams{
+        A,
+        B,
+        C,
+        B_scale, // scale
+        num_tokens_post_padded, // num_tokens_post_padded
+        sorted_token_ids, // m_offset_ptr
+        expert_ids, // expert_offset_ptr
+        topk_weights,
+        g_layout_a,
+        g_layout_b,
+        g_layout_d,
+        g_layout_scale,
+        g_layout_m_offset,
+        g_layout_expert_offset,
+        EM,
+        topk_ids_elements,
+        topk,
+        stride_bse,
+        stride_bsn,
+        stride_cm,
+        stride_cn
+    };
+
+    if constexpr (check_error) {
+        cudaDeviceSynchronize();
+        auto error = cudaGetLastError();
+        if (error != cudaSuccess) {
+            printf("before launch mutlass moe [ERROR] %s\n", cudaGetErrorString(error));
+            exit(-1);
+        }
+
+    }
+
+    if (mul_routed_weight) {
+        if (group_size == 128){
+            using KernelTraits = GroupGemmKernelTraits<TileShape, AType, BType, CType, ElementIdx, ElementScale, ScoreType, AlignmentA, AlignmentB, GroupSizeM, WITH_W4A16_QUANT, WITH_W4A16_QUANT, true, true, 128>;
+            dim3 block_dim(KernelTraits::NumThreads);
+            dim3 grid_dims(ceil_div(N, size<1>(TileShape{})), ceil_div(EM, size<0>(TileShape{})), 1);
+
+            const musaStream_t stream = at::cuda::getCurrentCUDAStream();
+            mp22_grouped_gemm_kernel<MoeParams,  KernelTraits><<<grid_dims, block_dim, 0, stream>>>(
+                params
+            );
+        } else if (group_size == 64) {
+            using KernelTraits = GroupGemmKernelTraits<TileShape, AType, BType, CType, ElementIdx, ElementScale, ScoreType, AlignmentA, AlignmentB, GroupSizeM, WITH_W4A16_QUANT, WITH_W4A16_QUANT, true, true, 64>;
+            dim3 block_dim(KernelTraits::NumThreads);
+            dim3 grid_dims(ceil_div(N, size<1>(TileShape{})), ceil_div(EM, size<0>(TileShape{})), 1);
+
+            const musaStream_t stream = at::cuda::getCurrentCUDAStream();
+            mp22_grouped_gemm_kernel<MoeParams,  KernelTraits><<<grid_dims, block_dim, 0, stream>>>(
+                params
+            );
+        } else {
+            using KernelTraits = GroupGemmKernelTraits<TileShape, AType, BType, CType, ElementIdx, ElementScale, ScoreType, AlignmentA, AlignmentB, GroupSizeM, WITH_W4A16_QUANT, WITH_W4A16_QUANT, true, false, 64>;
+            dim3 block_dim(KernelTraits::NumThreads);
+            dim3 grid_dims(ceil_div(N, size<1>(TileShape{})), ceil_div(EM, size<0>(TileShape{})), 1);
+
+            const musaStream_t stream = at::cuda::getCurrentCUDAStream();
+            mp22_grouped_gemm_kernel<MoeParams,  KernelTraits><<<grid_dims, block_dim, 0, stream>>>(
+                params
+            );
+        }
+    }
+    else
+    {
+        if (group_size == 128){
+            using KernelTraits = GroupGemmKernelTraits<TileShape, AType, BType, CType, ElementIdx, ElementScale, ScoreType, AlignmentA, AlignmentB, GroupSizeM, WITH_W4A16_QUANT, WITH_W4A16_QUANT, false, true, 128>;
+            dim3 block_dim(KernelTraits::NumThreads);
+            dim3 grid_dims(ceil_div(N, size<1>(TileShape{})), ceil_div(EM, size<0>(TileShape{})), 1);
+
+            const musaStream_t stream = at::cuda::getCurrentCUDAStream();
+            mp22_grouped_gemm_kernel<MoeParams, KernelTraits><<<grid_dims, block_dim, 0, stream>>>(
+                params
+            );
+        } else if (group_size == 64){
+            using KernelTraits = GroupGemmKernelTraits<TileShape, AType, BType, CType, ElementIdx, ElementScale, ScoreType, AlignmentA, AlignmentB, GroupSizeM, WITH_W4A16_QUANT, WITH_W4A16_QUANT, false, true, 64>;
+            dim3 block_dim(KernelTraits::NumThreads);
+            dim3 grid_dims(ceil_div(N, size<1>(TileShape{})), ceil_div(EM, size<0>(TileShape{})), 1);
+
+            const musaStream_t stream = at::cuda::getCurrentCUDAStream();
+            mp22_grouped_gemm_kernel<MoeParams, KernelTraits><<<grid_dims, block_dim, 0, stream>>>(
+                params
+            );
+        } else {
+            using KernelTraits = GroupGemmKernelTraits<TileShape, AType, BType, CType, ElementIdx, ElementScale, ScoreType, AlignmentA, AlignmentB, GroupSizeM, WITH_W4A16_QUANT, WITH_W4A16_QUANT, false, false, 64>;
+            dim3 block_dim(KernelTraits::NumThreads);
+            dim3 grid_dims(ceil_div(N, size<1>(TileShape{})), ceil_div(EM, size<0>(TileShape{})), 1);
+
+            const musaStream_t stream = at::cuda::getCurrentCUDAStream();
+            mp22_grouped_gemm_kernel<MoeParams, KernelTraits><<<grid_dims, block_dim, 0, stream>>>(
+                params
+            );
+        }
+    }
+
+    if constexpr (check_error) {
+        cudaDeviceSynchronize();
+        auto error = cudaGetLastError();
+        if (error != cudaSuccess) {
+            printf("after launch mutlass moe [ERROR] %s\n", cudaGetErrorString(error));
+            exit(-1);
+        }
+
+    }
+}
+
+
+
+#define CALL_MUTLASS_MOE_LAUNCH(_ADTYPE, _BDTYPE, _TOPK_WEIGHT_DTYPE, WITH_W4A16_QUANT)                 \
+fused_moe_mutlass_kernel_launcher<_ADTYPE, _BDTYPE, _ADTYPE, _TOPK_WEIGHT_DTYPE, WITH_W4A16_QUANT>(     \
+    static_cast<_ADTYPE*>(A.data_ptr()),                                                                \
+    static_cast<_BDTYPE*>(B.data_ptr()),                                                                \
+    static_cast<_ADTYPE*>(C.data_ptr()),                                                                \
+    B_scale ? static_cast<float*>(B_scale->data_ptr()) : nullptr,                                       \
+    static_cast<int32_t *>(num_tokens_post_padded.data_ptr()),                                          \
+    static_cast<int32_t *>(sorted_token_ids.data_ptr()),                                                \
+    static_cast<int32_t *>(expert_ids.data_ptr()),                                                      \
+    static_cast<_TOPK_WEIGHT_DTYPE*>(topk_weights.data_ptr()),                                          \
+    static_cast<int32_t *>(topk_ids.data_ptr()),                                                        \
+    bseqlen, reduce_size, hidden_size, num_experts, EM, topk_ids.numel(),                               \
+    A.stride(0), A.stride(1), B.stride(0), B.stride(2), B.stride(1),                                    \
+    C.stride(1), C.stride(2), 0, 0, B_scale ? B_scale->stride(0) : 0,                                   \
+    B_scale ? B_scale->stride(2) : 0, B_scale ? B_scale->stride(1) : 0,                                 \
+    m_offset, expert_offset, topk, mul_routed_weight, group_size);
+
+
+void fused_moe_mutlass(
+    torch::Tensor &A,   // [32768, 2048]    [bseqlen, hidden_size]
+    torch::Tensor &B,   // [64, 2816, 256]  []
+    torch::Tensor &C,   // [32768, 6, 2846]
+    const c10::optional<torch::Tensor> &A_scale,    // use for fp8
+    const c10::optional<torch::Tensor> &B_scale,    // use for fp8/int
+    torch::Tensor &topk_weights,
+    torch::Tensor &topk_ids,
+    torch::Tensor &sorted_token_ids,
+    torch::Tensor &expert_ids,
+    torch::Tensor &num_tokens_post_padded,
+    bool mul_routed_weight,
+    int topk,
+    bool use_int4_w4a16,
+    int BLOCK_SIZE_M,
+    int BLOCK_SIZE_N,
+    int BLOCK_SIZE_K,
+    int GROUP_SIZE_M,
+    int group_size)
+{
+    TORCH_CHECK(A.dim() == 2, "A must be dim 2.")
+    TORCH_CHECK(B.dim() == 3, "B must be dim 3.")
+    TORCH_CHECK(C.dim() == 3, "C must be dim 3.")
+
+    TORCH_CHECK(group_size == 128 || group_size == 64 || group_size == -1,
+    "group_size only support 128 or 64 for per-group w4a16, and -1 for w16a16 and per-channel w4a16");
+
+    int32_t bseqlen = A.size(0);        // M
+    int32_t hidden_size = A.size(1);    // K
+    int32_t num_experts = B.size(0);    // E
+    int32_t reduce_size = B.size(1);    // N
+    int32_t EM = sorted_token_ids.size(0);
+    int32_t m_offset = sorted_token_ids.size(0);
+    int32_t expert_offset = expert_ids.size(0);
+
+    bool tile_shape_check = (size<0>(TileShape{}) == BLOCK_SIZE_M) &&
+                   (size<1>(TileShape{}) == BLOCK_SIZE_N) &&
+                   (size<2>(TileShape{}) == BLOCK_SIZE_K) &&
+                   (GROUP_SIZE_M == GroupSizeM);
+    assert(tile_shape_check && "Error: TileShape dimensions do not match the expected sizes.");
+
+    const at::musa::OptionalMUSAGuard device_guard(device_of(A));
+
+    // CALL_MUTLASS_MOE_LAUNCH(mutlass::bfloat16_t, mutlass::bfloat16_t, float, false)
+    // CALL_MUTLASS_MOE_LAUNCH(mutlass::half_t, mutlass::int4b_t, float, true)
+
+    if (A.scalar_type() == at::ScalarType::BFloat16)
+    {
+        if (topk_weights.scalar_type() == at::ScalarType::Float)
+        {
+            if (use_int4_w4a16) {
+                CALL_MUTLASS_MOE_LAUNCH(mutlass::bfloat16_t, mutlass::int4b_t, float, true)
+            }
+            else
+            {
+                CALL_MUTLASS_MOE_LAUNCH(mutlass::bfloat16_t, mutlass::bfloat16_t, float, false)
+            }
+        }
+        else if (topk_weights.scalar_type() == at::ScalarType::BFloat16)
+        {
+            if (use_int4_w4a16) {
+                CALL_MUTLASS_MOE_LAUNCH(mutlass::bfloat16_t, mutlass::int4b_t, mutlass::bfloat16_t, true)
+            }
+            else
+            {
+                CALL_MUTLASS_MOE_LAUNCH(mutlass::bfloat16_t, mutlass::bfloat16_t, mutlass::bfloat16_t, false)
+            }
+        }
+    }
+    else if (A.scalar_type() == at::ScalarType::Half)
+    {
+        if (topk_weights.scalar_type() == at::ScalarType::Float)
+        {
+            if (use_int4_w4a16) {
+                CALL_MUTLASS_MOE_LAUNCH(mutlass::half_t, mutlass::int4b_t, float, true)
+            }
+            else
+            {
+                CALL_MUTLASS_MOE_LAUNCH(mutlass::half_t, mutlass::half_t, float, false)
+            }
+        }
+        else if (topk_weights.scalar_type() == at::ScalarType::Half)
+        {
+            if (use_int4_w4a16) {
+                CALL_MUTLASS_MOE_LAUNCH(mutlass::half_t, mutlass::int4b_t, mutlass::half_t, true)
+            }
+            else
+            {
+                CALL_MUTLASS_MOE_LAUNCH(mutlass::half_t, mutlass::half_t, mutlass::half_t, false)
+            }
+        }
+    }
+    else
+    {
+        printf("no support on mutlass moe\n");
+        assert(false);
+    }
+}
