+#pragma once
+
+#include <mute/config.hpp>
+
+#include <mute/numeric/numeric_types.hpp>
+#include <mute/numeric/math.hpp>
+
+namespace mute
+{
+
+// Test if a pointer is aligned to N bytes
+template <int N>
+MUTE_HOST_DEVICE constexpr
+bool
+is_byte_aligned(void const* const ptr)
+{
+  static_assert(N > 0 && (N & (N - 1)) == 0, "N must be a power of 2 in alignment check");
+  return (reinterpret_cast<uintptr_t>(ptr) & (N-1)) == 0;
+}
+
+#if defined(__MUSACC__)
+#  define MUTE_ALIGNAS(n) __align__(n)
+#else
+#  define MUTE_ALIGNAS(n) alignas(n)
+#endif
+
+template <size_t Alignment, class Child = void>
+struct aligned_struct {};
+
+template <class Child> struct MUTE_ALIGNAS(  1) aligned_struct<  1, Child> {};
+template <class Child> struct MUTE_ALIGNAS(  2) aligned_struct<  2, Child> {};
+template <class Child> struct MUTE_ALIGNAS(  4) aligned_struct<  4, Child> {};
+template <class Child> struct MUTE_ALIGNAS(  8) aligned_struct<  8, Child> {};
+template <class Child> struct MUTE_ALIGNAS( 16) aligned_struct< 16, Child> {};
+template <class Child> struct MUTE_ALIGNAS( 32) aligned_struct< 32, Child> {};
+template <class Child> struct MUTE_ALIGNAS( 64) aligned_struct< 64, Child> {};
+template <class Child> struct MUTE_ALIGNAS(128) aligned_struct<128, Child> {};
+template <class Child> struct MUTE_ALIGNAS(256) aligned_struct<256, Child> {};
+
+} // end namespace mute
