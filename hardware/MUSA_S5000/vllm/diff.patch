+  Tensor tCrK = thr_mma_qk.make_fragment_B(tCsK);
+
+  // MMA PV
+  Tensor tCsP = thr_mma_pv.partition_A(sP);
+  Tensor tCrP = thr_mma_pv.make_fragment_A(tCsP);
