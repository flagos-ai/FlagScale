+  Tensor mO = make_tensor(make_gmem_ptr(params.ptr_O + o_ptr_offset), shape_O, select<0, 1, 2>(params.stride_O));
+  Tensor mL = make_tensor(make_gmem_ptr(params.ptr_L + l_ptr_offset), shape_L, select<0, 1, 2>(params.stride_L));
