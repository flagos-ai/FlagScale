+#!/bin/bash
+
+DEVELOP_MODE=0
+for arg in "$@"; do
+  if [ "$arg" == "-e" ]; then
+    DEVELOP_MODE=1
+    break
+  fi
+done
+
+SCRIPT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
+PROJECT_ROOT=$(dirname "$SCRIPT_DIR")
+
+VLLM_DIR="$PROJECT_ROOT/vllm"
+
+install_vllm_musa_command() {
+  if [ $DEVELOP_MODE -eq 1 ]; then
+    echo "📦 使用开发模式安装: pip install -e . -v"
+    pip install -e . -v
+  else
+    echo "📦 使用普通模式安装: pip install . -v"
+    pip install . -v
+  fi
+}
+
+
+install_vllm_musa_command
+# hack for ray==2.46.0
+RAY_PATH=$(python3 -c "import ray; print(ray.__file__)" | sed 's|/[^/]*$||')
+cp "./hack/compiled_dag_node.py" "$RAY_PATH/dag/compiled_dag_node.py"
+
+if command -v conda &> /dev/null; then
+    echo "检测到conda，使用conda安装gcc 12.1.0..."
+    conda install -c conda-forge gcc=12.1.0 -y
+else
+    echo "未检测到conda，尝试使用系统包管理器安装gcc/g++ 12..."
+    apt update
+    apt install -y gcc-12 g++-12
+fi
+
+# hack for triton_musa
+TRITON_PATH=$(python3 -c "import triton; print(triton.__file__)" | sed 's|/[^/]*$||')
+NV_TRITON_BACKEND="$TRITON_PATH/backends/nvidia/"
+if [ -d "$NV_TRITON_BACKEND" ]; then
+    rm -r "$NV_TRITON_BACKEND"
+else
+    echo "✅ 当前环境中没有 '$NV_TRITON_BACKEND' 目录，无需删除。"
+fi
+
+echo "Install vLLM_MUSA Done!"
