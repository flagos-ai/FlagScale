+template <int VLEN>
+void get_best_block(const std::vector<Block<VLEN>>& block_list,
+                                  const int batch, const int m,
+                                  const int k, const int nr_mp ) {
+  float best_score = 0.f;
+  const Block<VLEN>* best_block = nullptr;
+  for (auto& block : block_list) {
+    auto score = block.estimate(batch, m, k, nr_mp);
+    if (score> best_score) {
+      best_score = score;
+      best_block = &block;
+    }
+  }
+  printf("best block %s score %f\n", best_block->name().c_str(), best_score);
+  // return {best_block, best_score};
