+template <typename FloatType>
+MUTLASS_DEVICE
+FloatType random_normal_float(murandState_t *state) {
+  return murand_normal(state);
+}
+
+template <>
+MUTLASS_DEVICE
+double random_normal_float<double>(murandState_t *state) {
+  return murand_normal_double(state);
+}
+
+template <typename FloatType>
+MUTLASS_DEVICE
+FloatType random_uniform_float(murandState_t *state) {
