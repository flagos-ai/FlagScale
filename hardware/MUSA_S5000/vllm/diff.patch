+#define BATCH_GEMV_SWIGLU_COLCONTINUOUS_LAUNCH(_ALIGN_ATTR, _IOBIT)            \
+  {                                                                            \
+    int smem_bytes = 2 * block_k * block_m * sizeof(float);                    \
+    batch_gemv_swiglu_col_continuous_kernel<T, _ALIGN_ATTR, block_k, block_m,  \
+                                            _IOBIT>                            \
+        <<<grid_size, block_size, smem_bytes, stream>>>(                       \
+            o, mat, v, batch, mat_m, mat_k, ldm, batch_stride_m, inc_v,        \
+            batch_stride_v, inc_o, batch_stride_o, alpha, half_mat_m);         \
+  }
+
+#define BATCH_GEMV_SWIGLU_COLCONTINUOUS_CALL(_IOBIT)                           \
+  if (aligned_vec) {                                                           \
+    BATCH_GEMV_SWIGLU_COLCONTINUOUS_LAUNCH(AlignAttr::ALIGN_VEC, _IOBIT)       \
+  } else {                                                                     \
+    BATCH_GEMV_SWIGLU_COLCONTINUOUS_LAUNCH(AlignAttr::GENERAL, _IOBIT)         \
+  }
+
+/*
+    only accept the shape
+     - matrix (k, m), the column is continuous
+     - vector (k)
+     - output of gemv   (m)
+     - output of swiglu (m/2)
+*/
+template <typename T>
+StatusX GemvSwiGLU(T *o, const T *mat, const T *v, const int batch,
+                   const int mat_m, const int mat_k, const int ldm,
+                   const int batch_stride_m, const int inc_v,
+                   const int batch_stride_v, const int inc_o,
+                   const int batch_stride_o, double alpha, musaStream_t &stream,
+                   int num_mp) {
+  // printf("%s\n", __FUNCTION__);
+
+  if (0 != mat_m % 2) {
+    printf("mat_m must be even.\n");
+    return StatusX::INVALID_PARAMETER;
+  }
+  const int half_mat_m = mat_m / 2;
+
+  dim3 block_size{128, 1, 1};
+  dim3 grid_size{1, static_cast<uint32_t>(batch), 1};
+
+  constexpr int iobit = 128;
+  constexpr int bits_of_byte = 8;
+  constexpr int vlen = iobit / (sizeof(T) * bits_of_byte);
+  constexpr int elems_per_cacheline = 128 / sizeof(T);
+
+  //   int device_id = 0;
+  //   int num_mp = 0;
+  //   musaGetDevice(&device_id);
+  //   musaDeviceProp device_prop;
+  //   if (musaSuccess == musaGetDeviceProperties(&device_prop, device_id)) {
+  //     num_mp = device_prop.multiProcessorCount;
+  //   }
+
+  bool aligned_vec = half_mat_m >= vlen && half_mat_m % vlen == 0;
+  int estimated_grid_x = ceil_div(half_mat_m, elems_per_cacheline);
+
+  //   constexpr int block_m = elems_per_cacheline;
+  //   constexpr int block_k = 32;
+  //   block_size.x = block_k * (block_m / vlen) * 2;
+  //   grid_size.x = ceil_div(half_mat_m, block_m);
+  //   BATCH_GEMV_SWIGLU_COLCONTINUOUS_CALL(iobit)
+
+  if (false) {
+    printf("num_mp %d\n", num_mp);
+    printf("estimated_grid_x %d\n", estimated_grid_x);
+  }
+
+  //   printf("elems_per_cacheline %d, block_m %d block_k %d vlen %d, "
+  //          "block_size.x %d grid_size.x %d\n",
+  //          elems_per_cacheline, block_m, block_k, vlen, block_size.x,
+  //          grid_size.x);
+
+#define BLOCK_STRATEGY(_BLK_M, _BLK_K)                                         \
+  constexpr int block_m = _BLK_M;                                              \
+  constexpr int block_k = _BLK_K;                                              \
+  block_size.x = block_k * (block_m / vlen) * 2;                               \
+  grid_size.x = ceil_div(half_mat_m, block_m);                                 \
+  BATCH_GEMV_SWIGLU_COLCONTINUOUS_CALL(iobit)
+
+  //   BLOCK_STRATEGY(elems_per_cacheline * 16, 4); //not good
+  //   BLOCK_STRATEGY(elems_per_cacheline * 8, 8);
+  // BLOCK_STRATEGY(32, 32);
+  // BLOCK_STRATEGY(32, 64);
+  // BLOCK_STRATEGY(64, 32);
+  // BLOCK_STRATEGY(128, 16);
+  // BLOCK_STRATEGY(16, 128);
+
+
+#define BLOCK_STRATEGY_M(_BLK_M)                                         \
+  constexpr int block_m = _BLK_M;                                        \
+  constexpr int block_k = 512/(block_m/vlen);                            \
+  block_size.x = block_k * (block_m / vlen) * 2;                         \
+  grid_size.x = ceil_div(half_mat_m, block_m);                           \
+  BATCH_GEMV_SWIGLU_COLCONTINUOUS_CALL(iobit)
+
+  // if (estimated_grid_x >= num_mp * 4) {
+  //   // printf("estimated_grid_x %d elems_per_cacheline %d\n", estimated_grid_x,elems_per_cacheline);
+  //   BLOCK_STRATEGY_M(elems_per_cacheline);
+  // } else if (estimated_grid_x >= num_mp * 2) {
+  //   BLOCK_STRATEGY_M(elems_per_cacheline);
+  // } else {
+  //   BLOCK_STRATEGY_M(elems_per_cacheline/2);
+  // }
+  // if (estimated_grid_x >= num_mp * 2) {
+  //   BLOCK_STRATEGY_M(elems_per_cacheline * 2);
