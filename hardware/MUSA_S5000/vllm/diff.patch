+/*! \file
+    \brief Define basic numeric operators
+
+    This is inspired by the Standard Library's <functional> header.
+*/
+#pragma once
+
+#include "mutlass/mutlass.h"
+#include "mutlass/numeric_types.h"
+
+#include <musa_runtime.h>
+
+#ifdef _MSC_VER
