+template <class KernelTraits>
+__global__ __launch_bounds__(KernelTraits::NumThreads, 1)
+void decode_mla_kernel(const typename DecodeMLAParams<KernelTraits>::Params params) {
+  #if defined(__MUSA_ARCH__) && (__MUSA_ARCH__ == 220)
+  using ElementAccum = typename KernelTraits::ElementAccumulator;
+  constexpr int FragmentSize = KernelTraits::FragmentSize;
+
+  // Get them from traits
+  const int KVGroupNum = get<4,0>(params.problem_shape);
+  const int QHeadNum = size<4>(params.problem_shape);
+  const int NUM_KV_SPLITS = params.NumKVSplits;
+
+  constexpr int CTA_Q = KernelTraits::CTA_Q;
+  constexpr int Alignment = KernelTraits::Alignment;
+
+  const int ValidBlockH = KVGroupNum > CTA_Q ? CTA_Q : KVGroupNum;
+
+  __shared__ char __attribute__((aligned(128))) smem[sizeof(typename KernelTraits::SharedStorage)];
+  auto& shared_storage = *reinterpret_cast<typename KernelTraits::SharedStorage*>(smem);
+
+  auto [cur_batch, cur_head_id, split_kv_id] = static_cast<uint3>(blockIdx);
+
+  int cur_kv_head = cur_head_id / ceil_div(KVGroupNum, CTA_Q);
+
+  int thread_idx = threadIdx.x;
+
+  int cur_batch_seq_len = params.ptr_B_Seqlen[cur_batch];
+  int cur_batch_req_idx = cur_batch;
+
+  int kv_len_per_split = ceil_div(cur_batch_seq_len, NUM_KV_SPLITS);
+  int split_kv_start = kv_len_per_split * split_kv_id;
+  int split_kv_end = min(split_kv_start + kv_len_per_split, cur_batch_seq_len);
+
+  //if (thread_idx == 0) {
+  //      printf("bid:(%d, %d, %d) kv_st:%d kv_end:%d, kv_len_per_split:%d cur_seq_len:%d\n", blockIdx.x, blockIdx.y, blockIdx.z, split_kv_start, split_kv_end, kv_len_per_split, cur_batch_seq_len);
+  //}
+
+  // early return
+  if (split_kv_end <= split_kv_start) return;
+
+  const int* block_table = params.ptr_Req_to_tokens + cur_batch_req_idx * params.stride_req_to_tokens_b;
+
+  // TensorQ ((H_R, H_KV), D_QK, B)
+  auto shape_Q = make_shape(QHeadNum, get<2>(params.problem_shape), get<5>(params.problem_shape));
+  auto stride_Q = make_stride(params.stride_qh, _1{}, params.stride_qbs);
+  using TileShapeQ = conditional_t<KernelTraits::SplitQKSmem,
+                                  Shape<Int<KernelTraits::CTA_Q>, Int<512>>,
+                                  Shape<Int<KernelTraits::CTA_Q>, Int<576>>>;
+
+  auto tile_shape_Q = TileShapeQ{};
+
+  Tensor mQ = make_tensor(make_gmem_ptr(params.ptr_Q), shape_Q, stride_Q);
+  Tensor gQ = local_tile(mQ, tile_shape_Q, make_coord(cur_head_id, _0{}, cur_batch));
+  Tensor sQ  = make_tensor(make_smem_ptr(shared_storage.smem_q.data()), typename KernelTraits::SmemLayoutQ{});
+
+  typename KernelTraits::GmemTiledCopyQ gmem_tiled_copy_Q;
+  ThrCopy gmem_thr_copy_Q = gmem_tiled_copy_Q.get_thread_slice(thread_idx);
+  Tensor tQgQ = gmem_thr_copy_Q.partition_S(gQ); // (QCPY, QCPY_M, QCPY_N)
+  Tensor tQsQ = gmem_thr_copy_Q.partition_D(sQ); // (QCPY, QCPY_M, QCPY_N)
+
+  Tensor cQ = make_identity_tensor(make_shape(size<0>(sQ), size<1>(sQ)));
+  Tensor tQcQ = gmem_thr_copy_Q.partition_S(cQ);
+  Tensor tQpQ = make_tensor<bool>(make_shape(size<1>(tQsQ), size<2>(tQsQ)), Stride<_1,_0>{}); // let's only check Head
+
+  constexpr int KVPageNum = KernelTraits::CTA_KV / KernelTraits::PAGE_SIZE;
+  static_assert(KernelTraits::PAGE_SIZE == 16);
+  // TensorK (bs, D_QK, (H_R, H_KV))
+  auto tile_shape_K = select<1, 2>(typename KernelTraits::TileShape_QKD{});
+  Tensor sK  = make_tensor(make_smem_ptr(shared_storage.smem_k.data()), typename KernelTraits::SmemLayoutK{});
+
+  typename KernelTraits::GmemTiledCopyK gmem_tiled_copy_K;
+  ThrCopy gmem_thr_copy_K = gmem_tiled_copy_K.get_thread_slice(thread_idx);
+  Tensor tKsK = gmem_thr_copy_K.partition_D(sK); // (KCPY, KCPY_M, KCPY_N)
+
+  Tensor cK = make_identity_tensor(make_shape(size<0>(sK), size<1>(sK)));
+  Tensor tKcK = gmem_thr_copy_K.partition_S(cK);
+  Tensor tKpK = make_tensor<bool>(make_shape(size<1>(tKcK), size<2>(tKcK)), Stride<_1, _0>{}); // let's only check Seq
+
+  // TensorV (bs, D_VO, (H_R, H_KV))
+  auto tile_shape_V = select<2, 1>(typename KernelTraits::TileShape_PDV{});
+  Tensor sV  = make_tensor(make_smem_ptr(shared_storage.smem_v.data()), typename KernelTraits::SmemLayoutV{});
+  Tensor sVt = make_tensor(make_smem_ptr(shared_storage.smem_v.data()), typename KernelTraits::SmemLayoutVt{});
+
+  // Reuse TileCopyK to get same tensor partition...
