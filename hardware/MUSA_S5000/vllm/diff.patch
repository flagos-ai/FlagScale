+
+        auto q_ptr = Q.data_ptr();
+        auto k_ptr = K.data_ptr();
+        auto v_ptr = V.data_ptr();
+        auto o_ptr = O.data_ptr();
+        auto l_ptr = return_softmax_lse ? lse.value().data_ptr() : nullptr;
+
+        const int q_batch_stride = Q.stride(0);
+        const int q_head_stride = Q.stride(1);
+        const int q_seq_stride = Q.stride(2);
+
+        const int k_batch_stride = K.stride(0);
+        const int k_head_stride = K.stride(1);
+        const int k_seq_stride = K.stride(2);
+
+        const int v_batch_stride = V.stride(0);
+        const int v_head_stride = V.stride(1);
+        const int v_seq_stride = V.stride(2);
+
+        const int o_batch_stride = O.stride(0);
+        const int o_head_stride = O.stride(1);
+        const int o_seq_stride = O.stride(2);
+
+        const int l_batch_stride = return_softmax_lse ? lse.value().stride(0) : 0;
+        const int l_head_stride = return_softmax_lse ? lse.value().stride(1) : 0;
