+#pragma once
+
+#include <mute/config.hpp>
+
+#include <mute/numeric/integral_constant.hpp>
+
+namespace mute
+{
+
+template <class T>
+struct ConstantTensor
+{
+  template <class... Coords>
+  MUTE_HOST_DEVICE constexpr
+  T const&
+  operator()(Coords const&...) const {
+    return val_;
+  }
+
+  T val_;
+};
+
+struct TrivialPredTensor
+{
+  template <class... Coords>
+  MUTE_HOST_DEVICE constexpr
+  true_type
+  operator()(Coords const&...) const {
+    return {};
+  }
+};
+
+template <class Fn>
+struct FunctionPredTensor
+{
+  MUTE_HOST_DEVICE constexpr
+  FunctionPredTensor(Fn const& fn) : fn_(fn) {}
+
+  template <class... Coords>
+  MUTE_HOST_DEVICE constexpr
+  auto
+  operator()(Coords const&... coords) const {
+    return fn_(coords...);
+  }
+
+  Fn const& fn_;
+};
+
+} // end namespace mute
