+#else
+  return half_t(float(lhs) + float(rhs));
+#endif
+}
+
+MUTLASS_HOST_DEVICE
+half_t operator-(half_t const& lhs) {
+#if defined(__MUSA_ARCH__)
+  return half_t(__hneg(lhs.to_half()));
+#else
+  return half_t(-float(lhs));
+#endif
+}
+
+MUTLASS_HOST_DEVICE
