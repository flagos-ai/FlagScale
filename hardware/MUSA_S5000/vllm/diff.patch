+template <
+    typename T,
+    int VPT,
+    int NUM_EXPERT_GROUP,
+    int THREADS_PER_EXPERT_GROUP,
+    int ELTS_PER_LDG,
+    typename std::enable_if<std::is_same<__half, T>::value || std::is_same<__mt_bfloat16, T>::value>::type* = nullptr
+>
+__global__ void mp22_grouped_topk_softmax(const T* input, T* softmax_output, int* group_indices, const int experts_per_group, const int topk_group) {
+    using AccessType = AlignedArray<T, ELTS_PER_LDG>;
+    using AccumulateType = float;
+    using AccumulateAccessType = AlignedArray<AccumulateType, ELTS_PER_LDG>;
+
+    // threadIdx.y: indexing EXPERT_GROUP
+
+    constexpr uint32_t ELTS_PER_SUB_WARP = (MT_WARP_SIZE / NUM_EXPERT_GROUP) * ELTS_PER_LDG;
+
+    const uint32_t row_id = blockIdx.x;
+
+
+    // 1. Run softmax
+    // NUM_EXPERTS = NUM_EXPERT_GROUP * experts_per_group
+    const int global_offset = row_id * NUM_EXPERT_GROUP * experts_per_group +
+                              experts_per_group * threadIdx.y;
+    const T* thread_read_base_ptr = input + global_offset;
+    T* thread_write_base_ptr = softmax_output + global_offset;
+
+    // !!! 2-dim threadblock
+    uint32_t local_col_id = threadIdx.x * ELTS_PER_LDG;
+
+    AccumulateType row_chunk[VPT * ELTS_PER_LDG] = {(T)(-INFINITY)};
+    AccumulateAccessType* row_chunk_vec_ptr = reinterpret_cast<AccumulateAccessType*>(&row_chunk);
+    for (int ii = local_col_id; ii < experts_per_group; ii += ELTS_PER_SUB_WARP) {
+        AccessType regs = *reinterpret_cast<const AccessType*>(thread_read_base_ptr + ii);
+        AccumulateAccessType* row_chunk_cur_vec_ptr = row_chunk_vec_ptr + ii / ELTS_PER_SUB_WARP;
+        #pragma unroll
+        for (int k = 0; k < ELTS_PER_LDG; k++) {
+            row_chunk_cur_vec_ptr->data[k] = static_cast<AccumulateType>(regs.data[k]);
+        }
+    }
+    // 1.1 calculate maxval
+    AccumulateType maxval = row_chunk[0];  // global max value
+    for (int ii = 1; ii < VPT * ELTS_PER_LDG; ii++) {
+        maxval = fmaxf(maxval, row_chunk[ii]);
+    }
+
+    #pragma unroll
+    for (int mask = 1; mask < THREADS_PER_EXPERT_GROUP; mask *= 2) {
+        AccumulateType b = musa_shfl_xor_sync<AccumulateType, MT_WARP_SIZE>(maxval, mask);
+        maxval = maxval < b ? b : maxval;
+    }
+    AccumulateType maxval_per_group = maxval;
+    #pragma unroll
+    for (int mask = THREADS_PER_EXPERT_GROUP; mask < MT_WARP_SIZE; mask *= 2) {
+        AccumulateType b = musa_shfl_xor_sync<AccumulateType, MT_WARP_SIZE>(maxval, mask);
+        maxval = maxval < b ? b : maxval;
+    }
+
+    AccumulateType sum = static_cast<AccumulateType>(0.0f);
+    for (int ii = 0; ii < VPT * ELTS_PER_LDG; ii++) {
+        // row_chunk[ii] = expf(row_chunk[ii] - maxval);
+        row_chunk[ii] = threadIdx.x * ELTS_PER_LDG < experts_per_group ?
+                        expf(row_chunk[ii] - maxval) :
+                        (AccumulateType)(0.0f);
+        sum += row_chunk[ii];
+    }
+
+    #pragma unroll
+    for (int mask = MT_WARP_SIZE / 2; mask > 0; mask >>= 1) {
+        AccumulateType b = musa_shfl_xor_sync<AccumulateType, MT_WARP_SIZE>(sum, mask);
+        sum += b;
+    }
+
+    const AccumulateType reciprocal_sum = static_cast<AccumulateType>(1.f) / sum;
+    for (int ii = 0; ii < VPT * ELTS_PER_LDG; ii++) {
+        row_chunk[ii] = row_chunk[ii] * reciprocal_sum;
+    }
+
+    for (int ii = local_col_id; ii < experts_per_group; ii += ELTS_PER_SUB_WARP) {
+        AccessType regs;
+        AccumulateAccessType* row_chunk_cur_vec_ptr = row_chunk_vec_ptr + ii / ELTS_PER_SUB_WARP;
+        for (int k = 0; k < ELTS_PER_LDG; k++) {
+            regs.data[k] = static_cast<T>(row_chunk_cur_vec_ptr->data[k]);
+        }
+        *reinterpret_cast<AccessType*>(thread_write_base_ptr + ii) = regs;
+    }
+
+    // Now, we get max value within each expert group
+    maxval_per_group = expf(maxval_per_group - maxval) * reciprocal_sum;
+
+    // 2. Find the topk_group
+    for (int k_idx = 0; k_idx < topk_group; k_idx++) {
+        // if (threadIdx.x == 0 && blockIdx.x == 0 && k_idx == 0) {
+        //     printf("threadIdx.y: %d, maxval: %f\n", threadIdx.y, maxval);
+        // }
+        // low precison dtype will be fine
+        T max_val = static_cast<T>(maxval_per_group);
+        int group_idx = threadIdx.y;
+
+        #pragma unroll
+        for (int mask = THREADS_PER_EXPERT_GROUP; mask < MT_WARP_SIZE; mask *= 2) {
+            T other_maxval = musa_shfl_xor_sync<T, MT_WARP_SIZE>(max_val, mask);
+            int other_group_idx = musa_shfl_xor_sync<int, MT_WARP_SIZE>(group_idx, mask);
+
+            if (other_maxval > max_val || (other_maxval == max_val && other_group_idx < group_idx)) {
+                max_val = other_maxval;
+                group_idx = other_group_idx;
+            }
+        }
+
+        if (threadIdx.x == 0 && threadIdx.y == 0) {
+            group_indices[row_id * topk_group + k_idx] = group_idx;
+        }
+
+        // Finally, we clear the value in the thread with the current max if there is another iteration to run.
+        if (k_idx + 1 < topk_group) {
+            if (threadIdx.y == group_idx) {
+                maxval_per_group = static_cast<T>(-10000.f);
+            }
+        }
+    }
+}
