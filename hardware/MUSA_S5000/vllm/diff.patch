@@ -0,0 +1,32 @@
+import torch
+
+from typing import List, Optional
+from vllm.model_executor.sampling_metadata import SequenceGroupToSample
+from vllm.logger import init_logger
+
+logger = init_logger(__name__)
+
+def _multinomial(
+    probs: torch.Tensor,
+    num_samples: int,
+    seq_groups: Optional[list[SequenceGroupToSample]] = None,
+) -> torch.Tensor:
+    if num_samples > 1:
+        probs = probs.repeat_interleave(num_samples, dim=0)
+    q = torch.empty_like(probs)
+    if seq_groups is None:
+        q.exponential_()
+    else:
+        sample_idx = 0
+        for seq_group in seq_groups:
+            seq_ids = seq_group.seq_ids
+            stride = len(seq_ids) * num_samples
+            assert seq_group.generator is not None
+            q[sample_idx:sample_idx +
+              stride].exponential_(generator=seq_group.generator)
+            sample_idx += stride
+    q.clamp_min_(torch.finfo(q.dtype).tiny)
+    return probs.div_(q).argmax(dim=1).view(-1, num_samples)
+
+import vllm.model_executor.layers.sampler
+vllm.model_executor.layers.sampler._multinomial = _multinomial
