+                    K.stride(0), K.stride(1), 0,
+                    V.stride(0), V.stride(1), 0,
+                    O.stride(0), O.stride(1), 0,
+                    0, 0, 0, // lse strides (未使用)
+                    cu_q_ptr, cu_kv_ptr);
+            }
+        });
+    }
+    else
+    {
+        const int batch = Q.size(0);
+        const int num_head_q = Q.size(1);
+        const int num_head_kv = K.size(1);
+        const int seqlen_q = Q.size(2);
+        const int seqlen_kv = K.size(2);
