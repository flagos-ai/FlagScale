+            o_seq_stride, o_head_stride, o_batch_stride,
+            l_seq_stride, l_head_stride, l_batch_stride);
+    } else if (d_qk == 128 && d_vo == 128) {
+        flash_attn_fwd_kernel_launcher<128, 128, scalar_t, ReturnL>(
+            q_ptr, k_ptr, v_ptr, o_ptr, P, l_ptr,
+            seqlen_q, seqlen_kv, d_qk, d_vo,
+            num_head_q, num_head_kv, batch, causal, qkv_elem,
+            q_seq_stride, q_head_stride, q_batch_stride,
+            k_seq_stride, k_head_stride, k_batch_stride,
+            v_seq_stride, v_head_stride, v_batch_stride,
+            o_seq_stride, o_head_stride, o_batch_stride,
+            l_seq_stride, l_head_stride, l_batch_stride);
+    } else if (d_qk == 64 && d_vo == 64) {
+        flash_attn_fwd_kernel_launcher<64, 64, scalar_t, ReturnL>(
+            q_ptr, k_ptr, v_ptr, o_ptr, P, l_ptr,
+            seqlen_q, seqlen_kv, d_qk, d_vo,
+            num_head_q, num_head_kv, batch, causal, qkv_elem,
+            q_seq_stride, q_head_stride, q_batch_stride,
+            k_seq_stride, k_head_stride, k_batch_stride,
+            v_seq_stride, v_head_stride, v_batch_stride,
+            o_seq_stride, o_head_stride, o_batch_stride,
+            l_seq_stride, l_head_stride, l_batch_stride);
+    } else {
+        TORCH_CHECK(false, "Unsupported head dimensions: d_qk=", d_qk, ", d_vo=", d_vo);
+    }
+}
+
+template <typename scalar_t, bool ReturnL>
+void dispatch_head_dims_varlen(
+    int d_qk, int d_vo,
+    const scalar_t *q_ptr, const scalar_t *k_ptr, const scalar_t *v_ptr,
+    scalar_t *o_ptr, scalar_t *P, float *l_ptr,
+    int max_seqlen_q, int max_seqlen_kv, int num_head, int num_head_kv, int batch, bool causal,
+    mute::Shape<int, int, int> qkv_elem,
+    int q_seq_stride, int q_head_stride, int q_batch_stride,
+    int k_seq_stride, int k_head_stride, int k_batch_stride,
+    int v_seq_stride, int v_head_stride, int v_batch_stride,
+    int o_seq_stride, int o_head_stride, int o_batch_stride,
+    int l_seq_stride, int l_head_stride, int l_batch_stride,
+    int *cu_q_ptr, int *cu_kv_ptr)
+{
+    if (d_qk == 192 && d_vo == 128) {
+        varlen_flash_attn_fwd_kernel_launcher<192, 128, scalar_t, ReturnL>(
+            q_ptr, k_ptr, v_ptr, o_ptr, P, l_ptr,
+            max_seqlen_q, max_seqlen_kv, d_qk, d_vo,
+            num_head, num_head_kv, batch, causal, qkv_elem,
+            q_seq_stride, q_head_stride, q_batch_stride,
+            k_seq_stride, k_head_stride, k_batch_stride,
+            v_seq_stride, v_head_stride, v_batch_stride,
+            o_seq_stride, o_head_stride, o_batch_stride,
+            l_seq_stride, l_head_stride, l_batch_stride,
+            cu_q_ptr, cu_kv_ptr, max_seqlen_q, max_seqlen_kv);
+    } else if (d_qk == 128 && d_vo == 128) {
+        varlen_flash_attn_fwd_kernel_launcher<128, 128, scalar_t, ReturnL>(
+            q_ptr, k_ptr, v_ptr, o_ptr, P, l_ptr,
+            max_seqlen_q, max_seqlen_kv, d_qk, d_vo,
+            num_head, num_head_kv, batch, causal, qkv_elem,
+            q_seq_stride, q_head_stride, q_batch_stride,
+            k_seq_stride, k_head_stride, k_batch_stride,
+            v_seq_stride, v_head_stride, v_batch_stride,
+            o_seq_stride, o_head_stride, o_batch_stride,
+            l_seq_stride, l_head_stride, l_batch_stride,
+            cu_q_ptr, cu_kv_ptr, max_seqlen_q, max_seqlen_kv);
+    } else if (d_qk == 64 && d_vo == 64) {
+        varlen_flash_attn_fwd_kernel_launcher<64, 64, scalar_t, ReturnL>(
+            q_ptr, k_ptr, v_ptr, o_ptr, P, l_ptr,
+            max_seqlen_q, max_seqlen_kv, d_qk, d_vo,
