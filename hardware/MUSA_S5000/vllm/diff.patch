@@ -0,0 +1,160 @@
+#include "mute/tensor.hpp"
+#include <torch/torch.h>
+#include "mixed_input_gemm_kernel.hpp"
+#include "mutlass/util/device_memory.h"
+#include "mutlass/util/GPU_Clock.hpp"
+
+#include "../../type_convert.muh"
+#include "../../dispatch_utils.h"
+
+#include <vector>
+#include <cstdlib>
+
+using namespace mute;
+
+
+/////////////////////////////////////////////////////////////////////////////////////////////////
+/// GEMM kernel configurations
+/////////////////////////////////////////////////////////////////////////////////////////////////
+
+//using TileShape          = Shape<_256, _256, _32>;
+using TileShape          = Shape<_64, _64, _32>;
+
+constexpr int AlignmentA = 8;
+
+using ElementB           = mutlass::int4b_t;
+constexpr int AlignmentB = 8;
+
+
+template <typename ElementAC, typename ElementScale, int GroupSizeK_>
+void mixed_input_gemm_kernel_launcher(
+  ElementAC *A, ElementB *B, ElementAC *C, ElementScale *B_scale,
+  int M, int N, int K) {
+
+  using KernelTraits = MixedInputGemmKernelTratis<TileShape, ElementAC, AlignmentA, ElementB, AlignmentB, ElementScale, ElementAC, GroupSizeK_>;
+  auto problem_shape = make_shape(M, N, K);
+
+  typename KernelTraits::Arguments arguments {
+    A,
+    B,
+    C,
+    B_scale,
+    K,
+    K,
+    N,
+    K / KernelTraits::GroupSizeK,
+    1
+  };
+
+  typename KernelTraits::Params params = KernelTraits::to_underlying_arguments(problem_shape, arguments);
+
+  bool can_impl_check = KernelTraits::can_implement(problem_shape, arguments);
+  if (!can_impl_check) {
+    printf("Mixed Input GEMM Error: TileShape dimensions do not match the expected sizes.");
+  }
+  assert(can_impl_check && "Error: TileShape dimensions do not match the expected sizes.");
+
+  auto tile_shape = TileShape{};
+  dim3 grid_dims = {static_cast<uint32_t>(mute::ceil_div(M, get<0>(tile_shape))), static_cast<uint32_t>(mute::ceil_div(N, get<1>(tile_shape))), 1};
+
+  const musaStream_t stream = at::musa::getCurrentMUSAStream();
+  mixed_input_gemm<KernelTraits><<<grid_dims, KernelTraits::NumThreads, 0, stream>>>(params);
+}
+
+
+
+#define CALL_MIXED_INPUT_GEMM_LAUNCH(ElementAC, ElementScale, GroupSizeK_)                 \
+mixed_input_gemm_kernel_launcher<ElementAC, ElementScale, GroupSizeK_>(                    \
+    static_cast<ElementAC*>(A.data_ptr()),                                       \
+    static_cast<ElementB*>(B.data_ptr()),                                       \
+    static_cast<ElementAC*>(C.data_ptr()),                                       \
+    static_cast<ElementScale*>(B_scale.data_ptr()),                            \
+    M, N, K);                                                                   \
+
+
+
+void group_scale_gemm(
+    torch::Tensor &A,       // [bseqlen, in]
+    torch::Tensor &B,       // [out, in/8]
+    torch::Tensor &C,       // [bseqlen, out]
+    torch::Tensor &B_scale)
+{
+    TORCH_CHECK(A.dim() == 2, "A must be dim 2.")
+    TORCH_CHECK(B.dim() == 2, "B must be dim 2.")
+
+    int32_t hidden_size = A.size(1);
+    int32_t scale_k_len = B_scale.size(1);
+    int group_size = ceil_div(hidden_size, scale_k_len);
+
+    int M = A.size(0);
+    int N = B.size(0);
+    int K = hidden_size;
+
+    TORCH_CHECK(group_size == 128 || group_size == 64,
+    "group_size only support 128 or 64 for per-group w4a16");
+
+    if (A.scalar_type() == at::ScalarType::Half)
+    {
+      if (B_scale.scalar_type() == at::ScalarType::Float)
+      {
+        if (group_size == 64) {
+          CALL_MIXED_INPUT_GEMM_LAUNCH(mutlass::half_t, float, 64)
+        } else {
+          CALL_MIXED_INPUT_GEMM_LAUNCH(mutlass::half_t, float, 128)
+        }
+      }
+      else if (B_scale.scalar_type() == at::ScalarType::Half)
+      {
+        if (group_size == 64) {
+          CALL_MIXED_INPUT_GEMM_LAUNCH(mutlass::half_t, mutlass::half_t, 64)
+        } else {
+          CALL_MIXED_INPUT_GEMM_LAUNCH(mutlass::half_t, mutlass::half_t, 128)
+        }
+      }
+      else if (B_scale.scalar_type() == at::ScalarType::BFloat16)
+      {
+        if (group_size == 64) {
+          CALL_MIXED_INPUT_GEMM_LAUNCH(mutlass::half_t, mutlass::bfloat16_t, 64)
+        } else {
+          CALL_MIXED_INPUT_GEMM_LAUNCH(mutlass::half_t, mutlass::bfloat16_t, 128)
+        }
+      }
+      else
+      {
+          printf("no support on mutlass w4a16 gemm\n");
+          assert(false);
+      }
+    }
+    else if (A.scalar_type() == at::ScalarType::BFloat16)
+    {
+      if (B_scale.scalar_type() == at::ScalarType::Float)
+      {
+        if (group_size == 64) {
+          CALL_MIXED_INPUT_GEMM_LAUNCH(mutlass::bfloat16_t, float, 64)
+        } else {
+          CALL_MIXED_INPUT_GEMM_LAUNCH(mutlass::bfloat16_t, float, 128)
+        }
+      }
+      else if (B_scale.scalar_type() == at::ScalarType::Half)
+      {
+        if (group_size == 64) {
+          CALL_MIXED_INPUT_GEMM_LAUNCH(mutlass::bfloat16_t, mutlass::half_t, 64)
+        } else {
+          CALL_MIXED_INPUT_GEMM_LAUNCH(mutlass::bfloat16_t, mutlass::half_t, 128)
+        }
+      }
+      else if (B_scale.scalar_type() == at::ScalarType::BFloat16)
+      {
+        if (group_size == 64) {
+          CALL_MIXED_INPUT_GEMM_LAUNCH(mutlass::bfloat16_t, mutlass::bfloat16_t, 64)
+        } else {
+          CALL_MIXED_INPUT_GEMM_LAUNCH(mutlass::bfloat16_t, mutlass::bfloat16_t, 128)
+        }
+      }
+      else
+      {
+          printf("no support on mutlass w4a16 gemm\n");
+          assert(false);
+      }
+    }
+}
