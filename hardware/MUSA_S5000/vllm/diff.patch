+
+using vec_128bit  = uint32_t __attribute__((vector_size(16)));
+
+template <typename T, int BLOCKDIM_X, int BLOCKDIM_Y, bool IsPaddingKV>
+__global__ void padding_kernel(
+    const T* input1,         //  [sum_seq, head_dim, num_heads]
+    const T* input2,         //  [sum_seq, head_dim, num_heads]
+    T* output1,              //  [max_seq, head_dim, num_heads, batch_size]
+    T* output2,
+    const int* accum_length,//  [seq_0, seq_1,...]
+    int max_seq,
+    int head_dim,
+    int num_heads,
+    int batch_size,
+    int seq_stride,int head_stride,int seq_out_stride,int head_out_stride,int bs_out_stride
+) {
+    const int input_base_idx = blockIdx.y * head_stride + (accum_length[blockIdx.z] + blockIdx.x * BLOCKDIM_Y + threadIdx.y) * seq_stride;
+    const int out_base_idx = blockIdx.z * bs_out_stride + blockIdx.y*head_out_stride;
+
+    const int seq_length = accum_length[blockIdx.z+1] - accum_length[blockIdx.z];
+
+    const int seq_out_idx = blockIdx.x * BLOCKDIM_Y + threadIdx.y;
+
+    bool is_oob = threadIdx.x * 16 / sizeof(T) >= head_dim;
+
+    if (seq_out_idx >= max_seq || is_oob) {
+        return;
+    }
+
+    int output_pos = out_base_idx + seq_out_idx * seq_out_stride;
+    const vec_128bit* input_vec1  = reinterpret_cast<const vec_128bit*>(input1 + input_base_idx);
+    const vec_128bit* input_vec2  = reinterpret_cast<const vec_128bit*>(input2 + input_base_idx);
+
+    vec_128bit* output_vec_1 = reinterpret_cast<vec_128bit*>(output1 + output_pos);
+    vec_128bit* output_vec_2 = reinterpret_cast<vec_128bit*>(output2 + output_pos);
+
+
+    if (seq_out_idx < seq_length) {
+        output_vec_1[threadIdx.x] = input_vec1[threadIdx.x];
+        if constexpr (IsPaddingKV) {
+            output_vec_2[threadIdx.x] = input_vec2[threadIdx.x];
+        }
+    } else {
+        vec_128bit Zeros = {};
+        output_vec_1[threadIdx.x] =  Zeros;
+        if constexpr (IsPaddingKV) {
+            output_vec_2[threadIdx.x] =  Zeros;
+        }
+    }
+}
+
+template <typename T, int BLOCKDIM_X, int BLOCKDIM_Y>
+__global__ void unpadding_kernel(
+    const T* input,         //  [max_seq, head_dim, num_heads, batch_size]
+    T* output,              //  [sum_seq, head_dim, num_heads]
+    const int* accum_length,//  [seq_0, seq_1,...]
+    int sum_seq,            // (seq_lens)）
+    int max_seq,
+    int head_dim,
+    int num_heads,
+    int batch_size,
+    int seq_stride,int head_stride,int bs_stride, int seq_out_stride,int head_out_stride
+) {
+    const int out_base_idx = blockIdx.y * head_out_stride + (accum_length[blockIdx.z] + blockIdx.x * BLOCKDIM_Y + threadIdx.y) * seq_out_stride;
+    const int in_base_idx = blockIdx.z * bs_stride + blockIdx.y*head_stride;
+
+    const int seq_length = accum_length[blockIdx.z+1] - accum_length[blockIdx.z];
+
+    const int seq_in_idx = blockIdx.x * BLOCKDIM_Y + threadIdx.y;
+    bool is_oob = threadIdx.x * 16 / sizeof(T) >= head_dim;
+
+    if (seq_in_idx >= max_seq || is_oob) {
+        return;
+    }
+
+    int input_pos = in_base_idx + seq_in_idx * seq_stride;
+    vec_128bit* output_vec  = reinterpret_cast<vec_128bit*>(output + out_base_idx);
+
+    const vec_128bit* input_vec = reinterpret_cast<const vec_128bit*>(input + input_pos);
+
+    if (seq_in_idx < seq_length) {
+        output_vec[threadIdx.x] = input_vec[threadIdx.x];
+    }
+}
+
+template<class T>
+void launch_padding_kernel(
+    const T* input_q,
+    const T* input_k,
+    const T* input_v,
+    T* output_q,
+    T* output_k,
+    T* output_v,
+    const int* accum_lens_q,
+    const int* accum_lens_k,
+    int seqlen_q,
+    int seqlen_kv,
+    int head_dim_q,
+    int head_dim_k,
+    int head_dim_v,
+    int num_heads_q,
+    int num_heads_k,
+    int num_heads_v,
+    int batch_size,
+    int q_seq_stride, int q_head_stride,int q_seq_out_stride,int q_head_out_stride,int q_bs_out_stride,
+    int k_seq_stride, int k_head_stride,int k_seq_out_stride, int k_head_out_stride,int k_bs_out_stride,
+    int v_seq_stride, int v_head_stride,int v_seq_out_stride, int v_head_out_stride,int v_bs_out_stride,
+    musaStream_t stream = 0
+) {
+    if (head_dim_q > 128) {
+
+        dim3 block(32, 32);
+        dim3 grid_q(
+            (seqlen_q + block.y - 1) / block.y,
+            num_heads_q,
+            batch_size
+        );
+        dim3 grid_k(
+            (seqlen_kv + block.y - 1) / block.y,
+            num_heads_k,
+            batch_size
+        );
+        dim3 grid_v(
+            (seqlen_kv + block.y - 1) / block.y,
+            num_heads_v,
+            batch_size
+        );
+        padding_kernel<T, 32, 32, false><<<grid_q, block, 0, stream>>>(
+        input_q, nullptr, output_q, nullptr, accum_lens_q,
+        seqlen_q, head_dim_q, num_heads_q, batch_size,
+        q_seq_stride,q_head_stride,q_seq_out_stride,q_head_out_stride,q_bs_out_stride
+        );
+        padding_kernel<T, 32, 32, false><<<grid_k, block, 0, stream>>>(
+        input_k, nullptr, output_k, nullptr,accum_lens_k,
+        seqlen_kv, head_dim_k, num_heads_k, batch_size,
+        k_seq_stride, k_head_stride,k_seq_out_stride, k_head_out_stride,k_bs_out_stride
+        );
+        padding_kernel<T, 32, 32, false><<<grid_v, block, 0, stream>>>(
+        input_v, nullptr, output_v, nullptr,accum_lens_k,
+        seqlen_kv, head_dim_v, num_heads_v, batch_size,
+        v_seq_stride, v_head_stride,v_seq_out_stride, v_head_out_stride,v_bs_out_stride
+        );
+
+    }
+    else if (head_dim_q > 64) {
+        dim3 block(16, 32);
+        dim3 grid_q(
+            (seqlen_q+ block.y - 1) / block.y,
+            num_heads_q,
+            batch_size
+        );
+        dim3 grid_k(
+            (seqlen_kv + block.y - 1) / block.y,
+            num_heads_k,
+            batch_size
+        );
+        dim3 grid_v(
+            (seqlen_kv + block.y - 1) / block.y,
+            num_heads_v,
+            batch_size
+        );
+        padding_kernel<T, 16, 32, false><<<grid_q, block, 0, stream>>>(
+        input_q, nullptr, output_q, nullptr, accum_lens_q,
+        seqlen_q, head_dim_q, num_heads_q, batch_size,
+        q_seq_stride,q_head_stride,q_seq_out_stride,q_head_out_stride,q_bs_out_stride
+        );
+        padding_kernel<T, 16, 32, false><<<grid_k, block, 0, stream>>>(
+        input_k, nullptr, output_k, nullptr,accum_lens_k,
+        seqlen_kv, head_dim_k, num_heads_k, batch_size,
+        k_seq_stride, k_head_stride,k_seq_out_stride, k_head_out_stride,k_bs_out_stride
+        );
+        padding_kernel<T, 16, 32, false><<<grid_v, block, 0, stream>>>(
+        input_v, nullptr, output_v, nullptr,accum_lens_k,
+        seqlen_kv, head_dim_v, num_heads_v, batch_size,
+        v_seq_stride, v_head_stride,v_seq_out_stride, v_head_out_stride,v_bs_out_stride
+        );
+    } else if (head_dim_q > 32) {
+        dim3 block(8, 64);
+        dim3 grid_q(
+            (seqlen_q + block.y - 1) / block.y,
+            num_heads_q,
+            batch_size
+        );
+        dim3 grid_k(
+            (seqlen_kv + block.y - 1) / block.y,
+            num_heads_k,
+            batch_size
+        );
+        dim3 grid_v(
+            (seqlen_kv +  block.y - 1) / block.y,
+            num_heads_v,
+            batch_size
+        );
+        padding_kernel<T, 8, 64, false><<<grid_q, block, 0, stream>>>(
+        input_q, nullptr, output_q, nullptr, accum_lens_q,
+        seqlen_q, head_dim_q, num_heads_q, batch_size,
+        q_seq_stride,q_head_stride,q_seq_out_stride,q_head_out_stride,q_bs_out_stride
+        );
+        padding_kernel<T, 8, 64, false><<<grid_k, block, 0, stream>>>(
+        input_k, nullptr, output_k, nullptr,accum_lens_k,
+        seqlen_kv, head_dim_k, num_heads_k, batch_size,
+        k_seq_stride, k_head_stride,k_seq_out_stride, k_head_out_stride,k_bs_out_stride
+        );
+        padding_kernel<T, 8, 64, false><<<grid_v, block, 0, stream>>>(
+        input_v, nullptr, output_v, nullptr,accum_lens_k,
+        seqlen_kv, head_dim_v, num_heads_v, batch_size,
+        v_seq_stride, v_head_stride,v_seq_out_stride, v_head_out_stride,v_bs_out_stride
+        );
+    } else {
+        printf("no support on pad kernel\n");
+    }
+}
+
+template<class T>
+void launch_unpadding_kernel(
+    const T* input,
+    T* output,
+    const int* accum_lens,
+    int sum_seq,
+    int max_seq,
+    int head_dim,
+    int num_heads,
+    int batch_size,
+    int seq_out_stride, int head_out_stride,int seq_stride,int head_stride,int bs_stride,
+    musaStream_t stream = 0
+) {
+    if (head_dim > 128) {
+
+        dim3 block(32, 32);
+        dim3 grid(
+            (max_seq + block.y - 1) / block.y,
+            num_heads,
+            batch_size
+        );
+        unpadding_kernel<T, 32, 32><<<grid, block, 0, stream>>>(
+        input, output,accum_lens,
+        sum_seq, max_seq, head_dim, num_heads, batch_size,
+        seq_stride, head_stride,bs_stride, seq_out_stride, head_out_stride
+        );
+    }
+    else if (head_dim > 64) {
+        dim3 block(16, 32);
+        dim3 grid(
+            (max_seq + block.y - 1) / block.y,
+            num_heads,
+            batch_size
+        );
+        unpadding_kernel<T, 16, 32><<<grid, block, 0, stream>>>(
+        input, output, accum_lens,
+        sum_seq, max_seq, head_dim, num_heads, batch_size,
+        seq_stride, head_stride,bs_stride, seq_out_stride, head_out_stride
+        );
+    } else if (head_dim > 32) {
+        dim3 block(8, 64);
+        dim3 grid(
+            (max_seq + block.y - 1) / block.y,
+            num_heads,
+            batch_size
+        );
+        unpadding_kernel<T, 8, 64><<<grid, block, 0, stream>>>(
+        input, output,accum_lens,
+        sum_seq, max_seq, head_dim, num_heads, batch_size,
+        seq_stride, head_stride,bs_stride, seq_out_stride, head_out_stride
+        );
+    } else {
+        printf("no support on unpad kernel\n");
+    }
+}
+
+void varlen_fa_seqlen_pad(
+    torch::Tensor &q_in,
+    torch::Tensor &k_in,
+    torch::Tensor &v_in,
+    torch::Tensor &q_out,
+    torch::Tensor &k_out,
+    torch::Tensor &v_out,
+    torch::Tensor &accum_lens_q,
+    torch::Tensor &accum_lens_k,
+    int sum_seq,
+    int max_seq,
+    int batch_size) {
+
+    int q_seq_stride = q_in.strides()[0];
+    int q_head_stride = q_in.strides()[1];
+
+    int q_seq_out_stride = q_out.strides()[2];
+    int q_head_out_stride = q_out.strides()[1];
+    int q_bs_out_stride = q_out.strides()[0];
+
+
+    int k_seq_stride = k_in.strides()[0];
+    int k_head_stride = k_in.strides()[1];
+
+    int k_seq_out_stride = k_out.strides()[2];
+    int k_head_out_stride = k_out.strides()[1];
+    int k_bs_out_stride = k_out.strides()[0];
+
+    int v_seq_stride = v_in.strides()[0];
+    int v_head_stride = v_in.strides()[1];
+
+    int v_seq_out_stride = v_out.strides()[2];
+    int v_head_out_stride = v_out.strides()[1];
+    int v_bs_out_stride = v_out.strides()[0];
+
+
+
+    int head_dim_q = q_in.sizes()[2];
+    int head_dim_k = k_in.sizes()[2];
+    int head_dim_v = v_in.sizes()[2];
+
+    int num_heads_q = q_in.sizes()[1];
+    int num_heads_k = k_in.sizes()[1];
+    int num_heads_v = v_in.sizes()[1];
+
+    int seqlen_q = q_out.sizes()[2];
+    int seqlen_kv = k_out.sizes()[2];
+
+    const at::musa::OptionalMUSAGuard device_guard(device_of(q_in));
+    auto stream = c10::musa::getCurrentMUSAStream().stream();
+
+    if (q_in.scalar_type() == at::ScalarType::BFloat16)
+    {
+        launch_padding_kernel<__mt_bfloat16>(
+            static_cast<const __mt_bfloat16*>(q_in.data_ptr()),
+            static_cast<const __mt_bfloat16*>(k_in.data_ptr()),
+            static_cast<const __mt_bfloat16*>(v_in.data_ptr()),
+            static_cast<__mt_bfloat16*>(q_out.data_ptr()),
+            static_cast<__mt_bfloat16*>(k_out.data_ptr()),
+            static_cast<__mt_bfloat16*>(v_out.data_ptr()),
+            static_cast<int*>(accum_lens_q.data_ptr()),
+            static_cast<int*>(accum_lens_k.data_ptr()),
+            seqlen_q,
+            seqlen_kv,
+            head_dim_q,
+            head_dim_k,
+            head_dim_v,
+            num_heads_q,
+            num_heads_k,
+            num_heads_v,
+            batch_size,
+            q_seq_stride,q_head_stride,q_seq_out_stride,q_head_out_stride,q_bs_out_stride,
+            k_seq_stride, k_head_stride,k_seq_out_stride,k_head_out_stride, k_bs_out_stride,
+            v_seq_stride, v_head_stride,v_seq_out_stride,v_head_out_stride, v_bs_out_stride, stream);
+    }
+    else if (q_in.scalar_type() == at::ScalarType::Half)
+    {
+        launch_padding_kernel<__half>(
+            static_cast<const __half*>(q_in.data_ptr()),
+            static_cast<const __half*>(k_in.data_ptr()),
+            static_cast<const __half*>(v_in.data_ptr()),
+            static_cast<__half*>(q_out.data_ptr()),
+            static_cast<__half*>(k_out.data_ptr()),
+            static_cast<__half*>(v_out.data_ptr()),
+            static_cast<int*>(accum_lens_q.data_ptr()),
+            static_cast<int*>(accum_lens_k.data_ptr()),
+            seqlen_q,
+            seqlen_kv,
+            head_dim_q,
+            head_dim_k,
+            head_dim_v,
+            num_heads_q,
+            num_heads_k,
+            num_heads_v,
+            batch_size,
+            q_seq_stride,q_head_stride,q_seq_out_stride,q_head_out_stride,q_bs_out_stride,
+            k_seq_stride, k_head_stride,k_seq_out_stride,k_head_out_stride, k_bs_out_stride,
+            v_seq_stride, v_head_stride,v_seq_out_stride,v_head_out_stride, v_bs_out_stride, stream);
+    }
+    else if (q_in.scalar_type() == at::ScalarType::Float)
+    {
+        launch_padding_kernel<float>(
+            static_cast<const float*>(q_in.data_ptr()),
+            static_cast<const float*>(k_in.data_ptr()),
+            static_cast<const float*>(v_in.data_ptr()),
+            static_cast<float*>(q_out.data_ptr()),
+            static_cast<float*>(k_out.data_ptr()),
+            static_cast<float*>(v_out.data_ptr()),
+            static_cast<int*>(accum_lens_q.data_ptr()),
+            static_cast<int*>(accum_lens_k.data_ptr()),
+            seqlen_q,
+            seqlen_kv,
+            head_dim_q,
+            head_dim_k,
+            head_dim_v,
+            num_heads_q,
+            num_heads_k,
+            num_heads_v,
+            batch_size,
+            q_seq_stride,q_head_stride,q_seq_out_stride,q_head_out_stride,q_bs_out_stride,
+            k_seq_stride, k_head_stride,k_seq_out_stride,k_head_out_stride, k_bs_out_stride,
+            v_seq_stride, v_head_stride,v_seq_out_stride,v_head_out_stride, v_bs_out_stride, stream);
+    }
+    else
+    {
+        TORCH_CHECK(false, "only support Half and BFloat16 dtype");
+    }
+}
+
+void varlen_fa_seqlen_unpad(
+    torch::Tensor &in,
+    torch::Tensor &out,
+    torch::Tensor &accum_lens,
+    int sum_seq,
+    int max_seq,
+    int head_dim,
+    int num_heads,
+    int batch_size) {
+
+    int seq_out_stride = out.strides()[0];
+    int head_out_stride = out.strides()[1];
+
+    int seq_stride = in.strides()[2];
+    int head_stride = in.strides()[1];
+    int bs_stride = in.strides()[0];
+
+    const at::musa::OptionalMUSAGuard device_guard(device_of(in));
+    auto stream = c10::musa::getCurrentMUSAStream().stream();
+
+    if (in.scalar_type() == at::ScalarType::BFloat16)
+    {
+        launch_unpadding_kernel<__mt_bfloat16>(
+            static_cast<const __mt_bfloat16*>(in.data_ptr()),
+            static_cast<__mt_bfloat16*>(out.data_ptr()),
+            static_cast<int*>(accum_lens.data_ptr()),
+            sum_seq,
+            max_seq,
+            head_dim,
+            num_heads,
+            batch_size,
+            seq_out_stride,head_out_stride,seq_stride,head_stride,bs_stride, stream);
+    }
+    else if (in.scalar_type() == at::ScalarType::Half)
+    {
+        launch_unpadding_kernel<__half>(
+            static_cast<const __half*>(in.data_ptr()),
+            static_cast<__half*>(out.data_ptr()),
+            static_cast<int*>(accum_lens.data_ptr()),
+            sum_seq,
+            max_seq,
+            head_dim,
+            num_heads,
+            batch_size,
+            seq_out_stride,head_out_stride,seq_stride,head_stride,bs_stride, stream);
+    }
+    else if (in.scalar_type() == at::ScalarType::Float)
+    {
+        launch_unpadding_kernel<float>(
+            static_cast<const float*>(in.data_ptr()),
+            static_cast<float*>(out.data_ptr()),
+            static_cast<int*>(accum_lens.data_ptr()),
+            sum_seq,
+            max_seq,
+            head_dim,
+            num_heads,
+            batch_size,
+            seq_out_stride,head_out_stride,seq_stride,head_stride,bs_stride, stream);
+    }
+    else
+    {
+        TORCH_CHECK(false, "only support Half and BFloat16 dtype");
+    }
+}
+
+constexpr int VEC_SIZE = 4;
+template <int BLOCK_THREADS>
+__global__ void varlen_fa_lse_seqlen_unpad_kernel(
+    const float* __restrict__ input,     // [batch_size, num_heads, max_seq]
+    float* __restrict__ output,           // [num_heads, sum_seq]
+    const int* __restrict__ accum_length, // [batch_size+1]
+    const int max_seq,
+    const int num_heads,
+    const int batch_size,
+    const int head_stride,       // input.stride(1)
+    const int head_out_stride    // output.stride(0)
+) {
+    const int batch_idx = blockIdx.z;
+    const int head_idx = blockIdx.y;
+    const int tid = threadIdx.x;
+
+    if (batch_idx >= batch_size || head_idx >= num_heads)
+        return;
+
+    const int seq_start = accum_length[batch_idx];
+    const int seq_end = accum_length[batch_idx + 1];
+    const int seq_len = seq_end - seq_start;
+
+    const float* in_ptr = input +
+                         batch_idx * num_heads * head_stride +
+                         head_idx * head_stride;
+
+    float* out_ptr = output + head_idx * head_out_stride + seq_start;
+
+    const int num_vec = (seq_len + VEC_SIZE - 1) / VEC_SIZE;
+
+    for (int vec_idx = tid; vec_idx < num_vec; vec_idx += BLOCK_THREADS) {
+        float4 vec_val;
+        const int elem_offset = vec_idx * VEC_SIZE;
+        const int remaining = seq_len - elem_offset;
+
+        if (remaining >= VEC_SIZE) {
+            vec_val = reinterpret_cast<const float4*>(in_ptr)[vec_idx];
+        } else {
+            #pragma unroll
+            for (int i = 0; i < VEC_SIZE; ++i) {
+                reinterpret_cast<float*>(&vec_val)[i] =
+                    (i < remaining) ? in_ptr[elem_offset + i] : 0.0f;
+            }
+        }
+
+        if (elem_offset < seq_len) {
+            const int store_size = min(VEC_SIZE, remaining);
+            if (store_size == VEC_SIZE) {
+                reinterpret_cast<float4*>(out_ptr)[vec_idx] = vec_val;
+            } else {
+                #pragma unroll
+                for (int i = 0; i < store_size; ++i) {
+                    out_ptr[elem_offset + i] = reinterpret_cast<float*>(&vec_val)[i];
+                }
+            }
+        }
+    }
+}
+
+void varlen_fa_lse_seqlen_unpad(
+    torch::Tensor &in,          // [batch_size, num_heads, max_seq]
+    torch::Tensor &out,         // [num_heads, sum_seq]
+    torch::Tensor &accum_lens,  // [batch_size+1]
+    int sum_seq,
+    int max_seq,
+    int num_heads,
+    int batch_size
+) {
+    const int head_stride = in.stride(1);
+    const int head_out_stride = out.stride(0);
+
+    constexpr int BLOCK_THREADS = 256;
+
+    dim3 grid(1, num_heads, batch_size);
+    dim3 block(BLOCK_THREADS);
+
+    const at::musa::OptionalMUSAGuard device_guard(in.device());
+    auto stream = c10::musa::getCurrentMUSAStream().stream();
+
+    varlen_fa_lse_seqlen_unpad_kernel<BLOCK_THREADS><<<grid, block, 0, stream>>>(
+        in.data_ptr<float>(),
+        out.data_ptr<float>(),
+        accum_lens.data_ptr<int>(),
+        max_seq,
+        num_heads,
+        batch_size,
+        head_stride,
+        head_out_stride
+    );
+}
