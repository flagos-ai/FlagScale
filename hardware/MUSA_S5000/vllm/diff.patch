+#pragma once
+/**
+ * __device__ datatypes vectorized by 4
+ */
+
+// Include both AMD and NVIDIA fp8 types to avoid circular import
+// TODO(luka/varun) use FP8_TYPE instead after refactoring
+#include <c10/util/Float8_e4m3fnuz.h>
+#include <c10/util/Float8_e4m3fn.h>
+
+namespace vllm_musa {
+
+// Vectorization containers
+template <typename scalar_t>
+struct __align__(8) vec4_t {
+  scalar_t x;
+  scalar_t y;
+  scalar_t z;
+  scalar_t w;
+};
+
+template <typename quant_type_t>
+struct __align__(4) q8x4_t {
+  static_assert(std::is_same_v<quant_type_t, int8_t> ||
+                std::is_same_v<quant_type_t, c10::Float8_e4m3fn> ||
+                std::is_same_v<quant_type_t, c10::Float8_e4m3fnuz>);
+  quant_type_t x;
+  quant_type_t y;
+  quant_type_t z;
+  quant_type_t w;
+};
+
+}  // namespace vllm_musa
diff --git a/vllm_musa/csrc/rmsnorm_cast/dtype.muh b/vllm_musa/csrc/rmsnorm_cast/dtype.muh
new file mode 100644
index 000000000..4a4ba1553
--- /dev/null
+++ b/vllm_musa/csrc/rmsnorm_cast/dtype.muh
@@ -0,0 +1,409 @@
+#pragma once
+#include <musa_runtime.h>
+#include <stdint.h>
+
+#ifdef __MTGPU__
+#include <musa_robust.h>
+#endif
+
+#include "musa_bf16.h"
+#include "musa_fp16.h"
+#include "musa_fp8.h"
+
+namespace vllm_musa {
+
+typedef __half float16_t;
+#if defined(__MUSACC__) && (__MUSA_ARCH__ >= 220 || !defined(__MUSA_ARCH__))
+typedef __mt_bfloat16 bfloat16_t;
+#else
+typedef int16_t bfloat16_t;
+#endif
+
+#if defined(__MUSACC__) && (__MUSA_ARCH__ >= 310 || !defined(__MUSA_ARCH__))
+#define __MUSA_HOSTDEVICE__ __host__ __device__
+template <typename T> struct FDtypeWrapper {
+  T _x;
+  __MUSA_HOSTDEVICE__ FDtypeWrapper() = default;
+  __MUSA_HOSTDEVICE__ FDtypeWrapper(const float x) {
+    if constexpr (std::is_same<__mt_fp8_e4m3, T>::value) {
+      // hw instruction only support satfinity mode, add if to support normal
+      // mode
+      uint32_t f_abs_bits = (*(uint32_t *)&x) & (uint32_t)0x7fffffff;
+      // https://github.com/pytorch/pytorch/blob/16de25b1dc3af7cc3efdb24e5637a62b8c329881/c10/util/Float8_e4m3fn.h#L183-L186
+      constexpr uint32_t fp8_max = 0x43e80001;
+      if (f_abs_bits >= fp8_max) {
+        _x.__x = 0x7f;
+        _x.__x |= UINT8_C(((*(uint32_t *)&x) & UINT32_C(0x80000000)) >> 24); //
+      } else {
+        _x = __mt_fp8_e4m3(x);
+      }
+    } else if constexpr (std::is_same<__mt_fp8_e5m2, T>::value) {
+      // hw instruction only support satfinity mode, add if to support normal
+      // mode
+      uint32_t f_abs_bits = (*(uint32_t *)&x) & (uint32_t)0x7fffffff;
+      // https://github.com/pytorch/pytorch/blob/16de25b1dc3af7cc3efdb24e5637a62b8c329881/c10/util/Float8_e5m2.h#L64
+      constexpr uint32_t fp8_max = 0x47700000;
+      constexpr uint32_t fp32_inf = UINT32_C(255) << 23;
+      if (f_abs_bits >= fp8_max) {
+        _x.__x = f_abs_bits > fp32_inf ? UINT8_C(0x7F) : UINT8_C(0x7C);
+        _x.__x |= UINT8_C(((*(uint32_t *)&x) & UINT32_C(0x80000000)) >> 24);
+      } else {
+        _x = __mt_fp8_e5m2(x);
+      }
+    } else {
+      _x = T(x);
+    }
+  }
+  __MUSA_HOSTDEVICE__ operator float() const {
+    if constexpr (std::is_same<__mt_fp8_e4m3, T>::value) {
+      __half temp;
+      asm("CVT.RTE.DENORM.BST1 %0.f16, %1.e4m3\n" : "=R"(temp) : "R"(_x));
+      return (float)temp;
+    } else if constexpr (std::is_same<__mt_fp8_e5m2, T>::value) {
+      __half temp;
+      asm("CVT.RTE.DENORM.BST1 %0.f16, %1.e5m2\n" : "=R"(temp) : "R"(_x));
+      return (float)temp;
+    } else {
+      return (float)_x;
+    }
+  }
+  __MUSA_HOSTDEVICE__ FDtypeWrapper &operator+=(const float x) {
+    _x = T((float)_x + x);
+    return *this;
+  }
+  __MUSA_HOSTDEVICE__ FDtypeWrapper &operator-=(const float x) {
+    _x = T((float)_x - x);
+    return *this;
+  }
+  __MUSA_HOSTDEVICE__ FDtypeWrapper &operator*=(const float x) {
+    _x = T((float)_x * x);
+    return *this;
+  }
+  __MUSA_HOSTDEVICE__ FDtypeWrapper &operator/=(const float x) {
+    _x = T((float)_x / x);
+    return *this;
+  }
+};
+#undef __MUSA_HOSTDEVICE__
+typedef FDtypeWrapper<__mt_fp8_e4m3> fp8_e4m3_t;
+typedef FDtypeWrapper<__mt_fp8_e5m2> fp8_e5m2_t;
+#else
+typedef int8_t fp8_e4m3_t;
+typedef uint8_t fp8_e5m2_t;
+#endif
+
+#define MACRO_UNROLL _Pragma("unroll")
+
+#define ATTR_ALIGNED(v) __attribute__((aligned(v)))
+#define SELF_VEC_DEF(BASE_TYPE, VEC_TYPE_V2, VEC_TYPE_V4)                      \
+  struct ATTR_ALIGNED(sizeof(BASE_TYPE) * 2) VEC_TYPE_V2 {                     \
+    __device__ VEC_TYPE_V2() {}                                                \
+    __device__ VEC_TYPE_V2(const VEC_TYPE_V2 &t) {                             \
+      this->x = t.x;                                                           \
+      this->y = t.y;                                                           \
+    }                                                                          \
+    BASE_TYPE x, y;                                                            \
+  };                                                                           \
+                                                                               \
+  __device__ __forceinline__ VEC_TYPE_V2 make_##VEC_TYPE_V2(BASE_TYPE x,       \
+                                                            BASE_TYPE y) {     \
+    VEC_TYPE_V2 t;                                                             \
+    t.x = x, t.y = y;                                                          \
+    return t;                                                                  \
+  }                                                                            \
+                                                                               \
+  struct ATTR_ALIGNED(sizeof(BASE_TYPE) * 4) VEC_TYPE_V4 {                     \
+    __device__ VEC_TYPE_V4() {}                                                \
+    __device__ VEC_TYPE_V4(const VEC_TYPE_V4 &t) {                             \
+      this->x = t.x;                                                           \
+      this->y = t.y;                                                           \
+      this->z = t.z;                                                           \
+      this->w = t.w;                                                           \
+    }                                                                          \
+    BASE_TYPE x, y, z, w;                                                      \
+  };                                                                           \
+                                                                               \
+  __device__ __forceinline__ VEC_TYPE_V4 make_##VEC_TYPE_V4(                   \
+      BASE_TYPE x, BASE_TYPE y, BASE_TYPE z, BASE_TYPE w) {                    \
+    VEC_TYPE_V4 t;                                                             \
+    t.x = x, t.y = y, t.z = z, t.w = w;                                        \
+    return t;                                                                  \
+  }
+
+SELF_VEC_DEF(float16_t, Half2, Half4)
+#if defined(__MUSACC__) && (__MUSA_ARCH__ >= 220 || !defined(__MUSA_ARCH__))
+SELF_VEC_DEF(bfloat16_t, Bhalf2, Bhalf4)
+#endif
+#if defined(__MUSACC__) && (__MUSA_ARCH__ >= 310 || !defined(__MUSA_ARCH__))
+SELF_VEC_DEF(fp8_e5m2_t, E5m2x2, E5m2x4)
+SELF_VEC_DEF(fp8_e4m3_t, E4m3x2, E4m3x4)
+#endif
+
+#define GEN_VECTYPE(_CTYPE, _VECTYPE, _BYTES, _VLEN)                           \
+  struct ATTR_ALIGNED(_BYTES) _VECTYPE {                                       \
+    __device__ _VECTYPE() {}                                                   \
+    __device__ _VECTYPE(const _VECTYPE &t) {                                   \
+      MACRO_UNROLL                                                             \
+      for (int i = 0; i < _VLEN; i++) {                                        \
+        this->arr[i] = t.arr[i];                                               \
+      }                                                                        \
+    }                                                                          \
+    _CTYPE arr[_VLEN];                                                         \
+  }
+GEN_VECTYPE(float16_t, Half8, 16, 8);
+GEN_VECTYPE(float, Float8, 32, 8);
+#if defined(__MUSACC__) && (__MUSA_ARCH__ >= 220 || !defined(__MUSA_ARCH__))
+GEN_VECTYPE(bfloat16_t, Bhalf8, 16, 8);
+GEN_VECTYPE(bfloat16_t, Bhalf16, 32, 16);
+GEN_VECTYPE(bfloat16_t, Bhalf32, 64, 32);
+#endif
+#if defined(__MUSACC__) && (__MUSA_ARCH__ >= 310 || !defined(__MUSA_ARCH__))
+GEN_VECTYPE(fp8_e4m3_t, E4m3x8, 8, 8);
+GEN_VECTYPE(fp8_e4m3_t, E4m3x16, 16, 16);
+GEN_VECTYPE(fp8_e4m3_t, E4m3x32, 32, 32);
+GEN_VECTYPE(fp8_e5m2_t, E5m2x8, 8, 8);
+GEN_VECTYPE(fp8_e5m2_t, E5m2x16, 16, 16);
+GEN_VECTYPE(fp8_e5m2_t, E5m2x32, 32, 32);
+#endif
+GEN_VECTYPE(float16_t, Half16, 32, 16);
+GEN_VECTYPE(float, Float16, 64, 16);
+
+template <typename type> class Dtype;
+
+#define INST(_type, _vec2, _vec4)                                              \
+  template <> class Dtype<_type> {                                             \
+  public:                                                                      \
+    using Scalar = _type;                                                      \
+    using Vec2 = _vec2;                                                        \
+    using Vec4 = _vec4;                                                        \
+    static __device__ __forceinline__ Vec2 make_vec2(_type x, _type y) {       \
+      return make_##_vec2(x, y);                                               \
+    }                                                                          \
+    static __device__ __forceinline__ Vec4 make_vec4(_type x, _type y,         \
+                                                     _type z, _type w) {       \
+      return make_##_vec4(x, y, z, w);                                         \
+    }                                                                          \
+  }
+
+INST(float, float2, float4);
+INST(float16_t, Half2, Half4);
+#if defined(__MUSACC__) && (__MUSA_ARCH__ >= 220 || !defined(__MUSA_ARCH__))
+INST(bfloat16_t, Bhalf2, Bhalf4);
+#endif
+#if defined(__MUSACC__) && (__MUSA_ARCH__ >= 310 || !defined(__MUSA_ARCH__))
+INST(fp8_e5m2_t, E5m2x2, E5m2x4);
+INST(fp8_e4m3_t, E4m3x2, E4m3x4);
+#endif
+
+#undef INST
+
+template <typename T> struct DeduceVectorizedType { using Type = T; };
+
+template <> struct DeduceVectorizedType<bool> { using Type = int8_t; };
+
+template <> struct DeduceVectorizedType<half> { using Type = _Float16; };
+
+#if defined(__MUSACC__) && (__MUSA_ARCH__ >= 220 || !defined(__MUSA_ARCH__))
+template <> struct DeduceVectorizedType<bfloat16_t> { using Type = _Float16; };
+#endif
+#if defined(__MUSACC__) && (__MUSA_ARCH__ >= 310 || !defined(__MUSA_ARCH__))
+template <> struct DeduceVectorizedType<fp8_e4m3_t> { using Type = int8_t; };
+template <> struct DeduceVectorizedType<fp8_e5m2_t> { using Type = int8_t; };
+#endif
+
+#if defined(__MUSA_ARCH__) && __MUSA_ARCH__ == 310 // MUSIFY_EXCL_LINE
+#define LD_BYP_SLC(_BITS, _BYTES)                                              \
+  VecType dst;                                                                 \
+  const BaseType *addr = ptr + idx;                                            \
+  asm volatile("LSU.LD.B" #_BITS " %0, %1, _, " #_BYTES                        \
+               ", 1, 1, inner_persist=0, "                                     \
+               "outer_persist=2, chrnt=l2_l3, slc=byp, persist=0, "            \
+               "stride_add_first=0"                                            \
+               : "=R"(dst)                                                     \
+               : "R"(addr));                                                   \
+  return dst;
+#else
+#define LD_BYP_SLC(_BITS, _BYTES) return *(VecType *)(ptr + idx);
+#endif
+
+template <typename T, int bits = 16 * 8> struct VecType;
+
+#define DEF_VECT(_CTYPE, _VECTYPE)                                             \
+  template <> struct VecType<_CTYPE, sizeof(_VECTYPE) * 8> {                   \
+    static constexpr int vec_bytes = sizeof(_VECTYPE);                         \
+    static constexpr int bit_per_byte = 8;                                     \
+    using BaseType = _CTYPE;                                                   \
+    using RobustTypePtr = __musa::robust_ptr<_CTYPE>;                          \
+    using Ttype = _VECTYPE;                                                    \
+    static constexpr int bits = vec_bytes * bit_per_byte;                      \
+    static constexpr int vlen = bits / (sizeof(BaseType) * bit_per_byte);      \
+    using VectorizedType = typename DeduceVectorizedType<BaseType>::Type;      \
+    typedef VectorizedType VxTy __attribute__((vector_size(vec_bytes)));       \
+    template <typename OffsetType>                                             \
+    static __device__ __forceinline__ VecType load(const BaseType *ptr,        \
+                                                   OffsetType idx) {           \
+      return *(VecType *)(ptr + idx);                                          \
+    }                                                                          \
+    template <typename OffsetType>                                             \
+    static __device__ __forceinline__ VecType                                  \
+    load_byp_slc(const BaseType *ptr, OffsetType idx) {                        \
+      if constexpr (vec_bytes == 16) {                                         \
+        LD_BYP_SLC(128, 16);                                                   \
+      } else if constexpr (vec_bytes == 8) {                                   \
+        LD_BYP_SLC(64, 8);                                                     \
+      } else if constexpr (vec_bytes == 4) {                                   \
+        LD_BYP_SLC(32, 4);                                                     \
+      } else if constexpr (vec_bytes == 2) {                                   \
+        LD_BYP_SLC(16, 2);                                                     \
+      } else {                                                                 \
+        LD_BYP_SLC(8, 1);                                                      \
+      }                                                                        \
+    }                                                                          \
+    template <typename OffsetType>                                             \
+    static __device__ __forceinline__ VecType                                  \
+    robust_load(const RobustTypePtr ptr, OffsetType idx) {                     \
+      return __musa::robust_load<VecType, BaseType>(ptr, idx);                 \
+    }                                                                          \
+                                                                               \
+    template <typename OffsetType>                                             \
+    static __device__ __forceinline__ void                                     \
+    store(BaseType *ptr, OffsetType idx, const VecType &dst) {                 \
+      *(VecType *)(ptr + idx) = dst;                                           \
+    }                                                                          \
+    template <typename OffsetType>                                             \
+    static __device__ __forceinline__ void                                     \
+    robust_store(RobustTypePtr ptr, OffsetType idx, const VecType &dst) {      \
+      __musa::robust_store<VecType, BaseType>(dst, ptr, idx);                  \
+    }                                                                          \
+                                                                               \
+    __device__ VecType() {                                                     \
+      MACRO_UNROLL                                                             \
+      for (int i = 0; i < sizeof(Ttype) / sizeof(BaseType); i++) {             \
+        this->val_.elem[i] = 0;                                                \
+      }                                                                        \
+    }                                                                          \
+    __device__ VecType(const VecType &t) {                                     \
+      MACRO_UNROLL                                                             \
+      for (int i = 0; i < sizeof(Ttype) / sizeof(BaseType); i++) {             \
+        this->val_.elem[i] = t.val_.elem[i];                                   \
+      }                                                                        \
+    }                                                                          \
+    __device__ VecType &operator=(const VecType &t) {                          \
+      MACRO_UNROLL                                                             \
+      for (int i = 0; i < sizeof(Ttype) / sizeof(BaseType); i++) {             \
+        this->val_.elem[i] = t.val_.elem[i];                                   \
+      }                                                                        \
+      return *this;                                                            \
+    }                                                                          \
+    __device__ VecType(_CTYPE val) {                                           \
+      MACRO_UNROLL                                                             \
+      for (int i = 0; i < sizeof(Ttype) / sizeof(BaseType); i++) {             \
+        this->val_.elem[i] = val;                                              \
+      }                                                                        \
+    }                                                                          \
+    template <typename SrcVecType>                                             \
+    friend __device__ VecType operator+(VecType lhs, const SrcVecType &rhs) {  \
+      MACRO_UNROLL                                                             \
+      for (int i = 0; i < sizeof(Ttype) / sizeof(BaseType); i++) {             \
+        lhs.val_.elem[i] += static_cast<BaseType>(rhs.val_.elem[i]);           \
+      }                                                                        \
+      return lhs;                                                              \
+    }                                                                          \
+    friend __device__ VecType operator+(VecType lhs, const _CTYPE &rhs) {      \
+      MACRO_UNROLL                                                             \
+      for (int i = 0; i < sizeof(Ttype) / sizeof(BaseType); i++) {             \
+        lhs.val_.elem[i] += rhs;                                               \
+      }                                                                        \
+      return lhs;                                                              \
+    }                                                                          \
+    friend __device__ VecType operator-(VecType lhs, const VecType &rhs) {     \
+      MACRO_UNROLL                                                             \
+      for (int i = 0; i < sizeof(Ttype) / sizeof(BaseType); i++) {             \
+        lhs.val_.elem[i] -= rhs.val_.elem[i];                                  \
+      }                                                                        \
+      return lhs;                                                              \
+    }                                                                          \
+    friend __device__ VecType operator*(VecType lhs, const VecType &rhs) {     \
+      MACRO_UNROLL                                                             \
+      for (int i = 0; i < sizeof(Ttype) / sizeof(BaseType); i++) {             \
+        lhs.val_.elem[i] *= rhs.val_.elem[i];                                  \
+      }                                                                        \
+      return lhs;                                                              \
+    }                                                                          \
+    template <typename Func> __device__ VecType &apply() {                     \
+      MACRO_UNROLL                                                             \
+      for (int i = 0; i < sizeof(Ttype) / sizeof(BaseType); i++) {             \
+        this->val_.elem[i] = Func::apply(this->val_.elem[i]);                  \
+      }                                                                        \
+      return *this;                                                            \
+    }                                                                          \
+    template <typename SrcVecType>                                             \
+    static __device__ VecType cvt(const SrcVecType &src) {                     \
+      VecType dst;                                                             \
+      MACRO_UNROLL                                                             \
+      for (int i = 0; i < sizeof(Ttype) / sizeof(BaseType); i++) {             \
+        dst.val_.elem[i] = (BaseType)(src.val_.elem[i]);                       \
+      }                                                                        \
+      return dst;                                                              \
+    }                                                                          \
+    union U {                                                                  \
+      __device__ U() {                                                         \
+        MACRO_UNROLL                                                           \
+        for (int i = 0; i < sizeof(Ttype) / sizeof(BaseType); i++) {           \
+          this->elem[i] = 0;                                                   \
+        }                                                                      \
+      }                                                                        \
+      Ttype storage;                                                           \
+      BaseType elem[sizeof(Ttype) / sizeof(BaseType)];                         \
+      VxTy vt_elem;                                                            \
+    };                                                                         \
+    U val_{};                                                                  \
+  }
+DEF_VECT(float16_t, float16_t);
+DEF_VECT(float16_t, Half2);
+DEF_VECT(float16_t, Half4);
+DEF_VECT(float16_t, Half8);
+DEF_VECT(float16_t, Half16);
+#if defined(__MUSACC__) && (__MUSA_ARCH__ >= 220 || !defined(__MUSA_ARCH__))
+DEF_VECT(bfloat16_t, bfloat16_t);
+DEF_VECT(bfloat16_t, Bhalf2);
+DEF_VECT(bfloat16_t, Bhalf4);
+DEF_VECT(bfloat16_t, Bhalf8);
+DEF_VECT(bfloat16_t, Bhalf16);
+DEF_VECT(bfloat16_t, Bhalf32);
+#endif
+#if defined(__MUSACC__) && (__MUSA_ARCH__ >= 310 || !defined(__MUSA_ARCH__))
+DEF_VECT(fp8_e4m3_t, fp8_e4m3_t);
+DEF_VECT(fp8_e4m3_t, E4m3x2);
+DEF_VECT(fp8_e4m3_t, E4m3x4);
+DEF_VECT(fp8_e4m3_t, E4m3x8);
+DEF_VECT(fp8_e4m3_t, E4m3x16);
+DEF_VECT(fp8_e4m3_t, E4m3x32);
+DEF_VECT(fp8_e5m2_t, fp8_e5m2_t);
+DEF_VECT(fp8_e5m2_t, E5m2x2);
+DEF_VECT(fp8_e5m2_t, E5m2x4);
+DEF_VECT(fp8_e5m2_t, E5m2x8);
+DEF_VECT(fp8_e5m2_t, E5m2x16);
+DEF_VECT(fp8_e5m2_t, E5m2x32);
+#endif
+DEF_VECT(float, float);
+DEF_VECT(float, float2);
+DEF_VECT(float, float3);
+DEF_VECT(float, float4);
+DEF_VECT(float, Float8);
+DEF_VECT(float, Float16);
+
+#undef DEF_VECT
+#undef MACRO_UNROLL
+template <typename T> struct ComputeDType {
+  using Type = typename std::conditional<
+      (sizeof(T) >= 4), T,
+      typename std::conditional<
+          std::is_integral<T>::value,
+          typename std::conditional<std::is_unsigned<T>::value, uint32_t,
+                                    int32_t>::type,
+          float>::type>::type;
+};
+template <> struct ComputeDType<bool> { using Type = bool; };
+
+} // namespace vllm_musa
diff --git a/vllm_musa/csrc/rmsnorm_cast/math.muh b/vllm_musa/csrc/rmsnorm_cast/math.muh
new file mode 100644
index 000000000..5e14180a1
--- /dev/null
+++ b/vllm_musa/csrc/rmsnorm_cast/math.muh
@@ -0,0 +1,26 @@
+
+#pragma once
+#include "dtype.muh"
+#include <math.h>
+#include <type_traits>
+
+namespace vllm_musa {
+
+static __device__ __forceinline__ float fast_rcpf(float x) {
+  float y = __frcp_rn(x);
+  y = y * (2.f - x * y);
+  return y;
+}
+
+static __device__ __forceinline__ float fast_rsqrtf(float a) {
+  float x = 0.5f * a;
+  float y = __frsqrt_rn(a);
+  y = y * (1.5f - x * y * y);
+  return y;
+}
+
+static __device__ __forceinline__ float fast_divf(float a, float b) {
+  return a * fast_rcpf(b);
+}
+
+} // namespace vllm_musa
diff --git a/vllm_musa/csrc/rmsnorm_cast/rmsnorm_cast.mu b/vllm_musa/csrc/rmsnorm_cast/rmsnorm_cast.mu
new file mode 100644
index 000000000..3798d287b
--- /dev/null
+++ b/vllm_musa/csrc/rmsnorm_cast/rmsnorm_cast.mu
@@ -0,0 +1,299 @@
+#include "../dispatch_utils.h"
+#include "../type_convert.muh"
+#include "dtype.muh"
+#include "math.muh"
+#include "update_helper.muh"
+
+#include <torch/all.h>
+
+namespace vllm_musa {
+
+template <typename ComputeType, int width>
+__device__ ComputeType warp_max_reduce(ComputeType val) {
+#pragma unroll
+  for (int offset = width / 2; offset > 0; offset /= 2) {
+    val = fmaxf(val, mudnn_shfl_down_sync<ComputeType, width>(val, offset));
+  }
+  int lane_id = threadIdx.x & (warpSize - 1);
+  int subwarp_id = lane_id / width;
+  int subwarp_start = subwarp_id * width;
+  val = mudnn_shfl_sync<ComputeType, width>(val, subwarp_start);
+  return val;
+}
+
+template <typename SrcDtype, typename ComputeType, typename DstDtype,
+          typename StatDtype, int BLOCK_X, int BLOCK_Y, int vlen,
+          int quant_size>
+__global__ void rmsnorm_cast_kernel(
+                                    fp8_e4m3_t *output_fp8, float *scale,
+                                    const SrcDtype *input,
+                                    const DstDtype *gamma, const size_t M,
+                                    const size_t N, const ComputeType eps) {
+#if defined(__MUSA_ARCH__) && (__MUSA_ARCH__ == 310)
+  size_t tx = threadIdx.x;
+  size_t ty = threadIdx.y;
+  size_t m_idx = blockIdx.x * blockDim.y + ty;
+  size_t n_idx = tx * vlen;
+  size_t n_step = (size_t)blockDim.x * vlen;
+
+  using SrcVec = VecType<SrcDtype, vlen * sizeof(SrcDtype) * 8>;
+  using DstVec = VecType<DstDtype, vlen * sizeof(DstDtype) * 8>;
+  using Fp8Vec = VecType<fp8_e4m3_t, vlen * sizeof(fp8_e4m3_t) * 8>;
+
+  ComputeType mu = 0;
+  ComputeType m2 = 0;
+  ComputeType cnt = 0;
+
+  const SrcDtype *__restrict p_src = input + m_idx * N;
+
+  // TODO(wuke): use robust_load, robust_store
+  bool m_valid = m_idx < M;
+  if (m_valid) {
+    for (size_t j = n_idx; j < N; j += n_step) {
+      SrcVec curr = *(const SrcVec *)(p_src + j);
+#pragma unroll
+      for (int k = 0; k < vlen; k++) {
+        VarUpdate<ComputeType, VarUpdateMode::WELFORD_ONLY_MEAN> welford_op;
+        welford_op.apply((ComputeType)curr.val_.elem[k] *
+                             (ComputeType)curr.val_.elem[k],
+                         &mu, &cnt);
+      }
+    }
+  }
+
+  AllReduceOp<ComputeType, BLOCK_X, BLOCK_Y, ReduceMode::WELFORD_ONLY_MEAN,
+              ReduceAxis::COLUMN>
+      all_reduce_op;
+  all_reduce_op.apply(&mu, &cnt, tx, ty);
+
+  if (m_valid) {
+    ComputeType mean = mu;
+    ComputeType inv_var;
+    inv_var = fast_rsqrtf(mean + eps);
+    (void)m2;
+
+    // DstDtype *__restrict p_dst = output + m_idx * N;
+
+    // max allreduce
+    constexpr int group_sz = quant_size / vlen;
+
+    for (size_t j = n_idx; j < N; j += n_step) {
+      SrcVec val = *(const SrcVec *)(p_src + j);
+      DstVec gamma_val = *(const DstVec *)(gamma + j);
+      DstVec dst;
+      Fp8Vec dst_fp8;
+      ComputeType local_max = eps;
+#pragma unroll
+      for (int k = 0; k < vlen; k++) {
+        dst.val_.elem[k] = (DstDtype)((ComputeType)val.val_.elem[k] * inv_var *
+                                      (ComputeType)gamma_val.val_.elem[k]);
+        local_max = fmaxf(local_max, fabsf((ComputeType)dst.val_.elem[k]));
+      }
+      // per group_sz compute max
+      // *(DstVec*)(p_dst + j) = dst;
+      ComputeType amax = warp_max_reduce<ComputeType, group_sz>(local_max);
+      // printf("thread id:[%d, %d], amax = %f.\n", tx, ty, amax);
+      // compute amax & scale
+      ComputeType scale_val = amax / 448.;
+      scale[m_idx * (N / quant_size) + j / quant_size] = (float)scale_val;
+// compute fp8 output
+#pragma unroll
+      for (int k = 0; k < vlen; k++) {
+        dst_fp8.val_.elem[k] =
+            (fp8_e4m3_t)((ComputeType)(dst.val_.elem[k]) / scale_val);
+      }
+      *(Fp8Vec *)(output_fp8 + m_idx * N + j) = dst_fp8;
+    }
+  }
+#endif
+}
+
+template <typename SrcDtype, typename ComputeType, typename DstDtype,
+          typename StatDtype, int BLOCK_X, int BLOCK_Y, int vlen,
+          int quant_size>
+__global__ void rmsnorm_add_cast_kernel(
+                                        fp8_e4m3_t *output_fp8, float *scale,
+                                        const SrcDtype *input,
+                                        const SrcDtype *resdual,
+                                        const DstDtype *gamma, const size_t M,
+                                        const size_t N, const ComputeType eps) {
+#if defined(__MUSA_ARCH__) && (__MUSA_ARCH__ == 310)
+  size_t tx = threadIdx.x;
+  size_t ty = threadIdx.y;
+  size_t m_idx = blockIdx.x * blockDim.y + ty;
+  size_t n_idx = tx * vlen;
+  size_t n_step = (size_t)blockDim.x * vlen;
+
+  using SrcVec = VecType<SrcDtype, vlen * sizeof(SrcDtype) * 8>;
+  using DstVec = VecType<DstDtype, vlen * sizeof(DstDtype) * 8>;
+  using Fp8Vec = VecType<fp8_e4m3_t, vlen * sizeof(fp8_e4m3_t) * 8>;
+
+  ComputeType mu = 0;
+  ComputeType m2 = 0;
+  ComputeType cnt = 0;
+
+  const SrcDtype *__restrict p_src = input + m_idx * N;
+  const SrcDtype *__restrict r_src = resdual + m_idx * N;
+  // TODO(wuke): use robust_load, robust_store
+  bool m_valid = m_idx < M;
+  if (m_valid) {
+    for (size_t j = n_idx; j < N; j += n_step) {
+      SrcVec curr = *(const SrcVec *)(p_src + j);
+      SrcVec resd = *(const SrcVec *)(r_src + j);
+#pragma unroll
+      for (int k = 0; k < vlen; k++) {
+        curr.val_.elem[k] = curr.val_.elem[k] + resd.val_.elem[k];
+        VarUpdate<ComputeType, VarUpdateMode::WELFORD_ONLY_MEAN> welford_op;
+        welford_op.apply((ComputeType)curr.val_.elem[k] *
+                             (ComputeType)curr.val_.elem[k],
+                         &mu, &cnt);
+      }
+      *(SrcVec*)(p_src + j) = curr;
+    }
+  }
+
+  AllReduceOp<ComputeType, BLOCK_X, BLOCK_Y, ReduceMode::WELFORD_ONLY_MEAN,
+              ReduceAxis::COLUMN>
+      all_reduce_op;
+  all_reduce_op.apply(&mu, &cnt, tx, ty);
+
+  if (m_valid) {
+    ComputeType mean = mu;
+    ComputeType inv_var;
+    inv_var = fast_rsqrtf(mean + eps);
+    (void)m2;
+
+    // DstDtype *__restrict p_dst = output + m_idx * N;
+    // max allreduce
+    constexpr int group_sz = quant_size / vlen;
+
+    for (size_t j = n_idx; j < N; j += n_step) {
+      SrcVec val = *(const SrcVec *)(p_src + j);
+      DstVec gamma_val = *(const DstVec *)(gamma + j);
+      DstVec dst;
+      Fp8Vec dst_fp8;
+      ComputeType local_max = eps;
+#pragma unroll
+      for (int k = 0; k < vlen; k++) {
+        dst.val_.elem[k] = (DstDtype)((ComputeType)val.val_.elem[k] * inv_var *
+                                      (ComputeType)gamma_val.val_.elem[k]);
+        local_max = fmaxf(local_max, fabsf((ComputeType)dst.val_.elem[k]));
+      }
+      // per group_sz compute max
+      // *(DstVec*)(p_dst + j) = dst;
+      ComputeType amax = warp_max_reduce<ComputeType, group_sz>(local_max);
+      // printf("thread id:[%d, %d], amax = %f.\n", tx, ty, amax);
+      // compute amax & scale
+      ComputeType scale_val = amax / 448.;
+      scale[m_idx * (N / quant_size) + j / quant_size] = (float)scale_val;
+// compute fp8 output
+#pragma unroll
+      for (int k = 0; k < vlen; k++) {
+        dst_fp8.val_.elem[k] =
+            (fp8_e4m3_t)((ComputeType)(dst.val_.elem[k]) / scale_val);
+      }
+      *(Fp8Vec *)(output_fp8 + m_idx * N + j) = dst_fp8;
+    }
+  }
+#endif
+}
+} // namespace vllm_musa
+
+void rmsnorm_cast(
+                  torch::Tensor &output_fp8, torch::Tensor &inv_scale,
+                  const torch::Tensor &input, const torch::Tensor &gamma,
+                  const float eps, const int quant_size) {
+  size_t M = input.size(0);
+  size_t N = input.size(1);
+
+  TORCH_CHECK(quant_size == 128, "quant block size only support 128.");
+  constexpr int vlen = 8;
+  int64_t tune_n = N % vlen == 0 ? N / vlen : N;
+#define LAUNCH_RMSNORM(BX, BY)                                                 \
+  do {                                                                         \
+    constexpr int BLOCK_X = (BX), BLOCK_Y = (BY);                              \
+    dim3 block(BLOCK_X, BLOCK_Y);                                              \
+    dim3 grid((M + BLOCK_Y - 1) / BLOCK_Y);                                    \
+    VLLM_DISPATCH_FLOATING_TYPES(                                              \
+        input.scalar_type(), "rmsnorm_cast_kernel", [&] {                      \
+          using scalar_torch = scalar_t;                                       \
+          using scalar_internal = std::conditional_t<                          \
+              std::is_same<scalar_torch, c10::Half>::value,                    \
+              vllm_musa::float16_t,                                            \
+              std::conditional_t<                                              \
+                  std::is_same<scalar_torch, c10::BFloat16>::value,            \
+                  vllm_musa::bfloat16_t, scalar_torch>>;                       \
+          vllm_musa::rmsnorm_cast_kernel<scalar_internal, float,               \
+                                         scalar_internal, float, BLOCK_X,      \
+                                         BLOCK_Y, vlen, 128>                   \
+              <<<grid, block, 0, stream>>>(                                    \
+                  static_cast<vllm_musa::fp8_e4m3_t *>(output_fp8.data_ptr()), \
+                  static_cast<float *>(inv_scale.data_ptr()),                  \
+                  static_cast<scalar_internal *>(input.data_ptr()),            \
+                  static_cast<scalar_internal *>(gamma.data_ptr()), M, N,      \
+                  static_cast<float>(eps));                                    \
+        });                                                                    \
+  } while (0)
+
+  const musaStream_t stream = at::musa::getCurrentMUSAStream();
+  if (M / tune_n > 16) {
+    LAUNCH_RMSNORM(64, 8);
+  } else if (tune_n > 256 && tune_n <= 1024) {
+    LAUNCH_RMSNORM(128, 4);
+  } else if (tune_n <= 256) {
+    LAUNCH_RMSNORM(64, 1);
+  } else {
+    LAUNCH_RMSNORM(256, 1);
+  }
+}
+
+void rmsnorm_add_cast(
+                      torch::Tensor &output_fp8, torch::Tensor &inv_scale,
+                      const torch::Tensor &input, const torch::Tensor &resdual,
+                      const torch::Tensor &gamma, const float eps,
+                      const int quant_size) {
+  size_t M = input.size(0);
+  size_t N = input.size(1);
+
+  TORCH_CHECK(quant_size == 128, "quant block size only support 128.");
+  constexpr int vlen = 8;
+  int64_t tune_n = N % vlen == 0 ? N / vlen : N;
+
+#define LAUNCH_RMSNORM_ADD(BX, BY)                                             \
+  do {                                                                         \
+    constexpr int BLOCK_X = (BX), BLOCK_Y = (BY);                              \
+    dim3 block(BLOCK_X, BLOCK_Y);                                              \
+    dim3 grid((M + BLOCK_Y - 1) / BLOCK_Y);                                    \
+    VLLM_DISPATCH_FLOATING_TYPES(                                              \
+        input.scalar_type(), "rmsnorm_add_cast_kernel", [&] {                  \
+          using scalar_torch = scalar_t;                                       \
+          using scalar_internal = std::conditional_t<                          \
+              std::is_same<scalar_torch, c10::Half>::value,                    \
+              vllm_musa::float16_t,                                            \
+              std::conditional_t<                                              \
+                  std::is_same<scalar_torch, c10::BFloat16>::value,            \
+                  vllm_musa::bfloat16_t, scalar_torch>>;                       \
+          vllm_musa::rmsnorm_add_cast_kernel<scalar_internal, float,           \
+                                             scalar_internal, float, BLOCK_X,  \
+                                             BLOCK_Y, vlen, 128>               \
+              <<<grid, block, 0, stream>>>(                                    \
+                  static_cast<vllm_musa::fp8_e4m3_t *>(output_fp8.data_ptr()), \
+                  static_cast<float *>(inv_scale.data_ptr()),                  \
+                  static_cast<scalar_internal *>(input.data_ptr()),            \
+                  static_cast<scalar_internal *>(resdual.data_ptr()),          \
+                  static_cast<scalar_internal *>(gamma.data_ptr()), M, N,      \
+                  static_cast<float>(eps));                                    \
+        });                                                                    \
+  } while (0)
+
+  const musaStream_t stream = at::musa::getCurrentMUSAStream();
+  if (M / tune_n > 16) {
+    LAUNCH_RMSNORM_ADD(64, 8);
+  } else if (tune_n > 256 && tune_n <= 1024) {
+    LAUNCH_RMSNORM_ADD(128, 4);
+  } else if (tune_n <= 256) {
+    LAUNCH_RMSNORM_ADD(64, 1);
+  } else {
+    LAUNCH_RMSNORM_ADD(256, 1);
+  }
+}
diff --git a/vllm_musa/csrc/rmsnorm_cast/shuffle.muh b/vllm_musa/csrc/rmsnorm_cast/shuffle.muh
new file mode 100644
index 000000000..3b8a739bc
--- /dev/null
+++ b/vllm_musa/csrc/rmsnorm_cast/shuffle.muh
@@ -0,0 +1,223 @@
+#pragma once
+
+#include <musa_runtime.h>
+
+namespace vllm_musa {
+
+// FULL_MASK
+#define MASK_SHFL_128 ((~(128 - 1)) & 0x7f) << 7 | (128 - 1)
+#define MASK_SHFL_64 ((~(64 - 1)) & 0x7f) << 7 | (64 - 1)
+#define MASK_SHFL_32 ((~(32 - 1)) & 0x7f) << 7 | (32 - 1)
+#define MASK_SHFL_16 ((~(16 - 1)) & 0x7f) << 7 | (16 - 1)
+#define MASK_SHFL_8 ((~(8 - 1)) & 0x7f) << 7 | (8 - 1)
+#define MASK_SHFL_4 ((~(4 - 1)) & 0x7f) << 7 | (4 - 1)
+#define MASK_SHFL_2 ((~(2 - 1)) & 0x7f) << 7 | (2 - 1)
+
+#define MASK_SHFL_UP_128 ((~(128 - 1)) & 0x7f) << 7
+#define MASK_SHFL_UP_64 ((~(64 - 1)) & 0x7f) << 7
+#define MASK_SHFL_UP_32 ((~(32 - 1)) & 0x7f) << 7
+#define MASK_SHFL_UP_16 ((~(16 - 1)) & 0x7f) << 7
+#define MASK_SHFL_UP_8 ((~(8 - 1)) & 0x7f) << 7
+#define MASK_SHFL_UP_4 ((~(4 - 1)) & 0x7f) << 7
+#define MASK_SHFL_UP_2 ((~(2 - 1)) & 0x7f) << 7
+
+template <typename T, int width>
+__device__ __forceinline__ T mudnn_shfl_sync(T val, int src_lane) {
+#if (defined(__MUSA_ARCH__) && (__MUSA_ARCH__ > 220)) // MUSIFY_EXCL_LINE
+  return __shfl_sync(0xffffffff, val, src_lane, width);
+#elif (defined(__MUSA_ARCH__) && (__MUSA_ARCH__ > 210)) // MUSIFY_EXCL_LINE
+  // width must have a value which is a power of two in the range [1, warpSize]
+  static_assert((width >= 1) && (width <= 128) && ((width & (width - 1)) == 0));
+  if constexpr (width == 1) {
+    return val;
+  } else {
+    auto shfl_func = [&](int &var) {
+      if constexpr (width == 128) {
+        return __musa_shfl_idx_sync_i32(var, src_lane & 0x7f, MASK_SHFL_128);
+      } else if constexpr (width == 64) {
+        return __musa_shfl_idx_sync_i32(var, src_lane & 0x3f, MASK_SHFL_64);
+      } else if constexpr (width == 32) {
+        return __musa_shfl_idx_sync_i32(var, src_lane & 0x1f, MASK_SHFL_32);
+      } else if constexpr (width == 16) {
+        return __musa_shfl_idx_sync_i32(var, src_lane & 0xf, MASK_SHFL_16);
+      } else if constexpr (width == 8) {
+        return __musa_shfl_idx_sync_i32(var, src_lane & 0x7, MASK_SHFL_8);
+      } else if constexpr (width == 4) {
+        return __musa_shfl_idx_sync_i32(var, src_lane & 0x3, MASK_SHFL_4);
+      } else if constexpr (width == 2) {
+        return __musa_shfl_idx_sync_i32(var, src_lane & 0x1, MASK_SHFL_2);
+      }
+    };
+    if constexpr (sizeof(T) == 4) {
+      int var = *(reinterpret_cast<int32_t *>(&val));
+      int ret = shfl_func(var);
+      return *(reinterpret_cast<T *>(&ret));
+    } else {
+      struct __Bits {
+        int __a, __b;
+      };
+      __Bits __tmp;
+      memcpy(&__tmp, &val, sizeof(val));
+      __tmp.__a = shfl_func(__tmp.__a);
+      __tmp.__b = shfl_func(__tmp.__b);
+      int64_t ret = *(reinterpret_cast<int64_t *>(&__tmp));
+      return *(reinterpret_cast<T *>(&ret));
+    }
+  }
+#else
+  return 0;
+#endif
+}
+
+template <typename T, int width>
+__device__ __forceinline__ T mudnn_shfl_down_sync(T val, unsigned int delta) {
+#if (defined(__MUSA_ARCH__) && (__MUSA_ARCH__ > 220)) // MUSIFY_EXCL_LINE
+  return __shfl_down_sync(0xffffffff, val, delta, width);
+#elif (defined(__MUSA_ARCH__) && (__MUSA_ARCH__ > 210)) // MUSIFY_EXCL_LINE
+  static_assert((width >= 2) && (width <= 128) && ((width & (width - 1)) == 0));
+
+  auto shfl_func = [&](int &var) {
+    if constexpr (width == 128) {
+      return __musa_shfl_down_sync_i32(var, delta & 0x7f, MASK_SHFL_128);
+    } else if constexpr (width == 64) {
+      return __musa_shfl_down_sync_i32(var, delta & 0x3f, MASK_SHFL_64);
+    } else if constexpr (width == 32) {
+      return __musa_shfl_down_sync_i32(var, delta & 0x1f, MASK_SHFL_32);
+    } else if constexpr (width == 16) {
+      return __musa_shfl_down_sync_i32(var, delta & 0xf, MASK_SHFL_16);
+    } else if constexpr (width == 8) {
+      return __musa_shfl_down_sync_i32(var, delta & 0x7, MASK_SHFL_8);
+    } else if constexpr (width == 4) {
+      return __musa_shfl_down_sync_i32(var, delta & 0x3, MASK_SHFL_4);
+    } else if constexpr (width == 2) {
+      return __musa_shfl_down_sync_i32(var, delta & 0x1, MASK_SHFL_2);
+    }
+  };
+
+  if constexpr (sizeof(T) == 4) {
+    int var = *(reinterpret_cast<int32_t *>(&val));
+    int ret = shfl_func(var);
+    return *(reinterpret_cast<T *>(&ret));
+  } else {
+    struct __Bits {
+      int __a, __b;
+    };
+    __Bits __tmp;
+    memcpy(&__tmp, &val, sizeof(val));
+    __tmp.__a = shfl_func(__tmp.__a);
+    __tmp.__b = shfl_func(__tmp.__b);
+    int64_t ret = *(reinterpret_cast<int64_t *>(&__tmp));
+    return *(reinterpret_cast<T *>(&ret));
+  }
+#else
+  return 0;
+#endif
+}
+
+template <typename T, int width>
+__device__ __forceinline__ T mudnn_shfl_xor_sync(T val, int lane_mask) {
+#if (defined(__MUSA_ARCH__) && (__MUSA_ARCH__ > 220)) // MUSIFY_EXCL_LINE
+  return __shfl_xor_sync(0xffffffff, val, lane_mask, width);
+#elif (defined(__MUSA_ARCH__) && (__MUSA_ARCH__ > 210)) // MUSIFY_EXCL_LINE
+  static_assert((width >= 2) && (width <= 128) && ((width & (width - 1)) == 0));
+
+  auto shfl_func = [&](int &var) {
+    if constexpr (width == 128) {
+      return __musa_shfl_xor_sync_i32(var, lane_mask & 0x7f, MASK_SHFL_128);
+    } else if constexpr (width == 64) {
+      return __musa_shfl_xor_sync_i32(var, lane_mask & 0x3f, MASK_SHFL_64);
+    } else if constexpr (width == 32) {
+      return __musa_shfl_xor_sync_i32(var, lane_mask & 0x1f, MASK_SHFL_32);
+    } else if constexpr (width == 16) {
+      return __musa_shfl_xor_sync_i32(var, lane_mask & 0xf, MASK_SHFL_16);
+    } else if constexpr (width == 8) {
+      return __musa_shfl_xor_sync_i32(var, lane_mask & 0x7, MASK_SHFL_8);
+    } else if constexpr (width == 4) {
+      return __musa_shfl_xor_sync_i32(var, lane_mask & 0x3, MASK_SHFL_4);
+    } else if constexpr (width == 2) {
+      return __musa_shfl_xor_sync_i32(var, lane_mask & 0x1, MASK_SHFL_2);
+    }
+  };
+
+  if constexpr (sizeof(T) == 4) {
+    int var = *(reinterpret_cast<int32_t *>(&val));
+    int ret = shfl_func(var);
+    return *(reinterpret_cast<T *>(&ret));
+  } else {
+    struct __Bits {
+      int __a, __b;
+    };
+    __Bits __tmp;
+    memcpy(&__tmp, &val, sizeof(val));
+    __tmp.__a = shfl_func(__tmp.__a);
+    __tmp.__b = shfl_func(__tmp.__b);
+    int64_t ret = *(reinterpret_cast<int64_t *>(&__tmp));
+    return *(reinterpret_cast<T *>(&ret));
+  }
+#else
+  return 0;
+#endif
+}
+
+template <typename T, int width>
+__device__ __forceinline__ T mudnn_shfl_up_sync(T val, unsigned int delta) {
+#if (defined(__MUSA_ARCH__) && (__MUSA_ARCH__ > 220)) // MUSIFY_EXCL_LINE
+  return __shfl_up_sync(0xffffffff, val, delta, width);
+#elif (defined(__MUSA_ARCH__) && (__MUSA_ARCH__ > 210)) // MUSIFY_EXCL_LINE
+  static_assert((width >= 2) && (width <= 128) && ((width & (width - 1)) == 0));
+
+  auto shfl_func = [&](int &var) {
+    if constexpr (width == 128) {
+      return __musa_shfl_up_sync_i32(var, delta & 0x7f, MASK_SHFL_UP_128);
+    } else if constexpr (width == 64) {
+      return __musa_shfl_up_sync_i32(var, delta & 0x3f, MASK_SHFL_UP_64);
+    } else if constexpr (width == 32) {
+      return __musa_shfl_up_sync_i32(var, delta & 0x1f, MASK_SHFL_UP_32);
+    } else if constexpr (width == 16) {
+      return __musa_shfl_up_sync_i32(var, delta & 0xf, MASK_SHFL_UP_16);
+    } else if constexpr (width == 8) {
+      return __musa_shfl_up_sync_i32(var, delta & 0x7, MASK_SHFL_UP_8);
+    } else if constexpr (width == 4) {
+      return __musa_shfl_up_sync_i32(var, delta & 0x3, MASK_SHFL_UP_4);
+    } else if constexpr (width == 2) {
+      return __musa_shfl_up_sync_i32(var, delta & 0x1, MASK_SHFL_UP_2);
+    }
+  };
+
+  if constexpr (sizeof(T) == 4) {
+    int var = *(reinterpret_cast<int32_t *>(&val));
+    int ret = shfl_func(var);
+    return *(reinterpret_cast<T *>(&ret));
+  } else {
+    struct __Bits {
+      int __a, __b;
+    };
+    __Bits __tmp;
+    memcpy(&__tmp, &val, sizeof(val));
+    __tmp.__a = shfl_func(__tmp.__a);
+    __tmp.__b = shfl_func(__tmp.__b);
+    int64_t ret = *(reinterpret_cast<int64_t *>(&__tmp));
+    return *(reinterpret_cast<T *>(&ret));
+  }
+#else
+  return 0;
+#endif
+}
+
+#undef MASK_SHFL_128
+#undef MASK_SHFL_64
+#undef MASK_SHFL_32
+#undef MASK_SHFL_16
+#undef MASK_SHFL_8
+#undef MASK_SHFL_4
+#undef MASK_SHFL_2
+
+#undef MASK_SHFL_UP_128
+#undef MASK_SHFL_UP_64
+#undef MASK_SHFL_UP_32
+#undef MASK_SHFL_UP_16
+#undef MASK_SHFL_UP_8
+#undef MASK_SHFL_UP_4
+#undef MASK_SHFL_UP_2
+
+} // namespace vllm_musa
diff --git a/vllm_musa/csrc/rmsnorm_cast/update_helper.muh b/vllm_musa/csrc/rmsnorm_cast/update_helper.muh
new file mode 100644
index 000000000..8b9bf090a
--- /dev/null
+++ b/vllm_musa/csrc/rmsnorm_cast/update_helper.muh
@@ -0,0 +1,230 @@
+
+#pragma once
+
+#include "dtype.muh"
+#include "math.muh"
+#include "shuffle.muh"
+#include <stdint.h>
+
+#if defined(__MUSA_ARCH__) && __MUSA_ARCH__ <= 220 // MUSIFY_EXCL_LINE
+#define WARP_THREAD 128
+#else
+#define WARP_THREAD 32
+#endif
+
+#if defined(__MUSA_ARCH__) && __MUSA_ARCH__ == 310 // MUSIFY_EXCL_LINE
+#define __SYNCTHREADS_LM __syncthreads_lm()
+#else
+#define __SYNCTHREADS_LM __syncthreads()
+#endif
+
+namespace vllm_musa {
+#define DEVICE_INLINE __device__ __forceinline__
+
+enum class VarUpdateMode { WELFORD, WELFORD_ONLY_MEAN, CHAN, CHAN_ONLY_MEAN };
+
+template <typename T, VarUpdateMode Mode> struct VarUpdate;
+
+template <typename T> struct VarUpdate<T, VarUpdateMode::WELFORD> {
+  DEVICE_INLINE void apply(T curr, T *mu, T *m2, T *cnt) {
+    *cnt += 1;
+    T delta = curr - *mu;
+    *mu += fast_divf(delta, *cnt);
+    T delta2 = curr - *mu;
+    *m2 += delta * delta2;
+  }
+};
+
+template <typename T> struct VarUpdate<T, VarUpdateMode::WELFORD_ONLY_MEAN> {
+  DEVICE_INLINE void apply(T curr, T *mu, T *cnt) {
+    *cnt += 1;
+    T delta = curr - *mu;
+    *mu += fast_divf(delta, *cnt);
+  }
+};
+
+template <typename T> struct VarUpdate<T, VarUpdateMode::CHAN> {
+  DEVICE_INLINE void apply(T mu_B, T m2_B, T cnt_B, T *mu, T *m2, T *cnt) {
+    if (cnt_B > 0) {
+      T n_AB = cnt_B + (*cnt);
+      T delta = mu_B - (*mu);
+      *mu += delta * fast_divf(cnt_B, n_AB);
+      *m2 += m2_B + fast_divf(delta * delta * cnt_B * (*cnt), n_AB);
+      *cnt = n_AB;
+    }
+  }
+};
+
+template <typename T> struct VarUpdate<T, VarUpdateMode::CHAN_ONLY_MEAN> {
+  DEVICE_INLINE void apply(T mu_B, T cnt_B, T *mu, T *cnt) {
+    if (cnt_B > 0) {
+      T n_AB = cnt_B + (*cnt);
+      T delta = mu_B - (*mu);
+      *mu += delta * fast_divf(cnt_B, n_AB);
+      *cnt = n_AB;
+    }
+  }
+};
+
+enum class ReduceMode { WELFORD, WELFORD_ONLY_MEAN, SUM, MAX };
+enum class ReduceAxis { COLUMN, ABC };
+
+template <typename ComputeType, int BLOCK_X, int BLOCK_Y, ReduceMode Mode,
+          ReduceAxis Axis, int Vlen = 1>
+struct AllReduceOp;
+
+#if (defined(__MUSA_ARCH__) && (__MUSA_ARCH__ >= 220)) // >=QY2
+#define SMEM_STOP (WARP_THREAD / 2)
+#define SHFL_START min(WARP_THREAD / 2, BLOCK_X / 2)
+#else // <= QY1
+#define SMEM_STOP 0
+#define SHFL_START 0
+#endif
+
+template <typename ComputeType, int BLOCK_X, int BLOCK_Y, ReduceAxis Axis,
+          int Vlen>
+struct AllReduceOp<ComputeType, BLOCK_X, BLOCK_Y, ReduceMode::WELFORD, Axis,
+                   Vlen> {
+  DEVICE_INLINE void apply(ComputeType *mu, ComputeType *m2, ComputeType *cnt,
+                           int tx, int ty) {
+    __shared__ ComputeType __attribute__((aligned(16)))
+    smem[BLOCK_X * BLOCK_Y * 3];
+    ComputeType *smem_mu = &smem[0];
+    ComputeType *smem_m2 = &smem[BLOCK_X * BLOCK_Y];
+    ComputeType *smem_cnt = &smem[BLOCK_X * BLOCK_Y * 2];
+
+    VarUpdate<ComputeType, VarUpdateMode::CHAN> chan_op;
+
+    if constexpr (Axis == ReduceAxis::COLUMN) {
+      ComputeType mu_B;
+      ComputeType m2_B;
+      ComputeType cnt_B;
+#pragma unroll
+      for (int offset = BLOCK_X / 2; offset > SMEM_STOP; offset /= 2) {
+        if ((tx < offset * 2) && (tx >= offset)) {
+          smem_mu[ty * BLOCK_X + tx] = *mu;
+          smem_m2[ty * BLOCK_X + tx] = *m2;
+          smem_cnt[ty * BLOCK_X + tx] = *cnt;
+        }
+        __SYNCTHREADS_LM;
+        if (tx < offset) {
+          mu_B = smem_mu[ty * BLOCK_X + tx + offset];
+          m2_B = smem_m2[ty * BLOCK_X + tx + offset];
+          cnt_B = smem_cnt[ty * BLOCK_X + tx + offset];
+          chan_op.apply(mu_B, m2_B, cnt_B, mu, m2, cnt);
+        }
+      }
+#if ((defined __MUSA_ARCH__) && (__MUSA_ARCH__ >= 220))
+#pragma unroll
+      for (int offset = SHFL_START; offset > 0; offset /= 2) {
+        mu_B = mudnn_shfl_down_sync<ComputeType, WARP_THREAD>(*mu, offset);
+        m2_B = mudnn_shfl_down_sync<ComputeType, WARP_THREAD>(*m2, offset);
+        cnt_B = mudnn_shfl_down_sync<ComputeType, WARP_THREAD>(*cnt, offset);
+        chan_op.apply(mu_B, m2_B, cnt_B, mu, m2, cnt);
+      }
+#endif
+      if (tx == 0) {
+        smem_mu[ty * BLOCK_X + tx] = *mu;
+        smem_m2[ty * BLOCK_X + tx] = *m2;
+        smem_cnt[ty * BLOCK_X + tx] = *cnt;
+      }
+      __SYNCTHREADS_LM;
+      *mu = smem_mu[ty * BLOCK_X];
+      *m2 = smem_m2[ty * BLOCK_X];
+      *cnt = smem_cnt[ty * BLOCK_X];
+    } else {
+      smem_mu[ty * BLOCK_X + tx] = *mu;
+      smem_m2[ty * BLOCK_X + tx] = *m2;
+      smem_cnt[ty * BLOCK_X + tx] = *cnt;
+      __SYNCTHREADS_LM;
+
+#pragma unroll
+      for (int offset = BLOCK_Y / 2; offset > 0; offset /= 2) {
+        if (ty < offset) {
+          ComputeType mu_B = smem_mu[(ty + offset) * BLOCK_X + tx];
+          ComputeType m2_B = smem_m2[(ty + offset) * BLOCK_X + tx];
+          ComputeType cnt_B = smem_cnt[(ty + offset) * BLOCK_X + tx];
+          chan_op.apply(mu_B, m2_B, cnt_B, mu, m2, cnt);
+          smem_mu[ty * BLOCK_X + tx] = *mu;
+          smem_m2[ty * BLOCK_X + tx] = *m2;
+          smem_cnt[ty * BLOCK_X + tx] = *cnt;
+        }
+        __SYNCTHREADS_LM;
+      }
+
+      *mu = smem_mu[tx];
+      *m2 = smem_m2[tx];
+      *cnt = smem_cnt[tx];
+    }
+  }
+};
+
+template <typename ComputeType, int BLOCK_X, int BLOCK_Y, ReduceAxis Axis,
+          int Vlen>
+struct AllReduceOp<ComputeType, BLOCK_X, BLOCK_Y, ReduceMode::WELFORD_ONLY_MEAN,
+                   Axis, Vlen> {
+  DEVICE_INLINE void apply(ComputeType *mu, ComputeType *cnt, int tx, int ty) {
+    __shared__ ComputeType __attribute__((aligned(16)))
+    smem[BLOCK_X * BLOCK_Y * 2];
+    ComputeType *smem_mu = &smem[0];
+    ComputeType *smem_cnt = &smem[BLOCK_X * BLOCK_Y];
+
+    VarUpdate<ComputeType, VarUpdateMode::CHAN_ONLY_MEAN> chan_op;
+
+    if constexpr (Axis == ReduceAxis::COLUMN) {
+      ComputeType mu_B;
+      ComputeType cnt_B;
+#pragma unroll
+      for (int offset = BLOCK_X / 2; offset > SMEM_STOP; offset /= 2) {
+        if ((tx < offset * 2) && (tx >= offset)) {
+          smem_mu[ty * BLOCK_X + tx] = *mu;
+          smem_cnt[ty * BLOCK_X + tx] = *cnt;
+        }
+        __SYNCTHREADS_LM;
+        if (tx < offset) {
+          mu_B = smem_mu[ty * BLOCK_X + tx + offset];
+          cnt_B = smem_cnt[ty * BLOCK_X + tx + offset];
+          chan_op.apply(mu_B, cnt_B, mu, cnt);
+        }
+      }
+#if ((defined __MUSA_ARCH__) && (__MUSA_ARCH__ >= 220))
+#pragma unroll
+      for (int offset = SHFL_START; offset > 0; offset /= 2) {
+        mu_B = mudnn_shfl_down_sync<ComputeType, WARP_THREAD>(*mu, offset);
+        cnt_B = mudnn_shfl_down_sync<ComputeType, WARP_THREAD>(*cnt, offset);
+        chan_op.apply(mu_B, cnt_B, mu, cnt);
+      }
+#endif
+      if (tx == 0) {
+        smem_mu[ty * BLOCK_X + tx] = *mu;
+        smem_cnt[ty * BLOCK_X + tx] = *cnt;
+      }
+      __SYNCTHREADS_LM;
+      *mu = smem_mu[ty * BLOCK_X];
+      *cnt = smem_cnt[ty * BLOCK_X];
+    } else {
+      smem_mu[ty * BLOCK_X + tx] = *mu;
+      smem_cnt[ty * BLOCK_X + tx] = *cnt;
+      __SYNCTHREADS_LM;
+
+#pragma unroll
+      for (int offset = BLOCK_Y / 2; offset > 0; offset /= 2) {
+        if (ty < offset) {
+          ComputeType mu_B = smem_mu[(ty + offset) * BLOCK_X + tx];
+          ComputeType cnt_B = smem_cnt[(ty + offset) * BLOCK_X + tx];
+          chan_op.apply(mu_B, cnt_B, mu, cnt);
+          smem_mu[ty * BLOCK_X + tx] = *mu;
+          smem_cnt[ty * BLOCK_X + tx] = *cnt;
+        }
+        __SYNCTHREADS_LM;
+      }
+
+      *mu = smem_mu[tx];
+      *cnt = smem_cnt[tx];
+    }
+  }
+};
+
+#undef SMEM_STOP
+#undef SHFL_START
+} // namespace vllm_musa
diff --git a/vllm_musa/csrc/type_convert.muh b/vllm_musa/csrc/type_convert.muh
new file mode 100644
index 000000000..aa71c3565
--- /dev/null
+++ b/vllm_musa/csrc/type_convert.muh
@@ -0,0 +1,148 @@
+#pragma once
+
+#include <torch/all.h>
+
+#include "musa.h"
+
+namespace vllm_musa {
+/* Converter structs for the conversion from torch types to HIP/CUDA types,
+   and the associated type conversions within HIP/CUDA. These helpers need
+   to be implemented for now because the relevant type conversion
+   operators/constructors are not consistently implemented by HIP/CUDA, so
+   a generic conversion via type casts cannot be implemented.
+
+   Each struct should have the member static constexpr bool `exists`:
+   If false, the optimized kernel is not used for the corresponding torch type.
+   If true, the struct should be fully defined as shown in the examples below.
+ */
+template <typename torch_type>
+struct _typeConvert {
+  static constexpr bool exists = false;
+};
+
+template <>
+struct _typeConvert<c10::Half> {
+  static constexpr bool exists = true;
+  using hip_type = __half;
+  using packed_hip_type = __half2;
+
+  __device__ static inline float convert(hip_type x) { return __half2float(x); }
+  __device__ static inline float2 convert(packed_hip_type x) {
+    return __half22float2(x);
+  }
+  __device__ static inline hip_type convert(float x) {
+    return __float2half_rn(x);
+  }
+  __device__ static inline packed_hip_type convert(float2 x) {
+    return __float22half2_rn(x);
+  }
+};
+
+template <>
+struct _typeConvert<c10::BFloat16> {
+  static constexpr bool exists = true;
+  using hip_type = __nv_bfloat16;
+  using packed_hip_type = __nv_bfloat162;
+
+  __device__ static inline float convert(hip_type x) {
+    return __bfloat162float(x);
+  }
+  __device__ static inline float2 convert(packed_hip_type x) {
+    return __bfloat1622float2(x);
+  }
+  __device__ static inline hip_type convert(float x) {
+    return __float2bfloat16(x);
+  }
+  __device__ static inline packed_hip_type convert(float2 x) {
+    return __float22bfloat162_rn(x);
+  }
+};
+
+/* Vector POD struct to generate vectorized and packed FP16/BF16 ops
+   for appropriate specializations of fused_add_rms_norm_kernel.
+   Only functions that are necessary in that kernel are implemented.
+   Alignment to 16 bytes is required to use 128-bit global memory ops.
+ */
+template <typename scalar_t, int width>
+struct alignas(16) _f16Vec {
+  /* Not theoretically necessary that width is a power of 2 but should
+     almost always be the case for optimization purposes */
+  static_assert(width > 0 && (width & (width - 1)) == 0,
+                "Width is not a positive power of 2!");
+  using Converter = _typeConvert<scalar_t>;
+  using T1 = typename Converter::hip_type;
+  using T2 = typename Converter::packed_hip_type;
+  T1 data[width];
+
+  __device__ _f16Vec& operator+=(const _f16Vec<scalar_t, width>& other) {
+    if constexpr (width % 2 == 0) {
+#pragma unroll
+      for (int i = 0; i < width; i += 2) {
+        T2 temp{data[i], data[i + 1]};
+        temp += T2{other.data[i], other.data[i + 1]};
+        data[i] = temp.x;
+        data[i + 1] = temp.y;
+      }
+    } else {
+#pragma unroll
+      for (int i = 0; i < width; ++i) data[i] += other.data[i];
+    }
+    return *this;
+  }
+
+  __device__ _f16Vec& operator*=(const _f16Vec<scalar_t, width>& other) {
+    if constexpr (width % 2 == 0) {
+#pragma unroll
+      for (int i = 0; i < width; i += 2) {
+        T2 temp{data[i], data[i + 1]};
+        temp *= T2{other.data[i], other.data[i + 1]};
+        data[i] = temp.x;
+        data[i + 1] = temp.y;
+      }
+    } else {
+#pragma unroll
+      for (int i = 0; i < width; ++i) data[i] *= other.data[i];
+    }
+    return *this;
+  }
+
+  __device__ _f16Vec& operator*=(const float scale) {
+    if constexpr (width % 2 == 0) {
+#pragma unroll
+      for (int i = 0; i < width; i += 2) {
+        float2 temp_f = Converter::convert(T2{data[i], data[i + 1]});
+        temp_f.x *= scale;
+        temp_f.y *= scale;
+        T2 temp = Converter::convert(temp_f);
+        data[i] = temp.x;
+        data[i + 1] = temp.y;
+      }
+    } else {
+#pragma unroll
+      for (int i = 0; i < width; ++i) {
+        float temp = Converter::convert(data[i]) * scale;
+        data[i] = Converter::convert(temp);
+      }
+    }
+    return *this;
+  }
+
+  __device__ float sum_squares() const {
+    float result = 0.0f;
+    if constexpr (width % 2 == 0) {
+#pragma unroll
+      for (int i = 0; i < width; i += 2) {
+        float2 z = Converter::convert(T2{data[i], data[i + 1]});
+        result += z.x * z.x + z.y * z.y;
+      }
+    } else {
+#pragma unroll
+      for (int i = 0; i < width; ++i) {
+        float x = Converter::convert(data[i]);
+        result += x * x;
+      }
+    }
+    return result;
+  }
+};
+}  // namespace vllm_musa
