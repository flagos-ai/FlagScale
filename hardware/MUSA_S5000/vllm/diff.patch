+template<int VLEN>
+class Block {
+public:
+  const int threads;
+  const int bm;
+  const int bk;
+
+  static constexpr float base_score = 1.f;
+  static constexpr float epilog_loss_ratio = 0.5;
+
+  Block() = delete;
+  Block(int _threads, int _bm, int _bk)
+      : threads(_threads), bm(_bm), bk(_bk){
+        assert(bk * (bm / VLEN) * 2 <= 1024);
+      }
+  std::string name() const {
+    return std::to_string(threads) + "_" + std::to_string(bm) + "_" + std::to_string(bk);
+  }
+  float estimate(const int batch, const int m, const int k,
+                 const int nr_mp) const {
+
+    int m_tile = ceil_div(m, bm);
+    // int k_tile = ceil_div(k, bk);
+    int wave = ceil_div(batch * m_tile, nr_mp);
+    float wave_ratio = (float)batch * m  / ((float)bm * wave * nr_mp);
+    // float epilog_loss = (float)bk / max(k, bk) * epilog_loss_ratio;
+    // float epilog_ratio = 1.f - epilog_loss;
+    float epilog_ratio = 1.f;
+    float normal_score = base_score * wave_ratio * epilog_ratio;
+    return normal_score;
+  }
+};
+
+static std::vector<Block<4>> block_list_vlen4;
+static std::once_flag block_list_init_flag;
