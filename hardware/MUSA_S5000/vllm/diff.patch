+
+#include <mutlass/mutlass.h>
+#include <mutlass/gemm/gemm.h>
+#include <mutlass/gemm/collective/collective_builder.hpp>
+
+#include "mutlass_extension.hpp"
+
+// using namespace mute;
+
+template <
+  class ElementQ,
+  class ElementKV,
+  class SmemLayoutQ,
+  class SmemLayoutK,
+  class SmemLayoutV,
+  class SmemLayoutP
+>
+struct SharedStorage {
+  mute::array_aligned<ElementQ,  mute::cosize_v<SmemLayoutQ>> smem_q;
+  mute::array_aligned<ElementKV, mute::cosize_v<SmemLayoutK>> smem_k;
+  mute::array_aligned<ElementKV, mute::cosize_v<SmemLayoutV>> smem_v;
+  mute::array_aligned<ElementKV, mute::cosize_v<SmemLayoutP>> smem_p;
+};
+
+
+template <
+  class ElementQ,
+  class ElementKV,
+  class SmemLayoutQ,
+  class SmemLayoutK,
+  class SmemLayoutV,
+  class SmemLayoutP
+>
+struct SharedStorageReuseQ {
+  union {
+    mute::array_aligned<ElementQ,  mute::cosize_v<SmemLayoutQ>> smem_q;
+    struct {
+      mute::array_aligned<ElementKV, mute::cosize_v<SmemLayoutK>> smem_k;
+      mute::array_aligned<ElementKV, mute::cosize_v<SmemLayoutV>> smem_v;
+      mute::array_aligned<ElementKV, mute::cosize_v<SmemLayoutP>> smem_p;
+    };
+  };
+};
+
+
+template <class TileN, class PermuteTileShape = TileN>
+constexpr auto
+get_permute_tile_for_operand_B() {
+  using MmaAtomN = mute::_16;
+  static_assert(TileN{} % PermuteTileShape{} == 0);
+  static_assert(PermuteTileShape{} % MmaAtomN{} == 0);
+
+  using RepeatInsidePermuteTile = decltype(PermuteTileShape{} / MmaAtomN{});
+  using RepeatAcrossPermuteTile = decltype(TileN{} / PermuteTileShape{});
+
+  using PermuteTileN = mute::Layout<mute::Shape <               MmaAtomN, RepeatInsidePermuteTile, RepeatAcrossPermuteTile>,
+                              mute::Stride<RepeatInsidePermuteTile,                      mute::_1,        PermuteTileShape>>;
+
+  return PermuteTileN{};
+}
+
+template <
+  int HEAD_DIM_QK_,
+  int HEAD_DIM_VO_,
+  int CTA_Q_,
+  int CTA_KV_,
+  bool IsVarlen_,
+  bool IsQInReg_,
+  bool UseRobustLoadQ_,
+  bool UseRobustLoadK_,
+  bool UseRobustLoadV_,
+  class ElementQ_,
+  bool ReturnL_,
+  class ElementKV_ = ElementQ_,
+  class IdType_ = int32_t
+>
+struct AttentionForwardKernelTraits {
+  using ElementQ  = ElementQ_;
+  using ElementL  = ElementQ_;
+  using ElementKV = ElementKV_;
+  static constexpr bool ReturnL = ReturnL_;
+  using ElementAccumulator = float;
+
+  static constexpr int CTA_Q       = CTA_Q_;
+  static constexpr int CTA_KV      = CTA_KV_;
+  static constexpr int HEAD_DIM_QK = HEAD_DIM_QK_;
+  static constexpr int HEAD_DIM_VO = HEAD_DIM_VO_;
+  static constexpr bool IsVarlen = IsVarlen_;
+  static constexpr bool IsQInReg = IsQInReg_;
+  static constexpr bool ReuseSmemQ = IsQInReg;
+  static constexpr bool UseRobustLoadQ = UseRobustLoadQ_;
+  static constexpr bool UseRobustLoadK = UseRobustLoadK_;
+  static constexpr bool UseRobustLoadV = UseRobustLoadV_;
+
+  // TODO: now only pack T0V0/TV01, try to pack more regs
+  static constexpr int FragmentSize = 2;
+
+  using TileShape_QKD = mute::Shape<mute::Int<CTA_Q>, mute::Int<CTA_KV>, mute::Int<HEAD_DIM_QK>>;
+  using TileShape_PDV = mute::Shape<mute::Int<CTA_Q>, mute::Int<HEAD_DIM_VO>, mute::Int<CTA_KV>>;
+
+  // We extend in M-dim to avoid smem reduce
+  using AtomLayoutMNK = mute::Layout<mute::Shape<mute::Int<CTA_Q/32>, mute::_1, mute::_1>>;
+
+  // Internal Mma Stride type
+  using MmaStrideMNMajor = mute::Stride<mute::_1, int>;
+  using MmaStrideKMajor  = mute::Stride<int, mute::_1>;
+
+  using PermutedTileN = decltype(get_permute_tile_for_operand_B<mute::Int<CTA_KV>, mute::Int<32>>());
+  using PermuteLayoutMNK = mute::Tile<mute::Underscore, PermutedTileN, mute::Underscore>;
+
+  using TiledMmaQK = decltype(mute::make_tiled_mma(
+    mutlass::gemm::collective::detail::mp22_mma_operation_select<
+                                        ElementQ, MmaStrideKMajor,
+                                        ElementKV,MmaStrideKMajor>(),
+    AtomLayoutMNK{},
+    PermuteLayoutMNK{}));
+
+  using TiledMmaPV =decltype(mute::make_tiled_mma(
+    mutlass::gemm::collective::detail::mp22_mma_operation_select<
+                                        ElementKV, MmaStrideKMajor,
+                                        ElementKV, MmaStrideMNMajor>(),
+    AtomLayoutMNK{}));
+
+  static constexpr int NumThreads = size(TiledMmaQK{});
+  static_assert(size(TiledMmaQK{}) == size(TiledMmaPV{}));
+
+  using SmemLayoutAtomQ = decltype(
+    mutlass::gemm::collective::detail::make_mp22_smem_atom_layout<ElementQ,  MmaStrideKMajor>());
+  using SmemLayoutQ = decltype(tile_to_shape(SmemLayoutAtomQ{}, mute::select<0,2>(TileShape_QKD{})));
+
+  using SmemLayoutAtomK = decltype(
+    mutlass::gemm::collective::detail::make_mp22_smem_atom_layout<ElementKV, MmaStrideKMajor>());
+  using SmemLayoutK = decltype(tile_to_shape(SmemLayoutAtomK{}, mute::select<1,2>(TileShape_QKD{})));
+
+  using SmemLayoutAtomP = decltype(
+    mutlass::gemm::collective::detail::make_mp22_smem_atom_layout<ElementKV, MmaStrideKMajor>());
+  using SmemLayoutP = decltype(tile_to_shape(SmemLayoutAtomP{}, mute::select<0,1>(TileShape_QKD{})));
+
+  using SmemLayoutAtomV = decltype(
+    mutlass::gemm::collective::detail::make_mp22_smem_atom_layout<ElementKV, MmaStrideKMajor>());
+  using SmemLayoutV  = decltype(tile_to_shape(SmemLayoutAtomV{}, mute::select<2,1>(TileShape_PDV{})));
+  using SmemLayoutVt = decltype(composition(SmemLayoutV{},
+                        make_layout(mute::select<1,2>(TileShape_PDV{}), mute::LayoutRight{})));
+
+  using SmemCopyAtomQ = mute::Copy_Atom<mute::DefaultCopy, ElementQ>;
+  using SmemCopyAtomK = mute::Copy_Atom<mute::DefaultCopy, ElementKV>;
+  using SmemCopyAtomP = mute::Copy_Atom<mute::DefaultCopy, ElementKV>;
+  using SmemCopyAtomV = mute::Copy_Atom<mute::DefaultCopy, ElementKV>;
+
+  using R2SCopyAtomP  = mute::Copy_Atom<mute::UniversalCopy<mute::uint_byte_t<FragmentSize * sizeof(ElementKV)>>, ElementKV>;
+
+  // TileCopy
+  static constexpr int AlignmentQ = 128 / mute::sizeof_bits_v<ElementQ>;
+  static constexpr int ThreadsMajorQ = mute::gcd(HEAD_DIM_QK / AlignmentQ, NumThreads);
+  static constexpr int ThreadsMinorQ = NumThreads / ThreadsMajorQ;
+  using GmemCopyQThrLayout = mute::Layout<mute::Shape <mute::Int<ThreadsMinorQ>, mute::Int<ThreadsMajorQ>>,
+                                    mute::Stride<mute::Int<ThreadsMajorQ>,                mute::_1>>;
+  using GmemCopyQValLayout = mute::Layout<mute::Shape<mute::_1, mute::Int<AlignmentQ>>>;
+  using GmemCopyOpQ = mute::conditional_t<UseRobustLoadQ,
+            mute::MP22_ROBUST_LOAD<mute::uint_bit_t<AlignmentQ * mute::sizeof_bits_v<ElementQ>>>,
+            mute::UniversalCopy<mute::uint_bit_t<AlignmentQ * mute::sizeof_bits_v<ElementQ>>>>;
+
+  using GmemTiledCopyQ = decltype(make_tiled_copy(
+                            mute::Copy_Atom<GmemCopyOpQ, ElementQ>{},
+                            GmemCopyQThrLayout{}, GmemCopyQValLayout{}));
+
+  static constexpr int AlignmentK = 128 / mute::sizeof_bits_v<ElementKV>;
+  static constexpr int ThreadsMajorK = mute::gcd(HEAD_DIM_QK / AlignmentK, NumThreads);
+  static constexpr int ThreadsMinorK = NumThreads / ThreadsMajorK;
+  using GmemCopyKThrLayout = mute::Layout<mute::Shape <mute::Int<ThreadsMinorK>, mute::Int<ThreadsMajorK>>,
+                                    mute::Stride<mute::Int<ThreadsMajorK>,                mute::_1>>;
+  using GmemCopyKValLayout = mute::Layout<mute::Shape<mute::_1, mute::Int<AlignmentK>>>;
+  using GmemCopyOpK = mute::conditional_t<UseRobustLoadK,
+            mute::MP22_ROBUST_LOAD<mute::uint_bit_t<AlignmentK * mute::sizeof_bits_v<ElementKV>>>,
+            mute::UniversalCopy<mute::uint_bit_t<AlignmentK * mute::sizeof_bits_v<ElementKV>>>>;
+
+
+  using GmemTiledCopyK = decltype(make_tiled_copy(
+                            mute::Copy_Atom<GmemCopyOpK, ElementKV>{},
+                            GmemCopyKThrLayout{}, GmemCopyKValLayout{}));
+
+  static constexpr int AlignmentV = 128 / mute::sizeof_bits_v<ElementKV>;
+  static constexpr int ThreadsMajorV = mute::gcd(HEAD_DIM_VO / AlignmentV, NumThreads);
+  static constexpr int ThreadsMinorV = NumThreads / ThreadsMajorV;
+  using GmemCopyVThrLayout = mute::Layout<mute::Shape <mute::Int<ThreadsMinorV>, mute::Int<ThreadsMajorV>>,
+                                    mute::Stride<mute::Int<ThreadsMajorV>,                mute::_1>>;
+  using GmemCopyVValLayout = mute::Layout<mute::Shape<mute::_1, mute::Int<AlignmentV>>>;
+  using GmemCopyOpV = mute::conditional_t<UseRobustLoadV,
+            mute::MP22_ROBUST_LOAD<mute::uint_bit_t<AlignmentV * mute::sizeof_bits_v<ElementKV>>>,
+            mute::UniversalCopy<mute::uint_bit_t<AlignmentV * mute::sizeof_bits_v<ElementKV>>>>;
+
+  using GmemTiledCopyV = decltype(make_tiled_copy(
+                            mute::Copy_Atom<GmemCopyOpV, ElementKV>{},
+                            GmemCopyVThrLayout{}, GmemCopyVValLayout{}));
+
+  using SharedStorage = mute::conditional_t<ReuseSmemQ,
+      SharedStorageReuseQ<ElementQ, ElementKV, SmemLayoutQ, SmemLayoutK, SmemLayoutV, SmemLayoutP>,
+      SharedStorage<ElementQ, ElementKV, SmemLayoutQ, SmemLayoutK, SmemLayoutV, SmemLayoutP>>;
+};
diff --git a/vllm_musa/csrc/flash_attn/impl/mutlass_extension.hpp b/vllm_musa/csrc/flash_attn/impl/mutlass_extension.hpp
new file mode 100644
index 000000000..cd2a22689
--- /dev/null
+++ b/vllm_musa/csrc/flash_attn/impl/mutlass_extension.hpp
@@ -0,0 +1,191 @@
+#pragma once
+
+#if defined(__MUSA_ARCH__) && (__MUSA_ARCH__ == 220)
+#define MUTE_MP22_ROBUST_EXT
+#endif
+
+#include <mute/config.hpp>
+#include <mute/atom/copy_atom.hpp>
+#include <mute/arch/copy_mp31_desc.hpp> // RobustDescriptor
+
+namespace mute {
+
+//
+// Robust LD
+//
+template <class TS, class TD = TS>
+struct MP22_ROBUST_LOAD
+{
+  using SRegisters = TS[1];
+  using DRegisters = TD[1];
+
+  static_assert(sizeof(TS) == sizeof(TD),
+                "MP22_ROBUST_LOAD requires sizeof(src_value_type) == sizeof(dst_value_type)");
+
+  MUTE_HOST_DEVICE static void
+  copy(TS               const& gmem_src,
+       TD                    & rmem_dst,
+       bool                    pred,
+       RobustDescriptor const& src_desc)
+
+  {
+#if defined(MUTE_MP22_ROBUST_EXT)
+    void const* gmem_ptr = pred ? reinterpret_cast<void const*>(&gmem_src)
+                         : reinterpret_cast<void const*>(src_desc.oob_addr);
+    // meet the intrinsic requirement
+    using RobustRegV3 = uint32_t __attribute__((vector_size(12)));
+    union ExtractRobustReg {
+      RobustReg reg_v4;
+      struct {
+        RobustRegV3 reg;
+        uint32_t dummy;
+      };
+    };
+
+    ExtractRobustReg desc {src_desc.reg};
+
+    if constexpr (sizeof(TS) == 1) {
+      auto val = __musa_ld_robust_i8(gmem_ptr, desc.reg);
+      rmem_dst = *reinterpret_cast<TD*>(&val);
+    } else if constexpr (sizeof(TS) == 2) {
+      auto val = __musa_ld_robust_i16(gmem_ptr, desc.reg);
+      rmem_dst = *reinterpret_cast<TD*>(&val);
+    } else if constexpr (sizeof(TS) == 4) {
+      auto val = __musa_ld_robust_i32(gmem_ptr, desc.reg);
+      rmem_dst = *reinterpret_cast<TD*>(&val);
+    } else if constexpr (sizeof(TS) == 8) {
+      auto val = __musa_ld_robust_i64(gmem_ptr, desc.reg);
+      rmem_dst = *reinterpret_cast<TD*>(&val);
+    } else if constexpr (sizeof(TS) == 16) {
+      auto val = __musa_ld_robust_v4i32(gmem_ptr, desc.reg);
+      rmem_dst = *reinterpret_cast<TD*>(&val);
+    } else if constexpr (sizeof(TS) == 32) {
+      auto val = __musa_ld_robust_v8i32(gmem_ptr, desc.reg);
+      rmem_dst = *reinterpret_cast<TD*>(&val);
+    } else if constexpr (sizeof(TS) == 64) {
+      auto val = __musa_ld_robust_v16i32(gmem_ptr, desc.reg);
+      rmem_dst = *reinterpret_cast<TD*>(&val);
+    } else if constexpr (sizeof(TS) == 128) {
+      auto val = __musa_ld_robust_v32i32(gmem_ptr, desc.reg);
+      rmem_dst = *reinterpret_cast<TD*>(&val);
+    } else {
+      static_assert(sizeof(TS) <= 128, "Currently we only support up-to 1024-bit load");
+    }
+#else
+    MUTE_INVALID_CONTROL_PATH(
+        "Trying to use MP22_ROBUST_LOAD without MUTE_ARCH_ROBUST_BUFFER_ACCESS_ACTIVATED.");
+#endif
+  }
+};
+
+
+//
+// Robust load traits
+//
+template <class S, class D>
+struct MP22_ROBUST_LOAD_OP : MP22_ROBUST_LOAD<S, D> {};
+
+template <class S, class D>
+struct MP22_ROBUST_PRED_LOAD_OP : MP22_ROBUST_LOAD<S, D> {};
+
+template <class S, class D>
+struct Copy_Traits<MP22_ROBUST_PRED_LOAD_OP<S, D>>
+{
+  // Logical thread id to thread idx (one-thread)
+  using ThrID     = Layout<_1>;
+
+  // Map from (src-thr,src-val) to bit
+  using SrcLayout = Layout<Shape<_1, Int<sizeof_bits<S>::value>>>;
+  // Map from (dst-thr,dst-val) to bit
+  using DstLayout = Layout<Shape<_1, Int<sizeof_bits<D>::value>>>;
+
+  // Reference map from (thr,val) to bit
+  using RefLayout = SrcLayout;
+
+  // Robust Buffer Access Descriptor
+  const RobustDescriptor src_desc;
+
+  // Predicate value that determines whether to load or return zero
+  bool pred;
+
+  // Overload copy_unpack to pass robust buffer access descriptor
+  template <class TS, class SLayout,
+            class TD, class DLayout>
+  MUTE_HOST_DEVICE friend constexpr
+  void
+  copy_unpack(Copy_Traits         const& traits,
+              Tensor<TS, SLayout> const& src,
+              Tensor<TD, DLayout>      & dst)
+  {
+    static_assert(is_gmem<TS>::value, "Expected gmem src for MP22_ROBUST_LOAD");
+    static_assert(is_rmem<TD>::value, "Expected rmem dst for MP22_ROBUST_LOAD");
+
+    Tensor rS = recast<S>(src);
+    Tensor rD = recast<D>(dst);
+
+    MUTE_STATIC_ASSERT_V(size(rS) == Int<1>{},
+        "This src layout is incompatible with this tiled copy.");
+    MUTE_STATIC_ASSERT_V(size(rD) == Int<1>{},
+        "This dst layout is incompatible with this tiled copy.");
+
+    MP22_ROBUST_LOAD<S, D>::copy(rS[0], rD[0], traits.pred, traits.src_desc);
+  }
+};
+
+template <class S, class D>
+struct Copy_Traits<MP22_ROBUST_LOAD_OP<S, D>>
+{
+  // Logical thread id to thread idx (one-thread)
+  using ThrID     = Layout<_1>;
+
+  // Map from (src-thr,src-val) to bit
+  using SrcLayout = Layout<Shape<_1, Int<sizeof_bits<S>::value>>>;
+  // Map from (dst-thr,dst-val) to bit
+  using DstLayout = Layout<Shape<_1, Int<sizeof_bits<D>::value>>>;
+
+  // Reference map from (thr,val) to bit
+  using RefLayout = SrcLayout;
+
+  // Robust Buffer Access Descriptor
+  const RobustDescriptor src_desc;
+
+  MUTE_HOST_DEVICE constexpr
+  Copy_Traits<MP22_ROBUST_PRED_LOAD_OP<S, D>>
+  with(bool pred) const {
+    return {src_desc, pred};
+  }
+};
+
+template <class S, class D>
+struct Copy_Traits<MP22_ROBUST_LOAD<S, D>>
+{
+  // Logical thread id to thread idx (one-thread)
+  using ThrID     = Layout<_1>;
+
+  // Map from (src-thr,src-val) to bit
+  using SrcLayout = Layout<Shape<_1, Int<sizeof_bits<S>::value>>>;
+  // Map from (dst-thr,dst-val) to bit
+  using DstLayout = Layout<Shape<_1, Int<sizeof_bits<D>::value>>>;
+
+  // Reference map from (thr,val) to bit
+  using RefLayout = SrcLayout;
+
+  // Construct an executable MP22_ROBUST_LOAD with robust buffer access descriptor
+  MUTE_HOST_DEVICE constexpr
+  Copy_Traits<MP22_ROBUST_LOAD_OP<S, D>>
+  with(RobustDescriptor desc) const {
+    return {desc};
+  }
+
+  // Don't try to execute a copy with MP22_ROBUST_LOAD before calling .with()
+  template <class TS, class SLayout,
+            class TD, class DLayout>
+  MUTE_HOST_DEVICE friend constexpr
+  void
+  copy_unpack(Copy_Traits         const& traits,
+              Tensor<TS, SLayout> const& src,
+              Tensor<TD, DLayout>      & dst) = delete;
+
+};
+
+} // namespace mute
