+#include "musa_runtime.h"
+
+#include "mutlass/trace.h"
+#endif
+
+namespace mutlass {
+
+struct KernelHardwareInfo {
+  //
+  // Data members
+  //
+  int device_id = 0;
+  int sm_count  = 0;
+
+  //
+  // Methods
+  //
+
+#if !defined(__MUSACC_RTC__)
+  static inline int
+  query_device_multiprocessor_count(int device_id = 0) {
+    musaError_t result = musaGetDevice(&device_id);
+    if (result != musaSuccess) {
+      MUTLASS_TRACE_HOST(
+        "  musaGetDevice() returned error "
+        << musaGetErrorString(result));
+      return 0;
+    }
+    int multiprocessor_count;
+    result = musaDeviceGetAttribute(&multiprocessor_count,
+      musaDevAttrMultiProcessorCount, device_id);
+    if (result != musaSuccess) {
+      MUTLASS_TRACE_HOST(
+        "  musaDeviceGetAttribute() returned error "
+        << musaGetErrorString(result));
+      return 0;
+    }
+    return multiprocessor_count;
+  }
+#endif
+};
