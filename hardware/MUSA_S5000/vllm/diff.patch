+    def _forward_prefill_flash_general(
+        self,
+        q: torch.Tensor,
+        k: torch.Tensor,
+        v: torch.Tensor,
+        cu_seqlens_q: torch.Tensor,
+        cu_seqlens_k: torch.Tensor,
+        max_seqlen_q: int,
+        max_seqlen_k: int,
+        dropout_p: float = 0.0,
+        causal: bool = True,
+        softmax_scale: float = None,
+        return_softmax_lse = False
+    ) -> torch.Tensor:
+        sum_seq, q_h, qk_d = q.shape
+        _, v_h, v_d = v.shape
+        bs = cu_seqlens_q.shape[0] - 1
+
+        max_seqlen = max(max_seqlen_q, max_seqlen_k)
+
+        q_pad = torch.empty(bs, q_h, max_seqlen, qk_d, device=q.device, dtype=q.dtype)
+        k_pad = torch.empty(bs, v_h, max_seqlen, qk_d, device=q.device, dtype=q.dtype)
+        v_pad = torch.empty(bs, v_h, max_seqlen, v_d, device=q.device, dtype=q.dtype)
+        output = torch.empty(sum_seq, q_h, v_d, device=q.device, dtype=q.dtype)
+
+        ops.varlen_fa_seqlen_pad(q, k, v, q_pad, k_pad, v_pad, cu_seqlens_q, cu_seqlens_k, sum_seq, max_seqlen, bs)
+        attn_output, attn_lse, _ = torch.ops.aten._scaled_dot_product_attention_flash_musa(
+            q_pad,
+            k_pad,
+            v_pad,
+            # scale=softmax_scale,
+            is_causal=causal
+        )
+        ops.varlen_fa_seqlen_unpad(attn_output, output, cu_seqlens_q, sum_seq, max_seqlen, v_d, q_h, bs)
+        if return_softmax_lse:
+            attn_lse = attn_lse * math.log(2) # workarround mudnn lse accurate issus
+            lse = torch.empty(q_h, sum_seq, device=q.device, dtype=torch.float32)
+            ops.varlen_fa_lse_seqlen_unpad(attn_lse, lse, cu_seqlens_q, sum_seq, max_seqlen, q_h, bs)
+            return output, lse
+        return output
