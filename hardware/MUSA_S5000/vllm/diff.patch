+
+  // Debug save
+  //Tensor tPgP = thr_copy_r2s.partition_D(gP); // (CPY, CPY_M, CPY_N, kv)
+
+  if (thread0()) {
+    //print("row_sum:"); print(row_sum); print("\n");
+    //print("mQ:"); print(mQ); print("\n");
+    //print("gQ:"); print(gQ); print("\n");
+    //print("mK:"); print(mK); print("\n");
+    //print("gK:"); print(gK); print("\n");
