+
+#define DISPATCH_TYPE(TYPE, NAME, ...)                       \
+    if (TYPE == at::ScalarType::BFloat16)                    \
+    {                                                        \
+        using scalar_t = mutlass::bfloat16_t;                \
+        __VA_ARGS__                                          \
+    }                                                        \
+    else if (TYPE == at::ScalarType::Half)                   \
+    {                                                        \
+        using scalar_t = mutlass::half_t;                    \
