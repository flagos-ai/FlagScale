+#ifndef INCLUDE_MUDNN_API_INTEGER_SUBBYTE_H_
+#define INCLUDE_MUDNN_API_INTEGER_SUBBYTE_H_
+
+#include <limits>
+#include <type_traits>
+
+namespace musa::dnn {
+
+// cutlass integer_subbyte class
+template <int Bits, bool Signed = true> struct integer_subbyte {
+  using Storage = uint8_t;
+
+  static_assert(Bits <= 8 * sizeof(Storage),
+                "Require a subbyte of bits in integer_subbyte");
+
+  using xint_t = typename std::conditional<Signed, int, unsigned>::type;
+
+  static constexpr Storage bits_mask_ = Storage((1 << Bits) - 1);
+
+  static constexpr Storage sign_mask_ = Storage((Signed ? 1 : 0) << (Bits - 1));
+
+  Storage storage;
+
+  __host__ __device__ constexpr integer_subbyte() {}
+
+  __host__ __device__ constexpr integer_subbyte(int value)
+      : storage(reinterpret_cast<Storage const &>(value) & bits_mask_) {}
+
+  __host__ __device__ constexpr integer_subbyte(unsigned value)
+      : storage(reinterpret_cast<Storage const &>(value) & bits_mask_) {}
+
+  __host__ __device__ constexpr operator xint_t() const {
+    if (sign_mask_ & storage) {
+      return xint_t(storage) | ~xint_t(bits_mask_);
+    } else {
+      return xint_t(storage);
+    }
+  }
+
+  __host__ __device__ constexpr bool
+  operator==(integer_subbyte const &rhs) const {
+    return storage == rhs.storage;
+  }
+
+  __host__ __device__ constexpr bool
+  operator!=(integer_subbyte const &rhs) const {
+    return storage != rhs.storage;
+  }
+
+  __host__ __device__ constexpr bool
+  operator<=(integer_subbyte const &rhs) const {
+    return storage <= rhs.storage;
+  }
+
+  __host__ __device__ constexpr bool
+  operator<(integer_subbyte const &rhs) const {
+    return storage < rhs.storage;
+  }
+
+  __host__ __device__ constexpr bool
+  operator>=(integer_subbyte const &rhs) const {
+    return storage >= rhs.storage;
+  }
+
+  __host__ __device__ constexpr bool
+  operator>(integer_subbyte const &rhs) const {
+    return storage > rhs.storage;
+  }
+};
+
+using uint1b_t = integer_subbyte<1, false>;
+using int2b_t = integer_subbyte<2, true>;
+using uint2b_t = integer_subbyte<2, false>;
+using int4b_t = integer_subbyte<4, true>;
+using uint4b_t = integer_subbyte<4, false>;
+using bin1_t = bool;
+
+} // namespace musa::dnn
+
+namespace std {
+
+template <> struct numeric_limits<musa::dnn::uint1b_t> {
+  __host__ __device__ static constexpr musa::dnn::uint1b_t const
+  lowest() noexcept {
+    return 0;
+  }
+  __host__ __device__ static constexpr musa::dnn::uint1b_t const
+  min() noexcept {
+    return 0;
+  }
+  __host__ __device__ static constexpr musa::dnn::uint1b_t const
+  max() noexcept {
+    return 1;
+  }
+  static constexpr bool is_integer = true;
+  static constexpr bool is_signed = false;
+};
+
+template <> struct numeric_limits<musa::dnn::int2b_t> {
+  __host__ __device__ static constexpr musa::dnn::int2b_t lowest() noexcept {
+    return -2;
+  }
+  __host__ __device__ static constexpr musa::dnn::int2b_t min() noexcept {
+    return -2;
+  }
+  __host__ __device__ static constexpr musa::dnn::int2b_t max() noexcept {
+    return 1;
+  }
+  static constexpr bool is_integer = true;
+  static constexpr bool is_signed = true;
+};
+
+template <> struct numeric_limits<musa::dnn::uint2b_t> {
+  __host__ __device__ static constexpr musa::dnn::uint2b_t const
+  lowest() noexcept {
+    return 0;
+  }
+  __host__ __device__ static constexpr musa::dnn::uint2b_t const
+  min() noexcept {
+    return 0;
+  }
+  __host__ __device__ static constexpr musa::dnn::uint2b_t const
+  max() noexcept {
+    return 3;
+  }
+  static constexpr bool is_integer = true;
+  static constexpr bool is_signed = false;
+};
+
+template <> struct numeric_limits<musa::dnn::int4b_t> {
+  __host__ __device__ static constexpr musa::dnn::int4b_t lowest() noexcept {
+    return -8;
+  }
+  __host__ __device__ static constexpr musa::dnn::int4b_t min() noexcept {
+    return -8;
+  }
+  __host__ __device__ static constexpr musa::dnn::int4b_t max() noexcept {
+    return 7;
+  }
+  static constexpr bool is_integer = true;
+  static constexpr bool is_signed = true;
+};
+
+template <> struct numeric_limits<musa::dnn::uint4b_t> {
+  __host__ __device__ static constexpr musa::dnn::uint4b_t const
+  lowest() noexcept {
+    return 0;
+  }
+  __host__ __device__ static constexpr musa::dnn::uint4b_t const
+  min() noexcept {
+    return 0;
+  }
+  __host__ __device__ static constexpr musa::dnn::uint4b_t const
+  max() noexcept {
+    return 15;
+  }
+  static constexpr bool is_integer = true;
+  static constexpr bool is_signed = false;
+};
+
+} // namespace std
+
+#endif // INCLUDE_MUDNN_API_INTEGER_SUBBYTE_H_
