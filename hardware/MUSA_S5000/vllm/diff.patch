+      // }
+
+    // if (threadIdx.x < 4 || (threadIdx.x >=64 && threadIdx.x < 68)) {
+    //   printf("liliang1 thread = %d tPrQ: ", threadIdx.x); print(tPrQ(0));print(" ");print(tPrQ(1)); print("\n");
+    // }
+    // if (threadIdx.x < 1) {
+    //   printf("liliang1 thread = %d accum_p: ", threadIdx.x); print(accum_p(0));print(" ");print(accum_p(1)); print("\n");
+    // }
+  // Apply Causal Mask
+  if constexpr (EnableCausal) {
+    apply_causal_mask(accum_p, tPcP, coord_q * size<0>(gQ) + mask_m_offset, 0, false);
+  }
+      if(thread(0)) {
+      // print("liliang thr_mma_qk: "); print(thr_mma_qk); print("\n");
+      // print("liliang accum_p: "); print(accum_p); print("\n");
+      // print("liliang cP: "); print(cP); print("\n");
+      // print("liliang tPcP: "); print(tPcP); print("\n");
+      // print("liliang gV: "); print(gV); print("\n");
+      // print("liliang v_ptr_offset: "); print(v_ptr_offset); print("\n");
+      // print("liliang tVgV: "); print(tVgV); print("\n");
+    }
+  // if (blockIdx.x == 0 && threadIdx.x < 8) {
+    // #pragma unroll
+    // for (int i = 0; i < 8; ++i) {
+    //   printf("liliang  threadIdx.x = %d accum_p(%d) = %f\n", threadIdx.x, i, accum_p(i));
+    // }
+  // }
+
+  // Softmax(P)
+  if constexpr (EnableSoftmax) {
+    online_softmax_scale(accum_p, accum_softmax, params.rln2_scale, tPcP, residue_kv, orig_kv_tile_count == 1);
+    //online_softmax_scale(accum_p, accum_softmax, params.rln2_scale);
+    online_softmax_row_max<ElementAccum>(accum_softmax, row_max, old_row_max, alpha);
+  } else {
+    online_softmax_scale(accum_p, accum_softmax, float(1.0f));
+  }
+  int page_size = 32; //TODO:
+  for (int loop = 1; loop < kv_tile_count; ++loop) {
+    int page_idx = loop * get<0>(tile_shape_K) / page_size;
+    int page_size_idx = (loop * get<0>(tile_shape_K) % page_size);
+    k_ptr_offset = params.block_table[coord_b * params.block_table_stride_batch + page_idx] * get<3>(params.stride_K) + page_size_idx * get<0>(params.stride_K) + k_num_head_offset;
+    gK = make_tensor(make_gmem_ptr(params.ptr_K + k_ptr_offset), tile_shape_K, select<0, 1>(params.stride_K));
+    tKgK = gmem_thr_copy_K.partition_S(gK);
+
+    // LDG V
+    if constexpr (KernelTraits::UseRobustLoadV) {
+      copy_if(gmem_tiled_copy_V.with(params.desc_V), tKpK, tVgV, tVrV);
+    } else {
+      copy_if(gmem_tiled_copy_V, tKpK, tVgV, tVrV);
+    }
+
+    // if(thread(0)) {
+    //   print("liliang params.ptr_V: "); print(params.ptr_V); print("\n");
+    //   print("liliang tVgV: "); print(tVgV(0)); print("\n");
+    //   print("liliang gV: "); print(gV); print("\n");
+    //   print("liliang v_ptr_offset: "); print(v_ptr_offset); print("\n");
+    // }
+
+    MUTLASS_PRAGMA_UNROLL
+    for (int i = 0; i < size<0>(tKpK); ++i) {
+      tKpK(i, 0) = loop * get<0>(tile_shape_K) + get<0>(tKcK(0,i,0)) < cur_seqlen_kv;
+    }
+
+    if constexpr (KernelTraits::UseRobustLoadK) {
+      copy_if(gmem_tiled_copy_K.with(params.desc_K), tKpK, tKgK, tKrK);
+    } else {
+      copy_if(gmem_tiled_copy_K, tKpK, tKgK, tKrK);
+    }
+    // ++k_tile_iter;
+    copy(tKrK, tKsK);
+    __syncthreads();
+
+    clear(accum_p);
+    gemm<KernelTraits::IsQInReg>(accum_p, tPrQ, tPrK, tPsQ, tPsK, tiled_mma_qk, thr_copy_Q, thr_copy_K);
+
+      // #pragma unroll
+      // for (int i = 0; i < size(accum_p); ++i) {
+      //   if (accum_p(i) != 128.0f) {
+      //     printf("liliang1 blockIdx = %d, %d, %d, threadIdx.x = %d i = %d, accum_p: ", blockIdx.x, blockIdx.y, blockIdx.z, threadIdx.x, i); print(accum_p(i)); print("\n");
+      //   }
+      // }
+
+    if constexpr (EnableSoftmax) {
+      // do softmax on accum_softmax
+      online_softmax_exp2(accum_softmax);
+      update_accum(accum_o, alpha);
+    }
+
+    // tCvt_frg -> accum_cvt, tAcc_frg -> accum_softmax
+    MUTE_UNROLL
+    for (int i = 0; i < size(tCvt_frg); ++i) {
+      tCvt_frg(i) = mutlass::NumericArrayConverter<typename KernelTraits::ElementKV, ElementAccum, FragmentSize, mutlass::FloatRoundStyle::round_to_nearest>{}(tAcc_frg(i));
+    }
+
+    // STS P (tPrP -> accum_cvt)
+    copy(tiled_copy_r2s, tPrP, tPsP);
+
+    // ++v_tile_iter;
+    // STS V
+    v_ptr_offset = params.block_table[coord_b * params.block_table_stride_batch + page_idx] * get<3>(params.stride_V) + page_size_idx * get<0>(params.stride_V) + v_num_head_offset;
+    gV = make_tensor(make_gmem_ptr(params.ptr_V + v_ptr_offset), tile_shape_V, select<0, 1>(params.stride_V));
+    tVgV = gmem_thr_copy_V.partition_S(gV); // (VCPY, VCPY_M, VCPY_N)
+    copy(tVrV, tVsV);
+
+    __syncthreads();
+
+    // O = PV
+    gemm(accum_o, tOrP, tOrVt, tOsP, tOsVt, tiled_mma_pv, thr_copy_P, thr_copy_V);
+    // if (thread(0)) {
+    //   print("liliang accum_o: "); print(accum_o(0)); print("\n");
+    // }
+
+    if constexpr (EnableSoftmax) {
+      // do softmax
+      online_softmax_row_sum<ElementAccum>(accum_softmax, row_sum, lse, alpha);
+
+      // Apply Causal Mask
+      if constexpr (EnableCausal) {
+        apply_causal_mask(accum_p, tPcP, coord_q * size<0>(gQ) + mask_m_offset, loop * size<0>(gK), true);
+      }
+      online_softmax_scale(accum_p, accum_softmax, params.rln2_scale, tPcP, residue_kv, loop == orig_kv_tile_count - 1);
+      online_softmax_row_max<ElementAccum>(accum_softmax, row_max, old_row_max, alpha);
+    } else {
+      online_softmax_scale(accum_p, accum_softmax, float(1.0f));
+    }
+  }
+
+  // Last tile
+  if constexpr (EnableSoftmax) {
+    // do softmax
+    online_softmax_exp2(accum_softmax);
+    update_accum(accum_o, alpha);
+  }
+
+  // tCvt_frg -> accum_cvt, tAcc_frg -> accum_softmax
+  MUTE_UNROLL
+  for (int i = 0; i < size(tCvt_frg); ++i) {
+    tCvt_frg(i) = mutlass::NumericArrayConverter<typename KernelTraits::ElementKV, ElementAccum, FragmentSize, mutlass::FloatRoundStyle::round_to_nearest>{}(tAcc_frg(i));
+  }
+
+  // Temp save
+  //copy(tiled_copy_r2s, tPrP, tPgP(_,_,_,0));
+
+  // int page_idx = kv_tile_count * get<0>(tile_shape_K) / page_size;
+  // int page_size_idx = kv_tile_count * get<0>(tile_shape_K) % page_size;
+  // v_ptr_offset = params.block_table[coord_b * params.block_table_stride_batch + page_idx] * get<3>(params.stride_V) + page_size_idx * get<0>(params.stride_V) + (coord_h / mute::size<4,0>(params.problem_shape)) * get<2, 1>(params.stride_V);
+  // gV = make_tensor(make_gmem_ptr(params.ptr_V + v_ptr_offset), tile_shape_V, select<0, 1>(params.stride_V));
+  // tVgV = gmem_thr_copy_V.partition_S(gV); // (VCPY, VCPY_M, VCPY_N)
+
+  // LDG V
+  if constexpr (KernelTraits::UseRobustLoadV) {
+    copy_if(gmem_tiled_copy_V.with(params.desc_V), tKpK, tVgV, tVrV);
+  } else {
+    copy_if(gmem_tiled_copy_V, tKpK, tVgV, tVrV);
+  }
+
+  // STS V
+  copy(tVrV, tVsV);
+
+  // STS P (tPrP -> accum_cvt)
+  copy(tiled_copy_r2s, tPrP, tPsP);
+
+  __syncthreads();
+
+  // if (threadIdx.x == 0) {
+  // if (thread(0)) {
+  //   // print("liliang tiled_copy_r2s: "); print(tiled_copy_r2s); print("\n");
+  //   // print("liliang thr_copy_P: "); print(thr_copy_P); print("\n");
+  //   // print("liliang tPrP: "); print(tPrP); print("\n");
+  //   // print("liliang tPsP: "); print(tPsP); print("\n");
+  //   // print("liliang tPrP: "); print(tPrP(0)); print("\n");
+  //   print("liliang mO: "); print(mO); print("\n");
+  //   print("liliang gO: "); print(gO); print("\n");
+  //   print("liliang tOgO: "); print(tOgO); print("\n");
+  //   print("liliang accum_o: "); print(accum_o); print("\n");
+  //   // printf("liliang coord_h  = %d ", coord_h);print(tPrP(0));print(" ");print(accum_softmax(0));print("\n");
+  // }
+
+  // O = PV
+  gemm(accum_o, tOrP, tOrVt, tOsP, tOsVt, tiled_mma_pv, thr_copy_P, thr_copy_V);
+
+    // if (thread(0)) {
+    //   print("liliang1 tOrP: "); print(tOrP(0)); print("\n");
+    //   print("liliang1 accum_o: "); print(accum_o(0)); print("\n");
+    // }
+  if constexpr (EnableSoftmax) {
+    online_softmax_row_sum<ElementAccum>(accum_softmax, row_sum, lse, alpha);
+
+    apply_softmax_normalizer(accum_o, lse);
+  //   if (threadIdx.x == 0) {
+  //   printf("liliang accum_o:  "); print(accum_o(0)); print(" lse = ");print(lse(0));print("\n");
+  // }
+  }
+
+  if constexpr(KernelTraits::ReturnL) {
+    #pragma unroll
+    for(int i = 0; i < size(lse); ++i) {
+      if (elem_less(get<0>(tCcL(i * size<0, 0>(tCcL))), get<0>(oob_mn))) {
+        tSgL(i) = (log2(lse(i)) + row_max(i)) / float(1.4426950408889634074);
+      }
+    }
+  }
+
+  MUTE_UNROLL
+  for (int i = 0; i < size(accum_o); ++i) {
+    if (elem_less(tCcO(i), oob_mn)) {
+      tOgO(i) = typename KernelTraits::ElementQ(accum_o(i));
+      // tOgO(i) = typename KernelTraits::ElementQ(1.0);
+    }
+  }
+  #endif
+}
diff --git a/vllm_musa/csrc/flash_attn/v1_mp22_impl/attention_params.hpp b/vllm_musa/csrc/flash_attn/v1_mp22_impl/attention_params.hpp
