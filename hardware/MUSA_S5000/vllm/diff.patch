+struct SharedStorageReuseQ {
+  union {
+    mute::array_aligned<Element,  mute::cosize_v<SmemLayoutQ>> smem_q;
+    struct {
+      mute::array_aligned<Element, mute::cosize_v<SmemLayoutK>> smem_k;
+      mute::array_aligned<Element, mute::cosize_v<SmemLayoutV>> smem_v;
+      mute::array_aligned<Element, mute::cosize_v<SmemLayoutP>> smem_p;
+    };
+    mute::array_aligned<Element, 1> smem_q_pe; // dummy
+    mute::array_aligned<Element, 1> smem_k_pe; // dummy
+  };
+};
+
+template <
+  class Element,
+  class SmemLayoutQ,
+  class SmemLayoutQPE,
+  class SmemLayoutK,
+  class SmemLayoutKPE,
+  class SmemLayoutV,
+  class SmemLayoutP
+>
+struct SharedStorageSplitHeadDim {
+  // Q use 36KB
+  struct {
+    mute::array_aligned<Element, mute::cosize_v<SmemLayoutQ>> smem_q; // q_model
+    mute::array_aligned<Element, mute::cosize_v<SmemLayoutQPE>> smem_q_pe;
+  };
+  // Reuse K_Model&K_PE && V --> 32KB
+  union {
+    union {
+      mute::array_aligned<Element, mute::cosize_v<SmemLayoutK>> smem_k;
+      mute::array_aligned<Element, mute::cosize_v<SmemLayoutKPE>> smem_k_pe;
+    };
+    mute::array_aligned<Element, mute::cosize_v<SmemLayoutV>> smem_v;
+  };
+  // P 2KB
+  mute::array_aligned<Element, mute::cosize_v<SmemLayoutP>> smem_p;
+};
+
+template <class TileN, class PermuteTileShape = TileN>
+constexpr auto
+get_mp22_permute_tile_for_operand_B() {
+  using MmaAtomN = _16;
+  static_assert(TileN{} % PermuteTileShape{} == 0);
+  static_assert(PermuteTileShape{} % MmaAtomN{} == 0);
+
+  using RepeatInsidePermuteTile = decltype(PermuteTileShape{} / MmaAtomN{});
+  using RepeatAcrossPermuteTile = decltype(TileN{} / PermuteTileShape{});
+
+  using PermuteTileN = Layout<Shape <               MmaAtomN, RepeatInsidePermuteTile, RepeatAcrossPermuteTile>,
+                              Stride<RepeatInsidePermuteTile,                      _1,        PermuteTileShape>>;
+
+  return PermuteTileN{};
+}
+
