+/******************************************************************************
+ * Debug and logging macros
+ ******************************************************************************/
+
+/**
+ * Formats and prints the given message to stdout
+ */
+#if !defined(MUSA_LOG)
+#if !defined(__MUSA_ARCH__)
+#define MUSA_LOG(format, ...) printf(format, __VA_ARGS__)
+#else
+#define MUSA_LOG(format, ...)                              \
+  printf("[block (%d,%d,%d), thread (%d,%d,%d)]: " format, \
+         blockIdx.x,                                       \
+         blockIdx.y,                                       \
+         blockIdx.z,                                       \
+         threadIdx.x,                                      \
+         threadIdx.y,                                      \
+         threadIdx.z,                                      \
+         __VA_ARGS__);
+#endif
+#endif
+
+/**
+ * Formats and prints the given message to stdout only if DEBUG is defined
+ */
+#if !defined(MUSA_LOG_DEBUG)
+#ifdef DEBUG
+#define MUSA_LOG_DEBUG(format, ...) MUSA_LOG(format, __VA_ARGS__)
+#else
+#define MUSA_LOG_DEBUG(format, ...)
+#endif
+#endif
+
+/**
+ * \brief The corresponding error message is printed to \p stderr (or \p stdout in device code)
+ * along with the supplied source context.
+ *
+ * \return The MUSA error.
+ */
+__host__ MUTLASS_DEVICE musaError_t musa_perror_impl(musaError_t error,
+                                                     const char* expression,
+                                                     const char* filename,
+                                                     int line) {
+  (void)filename;
+  (void)line;
+  if (error) {
+#if !defined(__MUSA_ARCH__)
+    fprintf(
+        stderr, "MUSA error %d [%s, %d] in expression '%s': %s\n", error, filename, line, expression, musaGetErrorString(error));
+    fflush(stderr);
+#else
+    printf("MUSA error %d [%s, %d] in expression '%s'\n", error, filename, line, expression);
+#endif
+  }
+  return error;
+}
+
+/**
+ * \brief Perror macro
+ */
+#ifndef MUSA_PERROR
+#define MUSA_PERROR(e) musa_perror_impl((musaError_t)(e), #e, __FILE__, __LINE__)
+#endif
+
+/**
+ * \brief Perror macro with exit
+ */
+#ifndef MUSA_PERROR_EXIT
+#define MUSA_PERROR_EXIT(e)                                     \
+  do { if (musa_perror_impl((musaError_t)(e), #e, __FILE__, __LINE__)) { \
+    exit(1);                                                    \
+  } } while (0)
+#endif
+
+/**
+ * \brief Perror macro only if DEBUG is defined
+ */
+#ifndef MUSA_PERROR_DEBUG
+#ifdef DEBUG
+#define MUSA_PERROR_DEBUG(e) MUSA_PERROR(e)
+#else
+#define MUSA_PERROR_DEBUG(e) (e)
+#endif
+#endif
