+using at::musa::muTensor;
+using at::musa::GetComputeModeFromCtx;
+
+void inline W4A16KernelCheck(torch::Tensor &out, torch::Tensor &in,
+                             torch::Tensor &weight, torch::Tensor &scales,
+                             std::optional<torch::Tensor> &bias, const bool trans_w) {
+  // input shape: [M, K], fp16
+  // weight shape: [K // 8, N], int32
+  // out shape: [M, N], fp16
+  // scale shape: [1, N], float
+  TORCH_CHECK(out.dim() == in.dim() && in.dim() == weight.dim() &&
+                  weight.dim() == 2,
+              "output, input and weight should all be 2D tensors",
+              "got output: ", out.dim(), ", input: ", in.dim(),
+              ", weight: ", weight.dim());
+  TORCH_CHECK(
+      out.scalar_type() == at::ScalarType::Half,
+      "dtype of output tensor of mudnn w4a16 kernel should be half, got ",
+      out.scalar_type());
+  TORCH_CHECK(
+      in.scalar_type() == at::ScalarType::Half,
+      "dtype of input tensor of mudnn w4a16 kernel should be half, got ",
+      in.scalar_type());
+  TORCH_CHECK(
+      weight.scalar_type() == at::ScalarType::Int,
+      "dtype of weight tensor of mudnn w4a16 kernel should be int32, got ",
+      weight.scalar_type());
+  TORCH_CHECK(out.size(0) == in.size(0) && out.size(1) == weight.size(1),
+              "unmatched shape of out, input and weight");
+  TORCH_CHECK(in.size(1) == weight.size(0) * 8,
+              "unmatched shape of input and weight");
+  TORCH_CHECK(scales.scalar_type() == at::ScalarType::Float,
+              "scales dtype should be float");
+  TORCH_CHECK(scales.dim() == 2,
+              "scales should all be 2D tensors");
+  TORCH_CHECK(scales.size(1) == weight.size(1),
+              "scales shape should be equal to weight channels");
+  if (bias.has_value()) {
+    TORCH_CHECK(bias->scalar_type() == out.scalar_type(), "bias should have same dtype as in&we");
+    TORCH_CHECK(bias->size(0) == out.size(1), "bias shape should match out-channel");
+  }
+}
+
+muTensor CreateW4MUTensor(torch::Tensor &weight, torch::Tensor &scales,
+                          const bool trans) {
+  muTensor w_m;
+  // weight: (K/8, N) -> w_m: (K, M) with INT4
+  CHECK_MUDNN_STATUS(w_m.SetType(muTensor::Type::QINT4), "Set QINT4 dtype");
+  CHECK_MUDNN_STATUS(w_m.SetAddr(weight.data_ptr()), "SetAddr");
+  CHECK_MUDNN_STATUS(w_m.SetFormat(muTensor::Format::NCHW), "SetFormat");
+  if (trans) {
+    // set transposed shape and stride
+    CHECK_MUDNN_STATUS(w_m.SetNdInfo({weight.size(1), weight.size(0) * 8},
+                                     {weight.stride(1) * 8, weight.stride(0)}),
+                       "SetNdInfo");
+  } else {
+    CHECK_MUDNN_STATUS(w_m.SetNdInfo({weight.size(0) * 8, weight.size(1)},
+                                     {weight.stride(0), weight.stride(1)}),
+                       "SetNdInfo");
+  }
+  return w_m;
+}
+
+void mudnn_w4a16_matmul(torch::Tensor out, torch::Tensor in,
+                        torch::Tensor weight, torch::Tensor scales,
+                        std::optional<torch::Tensor> bias,
+                        const bool split_k = false) {
+  bool trans_l = at::musa::IsTranspose(in);
+  bool trans_r = at::musa::IsTranspose(weight);
+  W4A16KernelCheck(out, in, weight, scales, bias, trans_r);
+
+  at::musa::muHandle &h = at::GetMudnnHandle();
+  muTensor in_mt = at::musa::CreateMUTensor(in);
+  muTensor o_mt = at::musa::CreateMUTensor(out);
+  muTensor s_mt = at::musa::CreateMUTensor(scales);
+  muTensor w_mt = CreateW4MUTensor(weight, scales, trans_r);
+  torch::Tensor bias_ = bias.value_or(torch::Tensor());
+  muTensor b_mt = at::musa::CreateMUTensor(bias_);
+
+  ::musa::dnn::BatchMatMul op;
+  CHECK_MUDNN_STATUS(op.SetAlpha(1.0), "SetAlpha");
+  CHECK_MUDNN_STATUS(op.SetBeta(0.0), "SetBeta");
+  CHECK_MUDNN_STATUS(op.SetGamma(0.0), "SetGamma");
+  CHECK_MUDNN_STATUS(op.SetTranspose(trans_l, trans_r), "SetTranspose");
+  // CHECK_MUDNN_STATUS(op.SetSplitK(split_k), "SetSplitK");
+  CHECK_MUDNN_STATUS(op.SetDeterministic(split_k), "SetDeterministic");
+  CHECK_MUDNN_STATUS(
+      op.SetComputeMode(static_cast<::musa::dnn::MatMul::ComputeMode>(0)),
+      "SetComputeMode");
+
+  ::musa::dnn::MatMulLtParam param;
+  CHECK_MUDNN_STATUS(param.SetScale(muTensor(), s_mt, muTensor(), muTensor()),
+                     "SetScale");
+
+  CHECK_MUDNN_STATUS(op.RunLt(h, o_mt, in_mt, w_mt, o_mt, b_mt, param,
+                              at::musa::InternalMemAlloc),
+                     "RunLt");
+}
+
+void mudnn_w8a8_scaled_mm(torch::Tensor& c, torch::Tensor const& a,
+  torch::Tensor const& b, torch::Tensor const& a_scales,
+  torch::Tensor const& b_scales,
+  std::optional<torch::Tensor> const& bias){
+  TORCH_CHECK(a.dim() == 2 && b.dim() == 2 && c.dim() == 2);
+  TORCH_CHECK(c.size(0) == a.size(0) && a.size(1) == b.size(1) &&
+  b.size(0) == c.size(1));
+
+  if (bias) {
+    TORCH_CHECK(bias->numel() == b.size(1) && bias->is_contiguous() &&
+      bias->dim() == 1);
+  }
+
+  at::musa::OptionalMUSAGuard const device_guard(device_of(a));
+
+  const auto a_type = a.scalar_type();
+
+  muTensor a_mu = at::musa::CreateMUTensor(a);
+  muTensor b_mu = at::musa::CreateMUTensor(b);
+  muTensor out_mu = at::musa::CreateMUTensor(c);
+  torch::Tensor bias_ = bias.value_or(torch::Tensor());
+  muTensor bias_mu = at::musa::CreateMUTensor(bias_);
+
+  muTensor a_scales_mu = at::musa::CreateMUTensor(a_scales);
+  muTensor b_scales_mu = at::musa::CreateMUTensor(b_scales);
+
+  auto& handle = at::GetMudnnHandle();
+  ::musa::dnn::BatchMatMul op;
+  ::musa::dnn::MatMulLtParam param;
+
+  CHECK_MUDNN_STATUS(param.SetScale(a_scales_mu, b_scales_mu, muTensor(), muTensor(), 128), "SetScale");
+  CHECK_MUDNN_STATUS(op.SetTranspose(false, true), "SetTranspose");
+  // CHECK_MUDNN_STATUS(op.SetSplitK(false), "SetSplitK");
+  CHECK_MUDNN_STATUS(op.SetDeterministic(false), "SetDeterministic");
+  CHECK_MUDNN_STATUS(op.SetComputeMode(GetComputeModeFromCtx(a_type)), "SetComputeMode");
+  CHECK_MUDNN_STATUS(op.SetBeta(0.0), "SetBeta");
+
+  CHECK_MUDNN_STATUS(
+    op.RunLt(handle,
+      out_mu,
+      a_mu,
+      b_mu,
+      out_mu,
+      bias_mu,
+      param,
+      at::musa::InternalMemAlloc),
+  "RunLt");
+}
+
+
+void mla_mudnn_bmm(
+  torch::Tensor& c,
+  torch::Tensor const& a,
+  torch::Tensor const& b) {
+  TORCH_CHECK(a.dim() == 3 && b.dim() == 3 && c.dim() == 3);
+
+  at::musa::OptionalMUSAGuard const device_guard(device_of(a));
+
+  const auto a_type = a.scalar_type();
+
+  muTensor a_mu = at::musa::CreateMUTensor(a);
+  muTensor b_mu = at::musa::CreateMUTensor(b);
+  muTensor out_mu = at::musa::CreateMUTensor(c);
+
+  bool trans_a = false;
+  bool trans_b = false;
+
+  if (b.stride(1) == 1) {
+      trans_b = true;
+      // (B, N, P) * (N, P, L) -> (B, N, L)
+      a_mu.SetNdInfo({a.size(1), a.size(0), a.size(2)},
+      {a.stride(1), a.stride(0), a.stride(2)});
+      b_mu.SetNdInfo({b.size(0), b.size(2), b.size(1)},
+        {b.stride(0), b.stride(2), b.stride(1)});
+      out_mu.SetNdInfo({c.size(1), c.size(0), c.size(2)},
+        {c.stride(1), c.stride(0), c.stride(2)});
+        // (N, B, P) * (N, L, P) -> (N, B, L)
+  } else if (b.stride(2) == 1) {
+      // (B, N, P) * (N, P, L) -> (B, N, L)
+      a_mu.SetNdInfo({a.size(1), a.size(0), a.size(2)},
+      {a.stride(1), a.stride(0), a.stride(2)});
+      b_mu.SetNdInfo({b.size(0), b.size(1), b.size(2)},
+        {b.stride(0), b.stride(1), b.stride(2)});
+      out_mu.SetNdInfo({c.size(1), c.size(0), c.size(2)},
+        {c.stride(1), c.stride(0), c.stride(2)});
+      // (N, B, P) * (N, P, L) -> (N, B, L)
+  } else {
+    TORCH_CHECK(false, "mla_mudnn_bmm not support current stide, export MUDNN_LOG_LEVEL=INFO");
+  }
+
+  auto& handle = at::GetMudnnHandle();
+  ::musa::dnn::BatchMatMul op;
+  ::musa::dnn::MatMulLtParam param;
+
+  CHECK_MUDNN_STATUS(op.SetTranspose(trans_a, trans_b), "SetTranspose");
+  // CHECK_MUDNN_STATUS(op.SetSplitK(false), "SetSplitK");
+  CHECK_MUDNN_STATUS(op.SetDeterministic(false), "SetDeterministic");
+  CHECK_MUDNN_STATUS(op.SetComputeMode(GetComputeModeFromCtx(a_type)), "SetComputeMode");
+  CHECK_MUDNN_STATUS(op.SetBeta(0.0), "SetBeta");
+
+  CHECK_MUDNN_STATUS(
+    op.RunLt(handle,
+      out_mu,
+      a_mu,
+      b_mu,
+      out_mu,
+      muTensor(),
+      param,
+      at::musa::InternalMemAlloc),
+  "RunLt");
+}
