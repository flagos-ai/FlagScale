+  switch (conv_operator) {
+    case mutlass::conv::Operator::kFprop: return problem_size.activation_extent();
+    case mutlass::conv::Operator::kDgrad: return problem_size.output_extent();
+    case mutlass::conv::Operator::kWgrad: return problem_size.output_extent();
