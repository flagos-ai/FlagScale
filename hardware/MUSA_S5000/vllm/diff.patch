+#pragma once
+
+#include <mute/tensor.hpp>
+#include <mute/atom/mma_atom.hpp>
+#include <mute/atom/copy_atom.hpp>
+
+#include <mutlass/gemm/collective/collective_builder.hpp>
+
+#include "mutlass_extension.hpp"
+
+
+using namespace mute;
+
+template <
+class ElementA,
+      class ElementB,
+      class SmemLayoutA,
+      class SmemLayoutB
+>
+struct SharedStorage {
+  mute::array_aligned<ElementA, mute::cosize_v<SmemLayoutA>, 128> smem_a;
+  mute::array_aligned<ElementB, mute::cosize_v<SmemLayoutB>, 128> smem_b;
+};
+
+template <class TileN, class PermuteTileShape = TileN>
+constexpr auto
+get_permute_tile_for_operand_B() {
+  using MmaAtomN = _16;
+  static_assert(TileN{} % PermuteTileShape{} == 0);
+  static_assert(PermuteTileShape{} % MmaAtomN{} == 0);
+
+  using RepeatInsidePermuteTile = decltype(PermuteTileShape{} / MmaAtomN{});
+  using RepeatAcrossPermuteTile = decltype(TileN{} / PermuteTileShape{});
+
+  using PermuteTileN = Layout<Shape <               MmaAtomN, RepeatInsidePermuteTile, RepeatAcrossPermuteTile>,
+                              Stride<RepeatInsidePermuteTile,                      _1,        PermuteTileShape>>;
+
+  return PermuteTileN{};
+}
+
+template <>
+constexpr auto
+get_permute_tile_for_operand_B<_256, _128>() {
+  using PermuteTileN = Layout<Shape <_16, _2,   _2, _4>,
+                              Stride< _8, _1, _128, _2>>;
+
+  return PermuteTileN{};
+}
+
+template <class TileShape_MNK, class MmaOp>
+constexpr auto
+mp22_make_tiled_mma_vectorize() {
+  constexpr int TileM = size<0>(TileShape_MNK{});
+  constexpr int TileN = size<1>(TileShape_MNK{});
+
+  constexpr int MmaOpShapeM = size<0>(typename MMA_Traits<MmaOp>::Shape_MNK{});
+  constexpr int MmaOpShapeN = size<1>(typename MMA_Traits<MmaOp>::Shape_MNK{});
+
+  static_assert(TileM % MmaOpShapeM == 0 && TileN % MmaOpShapeN == 0, "Invalid TileShape");
+
+  constexpr int MaxWarpTile = 128;
+
+  constexpr int ValueLayoutM = mute::min(MaxWarpTile, TileM) / MmaOpShapeM;
+  constexpr int ValueLayoutN = mute::min(MaxWarpTile, TileN) / MmaOpShapeN;
+
+  constexpr int AtomTileM = ValueLayoutM * MmaOpShapeM;
+  constexpr int AtomTileN = ValueLayoutN * MmaOpShapeN;
+
+  constexpr int AtomExtendM = TileM / AtomTileM;
+  constexpr int AtomExtendN = TileN / AtomTileN;
+
+  using AtomLayout = decltype(make_layout(Shape<Int<AtomExtendM>, Int<AtomExtendN>, _1>{}, LayoutLeft{}));
+
+  using PermuteLayoutK = X;
+
+  using ShapeM0 = Int<MmaOpShapeM>;
+  using ShapeM1 = Int<size<0>(AtomLayout{})>;
+  using ShapeM2 = Int<ValueLayoutM>;
+
+  using StrideM0 = _1;
+  using StrideM1 = Int<MmaOpShapeM * ValueLayoutM>;
+  using StrideM2 = Int<MmaOpShapeM>;
+
+  using PermuteLayoutM = Layout<Shape < ShapeM0,  ShapeM1,  ShapeM2>,
+                                Stride<StrideM0, StrideM1, StrideM2>>;
+
+  constexpr int MaxPermuteTile = min(128, tuple_element_t<1, TileShape_MNK>{});
+  using PermuteLayoutN = decltype(get_permute_tile_for_operand_B<tuple_element_t<1, TileShape_MNK>, Int<MaxPermuteTile>>());
+
+  using PermuteLayout = mute::Tile<PermuteLayoutM, PermuteLayoutN, PermuteLayoutK>;
+
+  return TiledMMA<MMA_Atom<MmaOp>, AtomLayout, PermuteLayout>{};
+}
+
+template <
+  class TileShape_,
+  class ElementA_,
+  int AlignmentA_,
+  class ElementB_,
+  int AlignmentB_,
+  class ElementScale_,
+  class ElementC_,
+  int GroupSizeK_ = 64
+>
+struct MixedInputGemmKernelTratis {
+  using TileShape                     = TileShape_;
+  using ElementA                      = ElementA_;
+  static constexpr int AlignmentA     = AlignmentA_;
+  using ElementB                      = ElementB_;
+  static constexpr int AlignmentB     = AlignmentB_;
+  using ElementScale                  = ElementScale_;
+  using ElementC                      = ElementC_;
+
+  static_assert(is_same_v<ElementC, ElementA>, "ElementA and ElementC should be same now.");
+
+  using IdxType = int32_t;
+
+  // Both A&B are K-major
+  using StrideA = Stride<IdxType, _1>;
+  using StrideB = Stride<IdxType, _1>;
+
+  // C is N-major
+  using StrideC = Stride<IdxType, _1>;
+
+  static_assert(sizeof_bits_v<ElementA> == 16, "Only support 16bit MMA");
+  static constexpr bool IsMixedInput = sizeof_bits_v<ElementB> < sizeof_bits_v<ElementA>;
+  static constexpr int GroupSizeK = GroupSizeK_;
+  static constexpr int ScaleInterleave = GroupSizeK / tuple_element_t<2, TileShape>{};
+
+  using MmaElementA = ElementA;
+  using MmaElementB = ElementA; // MmaElementB should be ElementA whether it is mixed-input or not
+
+  using MmaOp = decltype(mutlass::gemm::collective::detail::mp22_mma_operation_select<MmaElementA, StrideA, MmaElementB, StrideB>());
+  using TiledMma = decltype(mp22_make_tiled_mma_vectorize<TileShape, MmaOp>());
+  //using TiledMma = decltype(mutlass::gemm::collective::detail::mp22_make_tensorop_tiled_mma<TileShape, MmaOp>());
+
+  // Max WarpTile is 128
+  static constexpr int AlignmentC = min(128, tuple_element_t<1, TileShape>{}) / 16;
+
+  static constexpr int NumThreads = size(TiledMma{});
+
+  using SmemLayoutAtomA = decltype(mutlass::gemm::collective::detail::make_mp22_smem_atom_layout<MmaElementA, StrideA>());
+  using SmemCopyAtomA = Copy_Atom<DefaultCopy, MmaElementA>;
+  using SmemLayoutA = decltype(tile_to_shape(SmemLayoutAtomA{}, select<0, 2>(TileShape{})));
+
+  using SmemLayoutAtomB = decltype(mutlass::gemm::collective::detail::make_mp22_smem_atom_layout<MmaElementB, StrideB>());
+  using SmemCopyAtomB = Copy_Atom<DefaultCopy, MmaElementB>;
+  using SmemLayoutB = decltype(tile_to_shape(SmemLayoutAtomB{}, select<1, 2>(TileShape{})));
+
+  using SharedStorage = SharedStorage<MmaElementA, MmaElementB, SmemLayoutA, SmemLayoutB>;
+
+  using GmemTiledCopyA = decltype(mutlass::gemm::collective::detail::make_simt_tiled_copy<
+                                    NumThreads, ElementA, AlignmentA, StrideA,
+                                    get<0>(TileShape{}), get<2>(TileShape{}),
+                                    MP22_ROBUST_LOAD<uint_bit_t<AlignmentA * sizeof_bits_v<ElementA>>>>());
+
+  using GmemTiledCopyB = decltype(mutlass::gemm::collective::detail::make_simt_tiled_copy<
+                                    NumThreads, ElementB, AlignmentB, StrideB,
+                                    get<1>(TileShape{}), get<2>(TileShape{}),
+                                    MP22_ROBUST_LOAD<uint_bit_t<AlignmentB * sizeof_bits_v<ElementB>>>>());
+
+  // M, N, K
+  using ProblemShape = Shape<int, int, int>;
+
+  // Args
+  struct Arguments {
+    ElementA const* ptr_A;
+    ElementB const* ptr_B;
+    ElementC* ptr_C;
+    ElementScale const* ptr_scale;
+
+    // A [M, K], K-major
+    IdxType stride_am;
+
+    // B [N, K], K-major
+    IdxType stride_bn;
+
+    // C [M, N], N-major
+    IdxType stride_cm;
+
+    // Scale [N, K/128]
+    IdxType stride_sn;
+    IdxType stride_sk;
+  };
+
+  struct Params {
+    ProblemShape problem_shape;
+    ElementA const* ptr_A;
+    StrideA stride_A;
+    RobustDescriptor desc_A;
+
+    ElementB const* ptr_B;
+    StrideB stride_B;
+    RobustDescriptor desc_B;
+
+    ElementC* ptr_C;
+    StrideC stride_C;
+
+    ElementScale const* ptr_scale;
+    IdxType stride_sn;
+    IdxType stride_sk;
+  };
+
+  static bool
+  can_implement(ProblemShape problem_shape, Arguments args) {
+    bool implementable = true;
+
+    auto [M, N, K] = problem_shape;
+    implementable = implementable && (K % tuple_element_t<2, TileShape>{} == 0);
+    implementable = implementable && (K % GroupSizeK == 0);
+
+    return implementable;
+  }
+
+  static Params
+  to_underlying_arguments(ProblemShape problem_shape, Arguments args) {
+    StrideA stride_A {args.stride_am, _1{}};
+    StrideB stride_B {args.stride_bn, _1{}};
+    StrideC stride_C {args.stride_cm, _1{}};
+
+    auto [M, N, K] = problem_shape;
+    RobustDescriptor desc_A = make_robust_desc(args.ptr_A, M * K);
+    RobustDescriptor desc_B = make_robust_desc(args.ptr_B, N * K);
+
+    return {
+      problem_shape,
+      args.ptr_A,
+      stride_A,
+      desc_A,
+      args.ptr_B,
+      stride_B,
+      desc_B,
+      args.ptr_C,
+      stride_C,
+      args.ptr_scale,
+      args.stride_sn,
+      args.stride_sk
+    };
+  }
+};
diff --git a/vllm_musa/csrc/linear/mp22_w4a16_groupwise_gemm/mutlass_extension.hpp b/vllm_musa/csrc/linear/mp22_w4a16_groupwise_gemm/mutlass_extension.hpp
new file mode 100644
index 000000000..33b1348e0
--- /dev/null
+++ b/vllm_musa/csrc/linear/mp22_w4a16_groupwise_gemm/mutlass_extension.hpp
@@ -0,0 +1,192 @@
+#pragma once
+
+#if defined(__MUSA_ARCH__) && (__MUSA_ARCH__ == 220)
+#define MUTE_MP22_ROBUST_EXT
+#endif
+
+#include <mute/config.hpp>
+#include <mute/atom/copy_atom.hpp>
+#include <mute/arch/copy_mp31_desc.hpp> // RobustDescriptor
+
+
+namespace mute {
+
+//
+// Robust LD
+//
+template <class TS, class TD = TS>
+struct MP22_ROBUST_LOAD
+{
+  using SRegisters = TS[1];
+  using DRegisters = TD[1];
+
+  static_assert(sizeof(TS) == sizeof(TD),
+                "MP22_ROBUST_LOAD requires sizeof(src_value_type) == sizeof(dst_value_type)");
+
+  MUTE_HOST_DEVICE static void
+  copy(TS               const& gmem_src,
+       TD                    & rmem_dst,
+       bool                    pred,
+       RobustDescriptor const& src_desc)
+
+  {
+#if defined(MUTE_MP22_ROBUST_EXT)
+    void const* gmem_ptr = pred ? reinterpret_cast<void const*>(&gmem_src)
+                         : reinterpret_cast<void const*>(src_desc.oob_addr);
+    // meet the intrinsic requirement
+    using RobustRegV3 = uint32_t __attribute__((vector_size(12)));
+    union ExtractRobustReg {
+      RobustReg reg_v4;
+      struct {
+        RobustRegV3 reg;
+        uint32_t dummy;
+      };
+    };
+
+    ExtractRobustReg desc {src_desc.reg};
+
+    if constexpr (sizeof(TS) == 1) {
+      auto val = __musa_ld_robust_i8(gmem_ptr, desc.reg);
+      rmem_dst = *reinterpret_cast<TD*>(&val);
+    } else if constexpr (sizeof(TS) == 2) {
+      auto val = __musa_ld_robust_i16(gmem_ptr, desc.reg);
+      rmem_dst = *reinterpret_cast<TD*>(&val);
+    } else if constexpr (sizeof(TS) == 4) {
+      auto val = __musa_ld_robust_i32(gmem_ptr, desc.reg);
+      rmem_dst = *reinterpret_cast<TD*>(&val);
+    } else if constexpr (sizeof(TS) == 8) {
+      auto val = __musa_ld_robust_i64(gmem_ptr, desc.reg);
+      rmem_dst = *reinterpret_cast<TD*>(&val);
+    } else if constexpr (sizeof(TS) == 16) {
+      auto val = __musa_ld_robust_v4i32(gmem_ptr, desc.reg);
+      rmem_dst = *reinterpret_cast<TD*>(&val);
+    } else if constexpr (sizeof(TS) == 32) {
+      auto val = __musa_ld_robust_v8i32(gmem_ptr, desc.reg);
+      rmem_dst = *reinterpret_cast<TD*>(&val);
+    } else if constexpr (sizeof(TS) == 64) {
+      auto val = __musa_ld_robust_v16i32(gmem_ptr, desc.reg);
+      rmem_dst = *reinterpret_cast<TD*>(&val);
+    } else if constexpr (sizeof(TS) == 128) {
+      auto val = __musa_ld_robust_v32i32(gmem_ptr, desc.reg);
+      rmem_dst = *reinterpret_cast<TD*>(&val);
+    } else {
+      static_assert(sizeof(TS) <= 128, "Currently we only support up-to 1024-bit load");
+    }
+#else
+    MUTE_INVALID_CONTROL_PATH(
+        "Trying to use MP22_ROBUST_LOAD without MUTE_ARCH_ROBUST_BUFFER_ACCESS_ACTIVATED.");
+#endif
+  }
+};
+
+
+//
+// Robust load traits
+//
+template <class S, class D>
+struct MP22_ROBUST_LOAD_OP : MP22_ROBUST_LOAD<S, D> {};
+
+template <class S, class D>
+struct MP22_ROBUST_PRED_LOAD_OP : MP22_ROBUST_LOAD<S, D> {};
+
+template <class S, class D>
+struct Copy_Traits<MP22_ROBUST_PRED_LOAD_OP<S, D>>
+{
+  // Logical thread id to thread idx (one-thread)
+  using ThrID     = Layout<_1>;
+
+  // Map from (src-thr,src-val) to bit
+  using SrcLayout = Layout<Shape<_1, Int<sizeof_bits<S>::value>>>;
+  // Map from (dst-thr,dst-val) to bit
+  using DstLayout = Layout<Shape<_1, Int<sizeof_bits<D>::value>>>;
+
+  // Reference map from (thr,val) to bit
+  using RefLayout = SrcLayout;
+
+  // Robust Buffer Access Descriptor
+  const RobustDescriptor src_desc;
+
+  // Predicate value that determines whether to load or return zero
+  bool pred;
+
+  // Overload copy_unpack to pass robust buffer access descriptor
+  template <class TS, class SLayout,
+            class TD, class DLayout>
+  MUTE_HOST_DEVICE friend constexpr
+  void
+  copy_unpack(Copy_Traits         const& traits,
+              Tensor<TS, SLayout> const& src,
+              Tensor<TD, DLayout>      & dst)
+  {
+    static_assert(is_gmem<TS>::value, "Expected gmem src for MP22_ROBUST_LOAD");
+    static_assert(is_rmem<TD>::value, "Expected rmem dst for MP22_ROBUST_LOAD");
+
+    Tensor rS = recast<S>(src);
+    Tensor rD = recast<D>(dst);
+
+    MUTE_STATIC_ASSERT_V(size(rS) == Int<1>{},
+        "This src layout is incompatible with this tiled copy.");
+    MUTE_STATIC_ASSERT_V(size(rD) == Int<1>{},
+        "This dst layout is incompatible with this tiled copy.");
+
+    MP22_ROBUST_LOAD<S, D>::copy(rS[0], rD[0], traits.pred, traits.src_desc);
+  }
+};
+
+template <class S, class D>
+struct Copy_Traits<MP22_ROBUST_LOAD_OP<S, D>>
+{
+  // Logical thread id to thread idx (one-thread)
+  using ThrID     = Layout<_1>;
+
+  // Map from (src-thr,src-val) to bit
+  using SrcLayout = Layout<Shape<_1, Int<sizeof_bits<S>::value>>>;
+  // Map from (dst-thr,dst-val) to bit
+  using DstLayout = Layout<Shape<_1, Int<sizeof_bits<D>::value>>>;
+
+  // Reference map from (thr,val) to bit
+  using RefLayout = SrcLayout;
+
+  // Robust Buffer Access Descriptor
+  const RobustDescriptor src_desc;
+
+  MUTE_HOST_DEVICE constexpr
+  Copy_Traits<MP22_ROBUST_PRED_LOAD_OP<S, D>>
+  with(bool pred) const {
+    return {src_desc, pred};
+  }
+};
+
+template <class S, class D>
+struct Copy_Traits<MP22_ROBUST_LOAD<S, D>>
+{
+  // Logical thread id to thread idx (one-thread)
+  using ThrID     = Layout<_1>;
+
+  // Map from (src-thr,src-val) to bit
+  using SrcLayout = Layout<Shape<_1, Int<sizeof_bits<S>::value>>>;
+  // Map from (dst-thr,dst-val) to bit
+  using DstLayout = Layout<Shape<_1, Int<sizeof_bits<D>::value>>>;
+
+  // Reference map from (thr,val) to bit
+  using RefLayout = SrcLayout;
+
+  // Construct an executable MP22_ROBUST_LOAD with robust buffer access descriptor
+  MUTE_HOST_DEVICE constexpr
+  Copy_Traits<MP22_ROBUST_LOAD_OP<S, D>>
+  with(RobustDescriptor desc) const {
+    return {desc};
+  }
+
+  // Don't try to execute a copy with MP22_ROBUST_LOAD before calling .with()
+  template <class TS, class SLayout,
+            class TD, class DLayout>
+  MUTE_HOST_DEVICE friend constexpr
+  void
+  copy_unpack(Copy_Traits         const& traits,
+              Tensor<TS, SLayout> const& src,
+              Tensor<TD, DLayout>      & dst) = delete;
+
+};
+
+} // namespace mute
