+
+
+std::tuple<torch::Tensor, torch::Tensor> mp31_fused_grouped_topk(
+    const torch::Tensor& gating_output,
+    const c10::optional<torch::Tensor>& e_score_correction_bias,
+    int num_expert_group,
+    int topk_group,
+    int topk,
+    bool renormalize) {
+
+    TORCH_CHECK(e_score_correction_bias.has_value());
+
+    const int num_experts = gating_output.size(-1);
+    const int num_tokens = gating_output.numel() / num_experts;
+
+    auto topk_weights_option = gating_output.options().memory_format(at::MemoryFormat::Contiguous).dtype(at::kFloat);
+    auto topk_indices_option = gating_output.options().memory_format(at::MemoryFormat::Contiguous).dtype(at::kInt);
+
+    auto topk_weights = at::empty({num_tokens, topk}, topk_weights_option);
+    auto topk_indices = at::empty({num_tokens, topk}, topk_indices_option);
+
+    const at::musa::OptionalMUSAGuard device_guard(device_of(gating_output));
+    const musaStream_t stream = at::musa::getCurrentMUSAStream();
+
+#define DISPATCH(CPP_TYPE) \
+    vllm_musa::moe::MP31GroupedGatingTopkKernelLauncher(\
+    topk_weights.data_ptr<float>(),\
+    topk_indices.data_ptr<int>(),\
+    static_cast<CPP_TYPE*>(gating_output.data_ptr()),\
+    static_cast<CPP_TYPE*>(e_score_correction_bias.value().data_ptr()),\
+    num_tokens,\
+    num_experts,\
+    num_expert_group,\
+    topk_group,\
+    topk,\
+    renormalize,\
+    stream);
+
+    if (gating_output.scalar_type() == at::ScalarType::Float) {
+        DISPATCH(float);
+    }
+    else if (gating_output.scalar_type() == at::ScalarType::Half) {
+        DISPATCH(__half);
+    } else if (gating_output.scalar_type() == at::ScalarType::BFloat16) {
+        DISPATCH(__mt_bfloat16);
+    }
+    else {
+        TORCH_CHECK(false, "only support Float, Half and BFloat16 dtype");
+    }
+
+    return std::tuple<at::Tensor, at::Tensor>(topk_weights, topk_indices);
+
+#undef DISPATCH
+}
