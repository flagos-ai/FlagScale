+def fused_add_rms_norm(input: torch.Tensor, residual: torch.Tensor,
+                       weight: torch.Tensor, epsilon: float) -> None:
+    _kernels.fused_add_rms_norm(input, residual, weight, epsilon)
+
+def musa_fused_add_rms_norm(input: torch.Tensor, residual: torch.Tensor,
+                       weight: torch.Tensor, epsilon: float) -> None:
+    _kernels.musa_fused_add_rms_norm(input, residual, weight, epsilon)
+
+def rmsnorm_cast(
+        input: torch.Tensor, weight: torch.Tensor,
+        epsilon: float, quant_size: int
+):
+    M, N = input.shape
+    device = input.device
+    output_fp8 = torch.empty(M, N, device=device, dtype=torch.float8_e4m3fn)
+    inv_scale = torch.empty((M, (N + quant_size-1) // quant_size), device=device, dtype=torch.float32)
+    _kernels.rmsnorm_cast(output_fp8, inv_scale, input, weight, epsilon, quant_size)
+    return output_fp8, inv_scale
+
+def rmsnorm_add_cast(
+        input: torch.Tensor, resdual: torch.Tensor, weight: torch.Tensor,
+        epsilon: float, quant_size: int
+):
+    M, N = input.shape
+    device = input.device
+    output_fp8 = torch.empty(M, N, device=device, dtype=torch.float8_e4m3fn)
+    inv_scale = torch.empty((M, (N + quant_size-1) // quant_size), device=device, dtype=torch.float32)
+    _kernels.rmsnorm_add_cast(output_fp8, inv_scale, input, resdual, weight, epsilon, quant_size)
+    return output_fp8, inv_scale
+
