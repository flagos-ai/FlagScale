+        maybe_padded_v = v
+        if self._pad_v:
+            maybe_padded_v = torch.nn.functional.pad(
+                v, [0, q.shape[-1] - v.shape[-1]], value=0)
+
+        # vllm original code
+        # attn_out = self.flash_attn_varlen_func(
+        #     q=q,
+        #     k=k,
+        #     v=maybe_padded_v,
+        #     return_softmax_lse=return_softmax_lse,
