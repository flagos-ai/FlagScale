+namespace MP31::SQMMA {
+
+enum class ScaleOut {
+  One  = 0,
+  Zero = 1,
+};
+
+enum class ScaleIn {
+  One = 0,
+  Neg = 1,
+};
+
+} // namespace SQMMA
