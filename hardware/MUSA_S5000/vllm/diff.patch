+template <
+    typename T,
+    int VPT,
+    int NUM_EXPERT_GROUP,
+    int THREADS_PER_EXPERT_GROUP,
+    int ELTS_PER_LDG,
+    bool RENORMALIZE,
+    typename std::enable_if<std::is_same<float, T>::value || std::is_same<__half, T>::value || std::is_same<__mt_bfloat16, T>::value>::type* = nullptr
+>
+__global__ void mp31_grouped_gating_topk_sigmoid_kernel(const T* gating_output, const T* e_score_correction_bias, float* topk_weights, int* topk_indices, const int topk_group, const int topk, const int experts_per_group) {
+    using AccessType = AlignedArray<T, ELTS_PER_LDG>;
+    using AccumulateType = typename AccumulateTypeTraits<T>::type;
+    using AccumulateAccessType = AlignedArray<AccumulateType, ELTS_PER_LDG>;
+
+    // we split a warp into multiple sub-warps, each sub-warp is responsible
+    // for calculating the maximum value within an expert-group.
+    constexpr uint32_t ELTS_PER_SUB_WARP = (MT_WARP_SIZE / NUM_EXPERT_GROUP) * ELTS_PER_LDG;
+
+    const uint32_t row_id = blockIdx.x;
+
+    // 1. Run sigmoid along expert dimension
+    const int base_offset = row_id * NUM_EXPERT_GROUP * experts_per_group + experts_per_group * threadIdx.y;
+    const T* thread_read_base_ptr = gating_output + base_offset;
+    const T* thread_read_score_bias_base_ptr = e_score_correction_bias + experts_per_group * threadIdx.y;
+
+    // !!! 2-dim threadblock
+    uint32_t local_col_id = threadIdx.x * ELTS_PER_LDG;
+
+    // all elements will be loaded into thread registers, this is acceptable
+    // because the kernel assumes a small number of experts (maybe <= 256)
+    AccumulateType row_chunk[VPT * ELTS_PER_LDG] = {(AccumulateType)(-INFINITY)};
+    AccumulateType score_correction_bias_chunk[VPT * ELTS_PER_LDG] = {(AccumulateType)(0.0f)};
+    AccumulateAccessType* row_chunk_vec_ptr = reinterpret_cast<AccumulateAccessType*>(&row_chunk);
+    AccumulateAccessType* score_correction_bias_chunk_vec_ptr = reinterpret_cast<AccumulateAccessType*>(&score_correction_bias_chunk);
+    for (int ii = 0; ii < VPT; ii++) {
+        int offset = local_col_id + ii * ELTS_PER_SUB_WARP;
+        bool valid_pos = offset < experts_per_group;
+        const AccessType regs = valid_pos ?
+                                *reinterpret_cast<const AccessType*>(thread_read_base_ptr + offset) :
+                                (T)(-INFINITY);
+        const AccessType score_bias_regs = valid_pos ?
+                                           *reinterpret_cast<const AccessType*>(thread_read_score_bias_base_ptr + offset) :
+                                           (T)(0.0f);
+        AccumulateAccessType* row_chunk_cur_vec_ptr = row_chunk_vec_ptr + ii;
+        AccumulateAccessType* score_correction_bias_chunk_cur_vec_ptr = score_correction_bias_chunk_vec_ptr + ii;
+        if constexpr (std::is_same<AccumulateType, T>::value) {
+            *row_chunk_cur_vec_ptr = regs;
+            *score_correction_bias_chunk_cur_vec_ptr = score_bias_regs;
+        } else {
+            #pragma unroll
+            for (int k = 0; k < ELTS_PER_LDG; k++) {
+                row_chunk_cur_vec_ptr->data[k] = static_cast<AccumulateType>(regs.data[k]);
+                score_correction_bias_chunk_cur_vec_ptr->data[k] = static_cast<AccumulateType>(score_bias_regs.data[k]);
+            }
+        }
+    }
+
+    // 1.1 run sigmoid and apply bias correction
+    for (int ii = 0; ii < VPT * ELTS_PER_LDG; ii++) {
+        row_chunk[ii] = 1.f / (1.f + __expf(-row_chunk[ii]));
+        score_correction_bias_chunk[ii] += row_chunk[ii];
+    }
+
+    // 1.2 find max value in each expert group
+    // naive sort should be fine on small numel
+    AccumulateType maxval_per_group = static_cast<AccumulateType>(-INFINITY);
+    AccumulateType submaxval_per_group = static_cast<AccumulateType>(-INFINITY);
+    int max_idx = -1;
+    for (int ii = 0; ii < VPT * ELTS_PER_LDG; ii++) {
+        if (score_correction_bias_chunk[ii] > maxval_per_group) {
+            maxval_per_group = score_correction_bias_chunk[ii];
+            max_idx = ii;
+        }
+    }
+    for (int ii = 0; ii < VPT * ELTS_PER_LDG; ii++) {
+        if (ii != max_idx && (score_correction_bias_chunk[ii] > submaxval_per_group)) {
+            submaxval_per_group = score_correction_bias_chunk[ii];
+        }
+    }
+
+    AccumulateType other_maxvals[2];
+    #pragma unroll
+    for (int mask = 1; mask < THREADS_PER_EXPERT_GROUP; mask <<= 1) {
+        other_maxvals[0] = musa_shfl_xor_sync<AccumulateType, MT_WARP_SIZE>(maxval_per_group, mask);
+        other_maxvals[1] = musa_shfl_xor_sync<AccumulateType, MT_WARP_SIZE>(submaxval_per_group, mask);
+        for (int i = 0; i < 2; i++) {
+            if (other_maxvals[i] > maxval_per_group) {
+                submaxval_per_group = maxval_per_group;
+                maxval_per_group = other_maxvals[i];
+            } else if (other_maxvals[i] > submaxval_per_group) {
+                submaxval_per_group = other_maxvals[i];
+            }
+        }
+    }
+
+    maxval_per_group += submaxval_per_group;
+
+
+    // 2. Find the topk group
+    // use mask_per_group to mark the un-selected values as 0.0f, which keeps
+    // consistence with this implementation:
+    // tmp_scores = scores_for_choice.masked_fill(~score_mask.bool(), 0.0)
+    AccumulateType mask_per_group = static_cast<AccumulateType>(0.f);
+    for (int k_idx = 0; k_idx < topk_group; k_idx++) {
+        AccumulateType max_val = maxval_per_group;
+        int group_idx = threadIdx.y;
+
+        #pragma unroll
+        for (int mask = THREADS_PER_EXPERT_GROUP; mask < MT_WARP_SIZE; mask <<= 1) {
+            AccumulateType other_maxval = musa_shfl_xor_sync<AccumulateType, MT_WARP_SIZE>(max_val, mask);
+            int other_group_idx = musa_shfl_xor_sync<int, MT_WARP_SIZE>(group_idx, mask);
+
+            if (other_maxval > max_val || (other_maxval == max_val && other_group_idx < group_idx)) {
+                max_val = other_maxval;
+                group_idx = other_group_idx;
+            }
+        }
+
+        if (threadIdx.y == group_idx) {
+            mask_per_group = static_cast<AccumulateType>(1.f);
+            maxval_per_group = static_cast<AccumulateType>(-10000.f);
+        }
+    }
+
+    // 3. Find the topk
+    AccumulateType topk_weight_reg = (AccumulateType)(0.0f);
+    int topk_id_reg;
+    int lane_id = (threadIdx.x + threadIdx.y * blockDim.x) % MT_WARP_SIZE;
+    for (int vpt_id = 0; vpt_id < VPT; vpt_id++) {
+        int local_base_offset = local_col_id + vpt_id * ELTS_PER_SUB_WARP;
+        for (int ii = 0; ii < ELTS_PER_LDG; ii++) {
+            score_correction_bias_chunk[vpt_id * ELTS_PER_LDG + ii] = (local_base_offset + ii) < experts_per_group ?
+                                                    score_correction_bias_chunk[vpt_id * ELTS_PER_LDG + ii] * mask_per_group :
+                                                    static_cast<AccumulateType>(-INFINITY);
+        }
+    }
+    for (int k_idx = 0; k_idx < topk; k_idx++) {
+        AccumulateType max_val = static_cast<AccumulateType>(-INFINITY);
+        AccumulateType original_max_val = static_cast<AccumulateType>(-INFINITY);
+        int expert = threadIdx.y * experts_per_group + local_col_id;  // expert id will be updated later
+
+        // not all threads' row_chunk value are valid
+        for (int vpt_id = 0; vpt_id < VPT; vpt_id++) {
+            int local_base_offset = local_col_id + vpt_id * ELTS_PER_SUB_WARP;
+            for (int ii = 0; ii < ELTS_PER_LDG; ii++) {
+                if (score_correction_bias_chunk[vpt_id * ELTS_PER_LDG + ii] > max_val) {
+                    max_val = score_correction_bias_chunk[vpt_id * ELTS_PER_LDG + ii];
+                    original_max_val = row_chunk[vpt_id * ELTS_PER_LDG + ii];
+                    expert = threadIdx.y * experts_per_group + local_base_offset + ii;
+                }
+            }
+        }
+
+        #pragma unroll
+        for (int mask = MT_WARP_SIZE / 2; mask > 0; mask >>= 1) {
+            AccumulateType other_maxval = musa_shfl_xor_sync<AccumulateType, MT_WARP_SIZE>(max_val, mask);
+            AccumulateType other_original_maxval = musa_shfl_xor_sync<AccumulateType, MT_WARP_SIZE>(original_max_val, mask);
+            int other_expert = musa_shfl_xor_sync<int, MT_WARP_SIZE>(expert, mask);
+
+            if (other_maxval > max_val || ((!isinf(other_maxval) && !isinf(max_val)) && other_maxval == max_val && other_expert < expert)) {
+                max_val = other_maxval;
+                original_max_val = other_original_maxval;
+                expert = other_expert;
+            }
+        }
+
+        // now we find maximum value and expert index
+        const int local_expert_idx = expert % experts_per_group;
+        const int thread_to_clear = (local_expert_idx / ELTS_PER_LDG) % THREADS_PER_EXPERT_GROUP;
+        const int chunk_idx_to_clear = (local_expert_idx / ELTS_PER_SUB_WARP) * ELTS_PER_LDG + local_expert_idx % ELTS_PER_LDG;
+        if (k_idx + 1 < topk) {
+            if (threadIdx.y == (expert / experts_per_group) && threadIdx.x == thread_to_clear) {
+                score_correction_bias_chunk[chunk_idx_to_clear] = static_cast<AccumulateType>(-INFINITY);
+            }
+        }
+
+        if (lane_id == k_idx) {
+            topk_weight_reg = static_cast<AccumulateType>(original_max_val);
+            topk_id_reg = expert;
+        }
+    }
+
+    // 4. renormalization
+    if constexpr (RENORMALIZE) {
+        AccumulateType topk_sum = topk_weight_reg;
+        for (int mask = 1; mask < next_power_of_two(topk); mask <<= 1) {
+            AccumulateType other_sum = musa_shfl_xor_sync<AccumulateType, MT_WARP_SIZE>(topk_sum, mask);
+            topk_sum += other_sum;
+        }
+
+        if (lane_id < topk) {
+            // topk_weights[topk * row_id + lane_id] = static_cast<T>(topk_weight_reg / topk_sum);
+            topk_weights[topk * row_id + lane_id] = static_cast<float>(topk_weight_reg / topk_sum);
+            topk_indices[topk * row_id + lane_id] = topk_id_reg;
+        }
+    } else {
+        if (lane_id < topk) {
+            // topk_weights[topk * row_id + lane_id] = static_cast<T>(topk_weight_reg);
+            topk_weights[topk * row_id + lane_id] = static_cast<float>(topk_weight_reg);
+            topk_indices[topk * row_id + lane_id] = topk_id_reg;
+        }
+    }
+}
+
+
+// topk_weights won't be large in decode stage, element wise kernel will be fine
+template <
+    typename T,
+    typename std::enable_if<std::is_same<float, T>::value || std::is_same<__half, T>::value || std::is_same<__mt_bfloat16, T>::value>::type* = nullptr
+>
+__global__ void renormalize_topk_weights_kernel(T* topk_weights, int num_tokens, int num_cols) {
+    using AccumulateType = typename AccumulateTypeTraits<T>::type;
+
+    const uint32_t bid = blockIdx.x * blockDim.y + threadIdx.y;
+    if (bid >= num_tokens) {
+        return;
+    }
+    const T* thread_read_base_ptr = topk_weights + bid * num_cols;
+    T* thread_write_base_ptr = topk_weights + bid * num_cols;
+
+    AccumulateType sum = static_cast<AccumulateType>(0.f);
+    for (int tid = threadIdx.x; tid < num_cols; tid += blockDim.x) {
+        sum += static_cast<AccumulateType>(thread_read_base_ptr[tid]);
+    }
+
+    #pragma unroll
+    for (int mask = MT_WARP_SIZE / 2; mask > 0; mask >>= 1) {
+        AccumulateType other_sum = musa_shfl_xor_sync<AccumulateType, MT_WARP_SIZE>(sum, mask);
+        sum += other_sum;
+    }
+
+    for (int tid = threadIdx.x; tid < num_cols; tid += blockDim.x) {
+        thread_write_base_ptr[tid] = static_cast<T>(static_cast<AccumulateType>(thread_write_base_ptr[tid]) / sum);
+    }
+}
+
+
+#define LAUNCH_TOPK_GATING_SOFTMAX(TYPE, NUM_EXPERTS, NUM_EXPERT_GROUP)           \
+{\
+    constexpr std::size_t MAX_BYTES_PER_LDG = sizeof(TYPE);                    \
+    constexpr int BYTES_PER_LDG = MIN(MAX_BYTES_PER_LDG, sizeof(TYPE) * (NUM_EXPERTS / NUM_EXPERT_GROUP));\
+    constexpr int ELTS_PER_LDG = BYTES_PER_LDG / sizeof(TYPE);\
+    constexpr int VPT = MAX(1, NUM_EXPERTS / ELTS_PER_LDG / MT_WARP_SIZE);\
+    dim3 block(MT_WARP_SIZE / NUM_EXPERT_GROUP, NUM_EXPERT_GROUP);                                    \
+    dim3 grid(num_tokens);                 \
+    moe::grouped_topk_softmax<TYPE, VPT, NUM_EXPERT_GROUP, MT_WARP_SIZE / NUM_EXPERT_GROUP, ELTS_PER_LDG><<<grid, block, 0, stream>>>(    \
+        gating_output, softmax_res, group_indices,                     \
+        NUM_EXPERTS / NUM_EXPERT_GROUP, topk_group);\
+}
+
+
+#define LAUNCH_GROUPED_GATING_TOPK(TYPE, NUM_EXPERTS, NUM_EXPERT_GROUP)           \
+{\
+    constexpr std::size_t MAX_BYTES_PER_LDG = sizeof(TYPE);                    \
+    constexpr int BYTES_PER_LDG = MIN(MAX_BYTES_PER_LDG, sizeof(TYPE) * (NUM_EXPERTS / NUM_EXPERT_GROUP));\
+    constexpr int ELTS_PER_LDG = BYTES_PER_LDG / sizeof(TYPE);\
+    constexpr int VPT = MAX(1, NUM_EXPERTS / ELTS_PER_LDG / MT_WARP_SIZE);\
+    dim3 block(MT_WARP_SIZE / NUM_EXPERT_GROUP, NUM_EXPERT_GROUP);                                    \
+    dim3 grid(num_tokens);                 \
+    if (renormalize) {\
+        int shm_size = topk * sizeof(typename AccumulateTypeTraits<TYPE>::type);\
+        moe::mp31_grouped_gating_topk_sigmoid_kernel<TYPE, VPT, NUM_EXPERT_GROUP, MT_WARP_SIZE / NUM_EXPERT_GROUP, ELTS_PER_LDG, true><<<grid, block, 0, stream>>>(    \
+        gating_output, e_score_correction_bias, topk_weights, topk_indices,                   \
+        topk_group, topk, NUM_EXPERTS / NUM_EXPERT_GROUP);\
+    } else {\
+        moe::mp31_grouped_gating_topk_sigmoid_kernel<TYPE, VPT, NUM_EXPERT_GROUP, MT_WARP_SIZE / NUM_EXPERT_GROUP, ELTS_PER_LDG, false><<<grid, block, 0, stream>>>(    \
+        gating_output, e_score_correction_bias, topk_weights, topk_indices,                   \
+        topk_group, topk, NUM_EXPERTS / NUM_EXPERT_GROUP);\
+    }\
+}
+
+
+template <typename T>
+void topkGatingSoftmaxKernelLauncher(
+    const T* gating_output,
+    T* softmax_res,
+    int* group_indices,
+    const int num_tokens,
+    const int num_experts,
+    const int num_expert_group,
+    const int topk_group,
+    musaStream_t stream) {
+    static constexpr int WARPS_PER_TB = 1;
+
+    if (num_experts == 256) {
+        switch (num_expert_group) {
+            case 2:
+                LAUNCH_TOPK_GATING_SOFTMAX(T, 256, 2);
+                break;
+            case 4:
+                LAUNCH_TOPK_GATING_SOFTMAX(T, 256, 4);
+                break;
+            case 8:
+                LAUNCH_TOPK_GATING_SOFTMAX(T, 256, 8);
+                break;
+            case 16:
+                LAUNCH_TOPK_GATING_SOFTMAX(T, 256, 16);
+                break;
+            default: {
+                TORCH_CHECK(false, "Not implemented error");
+            }
+        }
+    } else {
+        TORCH_CHECK(false, "Not implemented error");
+    }
+}
+
+
+template <typename T>
+void MP31GroupedGatingTopkKernelLauncher(
+    float* topk_weights,
+    int* topk_indices,
+    const T* gating_output,
+    const T* e_score_correction_bias,
+    const int num_tokens,
+    const int num_experts,
+    const int num_expert_group,
+    const int topk_group,
+    const int topk,
+    const bool renormalize,
+    musaStream_t stream) {
+    static constexpr int WARPS_PER_TB = 1;
+
+    if (num_experts == 256) {
+        switch (num_expert_group) {
+            case 2:
+                LAUNCH_GROUPED_GATING_TOPK(T, 256, 2);
+                break;
+            case 4:
+                LAUNCH_GROUPED_GATING_TOPK(T, 256, 4);
+                break;
+            case 8:
+                LAUNCH_GROUPED_GATING_TOPK(T, 256, 8);
+                break;
+            case 16:
+                LAUNCH_GROUPED_GATING_TOPK(T, 256, 16);
+                break;
+            default: {
+                TORCH_CHECK(false, "Not implemented error");
+            }
+        }
+    } else {
+        TORCH_CHECK(false, "Not implemented error");
+    }
+}
