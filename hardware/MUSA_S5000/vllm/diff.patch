+#define INST(T)                                                                \
+  template StatusX GemvSwiGLU(T *o, const T *mat, const T *v, const int batch, \
+                              const int mat_m, const int mat_k, const int ldm, \
+                              const int batch_stride_m, const int inc_v,       \
+                              const int batch_stride_v, const int inc_o,       \
+                              const int batch_stride_o, double alpha,          \
