+
+    See mutlass/tensor_ref.h for more details about the mapping of the logical tensor index space to
+    linear memory.
+*/
+
+#pragma once
+
+#if !defined(__MUSACC_RTC__)
+#include <cmath>
+#endif
+
+#include "mutlass/mutlass.h"
+#include "mutlass/tensor_ref_planar_complex.h"
+
+namespace mutlass {
+
