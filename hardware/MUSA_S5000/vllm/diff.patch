+
+#pragma once
+
+#include <mute/tensor.hpp>
+#include <mutlass/fast_math.h>
+#include "../online_softmax_ops.hpp"
+
+using namespace mute;
+
+template <class LayoutAccum>
+MUTE_DEVICE
+auto
+mp22_convert_layout_acc_rowcol(LayoutAccum acc_layout) {
+  if constexpr (decltype(rank<0>(acc_layout))::value == 3) { // MP31
+    // from ((2, VN, VM), MMA_M, MMA_N) to ((VM, MMA_M),(2, VN, MMA_N));
+    static_assert(decltype(size<0, 0>(acc_layout))::value == 2);
+    static_assert(decltype(rank(acc_layout))::value == 3);
+    auto l = acc_layout;
+    return make_layout(make_layout(get<0,2>(l), get<1>(l)), make_layout(get<0,0>(l), get<0,1>(l), get<2>(l)));
+  } else {  // MP22
+    // from((2,4), MMA_M, MMA_N) to ((4, MMA_M), (2, MMA_N))
+    static_assert(decltype(size<0, 0>(acc_layout))::value == 2);
+    static_assert(decltype(size<0, 1>(acc_layout))::value == 4);
+    auto l = acc_layout;
+    return make_layout(make_layout(get<0,1>(l), get<1>(l)), make_layout(get<0,0>(l), get<2>(l)));
+  }
+}
+
+template <typename Tensor0, typename Tensor1, typename Operator>
+MUTE_DEVICE void quad_allreduce_(Tensor0& dst, Tensor1& src, Operator& op) {
+  MUTE_STATIC_ASSERT_V(size(dst) == size(src));
+
+  MUTE_UNROLL
+  for (int i = 0; i < size(dst); ++i) {
+    dst(i) = Allreduce<4>::run(src(i), op);
+  }
+}
+
+template <typename Tensor0, typename Tensor1, typename Operator>
+MUTE_DEVICE void extra_allreduce_(Tensor0& dst, Tensor1& src, Operator& op) {
+  MUTE_STATIC_ASSERT_V(size(dst) == size(src));
+  constexpr int mask = ((~(128 - 1)) & 0x7f) << 7 | (128 - 1);
+
+  MUTE_UNROLL
+  for (int i = 0; i < size(dst); ++i) {
+    int val = *reinterpret_cast<int32_t*>(&src(i));
+    int ret = __musa_shfl_xor_sync_i32(val, 32 & 0x7f, mask);
+    // TODO: assume float here...get type from tensor
+    dst(i) = op(src(i), *reinterpret_cast<float*>(&ret));
+  }
+}
+
+
+//////////////////////////////////////////////////////////////////////////////////////////////////
+
+template <class Fragment0, class Fragment1, class AccumType>
+MUTE_HOST_DEVICE
+void
+mp22_online_softmax_scale(Fragment0& accum, Fragment1& accum_softmax, AccumType rln2_scale) {
+  MUTE_UNROLL
+  for (int i = 0; i < size(accum); ++i) {
+    accum_softmax(i) = accum(i) * rln2_scale;
+  }
+}
+
+template <class Fragment0, class Fragment1, class AccumType, class Fragment2>
+MUTE_HOST_DEVICE
+void
+mp22_online_softmax_scale(Fragment0& accum, Fragment1& accum_softmax, AccumType rln2_scale, Fragment2& tPcP, int oob_n, bool cond) {
+  Tensor accum_dst = make_tensor(accum_softmax.data(), mp22_convert_layout_acc_rowcol(accum_softmax.layout()));
+  Tensor accum_src = make_tensor(accum.data(), mp22_convert_layout_acc_rowcol(accum.layout()));
+  Tensor cP_view   = make_tensor(tPcP.data(), mp22_convert_layout_acc_rowcol(tPcP.layout()));
+
+  MUTE_STATIC_ASSERT_V(size<0>(accum_dst) == size<0>(accum_src));
+  MUTE_STATIC_ASSERT_V(size<1>(accum_dst) == size<1>(accum_src));
+
+  //if (threadIdx.x == 0) {
+  //  printf("bid:%d cond:%d\n", blockIdx.x, cond);
+  //}
+
+  MUTE_UNROLL
+  for (int m = 0; m < size<0>(accum_dst); ++m) {
+    MUTE_UNROLL
+    for (int n = 0; n < size<1>(accum_dst); ++n) {
+      accum_dst(m, n) = (cond && get<1>(cP_view(0,n)) >= oob_n) ?
+                                -mutlass::platform::numeric_limits<AccumType>::infinity()
+                              : accum_src(m, n) * rln2_scale;
+    }
+  }
+
+}
+
+template <class ElementAccum, class Fragment0, class Fragmnet1>
+MUTE_HOST_DEVICE
+void
+mp22_online_softmax_row_max(Fragment0& accum_softmax,
+                       Fragmnet1& row_max,
+                       Fragmnet1& old_row_max,
+                       Fragmnet1& alpha) {
+  Tensor accum_s = make_tensor(accum_softmax.data(), mp22_convert_layout_acc_rowcol(accum_softmax.layout()));
+
+  MUTE_STATIC_ASSERT_V(size(row_max) == size<0>(accum_s));
+  MUTE_STATIC_ASSERT_V(size(old_row_max) == size<0>(accum_s));
+  MUTE_STATIC_ASSERT_V(size(alpha) == size<0>(accum_s));
+  //static_assert(size<1>(accum_s) == 16);
+
+  MaxOp<ElementAccum> op;
+  ThreadReduce<size<1>(accum_s)> thread_reduce;
+
+  thread_reduce.template run<true>(accum_s, row_max, op);
+
+  octave_allreduce_(row_max, row_max, op);
+  // use width=128 shulff xor
+  extra_allreduce_(row_max, row_max, op);
+
+
+  MUTE_UNROLL
+  for (int mi = 0; mi < size<0>(accum_s); ++mi) {
+    row_max(mi) = mutlass::fast_max(row_max(mi), old_row_max(mi));
+
+    alpha(mi) = old_row_max(mi) - row_max(mi);
+    alpha(mi) = exp2f(alpha(mi));
+    old_row_max(mi) = row_max(mi);
+  }
+
+
+  MUTE_UNROLL
+  for (int mi = 0; mi < size<0>(accum_s); ++mi) {
+    MUTE_UNROLL
+    for (int ni = 0; ni < size<1>(accum_s); ++ni) {
+      accum_s(mi, ni) = accum_s(mi, ni) - row_max(mi);
+    }
+  }
+}
+
+template <class Fragment0, class Fragment1>
+MUTE_HOST_DEVICE
+void
+mp22_update_accum(Fragment0& accum, Fragment1& alpha) {
+  Tensor accum_o = make_tensor(accum.data(), mp22_convert_layout_acc_rowcol(accum.layout()));
+  MUTE_STATIC_ASSERT_V(size(alpha) == size<0>(accum_o));
+
+  MUTE_UNROLL
+  for (int mi = 0; mi < size<0>(accum_o); ++mi) {
+    MUTE_UNROLL
+    for (int ni = 0; ni < size<1>(accum_o); ++ni) {
+      accum_o(mi, ni) *= alpha(mi);
+    }
+  }
+}
+
+template <class ElementAccum, class Fragment0, class Fragment1>
+MUTE_HOST_DEVICE
+void
+mp22_online_softmax_row_sum(Fragment0& accum_softmax, Fragment1& row_sum,
+                       Fragment1& lse, Fragment1& alpha) {
+  Tensor accum_s = make_tensor(accum_softmax.data(), mp22_convert_layout_acc_rowcol(accum_softmax.layout()));
+  //static_assert(size<1>(accum_s) == 16);
+  MUTE_STATIC_ASSERT_V(size<0>(accum_s) == size(row_sum));
+  SumOp<ElementAccum> op;
+  ThreadReduce<size<1>(accum_s)> thread_reduce;
+  thread_reduce.template run<true>(accum_s, row_sum, op);
+  octave_allreduce_(row_sum, row_sum, op);
+  // use width=128 shulff xor
+  extra_allreduce_(row_sum, row_sum, op);
+
+  MUTE_UNROLL
+  for (int mi = 0; mi < size<0>(accum_s); ++mi) {
+    lse(mi) = lse(mi) * alpha(mi) + row_sum(mi);
+  }
+}
+
+template <class Fragment0, class Fragment1>
+MUTE_HOST_DEVICE
+void
+mp22_apply_softmax_normalizer(Fragment0& accum, Fragment1& lse) {
+  Tensor accum_o = make_tensor(accum.data(), mp22_convert_layout_acc_rowcol(accum.layout()));
+  MUTE_STATIC_ASSERT_V(size<0>(accum_o) == size(lse));
+
+  Tensor rlse = make_fragment_like(lse);
+
+  MUTE_UNROLL
+  for (int i = 0; i < size(lse); ++i) {
+    rlse(i) = 1.0f / lse(i);
+  }
+  MUTE_UNROLL
+  for (int mi = 0; mi < size<0>(accum_o); ++mi) {
+    MUTE_UNROLL
+    for (int ni = 0; ni < size<1>(accum_o); ++ni) {
+      accum_o(mi, ni) *= rlse(mi);
+    }
+  }
+}
+
+template <class Fragment0, class Fragment1>
+MUTE_HOST_DEVICE
+void
+mp22_apply_causal_mask(Fragment0& accum_, Fragment1& tPcP_, int m_idx, int n_idx, bool debug) {
+  Tensor accum = make_tensor(accum_.data(), mp22_convert_layout_acc_rowcol(accum_.layout()));
+  Tensor tPcP  = make_tensor(tPcP_.data(), mp22_convert_layout_acc_rowcol(tPcP_.layout()));
+
+  MUTE_UNROLL
+  for (int mi = 0; mi < size<0>(accum); ++mi) {
+    const int row_idx = m_idx + get<0>(tPcP(mi, 0));
+    const int col_idx_limit = row_idx + 1;
+    MUTE_UNROLL
+    for (int ni = 0; ni < size<1>(accum); ++ni) {
+      const int col_idx = n_idx + get<1>(tPcP(0, ni));
+      //if (debug && blockIdx.x == 1) {
+      //  printf("tid:%d col_idx_limit:%d col_idx:%d\n", threadIdx.x, col_idx_limit, col_idx);
+      //}
+      if (col_idx >= col_idx_limit) {
+        accum(mi, ni) = -std::numeric_limits<float>::infinity();
+      }
+    }
+  }
+}
+
+template <bool zero_clean, bool check_n, class Tensor0, class Tensor1>
+MUTE_HOST_DEVICE
+void
+mp22_process_qk_oob(Tensor0& accum_, Tensor1& tPcP_, int m_base, int VALID_BLOCK_H, int Q_HEAD_NUM, int n_base, int n_bound) {
+
+  Tensor accum = make_tensor(accum_.data(), mp22_convert_layout_acc_rowcol(accum_.layout()));
+  Tensor tPcP  = make_tensor(tPcP_.data(), mp22_convert_layout_acc_rowcol(tPcP_.layout()));
+
+  MUTE_UNROLL
+  for (int mi = 0; mi < size<0>(accum); ++mi) {
+    // don't need?
+    //const bool valid_h = get<0>(tPcP(mi, 0)) < VALID_BLOCK_H && (m_base + get<0>(tPcP(mi, 0)) < Q_HEAD_NUM);
+    MUTE_UNROLL
+    for (int ni = 0; ni < size<1>(accum); ++ni) {
+      //bool valid_n = n_base + get<1>(tPcP(0,ni)) < n_bound;
+      //
+
+      bool valid_n = true;
+      if constexpr (check_n) {
+        valid_n = n_base + get<1>(tPcP(0,ni)) < n_bound;
+      }
+
+      float oob_value = -std::numeric_limits<float>::infinity();
+      if constexpr (zero_clean) {
+        oob_value = 0.0f;
+      }
+      accum(mi, ni) = valid_n ? accum(mi, ni) : oob_value;
+    }
+  }
+}
diff --git a/vllm_musa/csrc/decode_mla/mp22_impl/utils.hpp b/vllm_musa/csrc/decode_mla/mp22_impl/utils.hpp
new file mode 100644
index 000000000..4450c5528
--- /dev/null
+++ b/vllm_musa/csrc/decode_mla/mp22_impl/utils.hpp
@@ -0,0 +1,41 @@
+#pragma once
+
+#include <mute/tensor.hpp>
+
+template <
+  bool A_in_regs = false,
+  bool B_in_regs = false,
+  typename Tensor0,
+  typename Tensor1,
+  typename Tensor2,
+  typename Tensor3,
+  typename Tensor4,
+  typename TiledMma,
+  typename ThrCopyA,
+  typename ThrCopyB
+>
+MUTE_DEVICE
+void gemm(Tensor0& acc, Tensor1& tCrA, Tensor2& tCrB, Tensor3 const& tCsA,
+          Tensor4 const& tCsB, TiledMma tiled_mma,
+          ThrCopyA smem_thr_copy_A, ThrCopyB smem_thr_copy_B) {
+  MUTE_STATIC_ASSERT_V(size<1>(tCrA) == size<1>(acc));
+  MUTE_STATIC_ASSERT_V(size<1>(tCrB) == size<2>(acc));
+  MUTE_STATIC_ASSERT_V(size<2>(tCrA) == size<2>(tCrB));
+  Tensor tCrA_copy_view = smem_thr_copy_A.retile_D(tCrA);
+  MUTE_STATIC_ASSERT_V(size<1>(tCsA) == size<1>(tCrA_copy_view));
+  Tensor tCrB_copy_view = smem_thr_copy_B.retile_D(tCrB);
+  MUTE_STATIC_ASSERT_V(size<1>(tCsB) == size<1>(tCrB_copy_view));
+
+  if constexpr (!A_in_regs) { copy(tCsA(_,_,_0{}), tCrA_copy_view(_,_,_0{})); }
+  if constexpr (!B_in_regs) { copy(tCsB(_,_,_0{}), tCrB_copy_view(_,_,_0{})); }
+
+  MUTE_UNROLL
+  for (int i = 0; i < size<2>(tCrA); ++i) {
+    if (i < size<2>(tCrA) - 1) {
+      if constexpr (!A_in_regs) { copy(tCsA(_,_,i + 1), tCrA_copy_view(_,_,i + 1)); }
+      if constexpr (!B_in_regs) { copy(tCsB(_,_,i + 1), tCrB_copy_view(_,_,i + 1)); }
+    }
+
+    mute::gemm(tiled_mma, tCrA(_,_,i), tCrB(_,_,i), acc);
+  }
+}
diff --git a/vllm_musa/csrc/decode_mla/mp31_impl/decode_mla.hpp b/vllm_musa/csrc/decode_mla/mp31_impl/decode_mla.hpp
new file mode 100644
index 000000000..fa8d29ac1
--- /dev/null
+++ b/vllm_musa/csrc/decode_mla/mp31_impl/decode_mla.hpp
@@ -0,0 +1,600 @@
+#pragma once
+
+#include "kernel_tratis.hpp"
+#include "online_softmax.hpp"
+
+#include <mutlass/numeric_conversion.h>
+
+template <class KernelTraits>
+__global__ __launch_bounds__(KernelTraits::NumThreads, 1)
+void mla_decode(typename KernelTraits::PackGQAParams const params) {
+  #if defined(__MUSA_ARCH__) && (__MUSA_ARCH__ == 310)
+  __shared__ char __attribute__((aligned(256))) smem_buf[sizeof(typename KernelTraits::SharedStorage)];
+  auto& shared_storage = *reinterpret_cast<typename KernelTraits::SharedStorage*>(smem_buf);
+
+  auto [m_coord, h_kv_coord, batch_and_split_coord] = static_cast<uint3>(blockIdx);
+
+  auto split_coord = batch_and_split_coord % params.num_splits;
+  auto b_coord = batch_and_split_coord / params.num_splits;
+
+  int cur_batch_seq_len = params.ptr_seqlen[b_coord];
+
+  constexpr int BlockN = KernelTraits::BlockN;
+
+  int n_tiles = ceil_div(cur_batch_seq_len, BlockN);
+  int n_tiles_per_split = ceil_div(n_tiles, params.num_splits);
+
+  int split_kv_start = n_tiles_per_split * split_coord;
+  int split_kv_end   = min(split_kv_start + n_tiles_per_split, n_tiles);
+
+  // early return
+  if (split_kv_end <= split_kv_start) return;
+
+  int thread_idx = threadIdx.x;
+
+  //if (thread_idx == 0 && h_q_coord == 0) {
+  //  printf("batch_id:%d split_id:%d cur_seqlen:%d, n_tiles:%d split:(%d %d)\n", b_coord, split_coord, cur_batch_seq_len, n_tiles, split_kv_start, split_kv_end);
+  //}
+
+  const int* block_table = params.ptr_block_table + b_coord * params.stride_block_table_b;
+
+  Tensor sQ  = make_tensor(make_smem_ptr(shared_storage.smem_q.data()),  typename KernelTraits::SmemLayoutQ{});
+  Tensor sK  = make_tensor(make_smem_ptr(shared_storage.smem_k.data()),  typename KernelTraits::SmemLayoutK{});
+  Tensor sP  = make_tensor(make_smem_ptr(shared_storage.smem_p.data()),  typename KernelTraits::SmemLayoutP{});
+  Tensor sV  = make_tensor(make_smem_ptr(shared_storage.smem_v.data()),  typename KernelTraits::SmemLayoutV{});
