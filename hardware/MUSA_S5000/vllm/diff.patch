+#if !defined(__MUSACC_RTC__)
+template <class Shape, class Stride>
+MUTE_HOST std::ostream& operator<<(std::ostream& os, Layout<Shape,Stride> const& layout)
+{
+  return os << shape(layout) << ":" << stride(layout);
+}
+#endif
