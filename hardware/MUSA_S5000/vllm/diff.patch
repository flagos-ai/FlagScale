+  Tensor gK = local_tile(mK, tile_shape_K, make_coord(_, _0{}, coord_h));         // (CTA_KV, HEAD_DIM_QK, kv)
+  Tensor gV = local_tile(mV, tile_shape_V, make_coord(_, _0{}, coord_h));         // (CTA_KV, HEAD_DIM_VO, kv)
+  Tensor gO = local_tile(mO, tile_shape_O, make_coord(coord_q, _0{}, coord_h));   // (CTA_Q, CTA_KV, kv)
+  Tensor gL = local_tile(mL, tile_shape_O, make_coord(coord_q, _0{}, coord_h));
+
+  Tensor sQ  = make_tensor(make_smem_ptr(shared_storage.smem_q.data()), typename KernelTraits::SmemLayoutQ{});
+  Tensor sK  = make_tensor(make_smem_ptr(shared_storage.smem_k.data()), typename KernelTraits::SmemLayoutK{});
+  Tensor sV  = make_tensor(make_smem_ptr(shared_storage.smem_v.data()), typename KernelTraits::SmemLayoutV{});
