+class CustomMLACommonMetadataBuilder(MLACommonMetadataBuilder):
+
+    def __init__(self,
+                 runner: "GPUModelRunner",
+                 kv_cache_spec: AttentionSpec,
+                 block_table: BlockTable,
+                 metadata_cls: Optional[type[M]] = None):
+        super().__init__(runner, kv_cache_spec, block_table, metadata_cls=metadata_cls)
