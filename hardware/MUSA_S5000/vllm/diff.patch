+#include "attention_params.hpp"
+#include "attention_kernel.hpp"
+#include "reference_attention.hpp"
+
+///////////////////////////////////////////////////////////////////////////////////////////////////
+struct Options {
+  bool help = false;
+  bool verbose = false;
+  bool skip_check = false;;
+
+  bool varlen = false;
+
+  int q = 128;
+  int kv = 128;
+  int d_qk = 192;
+  int d_vo = 128;
+  int h = 1;
+  int h_kv = 1;
+  int b = 1;
+
+  int warmup_iter, benchmark_iter;
+  mutlass::Distribution::Kind dist_kind;
+
+  Options():
+    help(false),
+    verbose(false),
+    skip_check(false),
+    varlen(false),
+    dist_kind(mutlass::Distribution::Kind::Uniform),
+    warmup_iter(1), benchmark_iter(1),
+    b(1), d_qk(192),d_vo(128),
+    q(128), kv(128), h(1), h_kv(1)
+  { }
+
+  void parse(int argc, char const** args) {
+    mutlass::CommandLine cmd(argc, args);
+
+    if (cmd.check_cmd_line_flag("help")) {
+      help = true;
+      return;
+    }
+    if (cmd.check_cmd_line_flag("verbose")) {
+      verbose = true;
+    }
+    if (cmd.check_cmd_line_flag("skip-check")) {
+      skip_check = true;
+    }
+
+    if (cmd.check_cmd_line_flag("varlen")) {
+      varlen = true;
+    }
+
+    std::string dist_str;
+    cmd.get_cmd_line_argument("dist", dist_str);
+    if (dist_str == "gaussian") {
+      dist_kind = mutlass::Distribution::Gaussian;
+    }
+
+    Options defaults;
+
+    cmd.get_cmd_line_argument("b", b, defaults.b);
+    cmd.get_cmd_line_argument("d_qk", d_qk, defaults.d_qk);
+    cmd.get_cmd_line_argument("d_vo", d_vo, defaults.d_vo);
+    cmd.get_cmd_line_argument("q", q, defaults.q);
+    cmd.get_cmd_line_argument("kv", kv, defaults.kv);
+    cmd.get_cmd_line_argument("h", h, defaults.h);
+    cmd.get_cmd_line_argument("h_kv", h_kv, defaults.h_kv);
+    cmd.get_cmd_line_argument("warmup", warmup_iter, 1);
+    cmd.get_cmd_line_argument("bench", benchmark_iter, 1);
+  }
+
+  std::ostream & print_usage(std::ostream &out) const {
+    out << "FlashAttention Forward:\n\n"
+        << "Options:\n"
+        << "  --help                      If specified, displays this usage statement.\n"
+        << "  --verbose                   If specified, displays detail information.\n"
+        << "  --skip-check                If specified, skip the correctnes check\n"
+        << "  --varlen                    If specified, use varlen input\n"
+        << "  --dist                      Data distribution of input tensors.(--dist=uniform/gaussian, default: uniform)\n"
+        << "  --warmup=<int>              Warmup iterations(default: --warmup=1)\n"
+        << "  --bench=<int>               Benchmark iterations(default: --bench=1)\n"
+        << "  --b=<int>                   B extent\n"
+        << "  --h=<int>                   H extent\n"
+        << "  --h_kv=<int>                H_K/V extent\n"
+        << "  --q=<int>                   Q extent\n"
+        << "  --kv=<int>                  K/V exntent\n"
+        << "  --d_qk=<int>                D_QK extent\n"
+        << "  --d_vo=<int>                D_VO extent\n"
+        << std::endl;
+    return out;
+  }
+};
+
+///////////////////////////////////////////////////////////////////////////////////////////////////
+
+template <class Element>
+bool initialize_block(
+    mutlass::DeviceAllocation<Element>& block,
+    mutlass::Distribution::Kind dist_kind = mutlass::Distribution::Kind::Uniform,
+    bool all_one = false,
+    uint64_t seed=2024) {
+
+  if (dist_kind == mutlass::Distribution::Uniform) {
+    Element scope_max, scope_min;
+    int bits_input = mutlass::sizeof_bits<Element>::value;
+    if (bits_input == 1) {
+      scope_max = Element(2);
+      scope_min = Element(0);
+    } else if (bits_input <= 8) {
+      scope_max = Element(2);
+      scope_min = Element(-2);
+    } else if (all_one) {
+      scope_max = Element(1);
+      scope_min = Element(1);
+    } else {
+      scope_max = Element(2);
+      scope_min = Element(-2);
+    }
+    mutlass::reference::device::BlockFillRandomUniform(
+      block.get(), block.size(), seed, scope_max, scope_min, 0);
+  } else if (dist_kind == mutlass::Distribution::Gaussian) {
+    mutlass::reference::device::BlockFillRandomGaussian(
+      block.get(), block.size(), seed, Element(0.0f), Element(1.0f));
+  }
+  return true;
+}
+
+/////////////////////////////////////////////////////////////////////////////////////////////////////
+
+template <class KernelTraits>
+struct FlashAttentionFwdRunner {
+  static constexpr bool IsVarlen = KernelTraits::IsVarlen;
+  using ElementQ = typename KernelTraits::ElementQ;
+  using ElementKV = typename KernelTraits::ElementKV;
+  using ElementAccumulator = typename KernelTraits::ElementAccumulator;
+  static_assert(mute::is_same_v<ElementQ, ElementKV>);
+
+  using AttentionParams = AttentionParams<KernelTraits>;
+  using Arguments = typename AttentionParams::Arguments;
+  using Params = typename AttentionParams::Params;
+  using ProblemShape = typename AttentionParams::ProblemShape;
+
+  // Data members
+  mutlass::DeviceAllocation<ElementQ>  block_Q;
+  mutlass::DeviceAllocation<ElementKV> block_K;
+  mutlass::DeviceAllocation<ElementKV> block_V;
+  mutlass::DeviceAllocation<ElementQ>  block_O;
+  mutlass::DeviceAllocation<ElementKV> block_P;
+
+
+  // Varlen used
+  std::vector<int> cumulative_seqlen_q;
+  std::vector<int> cumulative_seqlen_kv;
+
+  mutlass::DeviceAllocation<int> device_cumulative_seqlen_q;
+  mutlass::DeviceAllocation<int> device_cumulative_seqlen_kv;
+
+  template <class ProblemShapeIn>
+  void initialize(ProblemShapeIn problem_shape, const Options& options) {
+    auto ShapeQ = select<0,2,4,5>(problem_shape);
+    auto ShapeK = select<1,2,4,5>(problem_shape);
+    auto ShapeV = select<1,3,4,5>(problem_shape);
+    auto ShapeO = select<0,3,4,5>(problem_shape);
+    auto ShapeP = select<0,1,4,5>(problem_shape);
+
+
+    block_Q.reset(size(ShapeQ));
+    block_K.reset(size(ShapeK));
+    block_V.reset(size(ShapeV));
+    block_O.reset(size(ShapeO));
+    block_P.reset(size(ShapeP));
+
+    initialize_block(block_Q, options.dist_kind);
+    initialize_block(block_K, options.dist_kind);
+    initialize_block(block_V, options.dist_kind);
+
+    musaMemset(block_O.get(), 0, block_O.bytes());
+  }
+
+  template <bool EnableSoftmax, bool WithCausal>
+  bool verify(const Options& options) {
+    using Element = ElementQ;
+    using ElementAccum = ElementAccumulator;
+    TestAttention<Element, ElementAccum> testBed(options.h, options.h_kv, options.b, options.d_qk, options.d_vo,
+                                                options.q, options.kv, /*alignment*/1, /*use_mask*/false, WithCausal);
+
+    testBed.initialize();
+
+    std::vector<ElementAccum> MiOut(options.q * options.h * options.b);
+    std::vector<ElementAccum> SprimeOut(options.q * options.h * options.b);
+
+    std::vector<Element> gpu_O(block_O.capacity);
+    std::vector<Element> ref_O = gpu_O;
+
+    block_O.copy_to_host(gpu_O.data());
+
+    constexpr bool use_pre_scaling = EnableSoftmax ? true : false;
+    constexpr bool use_pow2 = true;
+
+    #if DEVICE_REF
+    printf("Device Reference...\n");
+    mutlass::DeviceAllocation<Element> block_S_ref(block_S.capacity);
+    mutlass::DeviceAllocation<Element> block_O_ref(block_O.capacity);
+
+    testBed.compute(block_Q.get(), block_K.get(), block_V.get(),
+                    block_S_ref.get(), block_O_ref.get(),
+                    MiOut.data(), SprimeOut.data(),
+                    use_pow2, use_pre_scaling, EnableSoftmax);
+
+    block_O_ref.copy_to_host(ref_O.data());
+    musaDeviceSynchronize();
+
+    #else
+    printf("Host Reference...\n");
+    std::vector<Element> host_Q(block_Q.capacity);
+    std::vector<Element> host_K(block_K.capacity);
+    std::vector<Element> host_V(block_V.capacity);
+    std::vector<Element> host_P(block_P.capacity);
+
+    std::vector<Element> ref_S(block_P.capacity);
+
+    block_Q.copy_to_host(host_Q.data());
+    block_K.copy_to_host(host_K.data());
+    block_V.copy_to_host(host_V.data());
+    block_P.copy_to_host(host_P.data());
+
+    musaDeviceSynchronize();
+
+    testBed.compute(host_Q.data(), host_K.data(), host_V.data(),
+                    ref_S.data(), ref_O.data(),
+                    MiOut.data(), SprimeOut.data(),
+                    use_pow2, use_pre_scaling, EnableSoftmax);
+    #endif
+
+    //bool pass_p = verify_tensor<Element>(host_P, ref_S, false, true);
+    //printf("Pass P:%d\n", pass_p);
+    bool pass_o = verify_tensor<Element>(gpu_O, ref_O, false, true);
+    printf("Pass O:%d\n", pass_o);
+    return pass_o;
+  }
+
+
+  template <bool WithSoftmax, bool WithCausal>
+  bool verify_varlen(Params params) {
+    using Element = ElementQ;
+    using ElementAccum = ElementAccumulator;
+
+    auto problem_shape = params.problem_shape;
+    // use host cumulative length
+    get<0>(problem_shape).cumulative_length = cumulative_seqlen_q.data();
+    get<1>(problem_shape).cumulative_length = cumulative_seqlen_kv.data();
+
+    std::vector<Element> host_Q(block_Q.capacity);
+    std::vector<Element> host_K(block_K.capacity);
+    std::vector<Element> host_V(block_V.capacity);
+    std::vector<ElementAccum> host_P(block_P.capacity);
+    std::vector<Element> host_O(block_O.capacity);
+
+    block_Q.copy_to_host(host_Q.data());
+    block_K.copy_to_host(host_K.data());
+    block_V.copy_to_host(host_V.data());
+
+
+    // construct tensor
+    Tensor mQ = make_tensor(host_Q.data(), select<0, 2, 4>(problem_shape), select<0, 1, 2>(params.stride_Q));
+    Tensor mK = make_tensor(host_K.data(), select<1, 2, 4>(problem_shape), select<0, 1, 2>(params.stride_K));
+    Tensor mV = make_tensor(host_V.data(), select<1, 3, 4>(problem_shape), select<0, 1, 2>(params.stride_V));
+    Tensor mO = make_tensor(host_O.data(), select<0, 3, 4>(problem_shape), select<0, 1, 2>(params.stride_O));
+
+    TestVarlenAttention<Element, ElementAccum> testbed;
+    testbed.template compute<WithCausal, WithSoftmax, true>(problem_shape, mQ, mK, mV, mO);
+
+    std::vector<Element> gpu_O(block_O.capacity);
+    block_O.copy_to_host(gpu_O.data());
+
+    bool pass_o = verify_tensor<Element>(gpu_O, host_O, false, true);
+    printf("Pass O:%d\n", pass_o);
+    return pass_o;
+  }
+
+  template <class ProblemShapeIn>
+  auto
+  initialize_varlen(ProblemShapeIn problem_shape, const bool same_seqlen_qkv = true, const bool use_fixed_q=true) {
+    int B = get<5>(problem_shape);
+
+    cumulative_seqlen_q = {0};
+    cumulative_seqlen_kv = {0};
+
+    int total_seqlen_q = 0;
+    int total_seqlen_kv = 0;
+    int max_seqlen_q = 0;
+    int max_seqlen_kv = 0;
+
+    for (int b = 0; b < B; ++b) {
+      int seqlen_q = use_fixed_q ? get<0>(problem_shape) : rand() % 1024 + 1;
+      int seqlen_kv = same_seqlen_qkv ? seqlen_q : rand() % 1024 + 1;
+
+      total_seqlen_q += seqlen_q;
+      total_seqlen_kv += seqlen_kv;
+
+      max_seqlen_q = std::max(max_seqlen_q, seqlen_q);
+      max_seqlen_kv = std::max(max_seqlen_kv, seqlen_kv);
+
+      cumulative_seqlen_q.push_back(cumulative_seqlen_q.back() + seqlen_q);
+      cumulative_seqlen_kv.push_back(cumulative_seqlen_kv.back() + seqlen_kv);
+    }
+
+    printf("Q max seqlen:%d total seqlen q:%d\n", max_seqlen_q, total_seqlen_q);
+    printf("KV max seqlen:%d total seqlen kv:%d\n", max_seqlen_kv, total_seqlen_kv);
+
+    ProblemShapeIn problem_size_for_init = problem_shape;
+
+    // used to alloca tensor
+    get<5>(problem_size_for_init) = 1;
+    get<0>(problem_size_for_init) = total_seqlen_q;
+    get<1>(problem_size_for_init) = total_seqlen_kv;
+
+    ProblemShape problem_size_for_launch;
+
+    device_cumulative_seqlen_q.reset(cumulative_seqlen_q.size());
+    device_cumulative_seqlen_q.copy_from_host(cumulative_seqlen_q.data());
+
+    device_cumulative_seqlen_kv.reset(cumulative_seqlen_kv.size());
+    device_cumulative_seqlen_kv.copy_from_host(cumulative_seqlen_kv.data());
+
+    get<0>(problem_size_for_launch) = VariableLength{max_seqlen_q, device_cumulative_seqlen_q.get()};  // Q
+    get<1>(problem_size_for_launch) = VariableLength{max_seqlen_kv, device_cumulative_seqlen_kv.get()}; // KV
+    get<2>(problem_size_for_launch) = get<2>(problem_shape); // D_QK
+    get<3>(problem_size_for_launch) = get<3>(problem_shape); // D_VO
+    get<4>(problem_size_for_launch) = get<4>(problem_shape); // (H_R, H_KV)
+    get<5>(problem_size_for_launch) = get<5>(problem_shape); // B
+
+    return mute::make_tuple(problem_size_for_init, problem_size_for_launch);
+  }
+
+  template <bool EnableSoftmax, bool WithCausal>
+  bool run(const Options& options) {
+    int h_r = options.h / options.h_kv;
+    assert(options.h % options.h_kv == 0);
+
+    auto problem_shape_in = mute::make_shape(options.q, options.kv, options.d_qk, options.d_vo, mute::make_shape(h_r, options.h_kv), options.b);
+
+    ProblemShape problem_shape; // used to run
+    decltype(problem_shape_in) problem_size; // used to alloc
+
+    if constexpr (IsVarlen) {
+      auto [problem_shape_init, problem_shape_launch] = initialize_varlen(problem_shape_in, true, true);
+      problem_size = problem_shape_init;
+      problem_shape = problem_shape_launch;
+
+    } else {
+      problem_shape = problem_shape_in;
+      problem_size = problem_shape_in;
+    }
+
+    // use total seqlen to alloca buffer
+    initialize(problem_size, options);
+
+    Arguments arguments {block_Q.get(), block_K.get(), block_V.get(), block_O.get(), block_P.get()};
+
+    auto qkv_elem = make_shape(static_cast<int>(block_Q.capacity), static_cast<int>(block_K.capacity), static_cast<int>(block_V.capacity));
+
+    // use VariableLength to construct params
+    Params params = AttentionParams::to_underlying_arguments(problem_shape, arguments, qkv_elem);
+
+    print("ProblemShape(Q,K,D_QK,D_VO,(H_R,H_KV),B)"); print(problem_shape); print("\n");
+
+    dim3 block_dims(KernelTraits::NumThreads);
+    dim3 grid_dims(ceil_div(size<0>(problem_shape), KernelTraits::CTA_Q), size<4>(problem_shape), size<5>(problem_shape));
+
+    printf("grid:%d %d %d\n", grid_dims.x, grid_dims.y, grid_dims.z);
+
+
+    musaError_t error = musaDeviceSynchronize();
+    if (error != musaSuccess) {
+      std::cerr << "Somthing failed. Error is " << musaGetErrorString(error) << std::endl;
+      return false;
+    }
+
+    // check correctness
+    flash_atten_forward<KernelTraits, EnableSoftmax, WithCausal><<<grid_dims, block_dims>>>(params);
+
+    error = musaGetLastError();
+    if (error != musaSuccess) {
+      std::cerr << "Launch FA failed. Error is " << musaGetErrorString(error) << std::endl;
+      return false;
+    }
+
+    error = musaDeviceSynchronize();
+    if (error != musaSuccess) {
+      std::cerr << "Running FA failed. Error is " << musaGetErrorString(error) << std::endl;
+      return false;
+    }
+
+    printf("GPU FA finished\n");
+
+    if (!options.skip_check) {
+      bool passed = false;
+      if constexpr (IsVarlen) {
+        passed = verify_varlen<EnableSoftmax, WithCausal>(params);
+      } else {
+        passed = verify<EnableSoftmax, WithCausal>(options);
+      }
+
+      if (passed) {
+        std::cout << "FlasAttn Fwd Passed!\n";
+      } else {
+        std::cerr << "FlasAttn Fwd Failed!\n";
+        return false;
+      }
+    }
+
+    return true;
+  }
+};
+
+
+int main(int argc, char const** argv) {
+  musaDeviceProp props;
+  MUSA_CHECK(musaGetDeviceProperties(&props, 0));
+
+  if (props.major * 10 + props.minor != 22) {
+    std::cout
+      << "This experimental code requires a GPU of MooreThreads's MP22 Architecture.\n";
+    return 0;
+  }
+
+  Options options;
+  options.parse(argc, argv);
+
+  if (options.help) {
+    options.print_usage(std::cout) << std::endl;
+    return 0;
+  }
+
+  constexpr int TileM = 64;
+  constexpr int TileN = 64;
+  constexpr int HeadDimQK = 192;
+  constexpr int HeadDimVO = 128;
+
+
+  //print("TileShapeQKD:"); print(KernelTraits::TileShape_QKD{}); print("\n");
+  //print("TileShapePDV:"); print(KernelTraits::TileShape_PDV{}); print("\n");
+  //print("TileMmaQK:"); print(KernelTraits::TiledMmaQK{}); print("\n");
+  //print("TileMmaPV:"); print(KernelTraits::TiledMmaPV{}); print("\n");
+  //print("SmemQ:"); print(KernelTraits::SmemLayoutQ{}); print("\n");
+  //print("SmemK:"); print(KernelTraits::SmemLayoutK{}); print("\n");
+  //print("SmemV:"); print(KernelTraits::SmemLayoutV{}); print("\n");
+  //print("SmemP:"); print(KernelTraits::SmemLayoutP{}); print("\n");
+  //print("SmemSize:"); print(sizeof(KernelTraits::SharedStorage{})); print("\n");
+  //print("GmemTiledCopyQ:"); print(KernelTraits::GmemTiledCopyQ{}); print("\n");
+  //print("GmemTiledCopyK:"); print(KernelTraits::GmemTiledCopyK{}); print("\n");
+
+  if (options.varlen) {
+    using KernelTraits = AttentionForwardKernelTraits<HeadDimQK, HeadDimVO, TileM, TileN, /*IsVarlen*/true, /*IsQInReg*/true, /*robustQ*/true, /*robustK*/true, /*rosbutV*/true, mutlass::half_t>;
+    FlashAttentionFwdRunner<KernelTraits> runner;
+    runner.run</*Enable Softmax*/true, /*EnaleCausal*/true>(options);
+  } else {
+    using KernelTraits = AttentionForwardKernelTraits<HeadDimQK, HeadDimVO, TileM, TileN, /*IsVarlen*/false, /*IsQInReg*/true, /*robustQ*/true, /*robustK*/true, /*rosbutV*/true, mutlass::half_t>;
+    FlashAttentionFwdRunner<KernelTraits> runner;
+    runner.run</*Enable Softmax*/true, /*EnaleCausal*/true>(options);
+  }
+  return 0;
+}
