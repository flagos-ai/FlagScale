+/// Returns sqrt(2 * pi)  (specialization for bfloat16_t)
+template <> MUTLASS_HOST_DEVICE bfloat16_t root_two_pi<bfloat16_t>() {
+  uint16_t bits = 0x4020u;
+  return reinterpret_cast<bfloat16_t const &>(bits);
+}
