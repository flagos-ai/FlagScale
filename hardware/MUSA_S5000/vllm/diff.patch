+/**
+ * This is a standalone test for custom allreduce.
+ * To compile, make sure you have MPI and NCCL installed in your system.
+ * export MPI_HOME=XXX
+ * nvcc -O2 -arch=native -std=c++17 custom_all_reduce_test.cu -o
+ * custom_all_reduce_test -lmccl -I${MPI_HOME}/include -lmpi
+ *
+ * Warning: this C++ test is not designed to be very readable and was used
+ * during the rapid prototyping process.
+ *
+ * To run:
+ * mpirun --allow-run-as-root -np 8 ./custom_all_reduce_test
+ */
+ #include <musa.h>
+ #include <murand_kernel.h>
+ #include <stdio.h>
+ #include <stdlib.h>
+
+ #include <limits>
+ #include <vector>
+
+ #include "musa_profiler_api.h"
+ #include "custom_all_reduce.muh"
+ #include "mpi.h"
+#include "mccl.h"
+#include "custom_all_reduce.muh"
+
+#define MUSACHECK(cmd)                                              \
+  do {                                                              \
+    musaError_t e = cmd;                                            \
+    if (e != musaSuccess) {                                         \
+      printf("Failed: Cuda error %s:%d '%s'\n", __FILE__, __LINE__, \
+             musaGetErrorString(e));                                \
+      exit(EXIT_FAILURE);                                           \
+    }                                                               \
+  } while (0)
+
+ #define MPICHECK(cmd)                                                  \
+   do {                                                                 \
+     int e = cmd;                                                       \
+     if (e != MPI_SUCCESS) {                                            \
+       printf("Failed: MPI error %s:%d '%d'\n", __FILE__, __LINE__, e); \
+       exit(EXIT_FAILURE);                                              \
+     }                                                                  \
+   } while (0)
+
+ #define NCCLCHECK(cmd)                                              \
+   do {                                                              \
+     mcclResult_t r = cmd;                                           \
+     if (r != mcclSuccess) {                                         \
+       printf("Failed, NCCL error %s:%d '%s'\n", __FILE__, __LINE__, \
+              mcclGetErrorString(r));                                \
+       exit(EXIT_FAILURE);                                           \
+     }                                                               \
+   } while (0)
+
+ #ifdef USE_ROCM
+ __global__ void dummy_kernel() {
+   for (int i = 0; i < 100; i++) {
+     uint64_t start = wall_clock64();
+     uint64_t cycles_elapsed;
+     do {
+       cycles_elapsed = wall_clock64() - start;
+     } while (cycles_elapsed < 100);
+   }
+   for (int i = 0; i < 100; i++) __nanosleep(1000000);  // 100ms
+ }
+ #else
+ __global__ void dummy_kernel() {
+   #if defined(__CUDA_ARCH__) && __CUDA_ARCH__ >= 700
+   for (int i = 0; i < 100; i++) __nanosleep(1000000);  // 100ms
+   #else
+   for (int i = 0; i < 100; i++) {
+     long long int start = clock64();
+     while (clock64() - start < 150000000);  // approximately 98.4ms on P40
+   }
+   #endif
+ }
+ #endif
+
+ template <typename T>
+ __global__ void set_data(T* data, int size, int myRank) {
+   for (int idx = blockIdx.x * blockDim.x + threadIdx.x; idx < size;
+        idx += gridDim.x * blockDim.x) {
+     data[idx] = myRank * 0.11f;
+   }
+ }
+
+ template <typename T>
+ __global__ void convert_data(const T* data1, const T* data2, double* fdata1,
+                              double* fdata2, int size) {
+   for (int idx = blockIdx.x * blockDim.x + threadIdx.x; idx < size;
+        idx += gridDim.x * blockDim.x) {
+     fdata1[idx] = data1[idx];
+     fdata2[idx] = data2[idx];
+   }
+ }
+
+ __global__ void init_rand(murandState_t* state, int size, int nRanks) {
+   for (int idx = blockIdx.x * blockDim.x + threadIdx.x; idx < size;
+        idx += gridDim.x * blockDim.x) {
+     for (int i = 0; i < nRanks; i++) {
+       murand_init(i + 1, idx, 0, &state[idx * nRanks + i]);
+     }
+   }
+ }
+
+ template <typename T>
+ __global__ void gen_data(murandState_t* state, T* data, double* ground_truth,
+                          int myRank, int nRanks, int size) {
+   for (int idx = blockIdx.x * blockDim.x + threadIdx.x; idx < size;
+        idx += gridDim.x * blockDim.x) {
+     double sum = 0.0;
+     for (int i = 0; i < nRanks; i++) {
+       double val = murand_uniform_double(&state[idx * nRanks + i]) * 4;
+       T hval = val;  // downcast first
+       sum += static_cast<double>(hval);
+       if (i == myRank) data[idx] = hval;
+     }
+     ground_truth[idx] = sum;
+   }
+ }
+
+ template <typename T>
+ void run(int myRank, int nRanks, mcclComm_t& comm, int threads, int block_limit,
+          int data_size, bool performance_test) {
+   T* result;
+   musaStream_t stream;
+   MUSACHECK(musaStreamCreateWithFlags(&stream, musaStreamNonBlocking));
+   MUSACHECK(musaMalloc(&result, data_size * sizeof(T)));
+   MUSACHECK(musaMemset(result, 0, data_size * sizeof(T)));
+
+   musaIpcMemHandle_t self_data_handle;
+   musaIpcMemHandle_t data_handles[8];
+   vllm_musa::Signal* buffer;
+   T* self_data_copy;
+   /**
+    * Allocate IPC buffer
+    *
+    * The first section is a temporary buffer for storing intermediate allreduce
+    * results, if a particular algorithm requires it. The second section is for
+    * the input to the allreduce. The actual API takes the input pointer as an
+    * argument (that is, they can and usually should be allocated separately).
+    * But since the input pointers and the temporary buffer all require IPC
+    * registration, they are allocated and registered together in the test for
+    * convenience.
+    */
+ #ifdef USE_ROCM
+   MUSACHECK(hipExtMallocWithFlags(
+       (void**)&buffer, 2 * data_size * sizeof(T) + sizeof(vllm_musa::Signal),
+       hipDeviceMallocUncached));
+ #else
+   MUSACHECK(
+       musaMalloc(&buffer, 2 * data_size * sizeof(T) + sizeof(vllm_musa::Signal)));
+ #endif
+   MUSACHECK(
+       musaMemset(buffer, 0, 2 * data_size * sizeof(T) + sizeof(vllm_musa::Signal)));
+   MUSACHECK(musaMalloc(&self_data_copy, data_size * sizeof(T)));
+   MUSACHECK(musaIpcGetMemHandle(&self_data_handle, buffer));
+
+   MPICHECK(MPI_Allgather(&self_data_handle, sizeof(musaIpcMemHandle_t),
+                          MPI_BYTE, data_handles, sizeof(musaIpcMemHandle_t),
+                          MPI_BYTE, MPI_COMM_WORLD));
+
+   void* rank_data;
+   size_t rank_data_sz = 16 * 1024 * 1024;
+   MUSACHECK(musaMalloc(&rank_data, rank_data_sz));
+   vllm_musa::Signal* ipc_ptrs[8];
+   for (int i = 0; i < nRanks; i++) {
+     if (i == myRank)
+       ipc_ptrs[i] = buffer;
+     else
+       MUSACHECK(musaIpcOpenMemHandle((void**)&ipc_ptrs[i], data_handles[i],
+                                      musaIpcMemLazyEnablePeerAccess));
+   }
+   vllm_musa::CustomAllreduce fa(ipc_ptrs, rank_data, rank_data_sz, myRank, nRanks);
+   auto* self_data =
+       reinterpret_cast<T*>(reinterpret_cast<char*>(buffer) +
+                            sizeof(vllm_musa::Signal) + data_size * sizeof(T));
+   // hack buffer registration
+   {
+     void* data[8];
+     for (int i = 0; i < nRanks; i++) {
+       data[i] =
+           ((char*)ipc_ptrs[i]) + sizeof(vllm_musa::Signal) + data_size * sizeof(T);
+     }
+     fa.register_buffer(data);
+   }
+
+   double* ground_truth;
+   MUSACHECK(musaMallocHost(&ground_truth, data_size * sizeof(double)));
+   murandState_t* states;
+   MUSACHECK(musaMalloc(&states, sizeof(murandState_t) * nRanks * data_size));
+   init_rand<<<108, 1024, 0, stream>>>(states, data_size, nRanks);
+   gen_data<T><<<108, 1024, 0, stream>>>(states, self_data, ground_truth, myRank,
+                                         nRanks, data_size);
+   MUSACHECK(musaMemcpyAsync(self_data_copy, self_data, data_size * sizeof(T),
+                             musaMemcpyDeviceToDevice, stream));
+   musaEvent_t start, stop;
+   MUSACHECK(musaEventCreate(&start));
+   MUSACHECK(musaEventCreate(&stop));
+
+   mcclDataType_t mcclDtype;
+   if (std::is_same<T, half>::value) {
+     mcclDtype = mcclFloat16;
+   } else if (std::is_same<T, mt_bfloat16>::value) {
+     mcclDtype = mcclBfloat16;
+   } else {
+     mcclDtype = mcclFloat;
+   }
+   double *mccl_result, *my_result;
+   MUSACHECK(musaMallocHost(&mccl_result, data_size * sizeof(double)));
+   MUSACHECK(musaMallocHost(&my_result, data_size * sizeof(double)));
+   if (performance_test) {
+     dummy_kernel<<<1, 1, 0, stream>>>();
+     constexpr int warmup_iters = 5;
+     constexpr int num_iters = 100;
+     // warmup
+     for (int i = 0; i < warmup_iters; i++) {
+       NCCLCHECK(mcclAllReduce(result, result, data_size, mcclDtype, mcclSum,
+                               comm, stream));
+     }
+     MUSACHECK(musaEventRecord(start, stream));
+     for (int i = 0; i < num_iters; i++) {
+       NCCLCHECK(mcclAllReduce(result, result, data_size, mcclDtype, mcclSum,
+                               comm, stream));
+     }
+     MUSACHECK(musaEventRecord(stop, stream));
+     MUSACHECK(musaStreamSynchronize(stream));
+     float allreduce_ms = 0;
+     musaEventElapsedTime(&allreduce_ms, start, stop);
+
+     dummy_kernel<<<1, 1, 0, stream>>>();
+     // warm up
+     for (int i = 0; i < warmup_iters; i++) {
+       fa.allreduce<T>(stream, self_data, result, data_size, threads,
+                       block_limit);
+     }
+     MUSACHECK(musaEventRecord(start, stream));
+     for (int i = 0; i < num_iters; i++) {
+       fa.allreduce<T>(stream, self_data, result, data_size, threads,
+                       block_limit);
+     }
+     MUSACHECK(musaEventRecord(stop, stream));
+     MUSACHECK(musaStreamSynchronize(stream));
+
+     float duration_ms = 0;
+     musaEventElapsedTime(&duration_ms, start, stop);
+     if (myRank == 0)
+       printf(
+           "Rank %d done, nGPUs:%d, sz (kb): %d, %d, %d, my time:%.2fus, mccl "
+           "time:%.2fus\n",
+           myRank, nRanks, data_size * sizeof(T) / 1024, threads, block_limit,
+           duration_ms * 1e3 / num_iters, allreduce_ms * 1e3 / num_iters);
+
+     // And wait for all the queued up work to complete
+     MUSACHECK(musaStreamSynchronize(stream));
+
+     NCCLCHECK(mcclAllReduce(self_data_copy, self_data, data_size, mcclDtype,
+                             mcclSum, comm, stream));
+
+     convert_data<T><<<108, 1024, 0, stream>>>(self_data, result, mccl_result,
+                                               my_result, data_size);
+     MUSACHECK(musaStreamSynchronize(stream));
+
+     for (unsigned long j = 0; j < data_size; j++) {
+       auto diff = abs(mccl_result[j] - my_result[j]);
+       if (diff >= 4e-2) {
+         printf("Rank %d: Verification mismatch at %lld: %f != (my) %f, gt=%f\n",
+                myRank, j, mccl_result[j], my_result[j], ground_truth[j]);
+         break;
+       }
+     }
+     long double mccl_diffs = 0.0;
+     long double my_diffs = 0.0;
+     for (int j = 0; j < data_size; j++) {
+       mccl_diffs += abs(mccl_result[j] - ground_truth[j]);
+       my_diffs += abs(my_result[j] - ground_truth[j]);
+     }
+     if (myRank == 0)
+       std::cout << "average abs diffs: mccl: " << mccl_diffs / data_size
+                 << " me: " << my_diffs / data_size << std::endl;
+   } else {
+     for (int i = 0; i < 100; i++) {
+       fa.allreduce<T>(stream, self_data, result, data_size, threads,
+                       block_limit);
+       MUSACHECK(musaStreamSynchronize(stream));
+       NCCLCHECK(mcclAllReduce(self_data, self_data_copy, data_size, mcclDtype,
+                               mcclSum, comm, stream));
+       convert_data<T><<<108, 1024, 0, stream>>>(
+           self_data_copy, result, mccl_result, my_result, data_size);
+       MUSACHECK(musaStreamSynchronize(stream));
+
+       for (unsigned long j = 0; j < data_size; j++) {
+         auto diff = abs(mccl_result[j] - my_result[j]);
+         if (diff >= 4e-2) {
+           printf(
+               "Rank %d: Verification mismatch at %lld: %f != (my) %f, gt=%f\n",
+               myRank, j, mccl_result[j], my_result[j], ground_truth[j]);
+           break;
+         }
+       }
+     }
+     if (myRank == 0)
+       printf("Test passed: nGPUs:%d, sz (kb): %d, %d, %d\n", nRanks,
+              data_size * sizeof(T) / 1024, threads, block_limit);
+     // long double mccl_diffs = 0.0;
+     // long double my_diffs = 0.0;
+     // for (int j = 0; j < data_size; j++) {
+     //   mccl_diffs += abs(mccl_result[j] - ground_truth[j]);
+     //   my_diffs += abs(my_result[j] - ground_truth[j]);
+     // }
+     // if (myRank == 0)
+     //   std::cout << "average abs diffs: mccl: " << mccl_diffs / data_size
+     //             << " me: " << my_diffs / data_size << std::endl;
+   }
+
+   MUSACHECK(musaFree(result));
+   MUSACHECK(musaFree(self_data_copy));
+   MUSACHECK(musaFree(rank_data));
+   MUSACHECK(musaFree(buffer));
+   MUSACHECK(musaFree(states));
+   MUSACHECK(musaFreeHost(ground_truth));
+   MUSACHECK(musaFreeHost(mccl_result));
+   MUSACHECK(musaFreeHost(my_result));
+   MUSACHECK(musaStreamDestroy(stream));
+ }
+
+ int main(int argc, char** argv) {
+   int nRanks, myRank;
+   MPICHECK(MPI_Init(&argc, &argv));
+   MPICHECK(MPI_Comm_rank(MPI_COMM_WORLD, &myRank));
+   MPICHECK(MPI_Comm_size(MPI_COMM_WORLD, &nRanks));
+   MUSACHECK(musaSetDevice(myRank));
+   mcclUniqueId id;
+   mcclComm_t comm;
+   if (myRank == 0) mcclGetUniqueId(&id);
+   MPICHECK(MPI_Bcast(static_cast<void*>(&id), sizeof(id), MPI_BYTE, 0,
+                      MPI_COMM_WORLD));
+   NCCLCHECK(mcclCommInitRank(&comm, nRanks, id, myRank));
+
+   bool performance_test = true;
+   musaProfilerStart();
+   // Uncomment to scan through different block size configs.
+   for (int threads : {256, 512, 1024}) {
+      for (int block_limit = 16; block_limit < 112; block_limit += 4) {
+        run<half>(myRank, nRanks, comm, threads, block_limit, 1024 * 1024,
+        performance_test);
+      }
+   }
+   const int block_limit = 16;
+   // Scan through different sizes to test performance.
+   for (int sz = 512; sz <= (8 << 20); sz *= 2) {
+     run<half>(myRank, nRanks, comm, 512, 36, sz + 8 * 47, performance_test);
+   }
+
+   musaProfilerStop();
+   MPICHECK(MPI_Finalize());
+   return EXIT_SUCCESS;
+ }
