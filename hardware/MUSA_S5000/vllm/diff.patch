+        }
+
+        auto q_ptr = Q.data_ptr();
+        auto k_ptr = K.data_ptr();
+        auto v_ptr = V.data_ptr();
+        auto o_ptr = O.data_ptr();
+        auto l_ptr = return_softmax_lse ? lse.value().data_ptr() : nullptr;
+        auto cu_q_ptr = cu_q_seqlen.data_ptr<int>();
+        auto cu_kv_ptr = cu_kv_seqlen.data_ptr<int>();
+
+        DISPATCH_TYPE(dtype, "varlen_fwd", {
+            if (return_softmax_lse)
+            {
+                dispatch_head_dims_varlen<scalar_t, true>(
+                    d_qk, d_vo,
+                    static_cast<scalar_t *>(q_ptr),
+                    static_cast<scalar_t *>(k_ptr),
+                    static_cast<scalar_t *>(v_ptr),
+                    static_cast<scalar_t *>(o_ptr),
+                    static_cast<scalar_t *>(P),
+                    static_cast<float *>(l_ptr),
+                    max_seqlen_q, max_seqlen_kv, num_head, num_head_kv, batch, causal, qkv_elem,
+                    Q.stride(0), Q.stride(1), 0, // q strides
+                    K.stride(0), K.stride(1), 0, // k strides
+                    V.stride(0), V.stride(1), 0, // v strides
+                    O.stride(0), O.stride(1), 0, // o strides
+                    return_softmax_lse ? lse.value().stride(1) : 0,
+                    return_softmax_lse ? lse.value().stride(0) : 0,
+                    0, // l_batch_stride
+                    cu_q_ptr, cu_kv_ptr);
+            }
+            else
+            {
+                dispatch_head_dims_varlen<scalar_t, false>(
+                    d_qk, d_vo,
+                    static_cast<scalar_t *>(q_ptr),
+                    static_cast<scalar_t *>(k_ptr),
+                    static_cast<scalar_t *>(v_ptr),
+                    static_cast<scalar_t *>(o_ptr),
+                    static_cast<scalar_t *>(P),
+                    static_cast<float *>(l_ptr),
+                    max_seqlen_q, max_seqlen_kv, num_head, num_head_kv, batch, causal, qkv_elem,
