+        MUTE_UNROLL
+        for (int ni = 0; ni < size<1>(accum_p_mn); ++ni) {
+          //bool is_oob_token = is_oob_tile && (cur_tile_idx * KernelTraits::BlockN + get<1>(tPcP_mn(0, ni))) >= cur_batch_seq_len;
+          bool is_oob_token = get<1>(tPcP_mn(0, ni)) >= (cur_batch_seq_len - cur_tile_idx * KernelTraits::BlockN);
+          MUTE_UNROLL
+          for (int mi = 0; mi < size<0>(accum_p_mn); ++mi) {
+            if constexpr (!KernelTraits::IsCausal) {
+              accum_p_mn(mi, ni) = is_oob_token ? -mutlass::platform::numeric_limits<typename KernelTraits::ElementAccum>::infinity() : accum_p_mn(mi ,ni);
+            } else {
+              int row = get<0>(tPcP_mn(mi, 0));
+              // int col_limit_right = cur_batch_seq_len - cur_tile_idx * KernelTraits::BlockN - (params.q_seq_per_hkv - 1 - (m_coord * KernelTraits::BlockM + row)) / params.h_r;
+              int col_limit_right = (m_coord * KernelTraits::BlockM + row) / params.h_r + cur_batch_seq_len - params.q_seq_per_hkv / params.h_r - (cur_tile_idx) * KernelTraits::BlockN;
