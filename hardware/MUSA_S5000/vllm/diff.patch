+
+  using SmemLayoutKMODEL = decltype(tile_to_shape(SmemLayoutAtomK{}, make_shape(get<1>(TileShape_QKD{}), Int<512>{})));
+  using SmemLayoutKPE    = decltype(tile_to_shape(SmemLayoutAtomK{}, make_shape(get<1>(TileShape_QKD{}), Int<64>{})));
