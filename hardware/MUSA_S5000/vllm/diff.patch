+            k_seq_stride, k_head_stride, k_batch_stride,
+            v_seq_stride, v_head_stride, v_batch_stride,
+            o_seq_stride, o_head_stride, o_batch_stride,
+            l_seq_stride, l_head_stride, l_batch_stride,
+            cu_q_ptr, cu_kv_ptr, max_seqlen_q, max_seqlen_kv);
+    } else {
+        TORCH_CHECK(false, "Unsupported head dimensions: d_qk=", d_qk, ", d_vo=", d_vo);
+    }
+}
+
+void flash_attn_fwd(
+    const torch::Tensor &Q,            // verlen ? [total_seqlen, num_head, qk_head_dim] : [batch, num_head, seqlen, qk_head_dim]
+    const torch::Tensor &K,            // verlen ? [total_seqlen, kv_num_head, qk_head_dim] : [batch, kv_num_head, seqlen, qk_head_dim]
+    const torch::Tensor &V,            // verlen ? [total_seqlen, kv_num_head, vo_head_dim] : [batch, kv_num_head, seqlen, vo_head_dim]
+    torch::Tensor &O,                  // [total_seqlen, num_head, d_vo]
+    c10::optional<torch::Tensor> &lse, // [num_head, total_seqlen]
+    const torch::Tensor &cu_q_seqlen,
+    const torch::Tensor &cu_kv_seqlen,
+    int max_seqlen_q,
+    int max_seqlen_kv,
+    bool causal,
+    bool varlen,
+    bool return_softmax_lse)
+{
+    TORCH_CHECK(Q.dim() == (varlen ? 3 : 4), "Q must be ", varlen ? 3 : 4, "D");
+    TORCH_CHECK(K.dim() == (varlen ? 3 : 4), "K must be ", varlen ? 3 : 4, "D");
+    TORCH_CHECK(V.dim() == (varlen ? 3 : 4), "V must be ", varlen ? 3 : 4, "D");
+
+    int current_arch = at::musa::getMUSAArch();
+    TORCH_CHECK(current_arch == 220, "flash_attn_varlen_fun not support on MUSA arch ", current_arch);
+
+    const auto dtype = Q.scalar_type();
+    TORCH_CHECK(dtype == K.scalar_type() && dtype == V.scalar_type(),
+                "Q, K, V must have same dtype");
+    TORCH_CHECK(dtype == at::ScalarType::BFloat16 || dtype == at::ScalarType::Half,
+                "Only BFloat16 and Half supported");
+
+    TORCH_CHECK(O.is_contiguous(), "O must be contiguous");
+    TORCH_CHECK(O.scalar_type() == dtype, "O must have same dtype as inputs");
+
+    if (return_softmax_lse)
+    {
+        TORCH_CHECK(lse.has_value(), "lse tensor must be provided when return_softmax_lse=true");
+        auto &lse_tensor = lse.value();
+        TORCH_CHECK(lse_tensor.scalar_type() == torch::kFloat32, "lse must be float32");
+        TORCH_CHECK(lse_tensor.is_contiguous(), "lse must be contiguous");
+    }
+
+    void *P = nullptr;
+    int q_elem = Q.numel();
+    int k_elem = K.numel();
+    int v_elem = V.numel();
+    auto qkv_elem = mute::make_shape(q_elem, k_elem, v_elem);
+    const auto stream = at::musa::getCurrentMUSAStream();
+    const int d_qk = Q.size(-1);
+    const int d_vo = V.size(-1);
+
+    if (varlen)
+    {
+        TORCH_CHECK(cu_q_seqlen.defined() && cu_kv_seqlen.defined(),
+                    "cu_seqlens must be defined for varlen mode");
+        TORCH_CHECK(cu_q_seqlen.dim() == 1, "cu_q_seqlen must be 1D");
+        TORCH_CHECK(cu_kv_seqlen.dim() == 1, "cu_kv_seqlen must be 1D");
+
+        const int batch = cu_q_seqlen.size(0) - 1;
+        const int num_head = Q.size(1);
+        const int num_head_kv = K.size(1);
+        const int total_seqlen = Q.size(0);
+
+        TORCH_CHECK(O.sizes() == torch::IntArrayRef({total_seqlen, num_head, d_vo}),
+                    "O has wrong shape");
+
+        if (return_softmax_lse)
+        {
+            auto &lse_tensor = lse.value();
+            TORCH_CHECK(lse_tensor.sizes() == torch::IntArrayRef({num_head, total_seqlen}),
