@@ -0,0 +1,171 @@
+# SPDX-License-Identifier: Apache-2.0
+
+from typing import Any, Optional
+
+import torch
+
+from vllm.attention.backends.abstract import (AttentionType,
+                                              is_quantized_kv_cache)
+from vllm.attention.ops.triton_decode_attention import decode_attention_fwd
+from vllm.logger import init_logger
+from vllm.v1.attention.backends.mla.common import (MLACommonBackend,
+                                                   MLACommonImpl,
+                                                   MLACommonMetadata)
+from vllm.v1.attention.backends.mla.triton_mla import TritonMLAImpl
+from vllm_musa.platforms.musa import on_ph1, on_qy2
+
+logger = init_logger(__name__)
+
+class CustomTritonMLAImpl(TritonMLAImpl):
+
+    def __init__(
+            self,
+            num_heads: int,
+            head_size: int,
+            scale: float,
+            num_kv_heads: int,
+            alibi_slopes: Optional[list[float]],
+            sliding_window: Optional[int],
+            kv_cache_dtype: str,
+            blocksparse_params: Optional[dict[str, Any]],
+            logits_soft_cap: Optional[float],
+            attn_type: str,
+            kv_sharing_target_layer_name: Optional[str],
+            # MLA Specific Arguments
+            **mla_args) -> None:
+        super().__init__(num_heads, head_size, scale, num_kv_heads,
+                         alibi_slopes, sliding_window, kv_cache_dtype,
+                         blocksparse_params, logits_soft_cap, attn_type,
+                         kv_sharing_target_layer_name, **mla_args)
+
+        if on_ph1():
+            self.num_kv_splits = 1
+            self._forward_decode = self.mp31_forward_decode
+        elif on_qy2():
+            self.num_kv_splits = 4
+            self._forward_decode = self.mp22_forward_decode
+
+    def mp22_forward_decode(
+        self,
+        q_nope: torch.Tensor,
+        q_pe: torch.Tensor,
+        kv_c_and_k_pe_cache: torch.Tensor,
+        attn_metadata: MLACommonMetadata,
+    ) -> torch.Tensor:
+        assert kv_c_and_k_pe_cache.numel() > 0
+        assert attn_metadata.decode is not None
+
+        if self.kv_cache_dtype.startswith("fp8"):
+            raise NotImplementedError("FP8 Triton MLA not yet supported")
+
+        B = q_nope.shape[0]
+
+        q = torch.cat([q_nope, q_pe], dim=-1)
+
+        o = torch.empty(B,
+                        self.num_heads,
+                        self.kv_lora_rank,
+                        dtype=q.dtype,
+                        device=q.device)
+
+
+        # TODO(lucas) Allocate ahead of time
+        attn_logits = torch.zeros(
+            (
+                B,
+                self.num_heads,
+                self.num_kv_splits,
+                # NOTE(lucas) idk why the +1 is here but sglang has it so we
+                # just mirror that
+                self.kv_lora_rank + 1,
+            ),
+            dtype=torch.float32,
+            device=q.device,
+        )
+
+        # Add a head dim of 1
+        kv_c_and_k_pe_cache = kv_c_and_k_pe_cache.unsqueeze(2)
+        kv_c_cache = kv_c_and_k_pe_cache[..., :self.kv_lora_rank]
+        PAGE_SIZE = kv_c_and_k_pe_cache.size(1)
+
+        # Run MQA
+        decode_attention_fwd(q, kv_c_and_k_pe_cache, kv_c_cache, o,
+                             attn_metadata.decode.block_table,
+                             attn_metadata.decode.seq_lens, attn_logits,
+                             self.num_kv_splits, self.scale, PAGE_SIZE)
+
+        return self._v_up_proj(o)
+
+    # Note (zhiguo.qin):
+    # When num_kv_splits = 1, the KV cache is not split, meaning there is only one segment to attend over.
+    # In this case, the mp31_decode_mla_kernel can skip calling the _decode_softmax_reducev_fwd Triton kernel,
+    # because no cross-split reduction (e.g., merging attention value contributions from multiple KV splits) is needed.
+    # Skipping this step avoids unnecessary kernel launch overhead and memory operations, improving decoding performance.
+    def mp31_forward_decode(
+        self,
+        q_nope: torch.Tensor,
+        q_pe: torch.Tensor,
+        kv_c_and_k_pe_cache: torch.Tensor,
+        attn_metadata: MLACommonMetadata,
+    ) -> torch.Tensor:
+        assert kv_c_and_k_pe_cache.numel() > 0
+        assert attn_metadata.decode is not None
+
+        if self.kv_cache_dtype.startswith("fp8"):
+            raise NotImplementedError("FP8 Triton MLA not yet supported")
+
+        B = q_nope.shape[0]
+
+        q = torch.cat([q_nope, q_pe], dim=-1)
+
+        if self.num_kv_splits == 1:
+            o = None
+            attn_logits = torch.zeros(
+                (
+                    B,
+                    self.num_heads,
+                    self.num_kv_splits,
+                    # NOTE(lucas) idk why the +1 is here but sglang has it so we
+                    # just mirror that
+                    self.kv_lora_rank,
+                ),
+                dtype=q.dtype,
+                device=q.device,
+            )
+        else:
+            o = torch.empty(B,
+                            self.num_heads,
+                            self.kv_lora_rank,
+                            dtype=q.dtype,
+                            device=q.device)
+            attn_logits = torch.zeros(
+                (
+                    B,
+                    self.num_heads,
+                    self.num_kv_splits,
+                    # NOTE(lucas) idk why the +1 is here but sglang has it so we
+                    # just mirror that
+                    self.kv_lora_rank + 1,
+                ),
+                dtype=torch.float32,
+                device=q.device,
+            )
+
+        # Add a head dim of 1
+        kv_c_and_k_pe_cache = kv_c_and_k_pe_cache.unsqueeze(2)
+        kv_c_cache = kv_c_and_k_pe_cache[..., :self.kv_lora_rank]
+        PAGE_SIZE = kv_c_and_k_pe_cache.size(1)
+
+        # Run MQA
+        decode_attention_fwd(q, kv_c_and_k_pe_cache, kv_c_cache, o,
+                             attn_metadata.decode.block_table,
+                             attn_metadata.decode.seq_lens, attn_logits,
+                             self.num_kv_splits, self.scale, PAGE_SIZE)
+
+        if self.num_kv_splits == 1:
+            o = attn_logits
+
+        return self._v_up_proj(o)
+
+import vllm.v1.attention.backends.mla.triton_mla
+vllm.v1.attention.backends.mla.triton_mla.TritonMLAImpl = CustomTritonMLAImpl
