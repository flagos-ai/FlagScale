+/*! \file
+    \brief This extends the contents of mutlass/functional.h with frequently used activation functions.
+
+*/
+
+#pragma once
+
+#include "mutlass/mutlass.h"
+#include "mutlass/numeric_types.h"
+#include "mutlass/numeric_conversion.h"
+#include "mutlass/constants.h"
