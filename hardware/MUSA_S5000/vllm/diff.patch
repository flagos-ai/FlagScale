+
+// Macro for MP31 decode MLA kernel launcher
+#define LAUNCH_MP31_DECODE_MLA(TYPE, ATT_TYPE, HEAD_DIM_QK, HEAD_DIM_VO, K_STAGES, V_STAGES, SPLITS_KV) \
+    mp31_decode_mla_kernel_launcher<TYPE, ATT_TYPE, HEAD_DIM_QK, HEAD_DIM_VO, K_STAGES, V_STAGES>( \
+        static_cast<TYPE*>(Q.data_ptr()), \
+        static_cast<TYPE*>(K_Buffer.data_ptr()), \
+        static_cast<TYPE*>(V_Buffer.data_ptr()), \
+        static_cast<ATT_TYPE*>(Att_out.data_ptr()), \
+        static_cast<int32_t*>(Req_to_tokens.data_ptr()), \
+        static_cast<int32_t*>(B_Seqlen.data_ptr()), \
+        sm_scale, \
+        num_splits_kv, \
+        seqlen_q_ori, 1, \
+        d_qk, d_vo, num_heads, num_head_kv, batch, num_blocks, \
+        Req_to_tokens.stride(0), \
+        Q.stride(0), Q.stride(1), Q.stride(2), \
+        K_Buffer.stride(0), K_Buffer.stride(1), K_Buffer.stride(2), \
+        V_Buffer.stride(0), V_Buffer.stride(1), V_Buffer.stride(2), \
+        Att_out.stride(3), Att_out.stride(0), Att_out.stride(1), Att_out.stride(2), \
+        causal \
+    )
+
+// Macro for MP31 decode MHA kernel launcher
+#define LAUNCH_MP31_DECODE_MHA(TYPE, ATT_TYPE, HEAD_DIM_QK, HEAD_DIM_VO, K_STAGES, V_STAGES, SPLITS_KV) \
+    mp31_decode_mla_kernel_launcher<TYPE, ATT_TYPE, HEAD_DIM_QK, HEAD_DIM_VO, K_STAGES, V_STAGES>( \
+        static_cast<TYPE*>(Q.data_ptr()), \
+        static_cast<TYPE*>(K_Buffer.data_ptr()), \
+        static_cast<TYPE*>(V_Buffer.data_ptr()), \
+        static_cast<ATT_TYPE*>(Att_out.data_ptr()), \
+        static_cast<int32_t*>(Req_to_tokens.data_ptr()), \
+        static_cast<int32_t*>(B_Seqlen.data_ptr()), \
+        sm_scale, \
+        num_splits_kv, \
+        1, 1,   /* q=1, kv=1 */ \
+        d_qk, d_vo, num_head, num_head_kv, batch, num_blocks, \
+        Req_to_tokens.stride(0), \
+        Q.stride(0), Q.stride(2), Q.stride(1), \
+        K_Buffer.stride(0), K_Buffer.stride(1), K_Buffer.stride(2), \
+        V_Buffer.stride(0), V_Buffer.stride(1), V_Buffer.stride(2), \
+        Att_out.stride(3), Att_out.stride(0), Att_out.stride(2), Att_out.stride(1), \
+        causal \
+    )
+
+template <typename T>
+void mp22_decode_mla_kernel_launcher(
+     T* Q, const T* K_Buffer, const T* V_Buffer, float* Att_out,
+     const int32_t* Req_to_tokens, const int32_t* B_Seqlen, float sm_scale, int num_splits_kv, int num_pages,
+    int q, int kv, int d_qk, int d_vo, int h, int h_kv, int b,
+    int stride_req_to_tokens_b,
+    int stride_qbs, int stride_qh,
+    int stride_buf_kbs, int stride_buf_kh,
+    int stride_buf_vbs, int stride_buf_vh,
+    int stride_mid_ob, int stride_mid_oh, int stride_mid_os
+) {
+    constexpr int TileM = 32;
+    constexpr int TileN = 32;
+    constexpr int HeadDimQK = 576;
+    constexpr int HeadDimVO = 512;
+    constexpr int PageSize = 16;
+    const musaStream_t stream = at::musa::getCurrentMUSAStream();
+    using KernelTraits = DecodeMLAKernelTraits<HeadDimQK, HeadDimVO, TileM, TileN, PageSize,
+                                                T, true, false>;
+    int h_r = h / h_kv;
+    auto problem_shape = mute::make_shape(mute::_1{}, PageSize, d_qk, d_vo, mute::make_shape(h_r, h_kv), b);
+    using DecodeMLAParams = DecodeMLAParams<KernelTraits>;
+    using Arguments = typename DecodeMLAParams::Arguments;
+    Arguments arguments = {
+        Q,
+        K_Buffer,
+        V_Buffer,
+        Req_to_tokens,
+        B_Seqlen,
+        Att_out,
+        sm_scale,
+        num_splits_kv,
+        num_pages,
+        stride_req_to_tokens_b,
+        stride_qbs,
+        stride_qh,
+        stride_buf_kbs,
+        stride_buf_kh,
+        stride_buf_vbs,
+        stride_buf_vh,
+        stride_mid_ob,
+        stride_mid_oh,
+        stride_mid_os
+    };
+
+    auto params = DecodeMLAParams::to_underlying_arguments(problem_shape, arguments);
+    dim3 block_dims(KernelTraits::NumThreads);
+    dim3 grid_dims = {static_cast<uint32_t>(b), static_cast<uint32_t>(ceil_div(h, min(KernelTraits::CTA_Q, h_r))), static_cast<uint32_t>(num_splits_kv)};
+    decode_mla_kernel<KernelTraits><<<grid_dims, block_dims, 0, stream>>>(params);
+}
+
+template <typename T, typename Att_T, int HeadDimQK, int HeadDimVO, int KStages, int VStages>
+void mp31_decode_mla_kernel_launcher(
+     T* Q, const T* K_Buffer, const T* V_Buffer, Att_T* Att_out,
+    const int32_t* Req_to_tokens, const int32_t* B_Seqlen, float sm_scale, int num_splits_kv,
+    int q, int kv, int d_qk, int d_vo, int h, int h_kv, int b, int num_blocks,
+    int stride_req_to_tokens_b,
+    int stride_qbs, int stride_q_seq, int stride_qh,
+    int stride_buf_kblock, int stride_buf_kpage, int stride_buf_kh,
+    int stride_buf_vblock, int stride_buf_vpage,int stride_buf_vh,
+    int stride_mid_o_split, int stride_mid_ob, int stride_mid_os, int stride_mid_oh,
+    bool causal
+) {
+    constexpr int BlockM = 32;
+    constexpr int BlockN = 64;
+    constexpr int PageSize = BlockN;
+    const musaStream_t stream = at::musa::getCurrentMUSAStream();
+
+    // PackGQA
+    int h_r = h / h_kv;
+    int q_seq_per_hkv = q * h_r;
+
+    auto problem_shape = mute::make_shape(q, PageSize, d_qk, d_vo, mute::make_shape(h_r, h_kv), b);
+    if (causal) {
+        using KernelTraits = FmhaDecodeKernelTratis<BlockM, BlockN, HeadDimQK, HeadDimVO, PageSize, T, Att_T, KStages, VStages, true>;
+        typename KernelTraits::PackGQAArguments arguments {
+            Q,
+            K_Buffer,
+            V_Buffer,
+            Req_to_tokens,
+            B_Seqlen,
+            Att_out,
+            sm_scale,
+            num_splits_kv,
+            num_blocks,
+            stride_req_to_tokens_b,
+            stride_qh,
+            stride_q_seq,
+            stride_qbs,
+            stride_buf_kblock,
+            stride_buf_kpage,
+            stride_buf_kh,
+            stride_buf_vblock,
+            stride_buf_vpage,
+            stride_buf_vh,
+            stride_mid_oh,
+            stride_mid_os,
+            stride_mid_ob,
+            stride_mid_o_split
+        };
+
+        auto params = KernelTraits::to_underlying_arguments(problem_shape, arguments);
+        int num_m_block = mute::ceil_div(q_seq_per_hkv, BlockM);
+        int batch_and_split = b * num_splits_kv;
+        dim3 grid = {static_cast<uint32_t>(num_m_block), static_cast<uint32_t>(h_kv), static_cast<uint32_t>(batch_and_split)};
+        mla_decode<KernelTraits><<<grid, KernelTraits::NumThreads, 0, stream>>>(params);
+    }
+    else {
+        using KernelTraits = FmhaDecodeKernelTratis<BlockM, BlockN, HeadDimQK, HeadDimVO, PageSize, T, Att_T, KStages, VStages, false>;
+        typename KernelTraits::PackGQAArguments arguments {
+            Q,
+            K_Buffer,
+            V_Buffer,
+            Req_to_tokens,
+            B_Seqlen,
+            Att_out,
+            sm_scale,
+            num_splits_kv,
+            num_blocks,
+            stride_req_to_tokens_b,
+            stride_qh,
+            stride_q_seq,
+            stride_qbs,
+            stride_buf_kblock,
+            stride_buf_kpage,
+            stride_buf_kh,
+            stride_buf_vblock,
+            stride_buf_vpage,
+            stride_buf_vh,
+            stride_mid_oh,
+            stride_mid_os,
+            stride_mid_ob,
+            stride_mid_o_split
+        };
+
+        auto params = KernelTraits::to_underlying_arguments(problem_shape, arguments);
+        int num_m_block = mute::ceil_div(q_seq_per_hkv, BlockM);
+        int batch_and_split = b * num_splits_kv;
+        dim3 grid = {static_cast<uint32_t>(num_m_block), static_cast<uint32_t>(h_kv), static_cast<uint32_t>(batch_and_split)};
+        mla_decode<KernelTraits><<<grid, KernelTraits::NumThreads, 0, stream>>>(params);
+    }
+}
+
+void decode_mla(
+    torch::Tensor &Q,
+    torch::Tensor &K_Buffer,
+    torch::Tensor &V_Buffer,
+    float sm_scale,
+    int num_splits_kv,
+    torch::Tensor &Req_to_tokens,
+    torch::Tensor &B_Seqlen,
+    torch::Tensor &Att_out
+) {
+    const int batch = B_Seqlen.size(0);
+    const int num_heads = Q.size(1);
+    const int d_qk = Q.size(2);
+    const int num_blocks = K_Buffer.size(0);
+    const int page_size = K_Buffer.size(1);
+    const int num_head_kv = K_Buffer.size(-2);
+    const int d_vo = V_Buffer.size(3);
+
+    constexpr int HeadDimQK = 576;
+    constexpr int HeadDimVO = 512;
+    constexpr int KStages = 1;
+    constexpr int VStages = 1;
+
+    TORCH_CHECK(d_qk == HeadDimQK, "mp31 decode mla d_qk only support ", HeadDimQK);
+    TORCH_CHECK(d_vo == HeadDimVO, "mp31 decode mla d_vo only support ", HeadDimVO);
+
+    const at::musa::OptionalMUSAGuard device_guard(device_of(Q));
+
+    if(at::musa::getMUSAArch() == 220) {
+        TORCH_CHECK(page_size == 16, "mp22 decode mla BLOCK_SIZE only support 16.");
+        if (Q.scalar_type() == at::ScalarType::BFloat16) {
+            LAUNCH_MP22_DECODE_MLA(mutlass::bfloat16_t);
+        } else if (Q.scalar_type() == at::ScalarType::Half) {
+            LAUNCH_MP22_DECODE_MLA(mutlass::half_t);
+        } else {
+            std::cerr << "Decode MLA not impl for this dtype." << std::endl;
+            assert(false);
+        }
+    } else if (at::musa::getMUSAArch() == 310) {
+        TORCH_CHECK(page_size == 64, "mp31 decode mla BLOCK_SIZE only support 64.");
+
+        const int seqlen_q_ori = Q.size(0) / batch;
+        const int num_q_heads_per_hk = num_heads / num_head_kv;
+        const int q_seq_per_hk = seqlen_q_ori * num_q_heads_per_hk;
+        const bool causal = true;
+
+        Q = Q.view({batch, q_seq_per_hk, num_head_kv, d_qk});
+        if (num_splits_kv == 1) {
+            Att_out = Att_out.view({batch, q_seq_per_hk, num_head_kv, num_splits_kv, d_vo});
+        } else {
+            Att_out = Att_out.view({batch, q_seq_per_hk, num_head_kv, num_splits_kv, d_vo + 1});
+        }
+
+        if (Q.scalar_type() == at::ScalarType::BFloat16) {
+            if (num_splits_kv == 1) {
+                LAUNCH_MP31_DECODE_MLA(mutlass::bfloat16_t, mutlass::bfloat16_t, HeadDimQK, HeadDimVO, KStages, VStages, 1);
+            } else {
+                LAUNCH_MP31_DECODE_MLA(mutlass::bfloat16_t, float, HeadDimQK, HeadDimVO, KStages, VStages, 0);
+            }
+        } else if (Q.scalar_type() == at::ScalarType::Half) {
+            if (num_splits_kv == 1) {
+                LAUNCH_MP31_DECODE_MLA(mutlass::half_t, mutlass::half_t, HeadDimQK, HeadDimVO, KStages, VStages, 1);
+            } else {
+                LAUNCH_MP31_DECODE_MLA(mutlass::half_t, float, HeadDimQK, HeadDimVO, KStages, VStages, 0);
+            }
+        } else {
+            std::cerr << "Decode MLA not impl for this dtype." << std::endl;
+            assert(false);
+        }
+    } else {
+        std::cerr << "Decode MLA only support for mp22 & mp31." << std::endl;
+        assert(false);
+    }
+}
+
+void mp31_decode_mha(
+    torch::Tensor &Q,
+    torch::Tensor &K_Buffer,
+    torch::Tensor &V_Buffer,
+    float sm_scale,
+    int num_splits_kv,
+    torch::Tensor &Req_to_tokens,
+    torch::Tensor &B_Seqlen,
+    torch::Tensor &Att_out
+) {
+    int batch = Q.size(0);
+    int num_head = Q.size(1);
+    int num_head_kv = K_Buffer.size(-2);
+    int d_qk = Q.size(2);
+    int d_vo = K_Buffer.size(3);
+    int num_blocks = K_Buffer.size(0);
+    int page_size = K_Buffer.size(1);
+    int head_size_v = V_Buffer.size(-1);
+
+    const int seqlen_q_ori = 1;
+    const int num_q_heads_per_hk = num_head / num_head_kv;
+    const int q_seq_per_hk = seqlen_q_ori * num_q_heads_per_hk;
+    const bool causal = false;
+
+    Q = Q.view({batch, num_head_kv, num_q_heads_per_hk, d_qk});
+
+    constexpr int KStages = 2;
+    constexpr int VStages = 2;
+
+    TORCH_CHECK((d_qk == 64 && d_vo == 64) || (d_qk == 128 && d_vo == 128),
+               "mp31 decode mla d_qk and d_vo only support 64 or 128.");
+
+    TORCH_CHECK(page_size == 64, "mp31 decode mla BLOCK_SIZE only support 64.");
+
+
+    int current_arch = at::musa::getMUSAArch();
+    TORCH_CHECK(current_arch >= 300, "mp31 decode mha not support on MUSA arch ", current_arch);
+
+    if (num_splits_kv == 1) {
+        Att_out = Att_out.view({batch, num_head_kv, q_seq_per_hk, num_splits_kv, head_size_v});
+    } else {
+        Att_out = Att_out.view({batch, num_head_kv, q_seq_per_hk, num_splits_kv, head_size_v + 1});
+    }
+
+    if (Q.scalar_type() == at::ScalarType::BFloat16) {
+        if (num_splits_kv == 1) {
+            if (d_qk == 64 && d_vo == 64) {
+                LAUNCH_MP31_DECODE_MHA(mutlass::bfloat16_t, mutlass::bfloat16_t, 64, 64, KStages, VStages, 1);
+            } else if (d_qk == 128 && d_vo == 128) {
+                LAUNCH_MP31_DECODE_MHA(mutlass::bfloat16_t, mutlass::bfloat16_t, 128, 128, KStages, VStages, 1);
+            } else {
+                TORCH_CHECK(false, "mp31 decode mla d_qk and d_vo only support 64 or 128.");
+            }
+        } else {
+            if (d_qk == 64 && d_vo == 64) {
+                LAUNCH_MP31_DECODE_MHA(mutlass::bfloat16_t, float, 64, 64, KStages, VStages, 0);
+            } else if (d_qk == 128 && d_vo == 128) {
+                LAUNCH_MP31_DECODE_MHA(mutlass::bfloat16_t, float, 128, 128, KStages, VStages, 0);
+            } else {
+                TORCH_CHECK(false, "mp31 decode mla d_qk and d_vo only support 64 or 128.");
+            }
+        }
+    } else if (Q.scalar_type() == at::ScalarType::Half) {
+        if (num_splits_kv == 1) {
+            if (d_qk == 64 && d_vo == 64) {
+                LAUNCH_MP31_DECODE_MHA(mutlass::half_t, mutlass::half_t, 64, 64, KStages, VStages, 1);
+            } else if (d_qk == 128 && d_vo == 128) {
+                LAUNCH_MP31_DECODE_MHA(mutlass::half_t, mutlass::half_t, 128, 128, KStages, VStages, 1);
+            } else {
+                TORCH_CHECK(false, "mp31 decode mla d_qk and d_vo only support 64 or 128.");
+            }
+        } else {
+            if (d_qk == 64 && d_vo == 64) {
+                LAUNCH_MP31_DECODE_MHA(mutlass::half_t, float, 64, 64, KStages, VStages, 0);
+            } else if (d_qk == 128 && d_vo == 128) {
+                LAUNCH_MP31_DECODE_MHA(mutlass::half_t, float, 128, 128, KStages, VStages, 0);
+            } else {
+                TORCH_CHECK(false, "mp31 decode mla d_qk and d_vo only support 64 or 128.");
+            }
+        }
+    } else {
+        std::cerr << "Decode MLA not impl for this dtype." << std::endl;
+    }
+
+    if (num_splits_kv == 1) {
+        Att_out = Att_out.reshape({batch, num_head, num_splits_kv, head_size_v});
+    } else {
+        Att_out = Att_out.reshape({batch, num_head, num_splits_kv, head_size_v + 1});
+    }
+}
