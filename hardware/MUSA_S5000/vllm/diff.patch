+    //print("gP:"); print(gP); print("\n");
+    //print("tPgP:"); print(tPgP); print("\n");
+    //
+    //print("tPcS"); print(tPcS); print("\n");
+    //
+    //print("shapeK:"); print(shape_K); print("\n");
+    //print("residue_kv:"); print(residue_kv); print("\n");
+    //
+    //print("actual seqlen q:"); print(actual_seqlen_q); print("\n");
+    //print("actual seqlen kv:"); print(actual_seqlen_kv); print("\n");
+
+    //print("tPcP_view"); print(tPcP_view); print("\n");
+    //print("v:"); print(tPcP_view(0, 1)); print("\n");
+    //print("v:"); print(tPcP_view(0, 2)); print("\n");
+    //print("sQ:"); print(sQ); print("\n");
+    //print("sK:"); print(sK); print("\n");
+    //print("sV:"); print(sV); print("\n");
+    //print("sP:"); print(sP); print("\n");
+    //print("tQgQ:"); print(tQgQ); print("\n");
+    //print("tQsQ:"); print(tQsQ); print("\n");
+    //print("tKgK:"); print(tKgK); print("\n");
+    //print("tKsK:"); print(tKsK); print("\n");
+    //print("tKrK:"); print(tKrK); print("\n");
+    //print("accum_p:"); print(accum_p); print("\n");
+    //print("accum_o:"); print(accum_o); print("\n");
+    //print("tPrQ:"); print(tPrQ); print("\n");
+    //print("tPrK:"); print(tPrK); print("\n");
+    //print("tPsQ:"); print(tPsQ); print("\n");
+    //print("tPrQ_copy_view:"); print(tPrQ_copy_view); print("\n");
+  }
+
+  //if (threadIdx.x == 0) {
+  //  print("residue_kv:"); print(residue_kv); print("\n");
+  //}
+
+  //
+  // Prologue
+  //
+
+  // LDG Q
+  if constexpr (KernelTraits::UseRobustLoadQ) {
+    copy(gmem_tiled_copy_Q.with(params.desc_Q), tQgQ, tQrQ);
+  } else {
+    copy(gmem_tiled_copy_Q, tQgQ, tQrQ);
+  }
+  // STS Q
+  copy(tQrQ, tQsQ);
+
+  __syncthreads();
+
+  // LDS Q, keep Q in register
+  copy(tPsQ, tPrQ_copy_view);
+
+  auto k_tile_iter = mute::make_coord_iterator(shape<2>(gK));
+  auto v_tile_iter = k_tile_iter;
+  int orig_kv_tile_count = size<2>(gK);
+  int kv_tile_count = 0;
+
+  if constexpr (EnableCausal) {
+    kv_tile_count = std::min(orig_kv_tile_count,
+                        int(mute::ceil_div((coord_q + 1) * size<0>(tile_shape_Q), size<0>(gK))));
+
+  }
+
+  // LDG K
+  if constexpr (KernelTraits::UseRobustLoadK) {
+    copy(gmem_tiled_copy_K.with(params.desc_K), tKgK(_,_,_,*k_tile_iter), tKrK);
+  } else {
+    copy(gmem_tiled_copy_K, tKgK(_,_,_,*k_tile_iter), tKrK);
+  }
+  ++k_tile_iter;
+
+  if constexpr (KernelTraits::ReuseSmemQ) {
+    __syncthreads();
+  }
+
+  copy(tKrK, tKsK);
+  __syncthreads();
+
+  // P = QK
+  gemm<KernelTraits::IsQInReg>(accum_p, tPrQ, tPrK, tPsQ, tPsK, tiled_mma_qk, thr_copy_Q, thr_copy_K);
+
+
+  // Apply Causal Mask
+  if constexpr (EnableCausal) {
+    apply_causal_mask(accum_p, tPcP, coord_q * size<0>(gQ), 0, false);
+  }
+
+  // Softmax(P)
+  if constexpr (EnableSoftmax) {
+    online_softmax_scale(accum_p, accum_softmax, params.rln2_scale, tPcP, residue_kv, orig_kv_tile_count == 1);
+    //online_softmax_scale(accum_p, accum_softmax, params.rln2_scale);
+    online_softmax_row_max<ElementAccum>(accum_softmax, row_max, old_row_max, alpha);
+  } else {
+    online_softmax_scale(accum_p, accum_softmax, float(1.0f));
+  }
+
+  for (int loop = 1; loop < kv_tile_count; ++loop) {
+    if constexpr (KernelTraits::UseRobustLoadK) {
+      copy(gmem_tiled_copy_K.with(params.desc_K), tKgK(_,_,_,*k_tile_iter), tKrK);
+    } else {
+      copy(gmem_tiled_copy_K, tKgK(_,_,_,*k_tile_iter), tKrK);
+    }
+    ++k_tile_iter;
+    copy(tKrK, tKsK);
+    __syncthreads();
+
+    clear(accum_p);
+    gemm<KernelTraits::IsQInReg>(accum_p, tPrQ, tPrK, tPsQ, tPsK, tiled_mma_qk, thr_copy_Q, thr_copy_K);
+
+    if constexpr (EnableSoftmax) {
+      // do softmax on accum_softmax
+      online_softmax_exp2(accum_softmax);
+      update_accum(accum_o, alpha);
+    }
+
+    // tCvt_frg -> accum_cvt, tAcc_frg -> accum_softmax
+    MUTE_UNROLL
+    for (int i = 0; i < size(tCvt_frg); ++i) {
+      tCvt_frg(i) = mutlass::NumericArrayConverter<typename KernelTraits::ElementKV, ElementAccum, FragmentSize, mutlass::FloatRoundStyle::round_to_nearest>{}(tAcc_frg(i));
+    }
+
+    // STS P (tPrP -> accum_cvt)
+    copy(tiled_copy_r2s, tPrP, tPsP);
+
+    // LDG V
+    if constexpr (KernelTraits::UseRobustLoadV) {
+      copy(gmem_tiled_copy_V.with(params.desc_V), tVgV(_,_,_,*v_tile_iter), tVrV);
+    } else {
+      copy(gmem_tiled_copy_V, tVgV(_,_,_,*v_tile_iter), tVrV);
+    }
+    ++v_tile_iter;
+    // STS V
+    copy(tVrV, tVsV);
+
+    __syncthreads();
+
+    // O = PV
+    gemm(accum_o, tOrP, tOrVt, tOsP, tOsVt, tiled_mma_pv, thr_copy_P, thr_copy_V);
+
+    if constexpr (EnableSoftmax) {
+      // do softmax
+      online_softmax_row_sum<ElementAccum>(accum_softmax, row_sum, lse, alpha);
+
+      // Apply Causal Mask
+      if constexpr (EnableCausal) {
+        apply_causal_mask(accum_p, tPcP, coord_q * size<0>(gQ), loop * size<0>(gK), true);
+      }
+      online_softmax_scale(accum_p, accum_softmax, params.rln2_scale, tPcP, residue_kv, loop == orig_kv_tile_count - 1);
+      online_softmax_row_max<ElementAccum>(accum_softmax, row_max, old_row_max, alpha);
+    } else {
+      online_softmax_scale(accum_p, accum_softmax, float(1.0f));
+    }
+  }
+
+  // Last tile
+  if constexpr (EnableSoftmax) {
+    // do softmax
+    online_softmax_exp2(accum_softmax);
+    update_accum(accum_o, alpha);
+  }
+
+  // tCvt_frg -> accum_cvt, tAcc_frg -> accum_softmax
+  MUTE_UNROLL
+  for (int i = 0; i < size(tCvt_frg); ++i) {
+    tCvt_frg(i) = mutlass::NumericArrayConverter<typename KernelTraits::ElementKV, ElementAccum, FragmentSize, mutlass::FloatRoundStyle::round_to_nearest>{}(tAcc_frg(i));
+  }
+
+  // Temp save
+  //copy(tiled_copy_r2s, tPrP, tPgP(_,_,_,0));
+
+  // LDG V
+  if constexpr (KernelTraits::UseRobustLoadV) {
+    copy(gmem_tiled_copy_V.with(params.desc_V), tVgV(_,_,_,*v_tile_iter), tVrV);
+  } else {
+    copy(gmem_tiled_copy_V, tVgV(_,_,_,*v_tile_iter), tVrV);
+  }
+  // STS V
+  copy(tVrV, tVsV);
+
+  // STS P (tPrP -> accum_cvt)
+  copy(tiled_copy_r2s, tPrP, tPsP);
+
+  __syncthreads();
+
+  // O = PV
+  gemm(accum_o, tOrP, tOrVt, tOsP, tOsVt, tiled_mma_pv, thr_copy_P, thr_copy_V);
+
+  if constexpr (EnableSoftmax) {
+    online_softmax_row_sum<ElementAccum>(accum_softmax, row_sum, lse, alpha);
+  }
+
+  // if (thread(0)) {
+  //   // print("liliang get<0>(oob_mn) = ");print(get<0>(oob_mn));print("\n");
+  //   // print("liliang cL = ");print(cL);print("\n");
+  //   // print("liliang tCcL = ");print(tCcL);print("\n");
+  //   // print("liliang lse = ");print(lse);print("\n");
+  //   // print("liliang row_max = ");print(row_max);print("\n");
+  //   // print("liliang ElementL(log2(lse(i)) + row_max(i)) = ");print(ElementL(log2(lse(0)) + row_max(0)) / float(1.4426950408889634074));print("\n");
+  //   // print("liliang lse(i) = ");print(lse(0));print("\n");
+  //   // print("liliang row_max(i) = ");print(row_max(0));print("\n");
+  //   // print("liliang exp2f = ");print(exp2f(1.0));print("\n");
+  //   // print("liliang exp2f = ");print(exp2f(1.0 * float(1.4426950408889634074)));print("\n");
+  // }
+
+  if constexpr(KernelTraits::ReturnL) {
+    #pragma unroll
+    for(int i = 0; i < size(lse); ++i) {
+      if (elem_less(get<0>(tCcL(i * size<0, 0>(tCcL))), get<0>(oob_mn))) {
+        tSgL(i) = (log2(lse(i)) + row_max(i)) / float(1.4426950408889634074);
+      }
+    }
+  }
+
+  if constexpr (EnableSoftmax) {
+    apply_softmax_normalizer(accum_o, lse);
+  }
+
+  MUTE_UNROLL
+  for (int i = 0; i < size(accum_o); ++i) {
+    if (elem_less(tCcO(i), oob_mn)) {
+      tOgO(i) = typename KernelTraits::ElementQ(accum_o(i));
+    }
+  }
+  #endif
+}
diff --git a/vllm_musa/csrc/flash_attn/impl/attention_params.hpp b/vllm_musa/csrc/flash_attn/impl/attention_params.hpp
new file mode 100644
index 000000000..5f14ecc43
--- /dev/null
+++ b/vllm_musa/csrc/flash_attn/impl/attention_params.hpp
@@ -0,0 +1,214 @@
+#pragma once
+
+#include <mute/tensor.hpp>
+#include "mutlass_extension.hpp"
+
+
+struct VariableLength {
+  int max_length;
+  int* cumulative_length = nullptr;
+
+  MUTE_HOST_DEVICE operator int() const {
+    return max_length;
+  }
+};
+
+namespace mute {
+template <>
+struct is_integral<VariableLength> : true_type {};
+
+MUTE_HOST_DEVICE
+void print(VariableLength _) {
+  printf("Varlen<%d, %p>", _.max_length, _.cumulative_length);
+}
+
+} // namespace mute
+
+template <class KernelTraits>
+struct AttentionParams {
+  static constexpr bool IsVarlen = KernelTraits::IsVarlen;
+
+  using ElementQ  = typename KernelTraits::ElementQ;
+  using ElementKV = typename KernelTraits::ElementKV;
+  using ElementAccumulator = typename KernelTraits::ElementAccumulator;
+
+  using ElementO = ElementQ;
+  using ElementL = float;
+  using ElementP = ElementKV;
+
+  using IndexType = int32_t;
+
+  // Q, K, D_QK, D_VO, (H_R, H_KV), B
+  using ProblemShapeFixed  = mute::Shape<int, int, int, int, mute::Shape<int, int>, int>;
+  using ProblemShapeVarlen = mute::Shape<VariableLength, VariableLength, int, int, mute::Shape<int, int>, int>;
+  using ProblemShape = mute::conditional_t<IsVarlen,
+                                           ProblemShapeVarlen,
+                                           ProblemShapeFixed>;
+
+  // Q, D_QK, (H_R, H_KV), B
+  using StrideQ = mute::Stride<int, mute::_1, mute::Stride<int, int>, int>;
+
+  // K, D_QK, (H_R, H_KV), B
+  using StrideK = mute::Stride<int, mute::_1, mute::Stride<mute::_0, int>, int>;
+
+  // V, D_VO, (H_R, H_KV), B
+  using StrideV = StrideK;
+
+  // Q, D_VO, (H_R, H_KV), B
+  using StrideO = StrideQ;
+  using StrideL = mute::Stride<mute::_1, mute::_0, mute::Stride<int, int>, int>;
+
+  // Debug
+  // Q, K, (H_R, H_KV), B
+  using StrideP  = StrideQ;
+
+  struct Arguments {
+    ElementQ const* ptr_Q;
+    ElementKV const* ptr_K;
+    ElementKV const* ptr_V;
+
+    ElementO* ptr_O;
+
+    // Debug
+    ElementP* ptr_P;
+    ElementL* ptr_L;
+  };
+
+
+  struct Params {
+    ProblemShape problem_shape;
+
+    ElementQ const* ptr_Q;
+    StrideQ stride_Q;
+    mute::RobustDescriptor desc_Q;
+    ElementKV const* ptr_K;
+    StrideK stride_K;
+    mute::RobustDescriptor desc_K;
+    ElementKV const* ptr_V;
+    StrideV stride_V;
+    mute::RobustDescriptor desc_V;
+
+    ElementO* ptr_O;
+    StrideO stride_O;
+    ElementL* ptr_L;
+    StrideL stride_L;
+
+    float rln2_scale;
+
+    // Debug
+    ElementP* ptr_P;
+    StrideP stride_P;
+  };
+
+  static Params
+  to_underlying_arguments(ProblemShape problem_shape, Arguments const& args, mute::Shape<int, int, int> qkv_elem) {
+    // ProblemShape: Q, K, D_QK, D_VO, (H_R, H_KV), B
+    int SeqQ  = mute::size<0>(problem_shape);
+    int SeqK  = mute::size<1>(problem_shape);
+    int DimQK = mute::size<2>(problem_shape);
+    int DimVO = mute::size<3>(problem_shape);
+    int H     = mute::size<4>(problem_shape);
+    int H_R   = mute::size<4,0>(problem_shape);
+    int H_KV  = mute::size<4,1>(problem_shape);
+    int B     = mute::size<5>(problem_shape);
+
+    // Q = (SeqQ, DimQK, (H_R, H_KV), B)
+    // K = (SeqK, DimQK, (0, H_KV), B)
+    // V = (SeqK, DimVO, (0, H_KV), B)
+    // O = (SeqQ, DimVO, (H_R, H_KV), B)
+    // L = (SeqQ, 1, (H_R, H_KV), B)
+    StrideQ stride_Q = mute::make_stride(DimQK, mute::_1{}, mute::make_stride(H_KV*DimQK*SeqQ, DimQK*SeqQ), IsVarlen ? 0 : DimQK * SeqQ * H);
+    StrideK stride_K = mute::make_stride(DimQK, mute::_1{}, mute::make_stride(mute::_0{}, DimQK * SeqK), IsVarlen ? 0 : DimQK * SeqK * H_KV);
+    StrideV stride_V = mute::make_stride(DimVO, mute::_1{}, mute::make_stride(mute::_0{}, DimVO * SeqK), IsVarlen ? 0 : DimVO * SeqK * H_KV);
+    StrideO stride_O = mute::make_stride(DimVO, mute::_1{}, mute::make_stride(H_KV*DimVO*SeqQ, DimVO*SeqQ), IsVarlen ? 0 : DimVO * SeqQ * H);
+    StrideL stride_L = mute::make_stride(mute::_1{}, mute::_0{}, mute::make_stride(H_KV*SeqQ, SeqQ), IsVarlen ? 0 : SeqQ * H);
+
+    mute::RobustDescriptor desc_Q = mute::make_robust_desc(args.ptr_Q, mute::get<0>(qkv_elem));
+    mute::RobustDescriptor desc_K = mute::make_robust_desc(args.ptr_K, mute::get<1>(qkv_elem));
+    mute::RobustDescriptor desc_V = mute::make_robust_desc(args.ptr_V, mute::get<2>(qkv_elem));
+
+    constexpr float kLog2e = float(1.4426950408889634074);
+    const float softmax_scale = (1.0f / sqrt(float(DimQK)));
+    float rln2_scale = softmax_scale * kLog2e;
+
+    // Debug
+    StrideP stride_P = mute::make_stride(SeqK, mute::_1{}, mute::make_stride(H_KV*SeqQ*SeqK, SeqQ*SeqK), IsVarlen ? 0 : SeqQ * SeqK * H);
+
+    return {
+      problem_shape,
+      args.ptr_Q,
+      stride_Q,
+      desc_Q,
+      args.ptr_K,
+      stride_K,
+      desc_K,
+      args.ptr_V,
+      stride_V,
+      desc_V,
+      args.ptr_O,
+      stride_O,
+      args.ptr_L,
+      stride_L,
+      rln2_scale,
+      args.ptr_P,
+      stride_P
+    };
+  }
+
+
+  static Params
+  to_underlying_arguments(ProblemShape problem_shape, Arguments const& args,
+                          mute::Shape<int, int, int> qkv_elem,
+                          IndexType q_seq_stride, IndexType q_head_stride, IndexType q_batch_stride,
+                          IndexType k_seq_stride, IndexType k_head_stride, IndexType k_batch_stride,
+                          IndexType v_seq_stride, IndexType v_head_stride, IndexType v_batch_stride,
+                          IndexType o_seq_stride, IndexType o_head_stride, IndexType o_batch_stride,
+                          IndexType l_head_stride, IndexType l_batch_stride
+                          ) {
+
+    int DimQK = mute::size<2>(problem_shape);
+    int H_KV  = mute::size<4,1>(problem_shape);
+
+
+    StrideQ stride_Q = mute::make_stride(q_seq_stride, mute::_1{},
+                      mute::make_stride(H_KV*q_head_stride, q_head_stride), IsVarlen ? 0 : q_batch_stride);
+    StrideK stride_K = mute::make_stride(k_seq_stride, mute::_1{},
+                      mute::make_stride(mute::_0{}, k_head_stride), IsVarlen ? 0 : k_batch_stride);
+    StrideV stride_V = mute::make_stride(v_seq_stride, mute::_1{},
+                      mute::make_stride(mute::_0{}, v_head_stride), IsVarlen ? 0 : v_batch_stride);
+    StrideO stride_O = mute::make_stride(o_seq_stride, mute::_1{},
+                      mute::make_stride(H_KV*o_head_stride, o_head_stride), IsVarlen ? 0 : o_batch_stride);
+    StrideL stride_L = mute::make_stride(mute::_1{}, mute::_0{},
+                      mute::make_stride(H_KV*l_head_stride, l_head_stride), IsVarlen ? 0 : l_batch_stride);
+
+    mute::RobustDescriptor desc_Q = mute::make_robust_desc(args.ptr_Q, mute::get<0>(qkv_elem));
+    mute::RobustDescriptor desc_K = mute::make_robust_desc(args.ptr_K, mute::get<1>(qkv_elem));
+    mute::RobustDescriptor desc_V = mute::make_robust_desc(args.ptr_V, mute::get<2>(qkv_elem));
+
+    constexpr float kLog2e = float(1.4426950408889634074);
+    const float softmax_scale = (1.0f / sqrt(float(DimQK)));
+    float rln2_scale = softmax_scale * kLog2e;
+
+    StrideP stride_P;
+
+    return {
+      problem_shape,
+      args.ptr_Q,
+      stride_Q,
+      desc_Q,
+      args.ptr_K,
+      stride_K,
+      desc_K,
+      args.ptr_V,
+      stride_V,
+      desc_V,
+      args.ptr_O,
+      stride_O,
+      args.ptr_L,
+      stride_L,
+      rln2_scale,
+      args.ptr_P,
+      stride_P
+    };
+  }
+};
