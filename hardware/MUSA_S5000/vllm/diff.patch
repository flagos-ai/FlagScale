+#pragma once
+
+#include "mixed_input_gemm_kernel_traits.hpp"
+
+template <class LayoutAccum>
+MUTE_DEVICE
+auto
+convert_layout_acc_rowcol(LayoutAccum acc_layout) {
+  if constexpr (decltype(rank<0>(acc_layout))::value == 3) { // MP31
+    // from ((2, VN, VM), MMA_M, MMA_N) to ((VM, MMA_M),(2, VN, MMA_N));
+    static_assert(decltype(size<0, 0>(acc_layout))::value == 2);
+    static_assert(decltype(rank(acc_layout))::value == 3);
+    auto l = acc_layout;
+    return make_layout(make_layout(get<0,2>(l), get<1>(l)), make_layout(get<0,0>(l), get<0,1>(l), get<2>(l)));
+  } else {  // MP22
+    // from((2,4), MMA_M, MMA_N) to ((4, MMA_M), (2, MMA_N))
+    static_assert(decltype(size<0, 0>(acc_layout))::value == 2);
+    static_assert(decltype(size<0, 1>(acc_layout))::value == 4);
+    auto l = acc_layout;
+    return make_layout(make_layout(get<0,1>(l), get<1>(l)), make_layout(get<0,0>(l), get<2>(l)));
+  }
+}
+
+
+template <
+	class Engine0, class Layout0,
+	class Engine1, class Layout1,
+  class Engine2, class Layout2
+>
+MUTE_DEVICE
+void
+dequant_tensor(Tensor<Engine0, Layout0>& src,
+							 Tensor<Engine1, Layout1>& dst,
+               Tensor<Engine2, Layout2>& scale) {
+	MUTE_STATIC_ASSERT_V(size(src) == size(dst));
+  using MmaType = typename Engine1::value_type;
+  using QuantType = typename Engine0::value_type;
+
+  static_assert(sizeof_bits_v<MmaType> == 16);
+  constexpr bool is_half_mma = is_same_v<MmaType, mutlass::half_t>;
+  static_assert(sizeof_bits_v<QuantType> == 4);
+
+  using v2f16_t = mute::conditional_t<is_half_mma,
+                                      _Float16 __attribute__((vector_size(4))),
+                                      mutlass::Array<mutlass::bfloat16_t, 2>>;
+
+  using v2f32_t = float __attribute__((vector_size(8)));
+  using v4f32_t = float __attribute__((vector_size(16)));
+
+  using v4u8_t = uint8_t __attribute__((vector_size(4)));
+
+#define U8_CAST 0
+
+#if U8_CAST
+  Tensor int_view = recast<uint8_t>(src);
+#else
+  Tensor int_view = recast<uint32_t>(src);
+#endif
+  Tensor v2f16_view = recast<v2f16_t>(dst);
+
+  constexpr float rescale = 1.0f / 16.0f;
+  constexpr float zp = 128.0f;
+  constexpr uint32_t mask = 0xF0F0F0F0;
+  constexpr int shift = 4;
+
+  MUTE_UNROLL
+  for (int ni = 0; ni < size<1>(int_view); ++ni) {
+    float scale_val = scale(ni) * rescale;
+    MUTE_UNROLL
+    for (int ki = 0; ki < size<2>(int_view); ++ki) {
+      MUTE_UNROLL
+      for (int vi = 0; vi < size<0>(int_view); ++vi) {
+#if U8_CAST
+        uint8_t lo = (int_view(vi, ni, ki) << 4) & 0xF0;
+        uint8_t hi = int_view(vi, ni, ki) & 0xF0;
+
+        v2f32_t value {(float(lo) - zp) * scale_val, (float(hi) - zp) * scale_val};
+
+        v2f16_view(vi, ni, ki) = __builtin_convertvector(value, v2f16_t);
+#else
+        const float scaled_zp = -zp * scale_val;
+
+        uint32_t value = int_view(vi, ni, ki);
+        uint32_t hi;
+        uint32_t lo;
+        v4f32_t f32x4_hi;
+        v4f32_t f32x4_lo;
+
+#if 1
+        asm("BIT.LUT.AND %0, %1, %2" : "=R"(hi) : "R"(value), "R"(mask));
+        asm("BIT.LSL.AND %0, %1, %2, %3" : "=R"(lo) : "R"(value), "R"(shift), "R"(mask));
+        asm("MOV.U8888_TO_F32.BST4 %0, %1" : "=R"(f32x4_hi) : "R"(hi));
+        asm("MOV.U8888_TO_F32.BST4 %0, %1" : "=R"(f32x4_lo) : "R"(lo));
+#else
+        hi = value & mask;
+        lo = (value << shift) & mask;
+
+        v4u8_t vec_hi = *reinterpret_cast<v4u8_t*>(&hi);
+        v4u8_t vec_lo = *reinterpret_cast<v4u8_t*>(&lo);
+
+        f32x4_hi = __builtin_convertvector(vec_hi, v4f32_t);
+        f32x4_lo = __builtin_convertvector(vec_lo, v4f32_t);
+#endif
+
+        MUTE_UNROLL
+        for (int i = 0; i < 4; ++i) {
+          v2f32_t value {f32x4_lo[i] * scale_val + scaled_zp, f32x4_hi[i] * scale_val + scaled_zp};
+          if constexpr (is_half_mma) {
+            v2f16_view(i, ni, ki) = __builtin_convertvector(value, v2f16_t);
+          } else {
+            float2 f32x2 = make_float2(value[0], value[1]);
+            __mt_bfloat162 res = __float22bfloat162_rn(f32x2);
+
+            v2f16_t f16x2;
+            f16x2[0] = mutlass::bfloat16_t(res.x);
+            f16x2[1] = mutlass::bfloat16_t(res.y);
+
+            v2f16_view(i, ni, ki) = f16x2;
+          }
+        }
+
+        //float f16x2;
+        //asm("FOP.FMA %0.l, %1, %2, %3" : "=R"(f16x2) : "R"(f32x4_lo[0]), "R"(scale_val), "R"(scaled_zp));
+        //asm("FOP.FMA %0.h, %1, %2, %3" : "=R"(f16x2) : "R"(f32x4_hi[0]), "R"(scale_val), "R"(scaled_zp));
+        //v2f16_view(0, ni, ki) = *reinterpret_cast<v2f16_t*>(&f16x2);
+
+        //asm("FOP.FMA %0.l, %1, %2, %3" : "=R"(f16x2) : "R"(f32x4_lo[1]), "R"(scale_val), "R"(scaled_zp));
+        //asm("FOP.FMA %0.h, %1, %2, %3" : "=R"(f16x2) : "R"(f32x4_hi[1]), "R"(scale_val), "R"(scaled_zp));
+        //v2f16_view(1, ni, ki) = *reinterpret_cast<v2f16_t*>(&f16x2);
+
+        //asm("FOP.FMA %0.l, %1, %2, %3" : "=R"(f16x2) : "R"(f32x4_lo[2]), "R"(scale_val), "R"(scaled_zp));
+        //asm("FOP.FMA %0.h, %1, %2, %3" : "=R"(f16x2) : "R"(f32x4_hi[2]), "R"(scale_val), "R"(scaled_zp));
+        //v2f16_view(2, ni, ki) = *reinterpret_cast<v2f16_t*>(&f16x2);
+
+        //asm("FOP.FMA %0.l, %1, %2, %3" : "=R"(f16x2) : "R"(f32x4_lo[3]), "R"(scale_val), "R"(scaled_zp));
+        //asm("FOP.FMA %0.h, %1, %2, %3" : "=R"(f16x2) : "R"(f32x4_hi[3]), "R"(scale_val), "R"(scaled_zp));
+        //v2f16_view(3, ni, ki) = *reinterpret_cast<v2f16_t*>(&f16x2);
+#endif
+      }
+    }
+  }
+}
+
+
+template <class KernelTraits>
+__global__ __launch_bounds__(KernelTraits::NumThreads, 1)
+void mixed_input_gemm(const typename KernelTraits::Params params) {
+
+  auto problem_shape_mnk = params.problem_shape;
+  auto M = get<0>(problem_shape_mnk);
+  auto N = get<1>(problem_shape_mnk);
+  auto K = get<2>(problem_shape_mnk);
+
+  int thread_idx = int(threadIdx.x);
+  auto blk_shape = typename KernelTraits::TileShape{};
+
+  auto [m_coord, n_coord, l_coord] = static_cast<uint3>(blockIdx);
+  auto blk_coord_mnk = make_coord(m_coord, n_coord, _);
+
+  Tensor mA_mk = make_tensor(make_gmem_ptr(params.ptr_A), make_shape(M, K), params.stride_A);
+  Tensor mB_nk = make_tensor(make_gmem_ptr<typename KernelTraits::ElementB>(params.ptr_B), make_shape(N, K), params.stride_B);
+
+
+  Tensor gA = local_tile(mA_mk, blk_shape, blk_coord_mnk, Step<_1, X, _1>{});
+  Tensor gB = local_tile(mB_nk, blk_shape, blk_coord_mnk, Step<X, _1, _1>{});
+
+  typename KernelTraits::TiledMma tiled_mma;
+  Tensor accum = partition_fragment_C(tiled_mma, take<0,2>(blk_shape)); // (MMA,MMA_M,MMA_N)
+  clear(accum);
+
+  auto k_tile_iter  = mute::make_coord_iterator(shape<2>(gA));
+  int  k_tile_count = size<2>(gA);
+
+  // Mainloop
+  __shared__ char __attribute__((aligned(128))) smem[sizeof(typename KernelTraits::SharedStorage)];
+  auto& shared_storage = *reinterpret_cast<typename KernelTraits::SharedStorage*>(smem);
+
+  Tensor sA = make_tensor(make_smem_ptr(shared_storage.smem_a.data()), typename KernelTraits::SmemLayoutA{});
+  Tensor sB = make_tensor(make_smem_ptr(shared_storage.smem_b.data()), typename KernelTraits::SmemLayoutB{});
+
+  typename KernelTraits::GmemTiledCopyA gmem_tiled_copy_a;
+  typename KernelTraits::GmemTiledCopyB gmem_tiled_copy_b;
+
+  auto copy_a_thr = gmem_tiled_copy_a.get_slice(thread_idx);
+  auto copy_b_thr = gmem_tiled_copy_b.get_slice(thread_idx);
+
+  Tensor tAgA = copy_a_thr.partition_S(gA);                                  // (ACPY,ACPY_M,ACPY_K,k)
+  Tensor tAsA = copy_a_thr.partition_D(sA);                                  // (ACPY,ACPY_M,ACPY_K)
+  Tensor tBgB = copy_b_thr.partition_S(gB);                                  // (BCPY,BCPY_N,BCPY_K,k)
+  Tensor tBsB = copy_b_thr.partition_D(sB);                                  // (BCPY,BCPY_N,BCPY_K)
+
+  // Allocate the register tiles for double buffering -- same shape as partitioned data
+  Tensor tArA = make_fragment_like(tAsA);                                    // (ACPY,ACPY_M,ACPY_K)
+  Tensor tBrB = make_fragment_like(tBsB);                                    // (BCPY,BCPY_N,BCPY_K)
+  Tensor tBrB_quant = make_fragment_like<typename KernelTraits::ElementB>(tBsB);
+
+  auto thr_mma = tiled_mma.get_thread_slice(thread_idx);
+  Tensor tCrA  = thr_mma.partition_fragment_A(sA);                           // (MMA,MMA_M,MMA_K)
+  Tensor tCrB  = thr_mma.partition_fragment_B(sB);                           // (MMA,MMA_M,MMA_K)
+
+  MUTE_STATIC_ASSERT_V(size<1>(tCrA) == size<1>(accum));                     // MMA_M
+  MUTE_STATIC_ASSERT_V(size<1>(tCrB) == size<2>(accum));                     // MMA_N
+  MUTE_STATIC_ASSERT_V(size<2>(tCrA) == size<2>(tCrB));                      // MMA_K
+
+  //
+  // Copy Atom retiling
+  //
+
+  auto thr_copy_A       = make_tiled_copy_A(typename KernelTraits::SmemCopyAtomA{}, tiled_mma).get_thread_slice(thread_idx);
+  Tensor tCsA           = thr_copy_A.partition_S(sA);
+  Tensor tCrA_copy_view = thr_copy_A.retile_D(tCrA);
+  MUTE_STATIC_ASSERT_V(size<1>(tCsA) == size<1>(tCrA_copy_view));            // M
+
+  auto thr_copy_B       = make_tiled_copy_B(typename KernelTraits::SmemCopyAtomB{}, tiled_mma).get_thread_slice(thread_idx);
+  Tensor tCsB           = thr_copy_B.partition_S(sB);
+  Tensor tCrB_copy_view = thr_copy_B.retile_D(tCrB);
+  MUTE_STATIC_ASSERT_V(size<1>(tCsB) == size<1>(tCrB_copy_view));            // N
+
+
+  clear(tArA);
+  if constexpr (KernelTraits::IsMixedInput) {
+    clear(tBrB_quant);
+  } else {
+    clear(tBrB);
+  }
+
+  // Scale [N, K/128]
+  Tensor tBrS = make_tensor<typename KernelTraits::ElementScale>(make_shape(size<1>(tBsB)));
+  //if (thread0()) {
+  //  print("tBsB:"); print(tBsB); print("\n");
+  //  print("tBrB_quant:"); print(tBrB_quant); print("\n");
+  //  print("tBrS:"); print(tBrS); print("\n");
+  //}
+  int offset_sn[size(tBrS)];
+  int scale_k_cnt = 0;
+  int read_scale_flag = KernelTraits::ScaleInterleave;
+
+  typename KernelTraits::ElementScale const* scale_base = params.ptr_scale + n_coord * get<1>(blk_shape) * params.stride_sn;
+
+  Tensor cB = make_identity_tensor(make_shape(size<0>(sB), size<1>(sB)));
+  Tensor tBcB = copy_b_thr.partition_S(cB);
+  Tensor tBpB = make_tensor<bool>(make_shape(size<1>(tBsB), size<2>(tBsB)), Stride<_1, _0>{});
+
+  Tensor cA = make_identity_tensor(make_shape(size<0>(sA), size<1>(sA)));
+  Tensor tAcA = copy_a_thr.partition_S(cA);
+  Tensor tApA = make_tensor<bool>(make_shape(size<1>(tAsA), size<2>(tAsA)), Stride<_1, _0>{});
+
+
+  int residue_m = M - m_coord * get<0>(blk_shape);
+  int residue_n = N - n_coord * get<1>(blk_shape);
+
+  MUTE_UNROLL
+  for (int m = 0; m < size<0>(tApA); ++m) {
+    tApA(m, 0) = get<0>(tAcA(0, m, 0)) < residue_m;
+  }
+
+  MUTE_UNROLL
+  for (int n = 0; n < size<0>(tBpB); ++n) {
+    tBpB(n, 0) = get<0>(tBcB(0, n, 0)) < residue_n;
+  }
+
+  //
+  // Prologue
+  //
+
+  // Copy gmem to rmem for the first k_tile
+  copy_if(gmem_tiled_copy_a.with(params.desc_A), tApA, tAgA(_,_,_,*k_tile_iter), tArA);
+  if constexpr (KernelTraits::IsMixedInput) {
+    copy_if(gmem_tiled_copy_b.with(params.desc_B), tBpB, tBgB(_,_,_,*k_tile_iter), tBrB_quant);
+  } else {
+    copy_if(gmem_tiled_copy_b.with(params.desc_B), tBpB, tBgB(_,_,_,*k_tile_iter), tBrB);
+  }
+
+  // update tBrS
+  if constexpr (KernelTraits::IsMixedInput) {
+    MUTE_UNROLL
+    for (int ni = 0; ni < size(tBrS); ++ni) {
+      offset_sn[ni] = get<0>(tBcB(0, ni, 0)) * params.stride_sn;
+      tBrS(ni) = scale_base[offset_sn[ni] + scale_k_cnt * params.stride_sk];
+    }
+    read_scale_flag--;
+    scale_k_cnt++;
+  }
+
+  if (--k_tile_count > 0) ++k_tile_iter;
+
+  copy(tArA, tAsA);
+  if constexpr (KernelTraits::IsMixedInput) {
+    dequant_tensor(tBrB_quant, tBrB, tBrS);
+  }
+  copy(tBrB, tBsB);
+
+  __syncthreads();
+
+
+  // Load A, B smem->rmem for k=0
+  copy(tCsA(_,_,0), tCrA_copy_view(_,_,0));
+  copy(tCsB(_,_,0), tCrB_copy_view(_,_,0));
+
+  // Size of the k-tiles's outer product mode (k)
+  auto K_BLOCK_MAX = size<2>(tCrA);
+
+  MUTLASS_PRAGMA_NO_UNROLL
+  while (k_tile_count > -1)
+  {
+    // Pipeline the outer products with a static for loop
+    //for_each(make_int_sequence<K_BLOCK_MAX>{}, [&] (auto k_block)
+    MUTE_UNROLL
+    for (int k_block = 0; k_block < K_BLOCK_MAX; ++k_block)
+    {
+      if (k_block == K_BLOCK_MAX - 1)
+      {
+
+        if constexpr (KernelTraits::IsMixedInput) {
+          dequant_tensor(tBrB_quant, tBrB, tBrS);
+        }
+        __syncthreads();
+
+        // Copy rmem to smem
+        copy(tArA, tAsA);
+        copy(tBrB, tBsB);
+        __syncthreads();
+      }
+
+      // Load A, B smem->rmem for k+1
+      int k_block_next = (k_block + Int<1>{}) % K_BLOCK_MAX;     // static
+      copy(tCsA(_,_,k_block_next), tCrA_copy_view(_,_,k_block_next));
+      copy(tCsB(_,_,k_block_next), tCrB_copy_view(_,_,k_block_next));
+      if (k_block == 0)
+      {
+        // Copy gmem to rmem
+        copy_if(gmem_tiled_copy_a.with(params.desc_A), tApA, tAgA(_,_,_,*k_tile_iter), tArA);
+        if constexpr (KernelTraits::IsMixedInput) {
+          copy_if(gmem_tiled_copy_b.with(params.desc_B), tBpB, tBgB(_,_,_,*k_tile_iter), tBrB_quant);
+        } else {
+          copy_if(gmem_tiled_copy_b.with(params.desc_B), tBpB, tBgB(_,_,_,*k_tile_iter), tBrB);
+        }
+
+        // update tBrS
+        if constexpr (KernelTraits::IsMixedInput) {
+          if (read_scale_flag == 0 && k_tile_count > 0) {
+            read_scale_flag = KernelTraits::ScaleInterleave;
+            MUTE_UNROLL
+            for (int ni = 0; ni < size(tBrS); ++ni) {
+              tBrS(ni) = scale_base[offset_sn[ni] + scale_k_cnt * params.stride_sk];
+            }
+            scale_k_cnt++;
+          }
+          read_scale_flag--;
+        }
+        if (--k_tile_count > 0) ++k_tile_iter;
+      }
+
+      // Thread-level register gemm for k
+      // disambiguate gemm (shared with the namespace name)
+      mute::gemm(tiled_mma, accum, tCrA(_,_,k_block), tCrB(_,_,k_block), accum);
+    };
+  }
+
+  // Epilogue
+  Tensor mC_mn = make_tensor(make_gmem_ptr(params.ptr_C), make_shape(M,N), params.stride_C);
+  Tensor gC_mn = local_tile(mC_mn, blk_shape, make_coord(_,_,_), Step<_1,_1,X>{});
+  Tensor gC = gC_mn(_,_,m_coord,n_coord);
+
+  Tensor tCgC = thr_mma.partition_C(gC);
+  Tensor cC = make_identity_tensor(take<0,2>(blk_shape));
+  Tensor tCcC = thr_mma.partition_C(cC);
+
+#if 1
+  constexpr bool is_half_output = is_same_v<typename KernelTraits::ElementC, mutlass::half_t>;
+  using DstVec = mute::conditional_t<is_half_output,
+                                     _Float16 __attribute__((vector_size(KernelTraits::AlignmentC * sizeof(typename KernelTraits::ElementC)))),
+                                     mutlass::Array<mutlass::bfloat16_t, KernelTraits::AlignmentC>>;
+  using SrcVec = float __attribute__((vector_size(KernelTraits::AlignmentC * sizeof(float))));
+
+  using v2f16_t = mute::conditional_t<is_half_output,
+                                      _Float16 __attribute__((vector_size(4))),
+                                      mutlass::Array<mutlass::bfloat16_t, 2>>;
+  using v2f32_t = float __attribute__((vector_size(8)));
+
+  // mn-view
+  Tensor tCcC_mn = make_tensor(tCcC.data(), convert_layout_acc_rowcol(tCcC.layout()));
+  Tensor accum_mn = make_tensor(accum.data(), convert_layout_acc_rowcol(accum.layout()));
+
+  static_assert(size<1>(accum_mn) == KernelTraits::AlignmentC);
+
+  typename KernelTraits::ElementC* ptr_C_base = params.ptr_C + m_coord * get<0>(blk_shape) * N + n_coord * get<1>(blk_shape);
+
+
+  if (residue_m >= get<0>(blk_shape) && residue_n >= get<1>(blk_shape)) {
+    MUTE_UNROLL
+    for (int mi = 0; mi < size<0>(accum_mn); ++mi) {
+      SrcVec src_vec;
+      DstVec dst_vec;
+
+      MUTE_UNROLL
+      for (int ni = 0; ni < size<1>(accum_mn) / 2; ++ni) {
+        v2f32_t f32x2_val {accum_mn(mi, ni * 2 + 0), accum_mn(mi, ni * 2 + 1)};
+
+        if constexpr (is_half_output) {
+          v2f16_t f16x2_val = __builtin_convertvector(f32x2_val, v2f16_t);
+
+          dst_vec[ni * 2 + 0] = f16x2_val[0];
+          dst_vec[ni * 2 + 1] = f16x2_val[1];
+        } else {
+          float2 f32x2 = make_float2(f32x2_val[0], f32x2_val[1]);
+          __mt_bfloat162 res = __float22bfloat162_rn(f32x2);
+          dst_vec[ni * 2 + 0] = mutlass::bfloat16_t(res.x);
+          dst_vec[ni * 2 + 1] = mutlass::bfloat16_t(res.y);
+        }
+
+      }
+
+      int offset_m = get<0>(tCcC_mn(mi,0));
+
+      *reinterpret_cast<DstVec*>(ptr_C_base + offset_m * N + get<1>(tCcC_mn(0,0))) = dst_vec;
+    }
+  } else {
+    //MUTE_UNROLL
+    //for (int mi = 0; mi < size<0>(accum_mn); ++mi) {
+    //  SrcVec src_vec;
+    //  DstVec dst_vec;
+
+    //  MUTE_UNROLL
+    //  for (int ni = 0; ni < size<1>(accum_mn) / 2; ++ni) {
+    //    v2f32_t f32x2_val {accum_mn(mi, ni * 2 + 0), accum_mn(mi, ni * 2 + 1)};
+
+    //    if constexpr (is_half_output) {
+    //      v2f16_t f16x2_val = __builtin_convertvector(f32x2_val, v2f16_t);
+
+    //      dst_vec[ni * 2 + 0] = f16x2_val[0];
+    //      dst_vec[ni * 2 + 1] = f16x2_val[1];
+    //    } else {
+    //      float2 f32x2 = make_float2(f32x2_val[0], f32x2_val[1]);
+    //      __mt_bfloat162 res = __float22bfloat162_rn(f32x2);
+    //      dst_vec[ni * 2 + 0] = mutlass::bfloat16_t(res.x);
+    //      dst_vec[ni * 2 + 1] = mutlass::bfloat16_t(res.y);
+    //    }
+    //  }
+
+    //  int offset_m = get<0>(tCcC_mn(mi,0));
+
+    //  if (offset_m < residue_m) {
+    //    *reinterpret_cast<DstVec*>(ptr_C_base + offset_m * N + get<1>(tCcC_mn(0,0))) = dst_vec;
+    //  }
+    //}
+    //
+
+
+    MUTE_UNROLL
+    for (int i = 0; i < size(accum); ++i) {
+      if (elem_less(tCcC(i), make_coord(residue_m, residue_n))) {
+        tCgC(i) = typename KernelTraits::ElementC(accum(i));
+      }
+    }
+  }
+#else
+
+  MUTE_UNROLL
+  for (int i = 0; i < size(accum); ++i) {
+    if (get<0>(tCcC(i)) < residue_m) {
+      tCgC(i) = accum(i);
+    }
+  }
+#endif
+}
