+#include <torch/torch.h>
+#include <iostream>
+#include "v1_mp22_impl/attention_kernel.hpp"
+#include "v1_mp22_impl/kernel_traits.hpp"
+
+#include "../type_convert.muh"
+#include "../dispatch_utils.h"
+
+#define DISPATCH_HEAD_DIM_QK_VO(d_qk, d_vo, ...)                                                   \
+    TORCH_CHECK((d_qk) == (d_vo), "QK head dim (", d_qk, ") must match VO head dim (", d_vo, ")"); \
+    if ((d_qk) == 64)                                                                              \
+    {                                                                                              \
+        constexpr int HeadDimQK = 64;                                                              \
+        constexpr int HeadDimVO = 64;                                                              \
+        __VA_ARGS__();                                                                             \
+    }                                                                                              \
+    else if ((d_qk) == 128)                                                                        \
+    {                                                                                              \
+        constexpr int HeadDimQK = 128;                                                             \
+        constexpr int HeadDimVO = 128;                                                             \
+        __VA_ARGS__();                                                                             \
+    }                                                                                              \
+    else if ((d_qk) == 256)                                                                        \
+    {                                                                                              \
+        constexpr int HeadDimQK = 256;                                                             \
+        constexpr int HeadDimVO = 256;                                                             \
+        __VA_ARGS__();                                                                             \
+    }                                                                                              \
+    else                                                                                           \
+    {                                                                                              \
+        TORCH_CHECK(false, "Unsupported head dim: ", d_qk,                                         \
+                    ". Only 64, 128, 256 are supported.");                                         \
+    }
+
+template <typename T, bool return_lse, int HeadDimQK, int HeadDimVO>
+void varlen_flash_attn_fwd_kernel_launcher(
+    const T *Q, const T *K, const T *V,
+    T *out, T *P, float *Lse,
+    int q, int kv, int d_qk, int d_vo,
+    int h, int h_kv, int b, bool causal, mute::Shape<int, int, int> qkv_elem,
+    int q_seq_stride, int q_num_head_stride,
+    int k_num_page_stride, int k_page_size_stride, int k_num_head_stride,
+    int v_num_page_stride, int v_page_size_stride, int v_num_head_stride,
+    int o_seq_stride, int o_num_head_stride,
+    int lse_num_head_stride,
+    int *cu_q_seqlen, int *cu_kv_seqlen, int *block_table, int block_table_stride_batch, float sm_scale, int max_seqlen_q, int max_seqlen_kv)
+{
+    constexpr int TileM = 128;
+    constexpr int TileN = 32;
+    const musaStream_t stream = at::musa::getCurrentMUSAStream();
+    VariableLength varlen_q{max_seqlen_q, cu_q_seqlen};
+    VariableLength varlen_kv{max_seqlen_kv, cu_kv_seqlen};
+
+    int h_r = h / h_kv;
+    auto problem_shape = mute::make_shape(varlen_q, varlen_kv, d_qk, d_vo, mute::make_shape(h_r, h_kv), b);
+
+    using KernelTraits = AttentionForwardKernelTraits<HeadDimQK, HeadDimVO, TileM, TileN,
+                                                      true, true, true, true, true, T, return_lse>;
+
+    using AttentionParams = AttentionParams<KernelTraits>;
+    using Arguments = typename AttentionParams::Arguments;
+    Arguments arguments = {Q, K, V, out, Lse, P};
+
+    auto params = AttentionParams::to_underlying_arguments(problem_shape, arguments, qkv_elem,
+                                                           q_seq_stride, q_num_head_stride,
+                                                           k_num_page_stride, k_page_size_stride, k_num_head_stride,
+                                                           v_num_page_stride, v_page_size_stride, v_num_head_stride,
+                                                           o_seq_stride, o_num_head_stride,
+                                                           lse_num_head_stride,
+                                                           block_table, block_table_stride_batch, sm_scale);
+
+    dim3 block_dims(KernelTraits::NumThreads);
+    dim3 grid_dims(mute::ceil_div(mute::size<0>(problem_shape), KernelTraits::CTA_Q),
+                   mute::size<4>(problem_shape),
+                   mute::size<5>(problem_shape));
+
+    // musaDeviceSynchronize();
+    // auto error = musaGetLastError();
+    // if (error != musaSuccess)
+    // {
+    //     std::cerr << "Error before kernel launch: " << musaGetErrorString(error) << std::endl;
+    //     return;
+    // }
+
+    if (causal)
+    {
+        mp22_varlen_flash_atten_forward<KernelTraits, true, true><<<grid_dims, block_dims, 0, stream>>>(params);
+    }
+    else
+    {
+        mp22_varlen_flash_atten_forward<KernelTraits, true, false><<<grid_dims, block_dims, 0, stream>>>(params);
+    }
+
+    // musaDeviceSynchronize();
+    // error = musaGetLastError();
+    // if (error != musaSuccess)
+    // {
+    //     std::cerr << "Kernel execution error: " << musaGetErrorString(error) << std::endl;
+    // }
+}
+
+void mp22_flash_attn_varlen_func(torch::Tensor &Q,                  // [seqs_len, num_heads, head_size]
+                                 torch::Tensor &K,                  // [num_block, page_size, num_heads, head_size]
+                                 torch::Tensor &V,                  // [num_block, page_size, num_heads, head_size]
+                                 torch::Tensor &out,                // [seqs_len, num_heads, head_size]
+                                 c10::optional<torch::Tensor> &lse, // [ num_heads, seqs_len]
+                                 torch::Tensor &cu_q_seqlen,        // such as [0, 19, 44]
+                                 torch::Tensor &cu_kv_seqlen,
+                                 torch::Tensor &block_table,
+                                 float sm_scale,
+                                 int max_seqlen_q,
+                                 int max_seqlen_kv,
+                                 bool causal,
+                                 bool return_softmax_lse)
+{
+    TORCH_CHECK(Q.scalar_type() == at::ScalarType::BFloat16 ||
+                    Q.scalar_type() == at::ScalarType::Half,
+                "Unsupported data type: ", Q.scalar_type());
+
+    int current_arch = at::musa::getMUSAArch();
+    TORCH_CHECK(current_arch == 220, "flash_attn_varlen_fun not support on MUSA arch ", current_arch);
+
+    int q_elem = Q.storage().nbytes() / Q.element_size();
+    int k_elem = K.storage().nbytes() / K.element_size();
+    int v_elem = V.storage().nbytes() / V.element_size();
+    auto qkv_elem = mute::make_shape(q_elem, k_elem, v_elem);
+
+    int batch = cu_q_seqlen.size(0) - 1;
+    int num_head = Q.size(1);
+    int num_head_kv = K.size(2);
+    int d_qk = Q.size(2);
+    int d_vo = V.size(3);
+    void *P = nullptr;
+
+    int page_size = K.size(1);
+    TORCH_CHECK(page_size == 32, "mp22 varlen flash attn BLOCK_SIZE only support 32.");
+
+    float *lse_ptr = nullptr;
+    int lse_num_head_stride = 1;
+    if (return_softmax_lse)
+    {
+        TORCH_CHECK(lse.has_value(), "lse tensor is required");
+        lse_ptr = static_cast<float *>(lse->data_ptr());
+        lse_num_head_stride = lse->stride(0);
+    }
+
+    DISPATCH_HEAD_DIM_QK_VO(d_qk, d_vo, [&]
+                            {
+        if (return_softmax_lse) {
+            if (Q.scalar_type() == at::ScalarType::BFloat16) {
+                varlen_flash_attn_fwd_kernel_launcher<mutlass::bfloat16_t, true, HeadDimQK, HeadDimVO>(
+                    static_cast<mutlass::bfloat16_t *>(Q.data_ptr()),
+                    static_cast<mutlass::bfloat16_t *>(K.data_ptr()),
+                    static_cast<mutlass::bfloat16_t *>(V.data_ptr()),
+                    static_cast<mutlass::bfloat16_t *>(out.data_ptr()),
+                    static_cast<mutlass::bfloat16_t *>(P),
+                    lse_ptr,
+                    max_seqlen_q, max_seqlen_kv, d_qk, d_vo,
+                    num_head, num_head_kv, batch, causal, qkv_elem,
+                    Q.stride(0), Q.stride(1),
+                    K.stride(0), K.stride(1), K.stride(2),
+                    V.stride(0), V.stride(1), V.stride(2),
+                    out.stride(0), out.stride(1),
+                    lse_num_head_stride,
+                    static_cast<int *>(cu_q_seqlen.data_ptr()),
+                    static_cast<int *>(cu_kv_seqlen.data_ptr()),
+                    static_cast<int *>(block_table.data_ptr()),
+                    block_table.stride(0),
+                    sm_scale, max_seqlen_q, max_seqlen_kv);
+            } else { // Half
+                varlen_flash_attn_fwd_kernel_launcher<mutlass::half_t, true, HeadDimQK, HeadDimVO>(
+                    static_cast<mutlass::half_t *>(Q.data_ptr()),
+                    static_cast<mutlass::half_t *>(K.data_ptr()),
+                    static_cast<mutlass::half_t *>(V.data_ptr()),
+                    static_cast<mutlass::half_t *>(out.data_ptr()),
+                    static_cast<mutlass::half_t *>(P),
+                    lse_ptr,
+                    max_seqlen_q, max_seqlen_kv, d_qk, d_vo,
+                    num_head, num_head_kv, batch, causal, qkv_elem,
+                    Q.stride(0), Q.stride(1),
+                    K.stride(0), K.stride(1), K.stride(2),
+                    V.stride(0), V.stride(1), V.stride(2),
+                    out.stride(0), out.stride(1),
+                    lse_num_head_stride,
+                    static_cast<int *>(cu_q_seqlen.data_ptr()),
+                    static_cast<int *>(cu_kv_seqlen.data_ptr()),
+                    static_cast<int *>(block_table.data_ptr()),
+                    block_table.stride(0),
+                    sm_scale, max_seqlen_q, max_seqlen_kv);
+            }
+        } else {
+            if (Q.scalar_type() == at::ScalarType::BFloat16) {
+                varlen_flash_attn_fwd_kernel_launcher<mutlass::bfloat16_t, false, HeadDimQK, HeadDimVO>(
+                    static_cast<mutlass::bfloat16_t *>(Q.data_ptr()),
+                    static_cast<mutlass::bfloat16_t *>(K.data_ptr()),
+                    static_cast<mutlass::bfloat16_t *>(V.data_ptr()),
+                    static_cast<mutlass::bfloat16_t *>(out.data_ptr()),
+                    static_cast<mutlass::bfloat16_t *>(P),
+                    lse_ptr,
+                    max_seqlen_q, max_seqlen_kv, d_qk, d_vo,
+                    num_head, num_head_kv, batch, causal, qkv_elem,
+                    Q.stride(0), Q.stride(1),
+                    K.stride(0), K.stride(1), K.stride(2),
+                    V.stride(0), V.stride(1), V.stride(2),
+                    out.stride(0), out.stride(1),
+                    lse_num_head_stride,
+                    static_cast<int *>(cu_q_seqlen.data_ptr()),
+                    static_cast<int *>(cu_kv_seqlen.data_ptr()),
+                    static_cast<int *>(block_table.data_ptr()),
+                    block_table.stride(0),
+                    sm_scale, max_seqlen_q, max_seqlen_kv);
+            } else { // Half
+                varlen_flash_attn_fwd_kernel_launcher<mutlass::half_t, false, HeadDimQK, HeadDimVO>(
+                    static_cast<mutlass::half_t *>(Q.data_ptr()),
+                    static_cast<mutlass::half_t *>(K.data_ptr()),
+                    static_cast<mutlass::half_t *>(V.data_ptr()),
+                    static_cast<mutlass::half_t *>(out.data_ptr()),
+                    static_cast<mutlass::half_t *>(P),
+                    lse_ptr,
+                    max_seqlen_q, max_seqlen_kv, d_qk, d_vo,
+                    num_head, num_head_kv, batch, causal, qkv_elem,
+                    Q.stride(0), Q.stride(1),
+                    K.stride(0), K.stride(1), K.stride(2),
+                    V.stride(0), V.stride(1), V.stride(2),
+                    out.stride(0), out.stride(1),
+                    lse_num_head_stride,
+                    static_cast<int *>(cu_q_seqlen.data_ptr()),
+                    static_cast<int *>(cu_kv_seqlen.data_ptr()),
+                    static_cast<int *>(block_table.data_ptr()),
+                    block_table.stride(0),
+                    sm_scale, max_seqlen_q, max_seqlen_kv);
+            }
+        } });
+}
