+__device__ __host__ __forceinline__ uint32_t next_power_of_two(uint32_t n) {
+    if (n == 0)
+        return 1;
+    n -= 1;
+    n |= n >> 1;
+    n |= n >> 2;
+    n |= n >> 4;
+    n |= n >> 8;
+    n |= n >> 16;
+    return -~n;
+}
