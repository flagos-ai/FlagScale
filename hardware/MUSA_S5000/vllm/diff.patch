+  MUTE_UNROLL
+  for (int i = 0; i < size(tCpB); ++i) {
+    tCpB(i) = elem_less(get<0>(tCcB(_,_,Int<0>{})(i)), shape<0>(sB));
+  }
+
+#if 0
+  if (thread0()) {
+    print("  cA: "); print(  cA); print("\n");
