+        o = torch.empty((q.shape[0], q.shape[1], v.shape[-1]), device=q.device, dtype=q.dtype)
+        attn_out = flash_attn_fwd(q=q,
+                                k=k,
+                                v=maybe_padded_v.contiguous(),
+                                o=o,
