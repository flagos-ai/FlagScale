+#pragma once
+#include "common.muh"
+
+template <typename T>
+StatusX DispatchBatchGemvGeneral(T *o, const T *mat, const T *v,
+                                 const int batch, const int mat_m, const int k,
+                                 double alpha, musaStream_t &stream);
+
+template <typename T>
+StatusX _SwiGluRun(T *out, const T *in, const int batch, const int split_dim,
+                   const int nr_elem, musaStream_t &stream);
+
+/*
+C = MATMUL(A, B):
+    A shape: m, k
+    B shape: k, n
+    C shape: m, n
+X = SWIGLU(C)
+    C shape: m, n
+    X shape: m*n/2
+
+when m==1,
+    A is vector
+    B is matrix
+    X = GEMV_SIWGLU(B, A, n, k)
+    X shape: n/2
+*/
+template <typename T>
+StatusX GemvSwiGLU(T *o, const T *mat, const T *v, const int batch,
+                   const int mat_m, const int mat_k, const int ldm,
+                   const int batch_stride_m, const int inc_v,
+                   const int batch_stride_v, const int inc_o,
+                   const int batch_stride_o, double alpha, musaStream_t &stream,
+                   int num_mp);
