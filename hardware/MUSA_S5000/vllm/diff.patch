+
+void gemm_swiglu(torch::Tensor &output, // [batch, hidden_size/2]
+                 torch::Tensor &input,  // [batch, hidden_size]
+                 torch::Tensor &weight, // [hidden_size, hidden_size/2]
+                 double alpha) {
+
+  TORCH_CHECK(weight.scalar_type() == input.scalar_type(), "weight dtype must same as input");
+  // construct kernel input m=1
+  int batch = input.size(0);  // batch
+  int k = input.size(1);  // k
+  int n = weight.size(1); // n
+  int output_dim = n / 2;
+
+  int ldm = n;
+  float alpha_f = static_cast<float>(alpha);
+  int batch_stride_weight = k * n;
+  int inc_input = 1;
+  int batch_stride_input = k;
+  int inc_output = 1;
+  int batch_stride_output = output_dim;
+
+  const at::musa::OptionalMUSAGuard device_guard(device_of(input));
+  musaStream_t stream = at::musa::getCurrentMUSAStream();
+  // num_mp
+  int device;
+  musaGetDevice(&device);
+  musaDeviceProp device_prop;
+  musaGetDeviceProperties(&device_prop, device);
+  int num_mp = device_prop.multiProcessorCount;
+
+  switch (input.scalar_type()) {
+
+  case at::ScalarType::Float:
+    GemvSwiGLU<float>(output.data_ptr<float>(),
+              weight.data_ptr<float>(),
+              input.data_ptr<float>(),
+              batch,
+              n,
+              k,
+              ldm,
+              batch_stride_weight,
+              inc_input,
+              batch_stride_input,
+              inc_output,
+              batch_stride_output,
+              alpha_f,
+              stream,
+              num_mp);
+    break;
+  case at::ScalarType::Half:
+    GemvSwiGLU<float16_t>(static_cast<float16_t*>(output.data_ptr()),
+              static_cast<float16_t*>(weight.data_ptr()),
+              static_cast<float16_t*>(input.data_ptr()),
+              batch,
+              n,
+              k,
+              ldm,
+              batch_stride_weight,
+              inc_input,
+              batch_stride_input,
+              inc_output,
+              batch_stride_output,
+              alpha_f,
+              stream,
+              num_mp);
+    break;
+  case at::ScalarType::BFloat16:
+    GemvSwiGLU<bfloat16_t>(static_cast<bfloat16_t*>(output.data_ptr()),
+              static_cast<bfloat16_t*>(weight.data_ptr()),
+              static_cast<bfloat16_t*>(input.data_ptr()),
+              batch,
+              n,
+              k,
+              ldm,
+              batch_stride_weight,
+              inc_input,
+              batch_stride_input,
+              inc_output,
+              batch_stride_output,
+              alpha_f,
+              stream,
+              num_mp);
+    break;
+  default:
+    break;
+  }
+}
