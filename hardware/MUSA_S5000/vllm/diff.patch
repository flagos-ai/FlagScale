+/*! \file
+    \brief Reference implementation for GEMM in host-side code.
+*/
+
+#pragma once
+
+#include "mutlass/coord.h"
+#include "mutlass/tensor_view.h"
+#include "mutlass/gemm/gemm.h"
+
+#include "mutlass/util/reference/device/thread/gemm.h"
