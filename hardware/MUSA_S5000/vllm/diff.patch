diff --git a/vllm_musa/csrc/linear/gemv_w4a16.mu b/vllm_musa/csrc/linear/gemv_w4a16.mu
new file mode 100644
index 000000000..d92547ea5
--- /dev/null
+++ b/vllm_musa/csrc/linear/gemv_w4a16.mu
@@ -0,0 +1,314 @@
+#include "common.muh"
+#include "dtype.muh"
+#include "gemv_swiglu.muh"
+#include <musa_runtime.h>
+#include <cassert>
+#include <mutex>
+
+#include "../type_convert.muh"
+#include "../dispatch_utils.h"
+
+using namespace musa::dnn;
+
+template <typename T, AlignAttr ALIGN_ATTR, int BLOCK_K, int BLOCK_M, int iobit, typename PACKED_T, int coeff = 8>
+__global__ void batch_gemv_col_continuous_w4a16(
+    T *d, const PACKED_T *mat, const T *v, const int batch, const int m, const int k,
+    const int ldm, const int64_t batch_stride_m, const int inc_x,
+    const int64_t batch_stride_x, const int inc_d, const int64_t batch_stride_d,
+    float alpha, float* scale, const int half_m) {
+  constexpr int bits_of_byte = 8;
+  constexpr int Vlen = iobit / (sizeof(PACKED_T) * bits_of_byte);
+  using CDtype = typename InferComputeDtype<T>::ComputeDtype;
+  using pvec = typename VecType<PACKED_T, iobit>::Ttype;
+  using tvec = typename VecType<T, coeff * sizeof(T) * bits_of_byte>::Ttype;
+  using fvec = typename VecType<float, Vlen * sizeof(float) * bits_of_byte>::Ttype;
+  using cvec = typename VecType<CDtype, 128>::Ttype;
+
+  int tid2 = threadIdx.x;
+  int bx = blockIdx.x;
+  int by = blockIdx.y;
+  if (bx * BLOCK_M >= half_m)
+    return;
+
+  int part_id = tid2 / (blockDim.x / 2);
+  int tid = tid2 % (blockDim.x / 2);
+  int slice_id = tid % (BLOCK_M / Vlen);
+  int lane_id = tid / (BLOCK_M / Vlen);
+  int m_id = bx * BLOCK_M + slice_id * Vlen;
+
+  extern __shared__ char shared_array[];
+  CDtype *smem = (CDtype *)shared_array;
+
+  CDtype cur_thread_sum[Vlen];
+#pragma unroll
+  for (int i = 0; i < Vlen; i++) {
+    cur_thread_sum[i] = (CDtype)0;
+  }
+
+  float s_reg[Vlen];
+  if (m_id < half_m) {
+    int64_t base_m_id = m_id + part_id * half_m;
+    if constexpr (ALIGN_ATTR == AlignAttr::ALIGN_VEC) {
+      *(fvec *)(s_reg) = *(fvec *)(scale + base_m_id);
+    } else {
+      if (bx * BLOCK_M + BLOCK_M <= half_m) {
+        *(fvec *)(s_reg) = *(fvec *)(scale + base_m_id);
+      } else {
+        s_reg[0] = scale[base_m_id];
+#pragma unroll
+        for (int p = 1; p < 4; p++) {
+          s_reg[p] = (m_id + p < half_m) ? scale[base_m_id + p] : 0.f;
+        }
+      }
+    }
+  }
+
+  for (int row_id = lane_id; row_id < k; row_id += BLOCK_K) {
+    if (m_id < half_m) {
+      PACKED_T m_reg[Vlen];
+      int64_t base_mat_offset = row_id * (int64_t)ldm + m_id + part_id * half_m;
+      if constexpr (ALIGN_ATTR == AlignAttr::ALIGN_VEC) {
+        *((pvec *)m_reg) = *(pvec *)(mat + base_mat_offset);
+      } else {
+        if (bx * BLOCK_M + BLOCK_M <= half_m) {
+          *((pvec *)m_reg) = *(pvec *)(mat + base_mat_offset);
+        } else {
+          m_reg[0] = *(mat + base_mat_offset);
+#pragma unroll
+          for (int p = 1; p < Vlen; p++) {
+            m_reg[p] = (m_id + p < half_m) ? *(mat + base_mat_offset + p) : static_cast<PACKED_T>(0);
+          }
+        }
+      }
+
+      int64_t v_offset = row_id * coeff * inc_x + by * batch_stride_x;
+      T v_reg[coeff];
+      *((tvec *)v_reg) = *(tvec *)(v + v_offset);
+#pragma unroll
+      for (int p = 0; p < Vlen; p++) {
+        PACKED_T packed_val = m_reg[p];
+        CDtype val = 0;
+#pragma unroll
+        for (int i = 0; i < coeff; i++) {
+          int32_t elem = ((packed_val >> (i * 4)) & 0xF);
+          elem = (elem & 0x8) ? elem - 16 : elem;
+          val += (CDtype)v_reg[i] * ((CDtype)elem * s_reg[p]);
+        }
+        cur_thread_sum[p] += val;
+      }
+    }
+  }
+
+
+  CDtype *smem_mat = smem;
+  int sts_offset = (lane_id * BLOCK_M * 2 + part_id * BLOCK_M + slice_id * Vlen);
+#pragma unroll
+  for (int p = 0; p < Vlen / 4; p++) {
+    *(cvec *)(&smem_mat[sts_offset + p * 4]) =
+        *(cvec *)(&cur_thread_sum[p * 4]);
+  }
+  __SYNCTHREADS_LM;
+
+#pragma unroll
+  for (int p = 0; p < Vlen / 4; p++) {
+#pragma unroll
+    for (int a = BLOCK_K / 2; a > 1; a >>= 1) {
+      if (lane_id < a) {
+        cvec w_reg = *(cvec *)(&smem_mat[sts_offset + p * 4]);
+        cvec r_reg = *(cvec *)(&smem_mat[sts_offset + p * 4 + a * BLOCK_M * 2]);
+        w_reg.x += r_reg.x;
+        w_reg.y += r_reg.y;
+        w_reg.z += r_reg.z;
+        w_reg.w += r_reg.w;
+        *(cvec *)(&smem_mat[sts_offset + p * 4]) = w_reg;
+      }
+      __SYNCTHREADS_LM;
+    }
+  }
+
+  m_id = bx * BLOCK_M + tid;
+  if (tid < BLOCK_M && m_id < half_m) {
+    CDtype res0 = alpha * (smem_mat[tid] + smem_mat[BLOCK_M * 2 + tid]);
+    int64_t out_offset0 = by * batch_stride_d + m_id * (int64_t)inc_d;
+    d[out_offset0] = res0;
+  }
+  if (tid < BLOCK_M && m_id < half_m) {
+    CDtype res1 = alpha * (smem_mat[tid + BLOCK_M] + smem_mat[BLOCK_M * 2 + tid + BLOCK_M]);
+    int64_t out_offset1 = by * batch_stride_d + (m_id + half_m) * (int64_t)inc_d;
+    d[out_offset1] = res1;
+  }
+}
+
+
+#define BATCH_GEMV_COLCONTINUOUS_LAUNCH(_ALIGN_ATTR, _IOBIT)            \
+  {                                                                            \
+    int smem_bytes = 2 * block_k * block_m * sizeof(float);                    \
+    batch_gemv_col_continuous_w4a16<T, _ALIGN_ATTR, block_k, block_m,      \
+                                           _IOBIT, int32_t, 8>                  \
+        <<<grid_size, block_size, smem_bytes, stream>>>(                       \
+            o, mat, v, batch, mat_m, packed_mat_k, ldm, packed_batch_stride_m, \
+            inc_v, batch_stride_v, inc_o, batch_stride_o, alpha, scale,        \
+            half_mat_m);                                                       \
+  }
+
+#define BATCH_GEMV_COLCONTINUOUS_CALL(_IOBIT)                           \
+  if (aligned_vec) {                                                           \
+    BATCH_GEMV_COLCONTINUOUS_LAUNCH(AlignAttr::ALIGN_VEC, _IOBIT)         \
+  } else {                                                                     \
+    BATCH_GEMV_COLCONTINUOUS_LAUNCH(AlignAttr::GENERAL, _IOBIT)           \
+  }
+
+
+template <typename T>
+StatusX GemvW4A16(T *o, const int32_t *mat, const T *v, float* scale, const int batch,
+                        const int mat_m, const int mat_k, const int ldm,
+                        const int batch_stride_m, const int inc_v,
+                        const int batch_stride_v, const int inc_o,
+                        const int batch_stride_o, float alpha, musaStream_t &stream,
+                        int num_mp) {
+  if (0 != mat_m % 2) {
+    printf("mat_m must be even.\n");
+    return StatusX::INVALID_PARAMETER;
+  }
+  if (0 != mat_k % 8) {
+    printf("mat_k must be a multiple of 8.\n");
+    return StatusX::INVALID_PARAMETER;
+  }
+
+  const int half_mat_m = mat_m / 2;
+  const int packed_mat_k = mat_k / 8;
+  const int packed_batch_stride_m = batch_stride_m / 8;
+
+  dim3 block_size{128, 1, 1};
+  dim3 grid_size{1, static_cast<uint32_t>(batch), 1};
+
+  constexpr int iobit = 128;
+  constexpr int bits_of_byte = 8;
+  constexpr int vlen = iobit / (sizeof(int32_t) * bits_of_byte);
+  constexpr int elems_per_cacheline = 128 / sizeof(int32_t);
+
+  bool aligned_vec = half_mat_m >= vlen && half_mat_m % vlen == 0;
+
+
+  int blk_m_list[4] = {8, 16, 32, 64};
+  int blk_scores[4] = {0, 0, 0, 0};
+  for (int i = 0; i < 4; i++) {
+    int blks = ceil_div(half_mat_m, blk_m_list[i]);
+    if (blks < num_mp) {
+      blk_scores[i] = 1;
+      break;
+    }
+    float ratio = (float)blks / num_mp;
+    blk_scores[i] = ratio - (int)ratio;
+  }
+
+  int chose_block = 0;
+  int chose_score = 0;
+  for (int i = 0; i < 4; i++) {
+    if (blk_scores[i] > chose_score) {
+      chose_score = blk_scores[i];
+      chose_block = i;
+    }
+  }
+
+
+#define BLOCK_STRATEGY_M(_BLK_M)                                         \
+  {                                                                      \
+    constexpr int block_m = _BLK_M;                                      \
+    constexpr int block_k = 512 / (block_m / vlen);                      \
+    block_size.x = block_k * (block_m / vlen) * 2;                         \
+    grid_size.x = ceil_div(half_mat_m, block_m);                           \
+    BATCH_GEMV_COLCONTINUOUS_CALL(iobit)                            \
+  }
+
+  switch (chose_block) {
+    case 0:
+      BLOCK_STRATEGY_M(8);
+      break;
+    case 1:
+      BLOCK_STRATEGY_M(16);
+      break;
+    case 2:
+      BLOCK_STRATEGY_M(32);
+      break;
+    case 3:
+      BLOCK_STRATEGY_M(64);
+      break;
+    default:
+      BLOCK_STRATEGY_M(32);
+  }
+
+  MUSA_CHECK(musaGetLastError());
+  return StatusX::SUCCESS;
+}
+
+void gemm_w4a16(torch::Tensor &output,
+                        torch::Tensor &input,
+                        torch::Tensor &weight,
+                        torch::Tensor &scale,
+                        double alpha) {
+  TORCH_CHECK(weight.scalar_type() == at::ScalarType::Int, "weight dtype must be int32.");
+  // TORCH_CHECK(input.scalar_type() == at::ScalarType::BFloat16, "input dtype must be bfloat16.");
+
+  int batch = input.size(0);
+  int k = input.size(1);
+  int n = weight.size(1);
+  int output_dim = n;
+
+  int ldm = n;
+  float alpha_f = static_cast<float>(alpha);
+  int batch_stride_weight = k * n;
+  int inc_input = 1;
+  int batch_stride_input = k;
+  int inc_output = 1;
+  int batch_stride_output = output_dim;
+
+  const at::musa::OptionalMUSAGuard device_guard(device_of(input));
+  musaStream_t stream = at::musa::getCurrentMUSAStream();
+
+  int device;
+  musaGetDevice(&device);
+  musaDeviceProp device_prop;
+  musaGetDeviceProperties(&device_prop, device);
+  int num_mp = device_prop.multiProcessorCount;
+
+  if (input.scalar_type() == at::ScalarType::BFloat16) {
+    GemvW4A16<bfloat16_t>(
+      static_cast<bfloat16_t *>(output.data_ptr()),
+      reinterpret_cast<int32_t *>(weight.data_ptr()),
+      static_cast<bfloat16_t *>(input.data_ptr()),
+      static_cast<float *>(scale.data_ptr()),
+      batch,
+      n,
+      k,
+      ldm,
+      batch_stride_weight,
+      inc_input,
+      batch_stride_input,
+      inc_output,
+      batch_stride_output,
+      alpha_f,
+      stream,
+      num_mp
+    );
+  } else if (input.scalar_type() == at::ScalarType::Half) {
+    GemvW4A16<float16_t>(
+      static_cast<float16_t *>(output.data_ptr()),
+      reinterpret_cast<int32_t *>(weight.data_ptr()),
+      static_cast<float16_t *>(input.data_ptr()),
+      static_cast<float *>(scale.data_ptr()),
+      batch,
+      n,
+      k,
+      ldm,
+      batch_stride_weight,
+      inc_input,
+      batch_stride_input,
+      inc_output,
+      batch_stride_output,
+      alpha_f,
+      stream,
+      num_mp
+    );
+  }
+}
