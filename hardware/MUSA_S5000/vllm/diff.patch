+    if return_softmax_lse:
+        lse = torch.empty((q.shape[1], q.shape[0]), device=q.device, dtype=torch.float32)
+    _kernels.flash_attn_fwd(q, k, v, o, lse, cu_q_seqlen, cu_kv_seqlen, max_seqlen_q, max_seqlen_kv, causal, varlen, return_softmax_lse)
