diff --git a/vllm_musa/csrc/decode_mla/mp22_impl/decode_mla_params.hpp b/vllm_musa/csrc/decode_mla/mp22_impl/decode_mla_params.hpp
new file mode 100644
index 000000000..5701925c6
--- /dev/null
+++ b/vllm_musa/csrc/decode_mla/mp22_impl/decode_mla_params.hpp
@@ -0,0 +1,152 @@
+#pragma once
+
+#include "decode_mla_kernel_traits.hpp"
+#include "mutlass_extension.hpp"
+
+template <class KernelTraits>
+struct DecodeMLAParams {
+  using Element = typename KernelTraits::Element;
+  using ElementAccumulator = typename KernelTraits::ElementAccumulator;
+
+  using ElementO = typename KernelTraits::ElementO;
+
+  using IndexType = int32_t;
+
+  // Q, K, D_QK, D_VO, (H_R, H_KV), B
+  using ProblemShape = Shape<_1, int, int, int, Shape<int, int>, int>;
+
+  // Q, D_QK, (H_R, H_KV), B
+  using StrideQ = Stride<_0, _1, Stride<int, int>, int>;
+
+  // K, D_QK, (H_R, H_KV), B
+  using StrideK = Stride<int, _1, Stride<_0, int>, int>;
+
+  // V, D_VO, (H_R, H_KV), B
+  using StrideV = StrideK;
+
+  // Q, D_VO, (H_R, H_KV), B
+  using StrideO = StrideQ;
+
+  struct Arguments {
+    Element const* ptr_Q;
+    Element const* ptr_K_Buffer;
+    Element const* ptr_V_Buffer;
+
+    int32_t const* ptr_Req_to_tokens;
+
+    int32_t const* ptr_B_Seqlen;
+
+    ElementO* ptr_O;
+
+    float sm_scale;
+    int NumKVSplits;
+    int NumPages;
+
+    IndexType stride_req_to_tokens_b;
+    IndexType stride_qbs;
+    IndexType stride_qh;
+    IndexType stride_buf_kbs;
+    IndexType stride_buf_kh;
+    IndexType stride_buf_vbs;
+    IndexType stride_buf_vh;
+    IndexType stride_mid_ob;
+    IndexType stride_mid_oh;
+    IndexType stride_mid_os;
+  };
+
+  struct Params {
+    ProblemShape problem_shape;
+
+    Element const* ptr_Q;
+    StrideQ stride_Q;
+    RobustDescriptor desc_Q;
+
+    Element const* ptr_K_Buffer;
+    StrideK stride_K;
+    RobustDescriptor desc_K;
+
+    Element const* ptr_V_Buffer;
+    StrideV stride_V;
+    RobustDescriptor desc_V;
+
+    int32_t const* ptr_Req_to_tokens;
+
+    int32_t const* ptr_B_Seqlen;
+
+    ElementO* ptr_O;
+    StrideO stride_O;
+
+    float sm_scale;
+    int NumKVSplits;
+    IndexType stride_req_to_tokens_b;
+    IndexType stride_qbs;
+    IndexType stride_qh;
+    IndexType stride_buf_kbs;
+    IndexType stride_buf_kh;
+    IndexType stride_buf_vbs;
+    IndexType stride_buf_vh;
+    IndexType stride_mid_ob;
+    IndexType stride_mid_oh;
+    IndexType stride_mid_os;
+
+    float rescale;
+  };
+
+  static Params
+  to_underlying_arguments(ProblemShape problem_shape, Arguments const& args) {
+    int DimQK = mute::size<2>(problem_shape);
+    int DimVO = mute::size<3>(problem_shape);
+    int H = mute::size<4>(problem_shape);
+    int H_KV = mute::size<4,1>(problem_shape);
+    int B = mute::size<5>(problem_shape);
+
+    StrideQ stride_Q = make_stride(_0{}, _1{}, make_stride(H_KV*args.stride_qh, args.stride_qh), args.stride_qbs);
+
+    // handle batch&seq in kernel
+    StrideK stride_K = make_stride(args.stride_buf_kbs, _1{}, make_stride(_0{}, args.stride_buf_kh), 0);
+
+    StrideV stride_V = make_stride(args.stride_buf_vbs, _1{}, make_stride(_0{}, args.stride_buf_vh), 0);
+
+    StrideO stride_O = make_stride(_0{}, _1{}, make_stride(H_KV*args.stride_mid_oh, args.stride_mid_oh), args.stride_mid_ob);
+
+    // Just wrapper robust Q
+    RobustDescriptor desc_Q = make_robust_desc(args.ptr_Q, DimQK * H * B);
+    RobustDescriptor desc_K = make_robust_desc(args.ptr_K_Buffer, DimQK * H_KV * KernelTraits::PAGE_SIZE * args.NumPages);
+    RobustDescriptor desc_V = make_robust_desc(args.ptr_V_Buffer, DimVO * H_KV * KernelTraits::PAGE_SIZE * args.NumPages);
+
+    constexpr float kLog2e = float(1.4426950408889634074);
+    constexpr float rescale = 1.0f / kLog2e;
+
+    float sm_scale = args.sm_scale * kLog2e;
+
+    return {
+      problem_shape,
+      args.ptr_Q,
+      stride_Q,
+      desc_Q,
+      args.ptr_K_Buffer,
+      stride_K,
+      desc_K,
+      args.ptr_V_Buffer,
+      stride_V,
+      desc_V,
+      args.ptr_Req_to_tokens,
+      args.ptr_B_Seqlen,
+      args.ptr_O,
+      stride_O,
+      sm_scale,
+      args.NumKVSplits,
+      args.stride_req_to_tokens_b,
+      args.stride_qbs,
+      args.stride_qh,
+      args.stride_buf_kbs,
+      args.stride_buf_kh,
+      args.stride_buf_vbs,
+      args.stride_buf_vh,
+      args.stride_mid_ob,
+      args.stride_mid_oh,
+      args.stride_mid_os,
+      rescale
+    };
+  }
+};
diff --git a/vllm_musa/csrc/decode_mla/mp22_impl/mutlass_extension.hpp b/vllm_musa/csrc/decode_mla/mp22_impl/mutlass_extension.hpp
new file mode 100644
index 000000000..136bbac4f
--- /dev/null
+++ b/vllm_musa/csrc/decode_mla/mp22_impl/mutlass_extension.hpp
@@ -0,0 +1,410 @@
+#pragma once
+
+#if defined(__MUSA_ARCH__) && (__MUSA_ARCH__ == 220)
+#define MUTE_MP22_ROBUST_EXT
+#endif
+
+#include <mute/config.hpp>
+#include <mute/atom/copy_atom.hpp>
+#include <mute/arch/copy_mp31_desc.hpp> // RobustDescriptor
+
+namespace mute {
+
+//
+// Robust LD
+//
+template <class TS, class TD = TS>
+struct MP22_ROBUST_LOAD
+{
+  using SRegisters = TS[1];
+  using DRegisters = TD[1];
+
+  static_assert(sizeof(TS) == sizeof(TD),
+                "MP22_ROBUST_LOAD requires sizeof(src_value_type) == sizeof(dst_value_type)");
+
+  MUTE_HOST_DEVICE static void
+  copy(TS               const& gmem_src,
+       TD                    & rmem_dst,
+       bool                    pred,
+       RobustDescriptor const& src_desc)
+
+  {
+#if defined(MUTE_MP22_ROBUST_EXT)
+    void const* gmem_ptr = pred ? reinterpret_cast<void const*>(&gmem_src)
+                         : reinterpret_cast<void const*>(src_desc.oob_addr);
+    // meet the intrinsic requirement
+    using RobustRegV3 = uint32_t __attribute__((vector_size(12)));
+    union ExtractRobustReg {
+      RobustReg reg_v4;
+      struct {
+        RobustRegV3 reg;
+        uint32_t dummy;
+      };
+    };
+
+    ExtractRobustReg desc {src_desc.reg};
+
+    if constexpr (sizeof(TS) == 1) {
+      auto val = __musa_ld_robust_i8(gmem_ptr, desc.reg);
+      rmem_dst = *reinterpret_cast<TD*>(&val);
+    } else if constexpr (sizeof(TS) == 2) {
+      auto val = __musa_ld_robust_i16(gmem_ptr, desc.reg);
+      rmem_dst = *reinterpret_cast<TD*>(&val);
+    } else if constexpr (sizeof(TS) == 4) {
+      auto val = __musa_ld_robust_i32(gmem_ptr, desc.reg);
+      rmem_dst = *reinterpret_cast<TD*>(&val);
+    } else if constexpr (sizeof(TS) == 8) {
+      auto val = __musa_ld_robust_i64(gmem_ptr, desc.reg);
+      rmem_dst = *reinterpret_cast<TD*>(&val);
+    } else if constexpr (sizeof(TS) == 16) {
+      auto val = __musa_ld_robust_v4i32(gmem_ptr, desc.reg);
+      rmem_dst = *reinterpret_cast<TD*>(&val);
+    } else if constexpr (sizeof(TS) == 32) {
+      auto val = __musa_ld_robust_v8i32(gmem_ptr, desc.reg);
+      rmem_dst = *reinterpret_cast<TD*>(&val);
+    } else if constexpr (sizeof(TS) == 64) {
+      auto val = __musa_ld_robust_v16i32(gmem_ptr, desc.reg);
+      rmem_dst = *reinterpret_cast<TD*>(&val);
+    } else if constexpr (sizeof(TS) == 128) {
+      auto val = __musa_ld_robust_v32i32(gmem_ptr, desc.reg);
+      rmem_dst = *reinterpret_cast<TD*>(&val);
+    } else {
+      static_assert(sizeof(TS) <= 128, "Currently we only support up-to 1024-bit load");
+    }
+#else
+    MUTE_INVALID_CONTROL_PATH(
+        "Trying to use MP22_ROBUST_LOAD without MUTE_ARCH_ROBUST_BUFFER_ACCESS_ACTIVATED.");
+#endif
+  }
+};
+
+
+//
+// Robust load traits
+//
+template <class S, class D>
+struct MP22_ROBUST_LOAD_OP : MP22_ROBUST_LOAD<S, D> {};
+
+template <class S, class D>
+struct MP22_ROBUST_PRED_LOAD_OP : MP22_ROBUST_LOAD<S, D> {};
+
+template <class S, class D>
+struct Copy_Traits<MP22_ROBUST_PRED_LOAD_OP<S, D>>
+{
+  // Logical thread id to thread idx (one-thread)
+  using ThrID     = Layout<_1>;
+
+  // Map from (src-thr,src-val) to bit
+  using SrcLayout = Layout<Shape<_1, Int<sizeof_bits<S>::value>>>;
+  // Map from (dst-thr,dst-val) to bit
+  using DstLayout = Layout<Shape<_1, Int<sizeof_bits<D>::value>>>;
+
+  // Reference map from (thr,val) to bit
+  using RefLayout = SrcLayout;
+
+  // Robust Buffer Access Descriptor
+  const RobustDescriptor src_desc;
+
+  // Predicate value that determines whether to load or return zero
+  bool pred;
+
+  // Overload copy_unpack to pass robust buffer access descriptor
+  template <class TS, class SLayout,
+            class TD, class DLayout>
+  MUTE_HOST_DEVICE friend constexpr
+  void
+  copy_unpack(Copy_Traits         const& traits,
+              Tensor<TS, SLayout> const& src,
+              Tensor<TD, DLayout>      & dst)
+  {
+    static_assert(is_gmem<TS>::value, "Expected gmem src for MP22_ROBUST_LOAD");
+    static_assert(is_rmem<TD>::value, "Expected rmem dst for MP22_ROBUST_LOAD");
+
+    Tensor rS = recast<S>(src);
+    Tensor rD = recast<D>(dst);
+
+    MUTE_STATIC_ASSERT_V(size(rS) == Int<1>{},
+        "This src layout is incompatible with this tiled copy.");
+    MUTE_STATIC_ASSERT_V(size(rD) == Int<1>{},
+        "This dst layout is incompatible with this tiled copy.");
+
+    MP22_ROBUST_LOAD<S, D>::copy(rS[0], rD[0], traits.pred, traits.src_desc);
+  }
+};
+
+template <class S, class D>
+struct Copy_Traits<MP22_ROBUST_LOAD_OP<S, D>>
+{
+  // Logical thread id to thread idx (one-thread)
+  using ThrID     = Layout<_1>;
+
+  // Map from (src-thr,src-val) to bit
+  using SrcLayout = Layout<Shape<_1, Int<sizeof_bits<S>::value>>>;
+  // Map from (dst-thr,dst-val) to bit
+  using DstLayout = Layout<Shape<_1, Int<sizeof_bits<D>::value>>>;
+
+  // Reference map from (thr,val) to bit
+  using RefLayout = SrcLayout;
+
+  // Robust Buffer Access Descriptor
+  const RobustDescriptor src_desc;
+
+  MUTE_HOST_DEVICE constexpr
+  Copy_Traits<MP22_ROBUST_PRED_LOAD_OP<S, D>>
+  with(bool pred) const {
+    return {src_desc, pred};
+  }
+};
+
+template <class S, class D>
+struct Copy_Traits<MP22_ROBUST_LOAD<S, D>>
+{
+  // Logical thread id to thread idx (one-thread)
+  using ThrID     = Layout<_1>;
+
+  // Map from (src-thr,src-val) to bit
+  using SrcLayout = Layout<Shape<_1, Int<sizeof_bits<S>::value>>>;
+  // Map from (dst-thr,dst-val) to bit
+  using DstLayout = Layout<Shape<_1, Int<sizeof_bits<D>::value>>>;
+
+  // Reference map from (thr,val) to bit
+  using RefLayout = SrcLayout;
+
+  // Construct an executable MP22_ROBUST_LOAD with robust buffer access descriptor
+  MUTE_HOST_DEVICE constexpr
+  Copy_Traits<MP22_ROBUST_LOAD_OP<S, D>>
+  with(RobustDescriptor desc) const {
+    return {desc};
+  }
+
+  // Don't try to execute a copy with MP22_ROBUST_LOAD before calling .with()
+  template <class TS, class SLayout,
+            class TD, class DLayout>
+  MUTE_HOST_DEVICE friend constexpr
+  void
+  copy_unpack(Copy_Traits         const& traits,
+              Tensor<TS, SLayout> const& src,
+              Tensor<TD, DLayout>      & dst) = delete;
+
+};
+
+
+//
+// Robust LDGSTS
+//
+template <class TS, class TD = TS>
+struct MP22_ROBUST_LDGSTS
+{
+  using SRegisters = TS[1];
+  using DRegisters = TD[1];
+
+  static_assert(sizeof(TS) == sizeof(TD),
+                "MP22_ROBUST_LDGSTS requires sizeof(src_value_type) == sizeof(dst_value_type)");
+  static_assert(sizeof(TS) == 1  || sizeof(TS) == 2  || sizeof(TS) == 4  || sizeof(TS) == 8 ||
+                sizeof(TS) == 16 || sizeof(TS) == 32 || sizeof(TS) == 64 || sizeof(TS) == 128,
+                "MP22_ROBUST_LDGSTS sizeof(TS) is not supported");
+
+  MUTE_HOST_DEVICE static void
+  copy(TS               const& gmem_src,
+       TD                    & smem_dst,
+       bool                    pred,
+       RobustDescriptor const& src_desc)
+  {
+#if defined(MUTE_MP22_ROBUST_EXT)
+    uint64_t gmem_int_ptr = reinterpret_cast<uint64_t>(&gmem_src);
+    uint32_t smem_int_ptr = cast_smem_ptr_to_uint(&smem_dst);
+    auto gmem_ptr = make_ptr_with_address_space<AddressSpace::Global>(
+                            pred ? gmem_int_ptr : src_desc.oob_addr);
+    auto smem_ptr = make_ptr_with_address_space<AddressSpace::Shared>(smem_int_ptr);
+
+    // meet the intrinsic requirement
+    using RobustRegV3 = uint32_t __attribute__((vector_size(12)));
+    union ExtractRobustReg {
+      RobustReg reg_v4;
+      struct {
+        RobustRegV3 reg;
+        uint32_t dummy;
+      };
+    };
+
+    ExtractRobustReg desc {src_desc.reg};
+
+    __musa_memcpy_g2s_robust(smem_ptr, gmem_ptr, sizeof(TS), desc.reg, 0);
+#else
+    MUTE_INVALID_CONTROL_PATH(
+        "Trying to use MP22_ROBUST_LDGSTS without MUTE_ARCH_ROBUST_BUFFER_ACCESS_ACTIVATED.");
+#endif
+  }
+};
+
+MUTE_HOST_DEVICE
+void
+ldlms_wait() {
+#if defined(MUTE_MP22_ROBUST_EXT)
+  __musa_memcpy_g2s_wait();
+#else
+  MUTE_INVALID_CONTROL_PATH("Trying to use MemcpyG2S Wait without MUTE_ARCH_ROBUST_BUFFER_ACCESS_ACTIVATED.");
+#endif
+}
+
+
+//
+// Robust LDGSTS traits
+//
+template <class S, class D>
+struct MP22_ROBUST_LDGSTS_OP : MP22_ROBUST_LDGSTS<S, D> {};
+
+template <class S, class D>
+struct MP22_ROBUST_PRED_LDGSTS_OP : MP22_ROBUST_LDGSTS<S, D> {};
+
+
+template <class S, class D>
+struct Copy_Traits<MP22_ROBUST_PRED_LDGSTS_OP<S, D>>
+{
+  // Logical thread id to thread idx (one-thread)
+  using ThrID     = Layout<_1>;
+
+  // Map from (src-thr,src-val) to bit
+  using SrcLayout = Layout<Shape<_1, Int<sizeof_bits<S>::value>>>;
+  // Map from (dst-thr,dst-val) to bit
+  using DstLayout = Layout<Shape<_1, Int<sizeof_bits<D>::value>>>;
+
+  // Reference map from (thr,val) to bit
+  using RefLayout = SrcLayout;
+
+  // Robust Buffer Access Descriptor
+  const RobustDescriptor src_desc;
+
+  // Predicate value that determines whether to load or return zero
+  bool pred;
+
+  // Overload copy_unpack to pass robust buffer access descriptor
+  template <class TS, class SLayout,
+            class TD, class DLayout>
+  MUTE_HOST_DEVICE friend constexpr
+  void
+  copy_unpack(Copy_Traits         const& traits,
+              Tensor<TS, SLayout> const& src,
+              Tensor<TD, DLayout>      & dst)
+  {
+    static_assert(is_gmem<TS>::value, "Expected gmem src for MP22_ROBUST_LDGSTS");
+    static_assert(is_smem<TD>::value, "Expected smem dst for MP22_ROBUST_LDGSTS");
+
+    Tensor rS = recast<S>(src);
+    Tensor rD = recast<D>(dst);
+
+    MUTE_STATIC_ASSERT_V(size(rS) == Int<1>{},
+        "This src layout is incompatible with this tiled copy.");
+    MUTE_STATIC_ASSERT_V(size(rD) == Int<1>{},
+        "This dst layout is incompatible with this tiled copy.");
+
+    MP22_ROBUST_LDGSTS<S, D>::copy(rS[0], rD[0], traits.pred, traits.src_desc);
+  }
+};
+
+template <class S, class D>
+struct Copy_Traits<MP22_ROBUST_LDGSTS_OP<S, D>>
+{
+  // Logical thread id to thread idx (one-thread)
+  using ThrID     = Layout<_1>;
+
+  // Map from (src-thr,src-val) to bit
+  using SrcLayout = Layout<Shape<_1, Int<sizeof_bits<S>::value>>>;
+  // Map from (dst-thr,dst-val) to bit
+  using DstLayout = Layout<Shape<_1, Int<sizeof_bits<D>::value>>>;
+
+  // Reference map from (thr,val) to bit
+  using RefLayout = SrcLayout;
+
+  // Robust Buffer Access Descriptor
+  const RobustDescriptor src_desc;
+
+  MUTE_HOST_DEVICE constexpr
+  Copy_Traits<MP22_ROBUST_PRED_LDGSTS_OP<S, D>>
+  with(bool pred) const {
+    return {src_desc, pred};
+  }
+};
+
+template <class S, class D>
+struct Copy_Traits<MP22_ROBUST_LDGSTS<S, D>>
+{
+  // Logical thread id to thread idx (one-thread)
+  using ThrID     = Layout<_1>;
+
+  // Map from (src-thr,src-val) to bit
+  using SrcLayout = Layout<Shape<_1, Int<sizeof_bits<S>::value>>>;
+  // Map from (dst-thr,dst-val) to bit
+  using DstLayout = Layout<Shape<_1, Int<sizeof_bits<D>::value>>>;
+
+  // Reference map from (thr,val) to bit
+  using RefLayout = SrcLayout;
+
+  // Construct an executable MP22_ROBUST_LDGSTS with robust buffer access descriptor
+  MUTE_HOST_DEVICE constexpr
+  Copy_Traits<MP22_ROBUST_LDGSTS_OP<S, D>>
+  with(RobustDescriptor desc) const {
+    return {desc};
+  }
+
+  // Don't try to execute a copy with MP22_ROBUST_LDGSTS before calling .with()
+  template <class TS, class SLayout,
+            class TD, class DLayout>
+  MUTE_HOST_DEVICE friend constexpr
+  void
+  copy_unpack(Copy_Traits         const& traits,
+              Tensor<TS, SLayout> const& src,
+              Tensor<TD, DLayout>      & dst) = delete;
+};
+
+
+//
+// LDGSTS
+//
+
+template <class TS, class TD = TS>
+struct MP22_LDGSTS
+{
+  using SRegisters = TS[1];
+  using DRegisters = TD[1];
+
+  static_assert(sizeof(TS) == sizeof(TD),
+                "MP22_ROBUST_LDGSTS requires sizeof(src_value_type) == sizeof(dst_value_type)");
+  static_assert(sizeof(TS) == 1  || sizeof(TS) == 2  || sizeof(TS) == 4  || sizeof(TS) == 8 ||
+                sizeof(TS) == 16 || sizeof(TS) == 32 || sizeof(TS) == 64 || sizeof(TS) == 128,
+                "MP22_ROBUST_LDGSTS sizeof(TS) is not supported");
+
+  MUTE_HOST_DEVICE static void
+  copy(TS               const& gmem_src,
+       TD                    & smem_dst)
+  {
+#if defined(MUTE_MP22_ROBUST_EXT)
+    uint64_t gmem_int_ptr = reinterpret_cast<uint64_t>(&gmem_src);
+    uint32_t smem_int_ptr = cast_smem_ptr_to_uint(&smem_dst);
+    auto gmem_ptr = make_ptr_with_address_space<AddressSpace::Global>(gmem_int_ptr);
+    auto smem_ptr = make_ptr_with_address_space<AddressSpace::Shared>(smem_int_ptr);
+
+    __musa_memcpy_g2s(smem_ptr, gmem_ptr, sizeof(TS), 0);
+#else
+    MUTE_INVALID_CONTROL_PATH(
+        "Trying to use MP22_ROBUST_LDGSTS without MUTE_ARCH_ROBUST_BUFFER_ACCESS_ACTIVATED.");
+#endif
+  }
+};
+
+template <class S, class D>
+struct Copy_Traits<MP22_LDGSTS<S,D>>
+{
+  // Logical thread id to thread idx (one-thread)
+  using ThrID     = Layout<_1>;
+
+  // Map from (src-thr,src-val) to bit
+  using SrcLayout = Layout<Shape<_1, Int<sizeof_bits<S>::value>>>;
+  // Map from (dst-thr,dst-val) to bit
+  using DstLayout = Layout<Shape<_1, Int<sizeof_bits<D>::value>>>;
+
+  // Reference map from (thr,val) to bit
+  using RefLayout = SrcLayout;
+};
+
+} // namespace mute
