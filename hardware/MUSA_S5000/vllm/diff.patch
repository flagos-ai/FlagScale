+
+/// Returns the imaginary part of the complex number
+MUTLASS_HOST_DEVICE
+float const &imag(muFloatComplex const &z) { return z.y; }
+
+/// Returns the imaginary part of the complex number
+MUTLASS_HOST_DEVICE
+float &imag(muFloatComplex &z) { return z.y; }
+
+/// Returns the imaginary part of the complex number
+MUTLASS_HOST_DEVICE
+double const &imag(muDoubleComplex const &z) { return z.y; }
+
