+    e_score_correction_bias: torch.Tensor):
+    if on_qy2():
+        num_tokens, _ = gating_output.shape
+        topk_weights = torch.empty((num_tokens, topk), device=gating_output.device, dtype=gating_output.dtype)
+        topk_ids = torch.empty((num_tokens, topk), device=gating_output.device, dtype=torch.int32)
+        _kernels.mp22_fused_grouped_topk(topk_weights, topk_ids, gating_output, e_score_correction_bias, num_expert_group, topk_group, topk, renormalize)
+    elif on_ph1():
