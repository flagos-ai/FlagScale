+  auto shape_O = make_shape(actual_seqlen_q, get<3>(params.problem_shape), get<4>(params.problem_shape));
+  auto shape_L = make_shape(actual_seqlen_q, mute::_1{}, get<4>(params.problem_shape));
+
+  Tensor mQ = make_tensor(make_gmem_ptr(params.ptr_Q + q_ptr_offset), shape_Q, select<0, 1, 2>(params.stride_Q));
+  Tensor mK = make_tensor(make_gmem_ptr(params.ptr_K + k_ptr_offset), shape_K, select<0, 1, 2>(params.stride_K));
