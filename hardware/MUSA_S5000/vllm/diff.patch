index 000000000..9a7d1415e
--- /dev/null
+++ b/vllm_musa/csrc/flash_attn/v1_mp22_impl/attention_params.hpp
@@ -0,0 +1,164 @@
+#pragma once
+
+#include <mute/tensor.hpp>
+#include "../impl/mutlass_extension.hpp"
+
+
+struct VariableLength {
+  int max_length;
+  int* cumulative_length = nullptr;
+
+  MUTE_HOST_DEVICE operator int() const {
+    return max_length;
+  }
+};
+
+namespace mute {
+template <>
+struct is_integral<VariableLength> : true_type {};
+
+MUTE_HOST_DEVICE
+void print(VariableLength _) {
+  printf("Varlen<%d, %p>", _.max_length, _.cumulative_length);
+}
+
+} // namespace mute
+
+template <class KernelTraits>
+struct AttentionParams {
+  static constexpr bool IsVarlen = KernelTraits::IsVarlen;
+
+  using ElementQ  = typename KernelTraits::ElementQ;
+  using ElementKV = typename KernelTraits::ElementKV;
+  using ElementAccumulator = typename KernelTraits::ElementAccumulator;
+  using ElementLse = typename KernelTraits::ElementLse;
+
+  using ElementO = ElementQ;
+  using ElementP = ElementKV;
+
+  using IndexType = int32_t;
+
+  // Q, K, D_QK, D_VO, (H_R, H_KV), B
+  using ProblemShapeFixed  = mute::Shape<int, int, int, int, mute::Shape<int, int>, int>;
+  using ProblemShapeVarlen = mute::Shape<VariableLength, VariableLength, int, int, mute::Shape<int, int>, int>;
+  using ProblemShape = mute::conditional_t<IsVarlen,
+                                           ProblemShapeVarlen,
+                                           ProblemShapeFixed>;
+
+  // Q, D_QK, (H_R, H_KV), B
+  using StrideQ = mute::Stride<int, mute::_1, mute::Stride<int, int>, int>;
+
+  // K, D_QK, (H_R, H_KV), B
+  using StrideK = mute::Stride<int, mute::_1, mute::Stride<mute::_0, int>, int>;
+  using StrideL = mute::Stride<mute::_1, mute::_0, mute::Stride<int, int>>;
+
+  // V, D_VO, (H_R, H_KV), B
+  using StrideV = StrideK;
+
+  // Q, D_VO, (H_R, H_KV), B
+  using StrideO = StrideQ;
+
+  // Debug
+  // Q, K, (H_R, H_KV), B
+  using StrideP  = StrideQ;
+
+  struct Arguments {
+    ElementQ const* ptr_Q;
+    ElementKV const* ptr_K;
+    ElementKV const* ptr_V;
+
+    ElementO* ptr_O;
+    ElementLse* ptr_L;
+
+    // Debug
+    ElementP* ptr_P;
+  };
+
+
+  struct Params {
+    ProblemShape problem_shape;
+
+    ElementQ const* ptr_Q;
+    StrideQ stride_Q;
+    mute::RobustDescriptor desc_Q;
+    ElementKV const* ptr_K;
+    StrideK stride_K;
+    mute::RobustDescriptor desc_K;
+    ElementKV const* ptr_V;
+    StrideV stride_V;
+    mute::RobustDescriptor desc_V;
+
+    ElementO* ptr_O;
+    StrideO stride_O;
+
+    ElementLse* ptr_L;
+    StrideL stride_L;
+
+    float rln2_scale;
+    int* block_table;
+    int block_table_stride_batch;
+
+    // Debug
+    ElementP* ptr_P;
+    StrideP stride_P;
+  };
+
+  static Params
+  to_underlying_arguments(ProblemShape problem_shape, Arguments const& args,
+                          mute::Shape<int, int, int> qkv_elem,
+    IndexType q_seq_stride, IndexType q_num_head_stride,
+    IndexType k_num_page_stride, IndexType k_page_size_stride, IndexType k_num_head_stride,
+    IndexType v_num_page_stride, IndexType v_page_size_stride, IndexType v_num_head_stride,
+    IndexType o_seq_stride, IndexType o_num_head_stride,
+    IndexType lse_num_head_stride,
+    int* block_table, int block_table_stride_batch, float sm_scale
+                          ) {
+
+    int DimQK = mute::size<2>(problem_shape);
+    int H_KV  = mute::size<4,1>(problem_shape);
+    int H_R  = mute::size<4,0>(problem_shape);
+
+
+    StrideQ stride_Q = mute::make_stride(q_seq_stride, mute::_1{},
+                      mute::make_stride(q_num_head_stride, q_num_head_stride * H_R), 0); // TODO:
+    StrideK stride_K = mute::make_stride(k_page_size_stride, mute::_1{},
+                      mute::make_stride(mute::_0{}, k_num_head_stride), k_num_page_stride);
+    StrideV stride_V = mute::make_stride(v_page_size_stride, mute::_1{},
+                      mute::make_stride(mute::_0{}, v_num_head_stride), v_num_page_stride);
+    StrideO stride_O = mute::make_stride(o_seq_stride, mute::_1{},
+                      mute::make_stride(o_num_head_stride, o_num_head_stride * H_R), 0);
+    StrideL stride_L = mute::make_stride(mute::_1{}, mute::_0{}, mute::make_stride(lse_num_head_stride, lse_num_head_stride * H_R)); // TODO:
+
+    mute::RobustDescriptor desc_Q = mute::make_robust_desc(args.ptr_Q, mute::get<0>(qkv_elem));
+    mute::RobustDescriptor desc_K = mute::make_robust_desc(args.ptr_K, mute::get<1>(qkv_elem));
+    mute::RobustDescriptor desc_V = mute::make_robust_desc(args.ptr_V, mute::get<2>(qkv_elem));
+
+    constexpr float kLog2e = float(1.4426950408889634074);
+    const float softmax_scale = sm_scale;
+    float rln2_scale = softmax_scale * kLog2e;
+
+    StrideP stride_P;
+
+    return {
+      problem_shape,
+      args.ptr_Q,
+      stride_Q,
+      desc_Q,
+      args.ptr_K,
+      stride_K,
+      desc_K,
+      args.ptr_V,
+      stride_V,
+      desc_V,
+      args.ptr_O,
+      stride_O,
+      args.ptr_L,
+      stride_L,
+      rln2_scale,
+      block_table,
+      block_table_stride_batch,
+      args.ptr_P,
+      stride_P
+    };
+  }
+};
