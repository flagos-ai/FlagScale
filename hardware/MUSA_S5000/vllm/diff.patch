+  }
+
+  /// Inverse of layout function, mapping linear offset to logical coordinate
+  MUTLASS_HOST_DEVICE
+  MatrixCoord inverse(LongIndex offset) const {
+    MUTLASS_UNUSED(offset);
+    return MatrixCoord(0, 0);
+  }
+
+  /// Returns the stride of the layout
+  MUTLASS_HOST_DEVICE
+  Stride stride() const {
