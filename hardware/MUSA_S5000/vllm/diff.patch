+  Tensor tVsV = gmem_thr_copy_V.partition_D(sV); // (VCPY, VCPY_M, VCPY_N)
+  Tensor tVrV = make_fragment_like(tVsV);
+
+  Tensor tSgL = gmem_thr_copy_L.partition_D(gL);
+  // if (thread(0)) {
+  //   // print("liliang l_ptr_offset = ");print(l_ptr_offset);print("\n");
+  //   // print("liliang params.ptr_L = ");print(params.ptr_L);print("\n");
