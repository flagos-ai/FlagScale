+  using MUTE_STL_NAMESPACE::enable_if_t;
+}
+
+#define __MUTE_REQUIRES(...)   typename mute::enable_if<(__VA_ARGS__)>::type* = nullptr
+#define __MUTE_REQUIRES_V(...) typename mute::enable_if<decltype((__VA_ARGS__))::value>::type* = nullptr
