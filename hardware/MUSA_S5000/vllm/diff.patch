+#include <vector>
+#include <torch/all.h>
+#include <torch/csrc/utils/pycfunction_helpers.h>
+#include <torch_musa/csrc/aten/utils/Context.h>
+#include <torch_musa/csrc/aten/utils/Utils.h>
+#include <torch_musa/csrc/core/MUSAGuard.h>
+#include <tuple>
+#include <musa_robust.h>
+#include "musa.h"
+#include "../../linear/common.muh"
+#include "musa_helper.muh"
+#define MANY_STRUCT_ASM_HELPER_S64A64 1
+using struct_S64A64 = MUtensorDescriptor;
+#include "musa_asm.h"
+
+namespace
+{
+  bool is_fp8_e4m3_dtype(const at::ScalarType t)
+  {
+    return t == at::ScalarType::Float8_e4m3fn;
+  }
+}
+
+#define LAUNCH_KERNEL(KERN_NAME)                                           \
+  status = musaLaunchKernelEx(                                             \
+      &config,                                                             \
+      KERN_NAME,                                                           \
+      output_ptr, amax_ptr, tensor_desc_lhs.tensorDesc,                    \
+      tensor_desc_rhs.tensorDesc, tensor_desc_out.tensorDesc,              \
+      robust_ptr_input_bias.get_robust_ptr(),                              \
+      robust_ptr_input_z.get_robust_ptr(),                                 \
+      robust_ptr_lhs_scale.get_robust_ptr(),                               \
+      robust_ptr_rhs_scale.get_robust_ptr(),                               \
+      robust_ptr_out_scale.get_robust_ptr(), k_part_buffer,                \
+      k_part_flag, group_idx_ptr, group_scale_idx_ptr,                     \
+      group_scale_lhs_robust_vec, group_scale_rhs_robust_vec, alpha, beta, \
+      gamma, scale_lhs_mode, scale_rhs_mode, scale_out_mode, lhs_scales_m, \
+      lhs_scales_k, rhs_scales_k, rhs_scales_n, batch_stride_scale_lhs,    \
+      batch_stride_scale_rhs, quant_tile, amax_mode, act_mode, m, n, k,    \
+      num_groups, n, n, total_tile, block_tile, batch_stride_out,          \
+      batch_stride_c, k_part, k_part_block, ldkpart,                       \
+      kpart_batch_stride_c, fast_xytile.divisor, fast_xytile.multiplier,   \
+      fast_xytile.shift_right, fast_batch.divisor,                         \
+      fast_batch.multiplier, fast_batch.shift_right, cluster_dimx,         \
+      macro_bid_max, switch_swizzle, max_tile_y,                           \
+      fast_macro_tile_x.divisor, fast_macro_tile_x.multiplier,             \
+      fast_macro_tile_x.shift_right, fast_res_tile_x.divisor,              \
+      fast_res_tile_x.multiplier, fast_res_tile_x.shift_right,             \
+      fast_macro_tile_size.divisor, fast_macro_tile_size.multiplier,       \
+      fast_macro_tile_size.shift_right, tile_a_dim0, tile_a_dim1,          \
+      tile_a_dim2, tile_b_dim0, tile_b_dim1, tile_b_dim2, tile_c_dim0,     \
+      tile_c_dim1, tile_c_dim2);
+
+#define COMMON_BLOCK_INIT()                                                    \
+  dim3 block_size(1, 1, 1);                                                    \
+  dim3 grid_size{1, 1, 1};                                                     \
+  dim3 launch_grid_size{1, 1, 1};                                              \
+  int nr_threads = block_m == 128 ? 128 : 256;                                 \
+  int block_n = 128;                                                           \
+  int block_k = 128;                                                           \
+  grid_size.x = ceil_div(n, block_n);                                          \
+  grid_size.y = ceil_div(m, block_m);                                          \
+  grid_size.z = batch;                                                         \
+  block_size.x = nr_threads;                                                   \
+                                                                               \
+  launch_grid_size = grid_size;                                                \
+  int total_tile = grid_size.x * grid_size.y * grid_size.z;                    \
+  int block_tile = 0;                                                          \
+  launch_grid_size.x = min(total_tile, num_mp);                                \
+  launch_grid_size.y = 1;                                                      \
+  launch_grid_size.z = 1;                                                      \
+  block_tile = ceil_div(total_tile, launch_grid_size.x);                       \
+  FastDivmodForAsm fast_xytile = FastDivmodForAsm(grid_size.x * grid_size.y);  \
+  int cluster_dimx = 1;                                                        \
+  bool use_swizzle = true;                                                     \
+  int switch_swizzle = default_switch_swizzle;                                 \
+  int macro_tile_x = suggest_swizzle_val;                                      \
+  int max_tile_y = grid_size.y - 1;                                            \
+  int macro_tile_size = macro_tile_x * grid_size.y;                            \
+  int res_tile_x = grid_size.x % macro_tile_x;                                 \
+  if (switch_swizzle == 1)                                                     \
+  {                                                                            \
+    if (!use_swizzle)                                                          \
+    {                                                                          \
+      macro_tile_x = grid_size.y;                                              \
+    }                                                                          \
+    max_tile_y = grid_size.x - 1;                                              \
+    macro_tile_size = macro_tile_x * grid_size.x;                              \
+    res_tile_x = grid_size.y % macro_tile_x;                                   \
+  }                                                                            \
+  int macro_bid_max = 0;                                                       \
+  FastDivmodForAsm fast_macro_tile_x;                                          \
+  FastDivmodForAsm fast_res_tile_x;                                            \
+  FastDivmodForAsm fast_macro_tile_size;                                       \
+  if (use_swizzle)                                                             \
+  {                                                                            \
+    fast_macro_tile_x = FastDivmodForAsm(macro_tile_x);                        \
+    if (res_tile_x != 0)                                                       \
+    {                                                                          \
+      fast_res_tile_x = FastDivmodForAsm(res_tile_x);                          \
+    }                                                                          \
+    fast_macro_tile_size = FastDivmodForAsm(macro_tile_size);                  \
+    if (switch_swizzle == 1)                                                   \
+    {                                                                          \
+      macro_bid_max = grid_size.y / macro_tile_x * macro_tile_x * grid_size.x; \
+    }                                                                          \
+    else                                                                       \
+    {                                                                          \
+      macro_bid_max = grid_size.x / macro_tile_x * macro_tile_x * grid_size.y; \
+    }                                                                          \
+  }
+
+template <int block_m>
+void musa_m_grouped_gemm_fp8_fp8_bf16_nt_contiguous_bm(
+    const std::tuple<torch::Tensor, torch::Tensor> &lhs,
+    const std::tuple<torch::Tensor, torch::Tensor> &rhs,
+    torch::Tensor &out, const torch::Tensor &m_indices)
+{
+  torch::Tensor lhs_mat = std::get<0>(lhs);
+  torch::Tensor lhs_scales = std::get<1>(lhs);
+  torch::Tensor rhs_mat = std::get<0>(rhs);
+  torch::Tensor rhs_scales = std::get<1>(rhs);
+  TORCH_CHECK(lhs_mat.dim() == 2, "lhs matrix must be a 2D tensor.");
+  TORCH_CHECK(lhs_scales.dim() == 2, "lhs scales must be a 2D tensor.");
+  TORCH_CHECK(rhs_mat.dim() == 3, "rhs matrix must be a 3D tensor.");
+  TORCH_CHECK(rhs_scales.dim() == 3, "rhs scales must be a 3D tensor.");
+  TORCH_CHECK(out.dim() == 2, "out must be a 2D tensor.");
+
+  int m = lhs_mat.size(0);
+  int k = lhs_mat.size(1);
+  int num_groups = rhs_mat.size(0);
+  int n = rhs_mat.size(1);
+  int k_ = rhs_mat.size(2);
+  int m_ = out.size(0);
+  int n_ = out.size(1);
+  int m__ = m_indices.numel();
+  int lhs_scales_m = lhs_scales.size(0);
+  int lhs_scales_k = lhs_scales.size(1);
+  int rhs_scales_groups = rhs_scales.size(0);
+  int rhs_scales_n = rhs_scales.size(1);
+  int rhs_scales_k = rhs_scales.size(2);
+  TORCH_CHECK((m == m_) && (m_ == m__), "M dimension mismatch among lhs matrix, out and m_indices.");
+  TORCH_CHECK(n == n_, "N dimension mismatch between rhs matrix and out.");
+  TORCH_CHECK(k == k_, "K dimension mismatch between lhs and rhs matrix.");
+  TORCH_CHECK((lhs_scales_m == m) && (lhs_scales_k == ceil_div(k, 128)), "Unsupported lhs_scales shape.");
+  TORCH_CHECK((rhs_scales_groups == num_groups) && (rhs_scales_n == ceil_div(n, 128) && (rhs_scales_k == ceil_div(k, 128))), "Unsupported rhs_scales shape.");
+  TORCH_CHECK(lhs_mat.is_contiguous() && rhs_mat.is_contiguous(), "lhs and rhs matrix must be contiguous tensors.");
+  TORCH_CHECK(out.is_contiguous() && m_indices.is_contiguous(), "out and m_indices must be contiguous tensors.");
+  TORCH_CHECK(lhs_scales.is_contiguous() && rhs_scales.is_contiguous(), "lhs_scales and rhs_scales must be contiguous tensors.");
+
+  const auto lhs_dtype = lhs_mat.scalar_type();
+  const auto rhs_dtype = rhs_mat.scalar_type();
+  TORCH_CHECK(is_fp8_e4m3_dtype(lhs_dtype) && is_fp8_e4m3_dtype(rhs_dtype),
+              "lhs and rhs matrix must be float8 data types.");
+  TORCH_CHECK((lhs_scales.scalar_type() == at::ScalarType::Float) && (rhs_scales.scalar_type() == at::ScalarType::Float),
+              "lhs_scales and rhs_scales must be float32 data types.");
+  TORCH_CHECK(out.scalar_type() == at::ScalarType::BFloat16, "out must be bfloat16 data type.");
+  TORCH_CHECK(m_indices.scalar_type() == at::ScalarType::Int, "m_indices must be int dtype.");
+
+  if (m == 0)
+  {
+    return;
+  }
+
+  bfloat16_t *output_ptr = (bfloat16_t *)(out.data_ptr());
+
+  size_t lhs_dim_scale = 1;
+  size_t rhs_dim_scale = 1;
+  size_t out_dim_scale = 1;
+  size_t lhs_dim0 = k / lhs_dim_scale;
+  size_t lhs_dim1 = m;
+  size_t rhs_dim0 = k / rhs_dim_scale;
+  size_t rhs_dim1 = n;
+  constexpr int batch = 1;
+  FastDivmodForAsm fast_batch = FastDivmodForAsm(batch);
+
+  TensorDesc tensor_desc_lhs = TensorDesc({lhs_dim0, lhs_dim1, (uint64_t)batch},
+                                          (void *)(lhs_mat.data_ptr<FP8_TYPE>()),
+                                          MU_TENSOR_DESCRIPTOR_DATA_TYPE_INT8, 1, false);
+  TensorDesc tensor_desc_rhs = TensorDesc({rhs_dim0, rhs_dim1, (uint64_t)num_groups},
+                                          (void *)(rhs_mat.data_ptr<FP8_TYPE>()),
+                                          MU_TENSOR_DESCRIPTOR_DATA_TYPE_INT8, 1, false);
+  TensorDesc tensor_desc_out = TensorDesc({n / out_dim_scale, (uint64_t)m, (uint64_t)batch},
+                                          (void *)output_ptr,
+                                          MU_TENSOR_DESCRIPTOR_DATA_TYPE_BFLOAT16, 2, false);
+
+  size_t lhs_scale_buffer_size = lhs_scales.numel() * sizeof(float);
+  size_t rhs_scale_buffer_size = rhs_scales.numel() * sizeof(float);
+
+  __musa::robust_ptr<float> robust_ptr_input_bias(nullptr, 0);
+  __musa::robust_ptr<float> robust_ptr_input_z(nullptr, 0);
+  __musa::robust_ptr<float> robust_ptr_lhs_scale((float *)(lhs_scales.data_ptr<float>()), lhs_scale_buffer_size);
+  __musa::robust_ptr<float> robust_ptr_rhs_scale((float *)(rhs_scales.data_ptr<float>()), rhs_scale_buffer_size);
+  __musa::robust_ptr<float> robust_ptr_out_scale(nullptr, 0);
+
+  int warpg_m = 128;
+  int warpg_n = 128;
+  int tme_warp = 1;
+  void *amax_ptr = nullptr;
+  void *k_part_buffer = nullptr;
+  int *k_part_flag = nullptr;
+  int *group_idx_ptr = m_indices.data_ptr<int>();
+  int *group_scale_idx_ptr = nullptr;
+  int *group_scale_lhs_robust_vec = nullptr;
+  int *group_scale_rhs_robust_vec = nullptr;
+  float alpha = 1.f;
+  float beta = 0.f;
+  float gamma = 0.f;
+  int scale_lhs_mode = 4; // lhs matrix per-group quant
+  int scale_rhs_mode = 3; // rhs matrix per-block quant
+  int scale_out_mode = 0;
+  int batch_stride_scale_lhs = lhs_scales_m * lhs_scales_k;
+  int batch_stride_scale_rhs = rhs_scales_n * rhs_scales_k;
+  int quant_tile = 128; // quantization tile size
+  int amax_mode = 0;    // no amax
+  int act_mode = 0;     // no activation
+  size_t batch_stride_out = m * n;
+  size_t batch_stride_c = batch_stride_out;
+  int k_part = 1;
+  int k_part_block = k;
+  int ldkpart = ceil_div(n, 128) * 128;
+  size_t kpart_batch_stride_c = 0;
+  int default_switch_swizzle = 0;
+  int device;
+  MUSART_CHECK(musaGetDevice(&device));
+  musaDeviceProp device_prop;
+  MUSART_CHECK(musaGetDeviceProperties(&device_prop, device));
+  int num_mp = device_prop.multiProcessorCount;
+  int suggest_swizzle_val = num_mp % 4 == 0 ? 4 : 2;
+  COMMON_BLOCK_INIT();
+  int tile_a_dim0 = block_k;
+  int tile_a_dim1 = warpg_m / tme_warp;
+  int tile_a_dim2 = 1;
+  int tile_b_dim0 = block_k;
+  int tile_b_dim1 = warpg_n / tme_warp;
+  int tile_b_dim2 = 1;
+  int tile_c_dim0 = warpg_n;
+  int tile_c_dim1 = 4;
+  int tile_c_dim2 = 1;
+
+  const musaStream_t stream = at::musa::getCurrentMUSAStream();
+  musaLaunchConfig_t config = {0};
+  config.gridDim = launch_grid_size;
+  config.blockDim = block_size;
+  config.dynamicSmemBytes = 0;
+  config.stream = stream;
+
+  musaError_t status = musaSuccess;
+  if constexpr (block_m == 128)
+  {
+    LAUNCH_KERNEL(e4m3e4m3bf16bf16gemm_gm3_nt_tce_128_128x128B128_epilogue_group_block_128);
+  }
+  else
+  {
+    LAUNCH_KERNEL(e4m3e4m3bf16bf16gemm_gm3_nt_tce_256_256x128B128_epilogue_group_block_128);
+  }
+  MUSART_CHECK(status);
+  MUSART_CHECK(musaGetLastError());
+}
+
+void musa_m_grouped_gemm_fp8_fp8_bf16_nt_contiguous(
+    const std::tuple<torch::Tensor, torch::Tensor> &lhs,
+    const std::tuple<torch::Tensor, torch::Tensor> &rhs,
+    torch::Tensor &out, const torch::Tensor &m_indices, const int block_m)
+{
+  if (block_m == 128)
+  {
+    musa_m_grouped_gemm_fp8_fp8_bf16_nt_contiguous_bm<128>(lhs, rhs, out, m_indices);
+  }
+  else if (block_m == 256)
+  {
+    musa_m_grouped_gemm_fp8_fp8_bf16_nt_contiguous_bm<256>(lhs, rhs, out, m_indices);
+  }
+  else
+  {
+    TORCH_CHECK(false, "Unsupported block m size: ", block_m);
+  }
+}
